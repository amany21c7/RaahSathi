@{
    ViewData["Title"] = "Contact Us - 24x7 Emergency Roadside Support & Partnership";
}

<div class="container py-4 py-md-5">
    
    <!-- 1. Hero Section -->
    <div class="text-center mb-5">
        <span class="badge bg-warning text-dark px-3 py-2 font-weight-bold mb-3 rounded-pill" style="font-size: 0.85rem; letter-spacing: 1px;">
            <i class="fa-solid fa-headset me-1"></i> WE'RE HERE FOR YOU 24/7
        </span>
        <h1 class="display-4 font-weight-bold text-white mb-3" style="font-family: 'Outfit', sans-serif;">
            📞 Contact <span class="notranslate" translate="no"><span style="color: #ff6b00;">Raah</span><span class="text-white">Sathi</span></span>
        </h1>
        <p class="lead text-muted max-w-700 mx-auto" style="font-size: 1.2rem; line-height: 1.6;">
            Need assistance, have a question, or want to partner with us? Our team is here to help 24×7.
        </p>
    </div>

    <!-- 2. Emergency Support (TOP PRIORITY - Red / Orange Highlighted) -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="p-4 p-md-5 rounded-4 shadow-lg border border-danger border-opacity-50 text-center position-relative overflow-hidden" 
                 style="background: linear-gradient(135deg, rgba(220, 38, 38, 0.25) 0%, rgba(234, 88, 12, 0.25) 50%, rgba(15, 23, 42, 0.95) 100%);">
                <div class="position-absolute top-0 end-0 p-3 opacity-20 d-none d-md-block">
                    <i class="fa-solid fa-truck-monster fa-8x text-danger"></i>
                </div>
                <div class="d-inline-block bg-danger text-white px-3 py-1 rounded-pill font-weight-bold mb-3 shadow animate-pulse">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i> TOP PRIORITY
                </div>
                <h2 class="display-5 font-weight-extrabold text-white mb-2" style="font-family: 'Outfit', sans-serif;">
                    🚨 Emergency Roadside Assistance
                </h2>
                <p class="text-light mb-3" style="font-size: 1.1rem;">
                    Stranded on the road? Don't panic — our dispatch desk is active right now.
                </p>
                <div class="d-flex flex-column flex-sm-row justify-content-center align-items-center gap-3 my-4">
                    <a href="tel:+919536838103" class="btn btn-danger btn-lg px-4 py-3 font-weight-bold shadow-lg text-decoration-none">
                        <i class="fa-solid fa-phone-volume me-2"></i> +91 9536838103
                    </a>
                    <span class="badge bg-dark text-warning border border-warning px-3 py-2" style="font-size: 1rem;">
                        <i class="fa-solid fa-clock me-1"></i> Available 24×7
                    </span>
                    <a href="/Customer/Book" class="btn btn-warning btn-lg px-4 py-3 font-weight-bold text-dark shadow-lg">
                        <i class="fa-solid fa-car me-2"></i> Request Assistance
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Grid Layout for Customer Support, Business, Mechanic Partner, WhatsApp -->
    <div class="row g-4 mb-5">
        
        <!-- 3. Customer Support -->
        <div class="col-md-6 col-lg-3">
            <div class="glass-card h-100 p-4 border-secondary border-opacity-30 d-flex flex-column justify-content-between hover-lift">
                <div>
                    <div class="rounded-3 bg-dark border border-warning p-3 d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px;">
                        <i class="fa-solid fa-headset text-warning fa-lg"></i>
                    </div>
                    <h4 class="text-white font-weight-bold mb-3" style="font-family: 'Outfit', sans-serif;">3. Customer Care</h4>
                    <ul class="list-unstyled text-muted small mb-0 d-flex flex-column gap-2" style="line-height: 1.6;">
                        <li><i class="fa-solid fa-phone me-2 text-warning"></i> <a href="tel:+919536838103" class="text-light text-decoration-none">+91 9536838103</a></li>
                        <li><i class="fa-solid fa-envelope me-2 text-warning"></i> <a href="mailto:support.raahsathi@gmail.com" class="text-light text-decoration-none font-weight-bold">support.raahsathi@gmail.com</a></li>
                        <li><i class="fa-solid fa-calendar-days me-2 text-warning"></i> Monday – Sunday</li>
                        <li><i class="fa-solid fa-clock me-2 text-warning"></i> <span class="badge bg-dark border border-secondary text-warning">24×7 Support</span></li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- 9. WhatsApp Support -->
        <div class="col-md-6 col-lg-3">
            <div class="glass-card h-100 p-4 border-success border-opacity-40 d-flex flex-column justify-content-between hover-lift" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.15) 0%, rgba(15, 23, 42, 0.95) 100%);">
                <div>
                    <div class="rounded-3 bg-dark border border-success p-3 d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px;">
                        <i class="fa-brands fa-whatsapp text-success fa-xl"></i>
                    </div>
                    <h4 class="text-white font-weight-bold mb-2" style="font-family: 'Outfit', sans-serif;">9. WhatsApp Support</h4>
                    <p class="text-muted small mb-3">Chat instantly on WhatsApp for location sharing &amp; quick estimates.</p>
                </div>
                <a href="https://wa.me/919536838103" target="_blank" class="btn btn-success w-100 py-2 font-weight-bold shadow-sm">
                    <i class="fa-brands fa-whatsapp me-2"></i> Chat Instantly (9536838103)
                </a>
            </div>
        </div>

        <!-- 4. Business Enquiries -->
        <div class="col-md-6 col-lg-3">
            <div class="glass-card h-100 p-4 border-secondary border-opacity-30 d-flex flex-column justify-content-between hover-lift">
                <div>
                    <div class="rounded-3 bg-dark border border-warning p-3 d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px;">
                        <i class="fa-solid fa-briefcase text-warning fa-lg"></i>
                    </div>
                    <h4 class="text-white font-weight-bold mb-2" style="font-family: 'Outfit', sans-serif;">4. Business &amp; Partnership</h4>
                    <p class="text-warning small font-weight-bold mb-2"><i class="fa-solid fa-envelope me-1"></i> <a href="mailto:support.raahsathi@gmail.com" class="text-warning text-decoration-none">support.raahsathi@gmail.com</a></p>
                    <div class="d-flex flex-wrap gap-1 mb-3">
                        <span class="badge bg-dark border border-secondary text-muted">Fleet Owners</span>
                        <span class="badge bg-dark border border-secondary text-muted">Insurance Cos</span>
                        <span class="badge bg-dark border border-secondary text-muted">Corporate</span>
                        <span class="badge bg-dark border border-secondary text-muted">Service Centers</span>
                        <span class="badge bg-dark border border-secondary text-muted">Franchise</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 5. Become a Partner Mechanic -->
        <div class="col-md-6 col-lg-3">
            <div class="glass-card h-100 p-4 border-warning border-opacity-40 d-flex flex-column justify-content-between hover-lift">
                <div>
                    <div class="rounded-3 bg-dark border border-warning p-3 d-inline-flex align-items-center justify-content-center mb-3" style="width: 48px; height: 48px;">
                        <i class="fa-solid fa-screwdriver-wrench text-warning fa-lg"></i>
                    </div>
                    <h4 class="text-white font-weight-bold mb-2" style="font-family: 'Outfit', sans-serif;">5. Join Our Mechanic Network</h4>
                    <ul class="list-unstyled text-muted small mb-3">
                        <li><i class="fa-solid fa-check text-success me-1"></i> Garage Owners</li>
                        <li><i class="fa-solid fa-check text-success me-1"></i> Freelance Mechanics</li>
                        <li><i class="fa-solid fa-check text-success me-1"></i> Towing Operators</li>
                        <li><i class="fa-solid fa-check text-success me-1"></i> EV Technicians</li>
                    </ul>
                </div>
                <a href="/Auth/Login?role=Mechanic" class="btn btn-premium-primary w-100 py-2 font-weight-bold">
                    <i class="fa-solid fa-user-plus me-1"></i> Join Now
                </a>
            </div>
        </div>
    </div>

    <!-- 6. Office Address & 7. Contact Form Grid -->
    <div class="row g-4 mb-5">
        
        <!-- 6. Office Address & Google Map -->
        <div class="col-lg-5">
            <div class="glass-card h-100 p-4 p-md-5 border-secondary border-opacity-30 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center mb-4">
                        <div class="rounded-circle bg-dark border border-warning p-2 d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                            <i class="fa-solid fa-building text-warning fa-lg"></i>
                        </div>
                        <div>
                            <span class="badge bg-dark text-warning border border-warning mb-1" style="font-size: 0.75rem;">HEADQUARTERS</span>
                            <h4 class="text-white font-weight-bold mb-0" style="font-family: 'Outfit', sans-serif;">6. Corporate Office</h4>
                        </div>
                    </div>
                    <h5 class="text-white font-weight-bold mb-2"><span class="notranslate" translate="no"><span style="color: #ff6b00;">Raah</span><span class="text-white">Sathi</span> Technologies Pvt. Ltd.</span></h5>
                    <p class="text-muted mb-4">
                        <i class="fa-solid fa-location-dot text-danger me-2"></i> Noida, Uttar Pradesh, India
                    </p>
                </div>

                <!-- Google Map Embed -->
                <div class="rounded-3 overflow-hidden border border-secondary shadow-sm mt-3" style="height: 250px;">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d14014.869875955051!2d77.37894225000001!3d28.57745745!2m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390ce5a43173357b%3A0x37ff13088b901a55!2sNoida%2C%20Uttar%20Pradesh!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin" 
                            width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>
        </div>

        <!-- 7. Contact Form -->
        <div class="col-lg-7">
            <div class="glass-card p-4 p-md-5 border-warning border-opacity-30">
                <div class="d-flex align-items-center mb-4">
                    <div class="rounded-circle bg-dark border border-warning p-2 d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                        <i class="fa-solid fa-paper-plane text-warning fa-lg"></i>
                    </div>
                    <div>
                        <span class="badge bg-dark text-warning border border-warning mb-1" style="font-size: 0.75rem;">GET IN TOUCH</span>
                        <h3 class="text-white font-weight-bold mb-0" style="font-family: 'Outfit', sans-serif;">7. Contact Form</h3>
                    </div>
                </div>

                <form id="contactUsForm" onsubmit="handleContactSubmit(event)">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Full Name *</label>
                            <input type="text" name="fullName" class="form-control glass-input text-white" placeholder="Enter your full name" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Mobile Number *</label>
                            <input type="tel" name="phone" class="form-control glass-input text-white" placeholder="+91 XXXXX XXXXX" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Email Address *</label>
                            <input type="email" name="email" class="form-control glass-input text-white" placeholder="name@example.com" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small">Subject *</label>
                            <select name="subject" class="form-select glass-input text-white" required>
                                <option value="" disabled selected class="bg-dark">Select inquiry subject</option>
                                <option value="Roadside Breakdown Help" class="bg-dark">Roadside Breakdown Help</option>
                                <option value="Business & Partnership" class="bg-dark">Business &amp; Partnership</option>
                                <option value="Join as Mechanic Partner" class="bg-dark">Join as Mechanic Partner</option>
                                <option value="General Inquiry" class="bg-dark">General Inquiry</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-muted small">Message *</label>
                            <textarea name="message" class="form-control glass-input text-white" rows="4" placeholder="How can we help you today?" required></textarea>
                        </div>
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-premium-primary btn-lg w-100 py-3 font-weight-bold shadow-lg">
                                <i class="fa-solid fa-paper-plane me-2"></i> Send Message
                            </button>
                        </div>
                    </div>
                </form>

                <div id="formSuccessAlert" class="alert alert-success mt-4 d-none" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i> Thank you! Your message has been sent successfully. Our support team will get back to you within 15 minutes.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function handleContactSubmit(e) {
        e.preventDefault();
        var formData = $('#contactUsForm').serialize();
        $.post('/Home/SubmitContactForm', formData, function(res) {
            if (res && res.success) {
                $('#formSuccessAlert').text('✔ ' + res.message).removeClass('d-none alert-danger').addClass('alert-success');
                document.getElementById('contactUsForm').reset();
                setTimeout(function() {
                    $('#formSuccessAlert').addClass('d-none');
                }, 6000);
            } else {
                $('#formSuccessAlert').text('✖ ' + (res.message || 'Error sending message')).removeClass('d-none alert-success').addClass('alert-danger');
            }
        }).fail(function() {
            $('#formSuccessAlert').text('✖ Failed to send message. Please try again or call +91 9536838103 directly.').removeClass('d-none alert-success').addClass('alert-danger');
        });
    }
</script>
}
