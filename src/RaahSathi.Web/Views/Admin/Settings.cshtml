@using RaahSathi.Models
@using RaahSathi.Services
@{
    ViewData["Title"] = "API & Contact Settings";
    var settings = ViewBag.Settings as List<AdminSystemSetting> ?? new List<AdminSystemSetting>();
    
    // API Gateway Keys
    var smsApiKeySetting = settings.FirstOrDefault(s => s.SettingKey == "SmsApiKey")?.SettingValue ?? "F2SMS_LIVE_SEC_882190012";
    var whatsappNoSetting = settings.FirstOrDefault(s => s.SettingKey == "WhatsAppNo")?.SettingValue ?? ContactInfoHelper.WhatsAppNumber;
    var googleMapsKeySetting = settings.FirstOrDefault(s => s.SettingKey == "GoogleMapsKey")?.SettingValue ?? "AIzaSyA88921_RS_MAPS_KEY";
    var emailSenderSetting = settings.FirstOrDefault(s => s.SettingKey == "EmailSender")?.SettingValue ?? ContactInfoHelper.SupportEmail;

    // RaahSathi Public Contact Details & Helplines
    var helplineNumberSetting = settings.FirstOrDefault(s => s.SettingKey == "HelplineNumber")?.SettingValue ?? ContactInfoHelper.HelplineNumber;
    var tollFreeNumberSetting = settings.FirstOrDefault(s => s.SettingKey == "TollFreeNumber")?.SettingValue ?? ContactInfoHelper.TollFreeNumber;
    var emergencySupportNumberSetting = settings.FirstOrDefault(s => s.SettingKey == "EmergencySupportNumber")?.SettingValue ?? ContactInfoHelper.EmergencySupportNumber;
    var whatsAppNumberSetting = settings.FirstOrDefault(s => s.SettingKey == "WhatsAppNumber")?.SettingValue ?? ContactInfoHelper.WhatsAppNumber;
    var supportEmailSetting = settings.FirstOrDefault(s => s.SettingKey == "SupportEmail")?.SettingValue ?? ContactInfoHelper.SupportEmail;
    var billingEmailSetting = settings.FirstOrDefault(s => s.SettingKey == "BillingEmail")?.SettingValue ?? ContactInfoHelper.BillingEmail;
    var partnerHelplineNumberSetting = settings.FirstOrDefault(s => s.SettingKey == "PartnerHelplineNumber")?.SettingValue ?? ContactInfoHelper.PartnerHelplineNumber;
    var officeAddressSetting = settings.FirstOrDefault(s => s.SettingKey == "OfficeAddress")?.SettingValue ?? ContactInfoHelper.OfficeAddress;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white font-weight-bold mb-1"><i class="fa-solid fa-sliders text-warning me-2"></i> System API &amp; Contact Integration</h4>
        <p class="text-muted small mb-0">Configure live SMS/WhatsApp gateways, system SMTP, and manage official RaahSathi public contact helplines &amp; email addresses.</p>
    </div>
</div>

<form action="/Admin/SaveSystemSettings" method="POST">
    <div class="row g-4">
        <!-- 1. API Gateway Credentials -->
        <div class="col-lg-12">
            <div class="card bg-dark border-secondary shadow-sm">
                <div class="card-header border-secondary bg-transparent py-3">
                    <h5 class="text-info mb-0"><i class="fa-solid fa-key me-2"></i> SMS, WhatsApp &amp; Map API Keys</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6 mb-2">
                            <label class="form-label text-muted small font-weight-bold">Fast2SMS / Twilio SMS API Key</label>
                            <input type="password" name="smsApiKey" class="form-control glass-input text-white" value="@smsApiKeySetting" placeholder="Enter SMS gateway secret key...">
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label text-muted small font-weight-bold">WhatsApp Business API Phone</label>
                            <input type="text" name="whatsappNo" class="form-control glass-input text-white" value="@whatsappNoSetting" placeholder="Enter WhatsApp phone number...">
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label text-muted small font-weight-bold">Google Maps JavaScript API Key</label>
                            <input type="password" name="googleMapsKey" class="form-control glass-input text-white" value="@googleMapsKeySetting" placeholder="Enter Maps Javascript API key...">
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label text-muted small font-weight-bold">System SMTP Sender Email Address</label>
                            <input type="email" name="emailSender" class="form-control glass-input text-white" value="@emailSenderSetting" placeholder="e.g. support.raahsathi@gmail.com">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. RaahSathi Public Contact Details & Helpline Grid -->
        <div class="col-lg-12">
            <div class="card bg-dark border-secondary shadow-sm">
                <div class="card-header border-secondary bg-transparent py-3 d-flex justify-content-between align-items-center">
                    <h5 class="text-warning mb-0"><i class="fa-solid fa-headset me-2"></i> RaahSathi Contact &amp; Helpline Details</h5>
                    <span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-40"><i class="fa-solid fa-arrows-rotate me-1"></i> Global Live Sync</span>
                </div>
                <div class="card-body p-4">
                    <div class="p-3 bg-warning bg-opacity-10 border border-warning border-opacity-30 rounded-3 mb-4 d-flex align-items-center gap-3">
                        <i class="fa-solid fa-shield-halved text-warning fs-3"></i>
                        <div>
                            <strong class="text-white d-block" style="font-size: 0.95rem;">Universal Platform Live Synchronization</strong>
                            <span class="text-muted small">Yahan update ki gayi details pure <strong>RaahSathi Platform</strong> (Navbar, Call Now Buttons, Footer, Contact Us Page, Emergency SOS Modals, AI Chatbot, Policies, Customer &amp; Mechanic Dashboards) par instantly sync ho jayengi.</span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <!-- Helpline / Calling Number -->
                        <div class="col-md-6 col-lg-3 mb-2">
                            <label class="form-label text-muted small font-weight-bold">
                                <i class="fa-solid fa-phone-volume text-warning me-1"></i> 24×7 Calling Helpline
                            </label>
                            <input type="text" name="helplineNumber" class="form-control glass-input text-white font-weight-bold" value="@helplineNumberSetting" placeholder="+91 9891819236">
                            <span class="text-muted text-xs d-block mt-1">Main number on Call Now buttons &amp; Header</span>
                        </div>

                        <!-- Toll-Free / Alternate Hotline -->
                        <div class="col-md-6 col-lg-3 mb-2">
                            <label class="form-label text-muted small font-weight-bold">
                                <i class="fa-solid fa-square-phone text-danger me-1"></i> Toll-Free / Hotline Number
                            </label>
                            <input type="text" name="tollFreeNumber" class="form-control glass-input text-white" value="@tollFreeNumberSetting" placeholder="1800-102-7224">
                            <span class="text-muted text-xs d-block mt-1">Toll-free hotline for emergency desk &amp; policies</span>
                        </div>

                        <!-- Emergency Support Contact -->
                        <div class="col-md-6 col-lg-3 mb-2">
                            <label class="form-label text-muted small font-weight-bold">
                                <i class="fa-solid fa-triangle-exclamation text-danger me-1"></i> Emergency SOS Direct Phone
                            </label>
                            <input type="text" name="emergencySupportNumber" class="form-control glass-input text-white" value="@emergencySupportNumberSetting" placeholder="+91 9536838103">
                            <span class="text-muted text-xs d-block mt-1">Direct escalation phone in SOS support modal</span>
                        </div>

                        <!-- WhatsApp Support Number -->
                        <div class="col-md-6 col-lg-3 mb-2">
                            <label class="form-label text-muted small font-weight-bold">
                                <i class="fa-brands fa-whatsapp text-success me-1"></i> WhatsApp Support Number
                            </label>
                            <input type="text" name="whatsAppNumber" class="form-control glass-input text-white" value="@whatsAppNumberSetting" placeholder="+91 9891819236">
                            <span class="text-muted text-xs d-block mt-1">Direct WhatsApp chat &amp; location sharing</span>
                        </div>

                        <!-- Support Email -->
                        <div class="col-md-6 col-lg-4 mb-2">
                            <label class="form-label text-muted small font-weight-bold">
                                <i class="fa-solid fa-envelope text-info me-1"></i> Customer Support Email
                            </label>
                            <input type="email" name="supportEmail" class="form-control glass-input text-white" value="@supportEmailSetting" placeholder="support.raahsathi@gmail.com">
                            <span class="text-muted text-xs d-block mt-1">Official public support inbox</span>
                        </div>

                        <!-- Billing & Dispute Email -->
                        <div class="col-md-6 col-lg-4 mb-2">
                            <label class="form-label text-muted small font-weight-bold">
                                <i class="fa-solid fa-receipt text-warning me-1"></i> Billing &amp; Dispute Email
                            </label>
                            <input type="email" name="billingEmail" class="form-control glass-input text-white" value="@billingEmailSetting" placeholder="billing@raahsathi.in">
                            <span class="text-muted text-xs d-block mt-1">Billing queries &amp; escrow dispute desk</span>
                        </div>

                        <!-- Partner / Mechanic Helpline -->
                        <div class="col-md-6 col-lg-4 mb-2">
                            <label class="form-label text-muted small font-weight-bold">
                                <i class="fa-solid fa-user-gear text-info me-1"></i> Mechanic Partner Helpline
                            </label>
                            <input type="text" name="partnerHelplineNumber" class="form-control glass-input text-white" value="@partnerHelplineNumberSetting" placeholder="+91 9891819236">
                            <span class="text-muted text-xs d-block mt-1">Helpline for mechanic onboarding &amp; partnerships</span>
                        </div>

                        <!-- Office Address -->
                        <div class="col-12 mb-2">
                            <label class="form-label text-muted small font-weight-bold">
                                <i class="fa-solid fa-location-dot text-danger me-1"></i> Corporate Head Office Address
                            </label>
                            <input type="text" name="officeAddress" class="form-control glass-input text-white" value="@officeAddressSetting" placeholder="Tower B, DLF Cyber City, Sector 24, Gurugram, Haryana - 122002">
                            <span class="text-muted text-xs d-block mt-1">Head office address displayed on Contact Us &amp; Footer</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 text-end">
        <button type="submit" class="btn btn-warning text-dark font-weight-bold px-5 py-2.5 shadow">
            <i class="fa-solid fa-floppy-disk me-1"></i> Save All System Settings
        </button>
    </div>
</form>
