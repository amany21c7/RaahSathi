@model IEnumerable<RaahSathi.Models.ContactMessage>
@using RaahSathi.Models
@using System.Text.Encodings.Web
@{
    ViewData["Title"] = "Analytics & Support Center - Admin Console";
    string currentFilter = ViewBag.StatusFilter as string ?? "All";
    int totalCount = ViewBag.TotalCount ?? 0;
    int pendingCount = ViewBag.PendingCount ?? 0;
    int contactedCount = ViewBag.ContactedCount ?? 0;
    int resolvedCount = ViewBag.ResolvedCount ?? 0;

    var complaints = ViewBag.Complaints as List<MechanicComplaint> ?? new List<MechanicComplaint>();
    var warnings = ViewBag.Warnings as List<MechanicWarning> ?? new List<MechanicWarning>();
}

<style>
    .btn-tab-pill {
        border-radius: 20px;
        font-weight: 600;
        transition: all 0.2s ease-in-out;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(30, 41, 59, 0.4);
    }
    .btn-tab-pill.active {
        background: #ff6b00 !important;
        border-color: #ff6b00 !important;
        color: #fff !important;
        box-shadow: 0 4px 15px rgba(255, 107, 0, 0.3);
    }
    .hover-lift {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-lift:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    }
    .glass-card {
        background: rgba(30, 41, 59, 0.45);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    }
    .cursor-pointer {
        cursor: pointer;
    }
    .quick-chip {
        font-size: 0.75rem;
        transition: all 0.15s ease;
        border-color: rgba(255, 255, 255, 0.2) !important;
    }
    .quick-chip:hover {
        background: #ff6b00 !important;
        border-color: #ff6b00 !important;
        color: #fff !important;
    }
</style>

<div class="container-fluid py-2 py-sm-4 px-1 px-sm-3">
    <!-- Header & Navigation -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 mb-sm-4 pb-3 border-bottom border-secondary gap-2">
        <div>
            <span class="badge bg-warning text-dark font-weight-bold px-3 py-1 mb-1.5">ADMIN NOC</span>
            <h3 class="text-white font-weight-bold mb-0 fs-5 fs-sm-4" style="font-family: 'Outfit', sans-serif;">
                <i class="fa-solid fa-headset text-warning me-1.5"></i> Support &amp; Complaint Center
            </h3>
            <p class="text-muted small mb-0">Manage customer/partner support tickets, track user complaints, and issue warning alerts.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Admin/Dashboard" class="btn btn-outline-light btn-sm px-3 font-weight-bold">
                <i class="fa-solid fa-gauge me-1"></i> Dashboard
            </a>
            <a href="/Admin/ManagePricing" class="btn btn-outline-warning btn-sm px-3 font-weight-bold">
                <i class="fa-solid fa-indian-rupee-sign me-1"></i> Pricing Rules
            </a>
        </div>
    </div>

    <!-- Tab Selection Navigation (Scrollable on Mobile) -->
    <div class="overflow-auto pb-1 mb-3">
        <ul class="nav nav-pills flex-nowrap text-nowrap gap-2" id="supportTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active btn-tab-pill text-white px-3 px-sm-4 py-2" id="enquiries-tab" data-bs-toggle="pill" data-bs-target="#enquiries-panel" type="button" role="tab" style="font-size: 0.85rem;">
                    <i class="fa-solid fa-envelope me-1.5 text-warning"></i> Support Enquiries
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link btn-tab-pill text-white position-relative px-3 px-sm-4 py-2" id="complaints-tab" data-bs-toggle="pill" data-bs-target="#complaints-panel" type="button" role="tab" style="font-size: 0.85rem;">
                    <i class="fa-solid fa-triangle-exclamation text-danger me-1.5"></i> Job Complaints &amp; Warnings
                    @if (complaints.Any(c => c.Status == "Pending"))
                    {
                        <span class="badge bg-danger rounded-pill ms-1 font-weight-bold" style="font-size: 0.7rem;">@complaints.Count(c => c.Status == "Pending")</span>
                    }
                </button>
            </li>
        </ul>
    </div>

    <!-- Tab Contents -->
    <div class="tab-content" id="supportTabsContent">
        
        <!-- PANEL 1: SUPPORT ENQUIRIES -->
        <div class="tab-pane fade show active" id="enquiries-panel" role="tabpanel" aria-labelledby="enquiries-tab">
            <!-- Summary Stat Cards -->
            <div class="row g-2 g-sm-3 mb-3">
                <div class="col-6 col-md-3">
                    <a href="/Admin/Messages?statusFilter=All" class="text-decoration-none">
                        <div class="kpi-stat-card @(currentFilter == "All" ? "border-warning bg-dark bg-opacity-60" : "")">
                            <span class="kpi-stat-title">Total Messages</span>
                            <h3 class="kpi-stat-value text-white">@totalCount</h3>
                            <small class="kpi-stat-subtitle"><i class="fa-solid fa-inbox me-1 text-primary"></i> All Inbox</small>
                        </div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/Admin/Messages?statusFilter=Pending" class="text-decoration-none">
                        <div class="kpi-stat-card @(currentFilter == "Pending" ? "border-warning bg-dark bg-opacity-60" : "")">
                            <span class="kpi-stat-title text-warning">Pending</span>
                            <h3 class="kpi-stat-value text-warning">@pendingCount</h3>
                            <small class="kpi-stat-subtitle"><i class="fa-solid fa-clock me-1 text-warning"></i> Follow-up</small>
                        </div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/Admin/Messages?statusFilter=Contacted" class="text-decoration-none">
                        <div class="kpi-stat-card @(currentFilter == "Contacted" ? "border-info bg-dark bg-opacity-60" : "")">
                            <span class="kpi-stat-title text-info">Contacted</span>
                            <h3 class="kpi-stat-value text-info">@contactedCount</h3>
                            <small class="kpi-stat-subtitle"><i class="fa-solid fa-phone me-1 text-info"></i> In Progress</small>
                        </div>
                    </a>
                </div>
                <div class="col-6 col-md-3">
                    <a href="/Admin/Messages?statusFilter=Resolved" class="text-decoration-none">
                        <div class="kpi-stat-card @(currentFilter == "Resolved" ? "border-success bg-dark bg-opacity-60" : "")">
                            <span class="kpi-stat-title text-success">Resolved</span>
                            <h3 class="kpi-stat-value text-success">@resolvedCount</h3>
                            <small class="kpi-stat-subtitle"><i class="fa-solid fa-circle-check me-1 text-success"></i> Closed</small>
                        </div>
                    </a>
                </div>
            </div>

            <!-- Filter Buttons Toolbar (Scrollable) -->
            <div class="overflow-auto pb-1 mb-3">
                <div class="btn-group text-nowrap" role="group">
                    <a href="/Admin/Messages?statusFilter=All" class="btn btn-sm py-1.5 @(currentFilter == "All" ? "btn-warning font-weight-bold text-dark" : "btn-outline-secondary text-light")">All (@totalCount)</a>
                    <a href="/Admin/Messages?statusFilter=Pending" class="btn btn-sm py-1.5 @(currentFilter == "Pending" ? "btn-warning font-weight-bold text-dark" : "btn-outline-secondary text-light")">Pending (@pendingCount)</a>
                    <a href="/Admin/Messages?statusFilter=Contacted" class="btn btn-sm py-1.5 @(currentFilter == "Contacted" ? "btn-warning font-weight-bold text-dark" : "btn-outline-secondary text-light")">Contacted (@contactedCount)</a>
                    <a href="/Admin/Messages?statusFilter=Resolved" class="btn btn-sm py-1.5 @(currentFilter == "Resolved" ? "btn-warning font-weight-bold text-dark" : "btn-outline-secondary text-light")">Resolved (@resolvedCount)</a>
                </div>
            </div>

            <!-- Messages Table -->
            <div class="glass-card p-3 border-secondary border-opacity-35">
                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <i class="fa-solid fa-inbox text-muted fa-3x mb-3"></i>
                        <h5 class="text-white">No Messages Found</h5>
                        <p class="text-muted small mb-0">There are no customer contact messages matching filter "@currentFilter".</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
                            <thead>
                                <tr class="text-muted small border-bottom border-secondary">
                                    <th>ID &amp; Date</th>
                                    <th>Customer Info</th>
                                    <th>Subject &amp; Inquiry</th>
                                    <th>Message &amp; Attachment</th>
                                    <th>Status</th>
                                    <th class="text-end">Direct Contact Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var msg in Model)
                                {
                                    var cleanPhone = msg.Phone.Replace(" ", "").Replace("-", "").Replace("+", "");
                                    if (cleanPhone.Length == 10) cleanPhone = "91" + cleanPhone;

                                    <tr class="border-bottom border-secondary border-opacity-30">
                                        <td class="cursor-pointer" onclick="triggerRowModal(@msg.Id)">
                                            <div class="font-weight-bold text-white">#MSG-@msg.Id</div>
                                            <div class="text-muted extra-small" style="font-size: 0.75rem;">
                                                @msg.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")
                                            </div>
                                        </td>
                                        <td class="cursor-pointer" onclick="triggerRowModal(@msg.Id)">
                                            <div class="font-weight-bold text-white">@msg.FullName</div>
                                            <div class="small text-warning">
                                                <i class="fa-solid fa-phone me-1"></i> @msg.Phone
                                            </div>
                                            @if (!string.IsNullOrEmpty(msg.Email))
                                            {
                                                <div class="small text-muted text-truncate" style="max-width: 190px;" title="@msg.Email">
                                                    <i class="fa-solid fa-envelope me-1"></i> @msg.Email
                                                </div>
                                            }
                                        </td>
                                        <td class="cursor-pointer" onclick="triggerRowModal(@msg.Id)">
                                            <span class="badge bg-dark border border-warning text-warning mb-1">
                                                @msg.Subject
                                            </span>
                                            @if (!string.IsNullOrEmpty(msg.UserRole))
                                            {
                                                var roleBadgeClass = msg.UserRole switch
                                                {
                                                    "Admin" => "bg-danger text-white",
                                                    "Mechanic" => "bg-info text-dark",
                                                    "Customer" => "bg-success text-white",
                                                    _ => "bg-secondary text-light"
                                                };
                                                <span class="badge @roleBadgeClass ms-1 mb-1">
                                                    @msg.UserRole
                                                </span>
                                            }
                                        </td>
                                        <td class="cursor-pointer" onclick="triggerRowModal(@msg.Id)" style="max-width: 280px;">
                                            <div class="text-light" style="font-size: 0.88rem; line-height: 1.45;">
                                                @if ((msg.Message ?? "").Length > 85)
                                                {
                                                    <span>@(msg.Message?.Substring(0, 85))...</span>
                                                    <span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-30 ms-1" style="font-size: 0.7rem;">
                                                        <i class="fa-solid fa-expand me-0.5"></i> Read More
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>@(msg.Message ?? "")</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(msg.PhotoUrl))
                                            {
                                                <div class="mt-1.5 d-flex align-items-center gap-1">
                                                    <img src="@msg.PhotoUrl" style="height: 34px; width: 34px; object-fit: cover; border-radius: 4px; border: 1px solid rgba(255,255,255,0.2);" alt="Attachment" />
                                                    <span class="badge bg-secondary text-light extra-small" style="font-size: 0.68rem;"><i class="fa-solid fa-paperclip me-1"></i>Attachment</span>
                                                </div>
                                            }
                                            @if (!string.IsNullOrEmpty(msg.AdminReply))
                                            {
                                                <div class="mt-1">
                                                    <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-30" style="font-size: 0.72rem;">
                                                        <i class="fa-solid fa-circle-check me-1"></i>Replied
                                                    </span>
                                                </div>
                                            }
                                            else if (!string.IsNullOrEmpty(msg.AdminNotes))
                                            {
                                                <div class="small text-info mt-1" style="font-size: 0.74rem;">
                                                    <i class="fa-solid fa-sticky-note me-1"></i>Note: @msg.AdminNotes
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            @if (msg.Status == "Pending")
                                            {
                                                <span class="badge bg-warning text-dark font-weight-bold px-2 py-1"><i class="fa-solid fa-clock me-1"></i> Pending</span>
                                            }
                                            else if (msg.Status == "Contacted")
                                            {
                                                <span class="badge bg-info text-dark font-weight-bold px-2 py-1"><i class="fa-solid fa-phone me-1"></i> Contacted</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success text-white font-weight-bold px-2 py-1"><i class="fa-solid fa-circle-check me-1"></i> Resolved</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end align-items-center gap-1">
                                                <!-- Call Button -->
                                                <a href="tel:@msg.Phone" class="btn btn-outline-warning btn-sm" title="Call Customer">
                                                    <i class="fa-solid fa-phone"></i>
                                                </a>

                                                <!-- WhatsApp Button -->
                                                <a href="https://wa.me/@cleanPhone?text=Hello%20@Uri.EscapeDataString(msg.FullName),%20this%20is%20RaahSathi%20Support%20regarding%20your%20inquiry:%20@Uri.EscapeDataString(msg.Subject)" target="_blank" class="btn btn-outline-success btn-sm" title="WhatsApp Customer">
                                                    <i class="fa-brands fa-whatsapp"></i>
                                                </a>

                                                <!-- Email Button (Clean subject, no clutter) -->
                                                @if (!string.IsNullOrEmpty(msg.Email))
                                                {
                                                    <a href="mailto:@msg.Email?subject=@Uri.EscapeDataString("RaahSathi Support: " + msg.Subject)" class="btn btn-outline-info btn-sm" title="Send Email">
                                                        <i class="fa-solid fa-envelope"></i>
                                                    </a>
                                                }

                                                <!-- Action: View & Reply Modal Trigger -->
                                                <button type="button" id="btnReplyRow-@msg.Id" class="btn btn-warning btn-sm px-2 px-md-3 font-weight-bold shadow-sm d-flex align-items-center gap-1"
                                                        onclick="openEnquiryModal(@msg.Id, '@JavaScriptEncoder.Default.Encode(msg.FullName)', '@JavaScriptEncoder.Default.Encode(msg.Phone)', '@JavaScriptEncoder.Default.Encode(msg.Email ?? "")', '@Uri.EscapeDataString(msg.Subject ?? "")', '@Uri.EscapeDataString(msg.Message ?? "")', '@msg.Status', '@Uri.EscapeDataString(msg.AdminNotes ?? "")', '@(msg.PhotoUrl ?? "")', '@msg.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")', '@(msg.UserRole ?? "Guest")', '@Uri.EscapeDataString(msg.AdminReply ?? "")', '@(msg.RepliedAt.HasValue ? msg.RepliedAt.Value.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt") : "")', '@Uri.EscapeDataString(msg.ReplySubject ?? "")')">
                                                    <i class="fa-solid fa-reply"></i> Reply
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- PANEL 2: JOB COMPLAINTS & WARNINGS -->
        <div class="tab-pane fade" id="complaints-panel" role="tabpanel" aria-labelledby="complaints-tab">
            <h5 class="text-white mb-3"><i class="fa-solid fa-triangle-exclamation text-danger me-2"></i> Mechanic Complaints & Warning Management Console</h5>
            
            <div class="glass-card p-3 border-secondary border-opacity-35">
                @if (!complaints.Any())
                {
                    <div class="p-4 text-center text-muted">
                        <i class="fa-solid fa-circle-check text-success fa-2x mb-2"></i>
                        <p class="mb-0">No complaints logged yet. All mechanic ratings are satisfactory.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive mb-4">
                        <table class="table table-dark table-hover align-middle mb-0" id="complaintsTable">
                            <thead>
                                <tr class="text-muted small border-bottom border-secondary">
                                    <th>CMP ID</th>
                                    <th>Mechanic Details</th>
                                    <th>Customer Details</th>
                                    <th>Rating</th>
                                    <th>Category & Reasons</th>
                                    <th>Details</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in complaints)
                                {
                                    <tr class="border-bottom border-secondary border-opacity-30">
                                        <td><span class="badge bg-secondary">#CMP-@c.Id</span></td>
                                        <td>
                                            <div class="font-weight-bold text-white">@(c.Mechanic?.Name ?? "Mechanic")</div>
                                            <span class="badge bg-warning text-dark font-weight-bold">URA-@c.MechanicId</span>
                                            <span class="text-muted small d-block">@(c.Mechanic?.PhoneNumber)</span>
                                        </td>
                                        <td>
                                            <div class="font-weight-bold text-light">@(c.Customer?.Name ?? "Customer")</div>
                                            <span class="text-muted small">Job #@c.JobId</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-danger text-white px-2 py-1"><i class="fa-solid fa-star me-1"></i>@c.Rating ★</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-info text-dark mb-1">@c.Category</span><br>
                                            @if (!string.IsNullOrEmpty(c.SelectedReasons))
                                            {
                                                @foreach (var r in c.SelectedReasons.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                                {
                                                    <span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30 me-1 mb-1" style="font-size: 0.7rem;">@r.Trim()</span>
                                                }
                                            }
                                        </td>
                                        <td style="max-width: 250px;" class="small text-light">
                                            @(string.IsNullOrEmpty(c.CustomerDetails) ? "No additional text provided." : c.CustomerDetails)
                                        </td>
                                        <td>
                                            @if (c.Status == "Pending")
                                            {
                                                <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i> Pending Action</span>
                                            }
                                            else if (c.Status == "WarningSent")
                                            {
                                                <span class="badge bg-danger text-white"><i class="fa-solid fa-triangle-exclamation me-1"></i> Warning Issued</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary"><i class="fa-solid fa-xmark me-1"></i> Dismissed</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end gap-2">
                                                @if (c.Status == "Pending")
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-danger open-warning-modal font-weight-bold"
                                                            data-complaint-id="@c.Id"
                                                            data-mechanic-id="@c.MechanicId"
                                                            data-mechanic-name="@(c.Mechanic?.Name ?? "Mechanic")"
                                                            data-mechanic-uid="URA-@c.MechanicId"
                                                            data-reasons="@c.SelectedReasons">
                                                        <i class="fa-solid fa-triangle-exclamation me-1"></i> Issue Warning
                                                    </button>
                                                    <form action="/Admin/DismissComplaint" method="post" class="d-inline">
                                                        <input type="hidden" name="complaintId" value="@c.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-secondary font-weight-bold" onclick="return confirm('Dismiss this complaint?');">Dismiss</button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-secondary open-warning-modal font-weight-bold"
                                                            data-complaint-id="@c.Id"
                                                            data-mechanic-id="@c.MechanicId"
                                                            data-mechanic-name="@(c.Mechanic?.Name ?? "Mechanic")"
                                                            data-mechanic-uid="URA-@c.MechanicId"
                                                            data-reasons="@c.SelectedReasons">
                                                        Send Another Warning
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <h6 class="text-warning mt-4 mb-3"><i class="fa-solid fa-clock-rotate-left me-1"></i> Issued Warnings History (@warnings.Count)</h6>
                @if (!warnings.Any())
                {
                    <div class="p-3 text-center text-muted small border border-secondary border-opacity-20 rounded bg-black bg-opacity-20">
                        No official warnings issued to partners yet.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-sm table-striped align-middle mb-0" style="font-size: 0.8rem;">
                            <thead>
                                <tr class="text-muted border-bottom border-secondary border-opacity-35">
                                    <th>Date</th>
                                    <th>Mechanic Details</th>
                                    <th>Severity Level</th>
                                    <th>Message</th>
                                    <th>Acknowledgment Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var w in warnings)
                                {
                                    <tr class="border-bottom border-secondary border-opacity-20">
                                        <td class="text-muted">@w.CreatedAt.ToLocalTime().ToString("dd MMM, hh:mm tt")</td>
                                        <td><strong class="text-white">@(w.Mechanic?.Name ?? "Mechanic")</strong> <span class="badge bg-warning text-dark">URA-@w.MechanicId</span></td>
                                        <td><span class="badge bg-danger">@w.WarningType</span></td>
                                        <td class="text-light">@w.Message</td>
                                        <td>
                                            @if (w.IsAcknowledged)
                                            {
                                                <span class="badge bg-success text-white"><i class="fa-solid fa-circle-check me-1"></i> Acknowledged</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark"><i class="fa-solid fa-bell fa-bounce me-1"></i> Pending Acknowledgment</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

    </div>
</div>

<!-- MODAL: VIEW FULL ENQUIRY & DIRECT REPLY -->
<div class="modal fade" id="enquiryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark border-secondary text-white shadow-lg">
            <!-- Modal Header -->
            <div class="modal-header border-secondary py-3" style="background: rgba(15, 23, 42, 0.75);">
                <div class="d-flex align-items-center gap-2">
                    <div class="badge bg-warning text-dark font-weight-bold px-2 py-1 fs-6">
                        #MSG-<span id="modalMsgIdDisplay">0</span>
                    </div>
                    <h5 class="modal-title font-weight-bold mb-0 text-white" style="font-family: 'Outfit', sans-serif;">
                        Enquiry Details &amp; Reply
                    </h5>
                    <span id="modalStatusBadge" class="badge ms-1"></span>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body p-3 p-md-4">
                <input type="hidden" id="modalMsgId" />

                <!-- Customer Details Bar -->
                <div class="p-3 rounded mb-3 border border-secondary border-opacity-40" style="background: rgba(30, 41, 59, 0.5);">
                    <div class="row g-3 align-items-center">
                        <div class="col-12 col-md-5">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="fa-solid fa-circle-user text-warning fs-5"></i>
                                <strong class="text-white fs-6" id="modalName">Customer Name</strong>
                                <span class="badge" id="modalRoleBadge">Role</span>
                            </div>
                            <div class="text-muted small" style="font-size: 0.78rem;">
                                <i class="fa-regular fa-clock me-1"></i> Received: <span id="modalCreatedAt" class="text-light"></span>
                            </div>
                        </div>
                        <div class="col-12 col-md-7">
                            <div class="d-flex flex-wrap gap-2 justify-content-md-end align-items-center">
                                <div class="btn-group btn-group-sm">
                                    <a id="modalCallBtn" href="tel:" class="btn btn-outline-warning btn-sm">
                                        <i class="fa-solid fa-phone me-1"></i> <span id="modalPhone"></span>
                                    </a>
                                    <a id="modalWhatsAppBtn" href="#" target="_blank" class="btn btn-outline-success btn-sm" title="Chat on WhatsApp">
                                        <i class="fa-brands fa-whatsapp"></i>
                                    </a>
                                </div>
                                <div id="modalEmailContainer">
                                    <a id="modalEmailBtn" href="mailto:" class="btn btn-outline-info btn-sm">
                                        <i class="fa-solid fa-envelope me-1"></i> <span id="modalEmail"></span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Full Inquiry Message Container -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label text-warning font-weight-bold small mb-0">
                            <i class="fa-solid fa-circle-question me-1"></i> Inquiry Subject: <span id="modalSubject" class="text-white"></span>
                        </label>
                        <span class="text-muted extra-small" style="font-size: 0.72rem;">Full un-truncated text</span>
                    </div>
                    <div class="p-3 rounded border border-secondary border-opacity-30 text-light bg-black bg-opacity-40" 
                         id="modalFullMessage" 
                         style="font-size: 0.92rem; line-height: 1.6; white-space: pre-wrap; word-break: break-word; max-height: 190px; overflow-y: auto;">
                    </div>

                    <!-- Photo Attachment (if any) -->
                    <div id="modalPhotoContainer" class="p-2 rounded border border-secondary border-opacity-25 bg-dark d-none mt-2">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="text-muted small"><i class="fa-solid fa-paperclip text-warning me-1"></i> Attached Screenshot / Image:</span>
                            <a id="modalPhotoLink" href="" target="_blank" class="btn btn-xs btn-outline-warning py-0 px-2" style="font-size: 0.75rem;">
                                <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Open Full View
                            </a>
                        </div>
                        <div class="text-center mt-2">
                            <a id="modalPhotoImgLink" href="" target="_blank">
                                <img id="modalPhotoImg" src="" style="max-height: 160px; max-width: 100%; border-radius: 6px; border: 1px solid rgba(255,255,255,0.15);" alt="Inquiry Attachment" />
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Previous Reply Card (Shows if already replied) -->
                <div id="modalPreviousReplyBox" class="p-3 rounded mb-3 border border-success border-opacity-40 bg-success bg-opacity-10 d-none">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <strong class="text-success small"><i class="fa-solid fa-reply-all me-1"></i> Previously Sent Reply:</strong>
                        <span class="text-muted extra-small" id="modalRepliedAt"></span>
                    </div>
                    <div class="text-light small" id="modalPreviousReplyText" style="white-space: pre-wrap; word-break: break-word; line-height: 1.5;"></div>
                </div>

                <!-- Admin Response Section -->
                <div class="p-3 rounded border border-warning border-opacity-30" style="background: rgba(255, 107, 0, 0.05);">
                    <h6 class="text-warning font-weight-bold mb-2">
                        <i class="fa-solid fa-reply me-1"></i> Reply to Customer
                    </h6>

                    <!-- Quick Reply Chips -->
                    <div class="mb-2.5">
                        <span class="text-muted extra-small d-block mb-1" style="font-size: 0.72rem;">QUICK RESPONSE TEMPLATES (Click to insert):</span>
                        <div class="d-flex flex-wrap gap-1.5">
                            <button type="button" class="btn btn-xs btn-outline-secondary text-light py-0.5 px-2 rounded-pill quick-chip" onclick="insertQuickReply(1)">
                                ⚡ Reviewing Request
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-secondary text-light py-0.5 px-2 rounded-pill quick-chip" onclick="insertQuickReply(2)">
                                🚗 Mechanic Dispatched
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-secondary text-light py-0.5 px-2 rounded-pill quick-chip" onclick="insertQuickReply(3)">
                                📞 Calling You Shortly
                            </button>
                            <button type="button" class="btn btn-xs btn-outline-secondary text-light py-0.5 px-2 rounded-pill quick-chip" onclick="insertQuickReply(4)">
                                ✅ Issue Resolved
                            </button>
                        </div>
                    </div>

                    <div class="mb-2.5">
                        <label class="form-label text-muted small mb-1">Email Subject (Clean &amp; Professional)</label>
                        <input type="text" id="modalReplySubject" class="form-control form-control-sm bg-dark text-white border-secondary" placeholder="RaahSathi Support: Roadside Breakdown Help" />
                    </div>

                    <div class="mb-2.5">
                        <label class="form-label text-muted small mb-1">Reply Message Content</label>
                        <textarea id="modalReplyMessage" class="form-control bg-dark text-white border-secondary" rows="3" placeholder="Type your response to the customer..."></textarea>
                    </div>

                    <div class="row g-2 align-items-center">
                        <div class="col-12 col-md-6">
                            <label class="form-label text-muted small mb-1">Update Status To</label>
                            <select id="modalReplyStatus" class="form-select form-select-sm bg-dark text-white border-secondary">
                                <option value="Resolved" selected>Resolved (Query Answered &amp; Closed)</option>
                                <option value="Contacted">Contacted (Follow-up In Progress)</option>
                                <option value="Pending">Pending (Needs Further Attention)</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-6 pt-md-3">
                            <div class="form-check form-switch" id="modalSendEmailCheckContainer">
                                <input class="form-check-input" type="checkbox" id="modalSendEmailCheck" checked>
                                <label class="form-check-label text-light small" for="modalSendEmailCheck">
                                    <i class="fa-solid fa-paper-plane text-info me-1"></i> Send Copy to Customer's Email
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Accordion for Internal Admin Notes only -->
                <div class="accordion mt-2" id="adminNotesAccordion">
                    <div class="accordion-item bg-transparent border-0">
                        <h2 class="accordion-header" id="headingNotes">
                            <button class="accordion-button collapsed py-2 px-2 bg-transparent text-muted small" type="button" data-bs-toggle="collapse" data-bs-target="#collapseNotes" aria-expanded="false" aria-controls="collapseNotes">
                                <i class="fa-solid fa-sticky-note me-1.5 text-info"></i> Private Internal Admin Notes (Optional)
                            </button>
                        </h2>
                        <div id="collapseNotes" class="accordion-collapse collapse" data-bs-parent="#adminNotesAccordion">
                            <div class="accordion-body pt-1 pb-2 px-1">
                                <textarea id="modalAdminNotes" class="form-control form-control-sm bg-dark text-white border-secondary" rows="2" placeholder="Private notes visible only to admins..."></textarea>
                                <button type="button" class="btn btn-outline-secondary btn-sm mt-2" onclick="saveAdminNotesOnly()">
                                    <i class="fa-solid fa-floppy-disk me-1"></i> Save Internal Notes Only
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Modal Footer -->
            <div class="modal-footer border-secondary py-2 justify-content-between">
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Close</button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-warning font-weight-bold px-4" id="btnSendReply" onclick="submitEnquiryReply()">
                        <i class="fa-solid fa-paper-plane me-1"></i> Send Reply
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: ISSUE WARNING RED ALERT -->
<div class="modal fade" id="sendWarningModal" tabindex="-1" aria-labelledby="sendWarningModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-danger text-light shadow-lg">
            <div class="modal-header border-danger bg-danger bg-opacity-20 text-danger">
                <h5 class="modal-title font-weight-bold" id="sendWarningModalLabel">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> Send Red Alert Warning to Mechanic
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/Admin/SendMechanicWarning" method="post">
                <div class="modal-body p-4">
                    <input type="hidden" name="complaintId" id="warnComplaintId" value="0">
                    <input type="hidden" name="mechanicId" id="warnMechanicId" value="0">

                    <div class="p-3 bg-danger bg-opacity-10 border border-danger rounded mb-3">
                        <span class="d-block small text-muted">TARGET MECHANIC:</span>
                        <h5 class="text-white mb-0" id="warnMechanicDisplay">Mechanic Name (URA-X)</h5>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-light small">Warning Severity / Level</label>
                        <select class="form-select bg-dark text-white border-secondary" name="warningType" required>
                            <option value="Official Warning" selected>Official Warning</option>
                            <option value="Notice">Notice / First Reminder</option>
                            <option value="Final Warning">Final Warning (Pre-Suspension)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-light small">Warning Message (Will trigger Red Alert Popup on Mechanic Dashboard):</label>
                        <textarea class="form-control bg-dark text-white border-secondary" name="message" id="warnMessageInput" rows="4" required placeholder="Type warning instructions for mechanic..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger font-weight-bold px-4">
                        <i class="fa-solid fa-paper-plane me-1"></i> Send Red Alert Warning
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var currentEnquiryData = {};

    function triggerRowModal(id) {
        $('#btnReplyRow-' + id).click();
    }

    function openEnquiryModal(id, name, phone, email, subject, message, status, notes, photoUrl, createdAt, userRole, reply, repliedAt, replySubject) {
        currentEnquiryData = {
            id: id,
            name: name,
            phone: phone,
            email: email,
            subject: decodeURIComponent(subject || ""),
            message: decodeURIComponent(message || ""),
            status: status || "Pending",
            notes: decodeURIComponent(notes || ""),
            photoUrl: photoUrl || "",
            createdAt: createdAt || "",
            userRole: userRole || "Guest",
            reply: decodeURIComponent(reply || ""),
            repliedAt: repliedAt || "",
            replySubject: decodeURIComponent(replySubject || "")
        };

        $('#modalMsgId').val(id);
        $('#modalMsgIdDisplay').text(id);
        $('#modalName').text(name);
        $('#modalPhone').text(phone);
        $('#modalCallBtn').attr('href', 'tel:' + phone);

        var cleanPhone = phone.replace(/\s+/g, '').replace(/-/g, '').replace(/\+/g, '');
        if (cleanPhone.length === 10) cleanPhone = '91' + cleanPhone;
        $('#modalWhatsAppBtn').attr('href', 'https://wa.me/' + cleanPhone + '?text=' + encodeURIComponent('Hello ' + name + ', this is RaahSathi Support regarding your inquiry: ' + currentEnquiryData.subject));

        if (email && email.indexOf('@@') > -1) {
            $('#modalEmail').text(email);
            $('#modalEmailBtn').attr('href', 'mailto:' + email + '?subject=' + encodeURIComponent('RaahSathi Support: ' + currentEnquiryData.subject));
            $('#modalEmailContainer').removeClass('d-none');
            $('#modalSendEmailCheckContainer').removeClass('d-none');
            $('#modalSendEmailCheck').prop('checked', true);
        } else {
            $('#modalEmailContainer').addClass('d-none');
            $('#modalSendEmailCheckContainer').addClass('d-none');
            $('#modalSendEmailCheck').prop('checked', false);
        }

        $('#modalCreatedAt').text(createdAt);
        
        // Role badge
        var roleBadge = $('#modalRoleBadge');
        roleBadge.text(userRole || 'Guest');
        roleBadge.removeClass('bg-danger bg-info bg-success bg-secondary text-dark text-white');
        if (userRole === 'Admin') roleBadge.addClass('bg-danger text-white');
        else if (userRole === 'Mechanic') roleBadge.addClass('bg-info text-dark');
        else if (userRole === 'Customer') roleBadge.addClass('bg-success text-white');
        else roleBadge.addClass('bg-secondary text-light');

        // Status badge
        var statusBadge = $('#modalStatusBadge');
        statusBadge.text(status);
        statusBadge.removeClass('bg-warning bg-info bg-success text-dark text-white');
        if (status === 'Pending') statusBadge.addClass('bg-warning text-dark');
        else if (status === 'Contacted') statusBadge.addClass('bg-info text-dark');
        else statusBadge.addClass('bg-success text-white');

        $('#modalSubject').text(currentEnquiryData.subject);
        $('#modalFullMessage').text(currentEnquiryData.message);

        // Photo Attachment
        if (photoUrl) {
            $('#modalPhotoImg').attr('src', photoUrl);
            $('#modalPhotoLink').attr('href', photoUrl);
            $('#modalPhotoImgLink').attr('href', photoUrl);
            $('#modalPhotoContainer').removeClass('d-none');
        } else {
            $('#modalPhotoContainer').addClass('d-none');
        }

        // Previous reply box
        if (currentEnquiryData.reply) {
            $('#modalPreviousReplyText').text(currentEnquiryData.reply);
            $('#modalRepliedAt').text(repliedAt ? 'Replied: ' + repliedAt : '');
            $('#modalPreviousReplyBox').removeClass('d-none');
        } else {
            $('#modalPreviousReplyBox').addClass('d-none');
        }

        // Prefill clean reply subject
        var defaultSubject = currentEnquiryData.replySubject || ('RaahSathi Support: ' + currentEnquiryData.subject);
        $('#modalReplySubject').val(defaultSubject);
        $('#modalReplyMessage').val('');
        $('#modalReplyStatus').val(status === 'Pending' ? 'Resolved' : status);
        $('#modalAdminNotes').val(currentEnquiryData.notes);

        var modal = new bootstrap.Modal(document.getElementById('enquiryModal'));
        modal.show();
    }

    // Backwards-compatible alias for any legacy triggers
    function openManageModal(id, name, phone, email, subject, message, status, notes, photoUrl) {
        openEnquiryModal(id, name, phone, email, subject, message, status, notes, photoUrl, '', 'Guest', '', '', '');
    }

    function insertQuickReply(type) {
        var name = currentEnquiryData.name || 'Customer';
        var text = '';
        if (type === 1) {
            text = "Namaste " + name + " ji,\n\nHumne aapki enquiry receive kar li hai aur hamari support team is par review kar rahi hai. Hum jald hi aapse contact karenge.\n\nRegards,\nRaahSathi Support Team";
        } else if (type === 2) {
            text = "Namaste " + name + " ji,\n\nRoadside assistance ke liye verified mechanic ko aapki location par assign kar diya gaya hai. Mechanic jald hi aapke paas pahunch jayega.\n\nEmergency Helpline: +91 9891819236\nRaahSathi Operations Team";
        } else if (type === 3) {
            text = "Namaste " + name + " ji,\n\nAapki inquiry ke sambandh me hamara support executive aapke registered number par agle 10-15 minute me call karega. Kripya phone active rakhein.\n\nRaahSathi Desk";
        } else if (type === 4) {
            text = "Namaste " + name + " ji,\n\nAapki query/problem ko successfully resolve kar diya gaya hai. RaahSathi ko choose karne ke liye dhanyawad. Kisi anya sahayata ke liye aap kabhi bhi humse sampark kar sakte hain.\n\nWarm regards,\nRaahSathi Team";
        }
        $('#modalReplyMessage').val(text);
    }

    function submitEnquiryReply() {
        var id = $('#modalMsgId').val();
        var reply = $('#modalReplyMessage').val();
        var subject = $('#modalReplySubject').val();
        var status = $('#modalReplyStatus').val();
        var sendEmail = $('#modalSendEmailCheck').is(':checked');
        var notes = $('#modalAdminNotes').val();

        if (!reply || !reply.trim()) {
            alert('Please enter your reply message content before sending.');
            $('#modalReplyMessage').focus();
            return;
        }

        var btn = $('#btnSendReply');
        var originalHtml = btn.html();
        btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Sending...');

        $.post('/Admin/SendEnquiryReply', {
            id: id,
            replyMessage: reply,
            replySubject: subject,
            status: status,
            sendEmail: sendEmail
        }, function(res) {
            if (res && res.success) {
                if (notes && notes !== currentEnquiryData.notes) {
                    $.post('/Admin/UpdateMessageStatus', { id: id, status: status, adminNotes: notes });
                }
                alert(res.message || 'Reply sent successfully!');
                location.reload();
            } else {
                alert('Error: ' + (res.message || 'Failed to send reply'));
                btn.prop('disabled', false).html(originalHtml);
            }
        }).fail(function() {
            alert('Failed to send reply. Please check server connection and try again.');
            btn.prop('disabled', false).html(originalHtml);
        });
    }

    function saveAdminNotesOnly() {
        var id = $('#modalMsgId').val();
        var status = $('#modalReplyStatus').val();
        var notes = $('#modalAdminNotes').val();

        $.post('/Admin/UpdateMessageStatus', { id: id, status: status, adminNotes: notes }, function(res) {
            if (res && res.success) {
                alert('Internal notes updated successfully.');
                location.reload();
            } else {
                alert('Error: ' + (res.message || 'Failed to update'));
            }
        }).fail(function() {
            alert('Failed to update notes.');
        });
    }

    $(document).ready(function() {
        // Handle opening of Issue Warning Modal
        $('.open-warning-modal').on('click', function() {
            var cid = $(this).data('complaint-id');
            var mid = $(this).data('mechanic-id');
            var mname = $(this).data('mechanic-name');
            var muid = $(this).data('mechanic-uid');
            var reasons = $(this).data('reasons');

            $('#warnComplaintId').val(cid);
            $('#warnMechanicId').val(mid);
            $('#warnMechanicDisplay').text(mname + ' (' + muid + ')');

            var defaultMsg = "Aapki customer complaint aayi hai: '" + (reasons || "Unsatisfactory Service") + "'. Kripya time par pahunche aur professional tarike se service dein. Agli baar aisi shikayat milne par aapki ID suspend kar di jayegi.";
            $('#warnMessageInput').val(defaultMsg);

            var modal = new bootstrap.Modal(document.getElementById('sendWarningModal'));
            modal.show();
        });
    });
</script>
}
