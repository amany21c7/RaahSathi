@using RaahSathi.Models
@using System.Text.Encodings.Web
@model List<CmsBanner>
@{
    ViewData["Title"] = "CMS Banner Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white font-weight-bold mb-1"><i class="fa-solid fa-images text-warning me-2"></i> Homepage & Dashboard Banner Management</h4>
        <p class="text-muted small mb-0">Update customer homepage banners, promotional sliders, and announcements without developer assistance.</p>
    </div>
    <button type="button" class="btn btn-warning text-dark font-weight-bold" data-bs-toggle="modal" data-bs-target="#addBannerModal">
        <i class="fa-solid fa-plus me-1"></i> Add New Banner
    </button>
</div>

<div class="card bg-dark border-secondary shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr class="border-secondary text-muted small">
                        <th class="ps-3">Banner Title</th>
                        <th>Target Page</th>
                        <th>Target Audience</th>
                        <th>Image URL</th>
                        <th>Expires At</th>
                        <th>Created Time</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">No custom homepage banners added yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var b in Model)
                        {
                            var isExpired = b.ExpiresAt.HasValue && b.ExpiresAt.Value < DateTime.UtcNow;
                            var isActive = b.IsActive && !isExpired;
                            <tr class="border-secondary">
                                <td class="ps-3 font-weight-bold text-white fs-6">@b.Title</td>
                                <td><span class="badge bg-info text-dark">@b.TargetPage</span></td>
                                <td><span class="badge bg-secondary text-light">@b.TargetAudience</span></td>
                                <td class="text-muted small" style="max-width: 180px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@b.ImageUrl</td>
                                <td class="text-muted small">
                                    @(b.ExpiresAt.HasValue ? b.ExpiresAt.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm") : "Never")
                                </td>
                                <td class="text-muted small">@b.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (isActive)
                                    {
                                        <span class="badge bg-success text-white">ACTIVE</span>
                                    }
                                    else if (isExpired)
                                    {
                                        <span class="badge bg-danger text-white">EXPIRED</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">DISABLED</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-flex justify-content-end gap-1.5">
                                        <!-- Edit button -->
                                        <button class="btn btn-sm btn-outline-warning" title="Edit Banner"
                                                onclick="openEditBannerModal(@b.Id, '@Html.Raw(JavaScriptEncoder.Default.Encode(b.Title))', '@Html.Raw(JavaScriptEncoder.Default.Encode(b.ImageUrl))', '@Html.Raw(JavaScriptEncoder.Default.Encode(b.TargetPage))', '@Html.Raw(JavaScriptEncoder.Default.Encode(b.TargetAudience))', '@(b.ExpiresAt?.ToString("yyyy-MM-ddTHH:mm"))', @(b.IsActive.ToString().ToLower()))">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                        <!-- Delete/Close button -->
                                        <form action="/Admin/DeleteCmsBanner" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this CMS banner?');">
                                            <input type="hidden" name="id" value="@b.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Banner">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Add CMS Banner -->
<div class="modal fade" id="addBannerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-warning font-weight-bold"><i class="fa-solid fa-plus me-1.5"></i> Add Homepage Banner</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/Admin/AddCmsBanner" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-muted small">Banner Title</label>
                        <input type="text" name="title" class="form-control glass-input text-white" placeholder="e.g. 24/7 National Highway Assistance Banner" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Image URL / File Path</label>
                        <input type="text" name="imageUrl" class="form-control glass-input text-white" value="/images/hero-banner.jpg" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Target Page / Location</label>
                        <select name="targetPage" class="form-select glass-input text-white">
                            <option value="Homepage">Homepage Banner</option>
                            <option value="Customer Dashboard">Customer Dashboard Page</option>
                            <option value="Mechanic Dashboard">Mechanic Dashboard Page</option>
                            <option value="Emergency Page">Emergency Assistance Page</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Target Audience</label>
                        <select name="targetAudience" class="form-select glass-input text-white">
                            <option value="All Users">All Users (Customers & Mechanics)</option>
                            <option value="Customers">Customers Only</option>
                            <option value="Mechanics">Mechanics / Partners Only</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Expires At (Optional - Date & Time until this banner is active)</label>
                        <input type="datetime-local" name="expiresAt" class="form-control glass-input text-white">
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="submit" class="btn btn-warning text-dark font-weight-bold w-100">Add Banner</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Edit CMS Banner -->
<div class="modal fade" id="editBannerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border border-warning shadow-lg">
            <div class="modal-header border-warning bg-warning bg-opacity-10 text-warning">
                <h5 class="modal-title font-weight-bold"><i class="fa-solid fa-pen-to-square me-2"></i> Modify CMS Banner</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/Admin/UpdateCmsBanner" method="POST">
                <div class="modal-body">
                    <input type="hidden" name="id" id="editBannerId" />
                    
                    <div class="mb-3">
                        <label class="form-label text-muted small">Banner Title</label>
                        <input type="text" name="title" id="editBannerTitle" class="form-control bg-dark text-white border-secondary" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Image URL / File Path</label>
                        <input type="text" name="imageUrl" id="editBannerImageUrl" class="form-control bg-dark text-white border-secondary" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Target Page / Location</label>
                        <select name="targetPage" id="editBannerTargetPage" class="form-select bg-dark text-white border-secondary">
                            <option value="Homepage">Homepage Banner</option>
                            <option value="Customer Dashboard">Customer Dashboard Page</option>
                            <option value="Mechanic Dashboard">Mechanic Dashboard Page</option>
                            <option value="Emergency Page">Emergency Assistance Page</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Target Audience</label>
                        <select name="targetAudience" id="editBannerTargetAudience" class="form-select bg-dark text-white border-secondary">
                            <option value="All Users">All Users (Customers & Mechanics)</option>
                            <option value="Customers">Customers Only</option>
                            <option value="Mechanics">Mechanics / Partners Only</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Expires At (Optional - Date & Time until this banner is active)</label>
                        <input type="datetime-local" name="expiresAt" id="editBannerExpiresAt" class="form-control bg-dark text-white border-secondary">
                    </div>
                    <div class="mb-3 form-check form-switch ms-1">
                        <input type="checkbox" name="isActive" value="true" id="editBannerIsActive" class="form-check-input" checked>
                        <label class="form-check-label text-white small" for="editBannerIsActive">Banner Active Status</label>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning text-dark font-weight-bold px-4">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openEditBannerModal(id, title, imageUrl, targetPage, targetAudience, expiresAt, isActive) {
        $('#editBannerId').val(id);
        $('#editBannerTitle').val(decodeURIComponent(title));
        $('#editBannerImageUrl').val(decodeURIComponent(imageUrl));
        $('#editBannerTargetPage').val(decodeURIComponent(targetPage));
        $('#editBannerTargetAudience').val(decodeURIComponent(targetAudience));
        
        if (expiresAt) {
            $('#editBannerExpiresAt').val(expiresAt);
        } else {
            $('#editBannerExpiresAt').val('');
        }
        
        $('#editBannerIsActive').prop('checked', isActive);
        
        var modal = new bootstrap.Modal(document.getElementById('editBannerModal'));
        modal.show();
    }
</script>
}
