                                                    <div class="text-muted small">@f.FriendPhone</div>
                                                </td>
                                                <td>
                                                    <span class="badge @(f.StageType == "C2M" ? "bg-danger" : "bg-success")">@f.StageType</span>
                                                </td>
                                                <td class="text-warning font-weight-bold">+₹@f.ExpectedReward.ToString("N0")</td>
                                                <td>
                                                    @if (f.Status == "Completed")
                                                    {
                                                        <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i> Reward Credited</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i> Awaiting 1st Booking</span>
                                                    }
                                                </td>
                                                <td class="text-muted small">@f.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    <!-- Tab 2: Withdrawal Request Form -->
                    <div class="tab-pane fade" id="refWithdrawContent" role="tabpanel">
                        <form action="/Customer/SubmitReferralWithdrawal" method="POST">
                            <div class="p-3 bg-black bg-opacity-40 rounded-3 border border-secondary mb-3">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label text-muted small font-weight-bold">Withdrawal Amount (₹) <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-dark border-secondary text-success">₹</span>
                                            <input type="number" step="1" min="@refSettings.MinWithdrawalAmount" max="@(refSummary?.ReferralWalletBalance ?? 0)" name="amount" class="form-control glass-input text-white font-weight-bold" placeholder="Min ₹@refSettings.MinWithdrawalAmount.ToString("N0")" required />
                                        </div>
                                        <span class="text-muted" style="font-size: 0.72rem;">Available: ₹@(refSummary?.ReferralWalletBalance.ToString("N2") ?? "0.00")</span>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label text-muted small font-weight-bold">Payout Method <span class="text-danger">*</span></label>
                                        <select name="payoutMethod" id="custPayoutMethodSelect" class="form-select glass-input text-white bg-dark border-secondary" onchange="toggleCustPayoutFields()" required>
                                            <option value="UPI">UPI (Google Pay, PhonePe, Paytm)</option>
                                            <option value="Bank">Direct Bank Transfer (NEFT/IMPS)</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- UPI Details Section -->
                            <div id="custUpiSection" class="mb-3">
                                <label class="form-label text-muted small font-weight-bold">UPI ID (VPA) <span class="text-danger">*</span></label>
                                <input type="text" name="upiId" class="form-control glass-input text-white" placeholder="e.g. yourname@okhdfcbank / 9876543210@paytm" />
                            </div>

                            <!-- Bank Details Section -->
                            <div id="custBankSection" class="row g-2 mb-3" style="display: none;">
                                <div class="col-md-6">
                                    <label class="form-label text-muted small font-weight-bold">Account Holder Name</label>
                                    <input type="text" name="accountHolder" class="form-control glass-input text-white" placeholder="As per passbook" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small font-weight-bold">Bank Name</label>
                                    <input type="text" name="bankName" class="form-control glass-input text-white" placeholder="e.g. HDFC / SBI / ICICI" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small font-weight-bold">Account Number</label>
                                    <input type="text" name="bankAccount" class="form-control glass-input text-white font-monospace" placeholder="Enter bank account number" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small font-weight-bold">IFSC Code</label>
                                    <input type="text" name="ifsc" class="form-control glass-input text-white text-uppercase" placeholder="e.g. HDFC0001234" />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-success w-100 font-weight-bold py-2.5 shadow" @((refSummary?.ReferralWalletBalance ?? 0) < refSettings.MinWithdrawalAmount ? "disabled" : "")>
                                <i class="fa-solid fa-paper-plane me-1"></i> Submit Payout Request
                            </button>
                            @if ((refSummary?.ReferralWalletBalance ?? 0) < refSettings.MinWithdrawalAmount)
                            {
                                <div class="text-center text-muted small mt-2">
                                    <i class="fa-solid fa-circle-info text-warning me-1"></i> Minimum withdrawal balance is ₹@refSettings.MinWithdrawalAmount.ToString("N0"). Refer more friends to unlock payout!
                                </div>
                            }
                        </form>
                    </div>

                    <!-- Tab 3: Payout History -->
                    <div class="tab-pane fade" id="refHistoryContent" role="tabpanel">
                        @if (refSummary == null || refSummary.WithdrawalHistory.Count == 0)
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="fa-solid fa-receipt fa-2x mb-2 text-secondary opacity-60"></i>
                                <p class="mb-0">No past withdrawal requests found.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive" style="max-height: 240px; overflow-y: auto;">
                                <table class="table table-dark table-sm table-hover mb-0 align-middle">
                                    <thead class="text-muted small text-uppercase">
                                        <tr>
                                            <th>Req ID</th>
                                            <th>Amount</th>
                                            <th>Method</th>
                                            <th>Status</th>
                                            <th>Date</th>
                                            <th>Reference / Remarks</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var w in refSummary.WithdrawalHistory)
                                        {
                                            <tr>
                                                <td class="font-monospace text-warning font-weight-bold">#REF-W@w.Id.ToString("D4")</td>
                                                <td class="text-white font-weight-bold">₹@w.Amount.ToString("N2")</td>
                                                <td><span class="badge bg-secondary">@w.PayoutMethod</span></td>
                                                <td>
                                                    @if (w.Status == "Approved")
                                                    {
                                                        <span class="badge bg-success">Paid</span>
                                                    }
                                                    else if (w.Status == "Pending")
                                                    {
                                                        <span class="badge bg-warning text-dark">Pending</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">Rejected</span>
                                                    }
                                                </td>
                                                <td class="text-muted small">@w.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                                <td class="text-muted small">
                                                    @(string.IsNullOrEmpty(w.TransactionReference) ? w.AdminRemarks : $"{w.TransactionReference} - {w.AdminRemarks}")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
    window.openCustomerReferralModal = function() {
        var modalEl = document.getElementById('customerReferralModal');
        if (modalEl) {
            if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                var instance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                instance.show();
            } else if (typeof $ !== 'undefined' && $.fn && $.fn.modal) {
                $('#customerReferralModal').modal('show');
            }
        }
    };

    function toggleCustPayoutFields() {
        var method = document.getElementById('custPayoutMethodSelect').value;
        if (method === 'UPI') {
            document.getElementById('custUpiSection').style.display = 'block';
            document.getElementById('custBankSection').style.display = 'none';
        } else {
            document.getElementById('custUpiSection').style.display = 'none';
            document.getElementById('custBankSection').style.display = 'flex';
        }
    }

    function copyCustomerReferralCode() {
        var code = document.getElementById('custRefCodeText').textContent.trim();
        navigator.clipboard.writeText(code).then(function() {
            var btnText = document.getElementById('btnCopyCustText');
            btnText.textContent = 'Copied!';
            setTimeout(function() { btnText.textContent = 'Copy Code'; }, 2000);
        });
    }

    function shareCustomerWhatsApp(refereeReward) {
        var code = document.getElementById('custRefCodeText').textContent.trim();
        var shareLink = window.location.origin + '/Auth/Login?ref=' + encodeURIComponent(code);
        var discountAmt = refereeReward || 50;
        var msg = "Hey! 🚗 Need 24/7 Roadside Assistance or verified Mechanics? Use my RaahSathi Referral Code: *" + code + "* to get instant ₹" + discountAmt + " discount! Sign up here: " + shareLink;
        window.open('https://api.whatsapp.com/send?text=' + encodeURIComponent(msg), '_blank');
    }

    function shareCustomerSms() {
        var code = document.getElementById('custRefCodeText').textContent.trim();
        var shareLink = window.location.origin + '/Auth/Login?ref=' + encodeURIComponent(code);
        var msg = "Book verified mechanics 24/7 on RaahSathi! Use my referral code: " + code + " for instant discount. Join: " + shareLink;
        window.location.href = 'sms:?body=' + encodeURIComponent(msg);
    }
</script>

