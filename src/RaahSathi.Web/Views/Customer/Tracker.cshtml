    var isTrackerPolling = false;
    function pollJobStatus() {
        if (isTrackerPolling || document.hidden) return;
        isTrackerPolling = true;

        $.get('/Customer/GetJobStatus?id=@job.Id&_t=' + Date.now(), function(res) {
            // Update unread chat message badge
            if (res.unreadChatCount > 0 && !$('#liveChatModal').hasClass('show')) {
                $('#chat-unread-badge').text(res.unreadChatCount).removeClass('d-none');
            } else {
                $('#chat-unread-badge').addClass('d-none');
            }

            // Check inactive seconds for warning display
            if ((res.status === "Accepted" || res.status === "Driving") && res.inactiveSeconds >= 30) {
                $('#customer-inactivity-warning').removeClass('d-none');
            } else {
                $('#customer-inactivity-warning').addClass('d-none');
            }

            // Update Timeline steps
            updateTimelineUI(res.status);

            // Real-time Problem Cancellation sync
            if (res.cancelledProblemItem) {
                $('#trackerCancelledItemName').text(res.cancelledProblemItem);
                $('#trackerCancelledReasonText').text(res.problemCancelReason || 'Cancelled by mechanic');
                $('#trackerCancelledAlert').removeClass('d-none');
                
                // Strike through cancelled badge in list
                $('.tracker-prob-badge').each(function() {
                    var bName = $(this).attr('data-prob-name');
                    if (bName && (bName.toLowerCase() === res.cancelledProblemItem.toLowerCase() || bName.toLowerCase().includes(res.cancelledProblemItem.toLowerCase()))) {
                        $(this).removeClass('bg-dark border-warning text-white shadow-sm')
                               .addClass('bg-danger bg-opacity-10 border-danger text-light');
                        $(this).html(`<i class="fa-solid fa-circle-xmark text-danger"></i> <span class="text-decoration-line-through text-muted font-weight-bold">${bName}</span> <span class="text-danger small" style="font-size:0.7rem;">(Cancelled by mechanic)</span>`);
                    }
                });
            }

            if (res.finalBillAmount) {
                $('#trackerEstimatedBillText').text('₹' + Number(res.finalBillAmount).toFixed(0));
            }

            // Show/hide receipt button dynamically in real-time
            if (res.status === "Completed") {
                $('#sidebarReceiptBtn').removeClass('d-none');
            } else {
                $('#sidebarReceiptBtn').addClass('d-none');
            }

            // Update mechanic details and map
            if (res.mechanicId) {
                $('#mechanicDetailsCard').removeClass('d-none');
                
                // Draw/Update mechanic marker
                if (res.mechanicLat && res.mechanicLng) {
                    mechanicLat = res.mechanicLat;
                    mechanicLng = res.mechanicLng;

                    if (!mechanicMarker) {
                        // Create mechanic marker
                        var mechIcon = L.icon({
                            iconUrl: 'https://cdn-icons-png.flaticon.com/512/3202/3202926.png',
                            iconSize: [40, 40],
                            iconAnchor: [20, 20]
                        });
                        mechanicMarker = L.marker([mechanicLat, mechanicLng], {icon: mechIcon}).addTo(map);
                        mechanicMarker.bindPopup('<b>Mechanic En Route</b>').openPopup();
                    } else {
                        // Move marker smoothly
                        mechanicMarker.setLatLng([mechanicLat, mechanicLng]);
                    }

                    // Draw and update real turn-by-turn road route
                    updateRoadRoute(mechanicLat, mechanicLng, customerLat, customerLng);
                }
            }

            // Check requested status timeout alert
            if (res.status === "Requested" || res.status === "TimedOut") {
                $('#etaText').html("<i class='fa-solid fa-circle-notch fa-spin text-info me-1'></i> Searching for nearest verified mechanics... Please hold on.");
                if (res.status === "TimedOut" || res.jobAgeSeconds >= 300) {
                    $('#etaText').html("<span class='text-danger font-weight-bold'><i class='fa-solid fa-circle-exclamation me-1'></i> Connection Timeout: No response from nearby mechanics.</span>");
                    $('#dispatch-timeout-alert').removeClass('d-none');
                } else {
                    $('#dispatch-timeout-alert').addClass('d-none');
                }
            } else {
                $('#dispatch-timeout-alert').addClass('d-none');
            }

            // Estimate ETA description with accurate road-routing distance & time
            if (res.status === "Accepted" || res.status === "Driving") {
                var etaDisplay = "<b>~8 mins</b>";
                if (res.mechanicLat && res.mechanicLng) {
                    if (window.currentRoadEtaMins && window.currentRoadDistanceKm) {
                        etaDisplay = "<b>~" + window.currentRoadEtaMins + " mins</b> (" + window.currentRoadDistanceKm + " km by road)";
                    } else {
                        var dist = calculateDistance(customerLat, customerLng, res.mechanicLat, res.mechanicLng);
                        var mins = Math.round(dist * 3.2 + 2);
                        if (mins < 2) mins = 2;
                        etaDisplay = "<b>~" + mins + " mins</b> (" + dist.toFixed(1) + " km away)";
                    }
                }
                $('#etaText').html("<i class='fa-solid fa-route text-warning me-1'></i> Mechanic travelling. ETA " + etaDisplay);
            } else if (res.status === "Inspecting" || res.status === "Arrived") {
                $('#etaText').html("<span class='text-warning font-weight-bold'><i class='fa-solid fa-stethoscope fa-spin me-1'></i> Mechanic reached breakdown spot & inspecting vehicle...</span>");
            } else if (res.status === "EstimatePending") {
                $('#etaText').text("Awaiting your parts estimate approval.");
            } else if (res.status === "Repairing") {
                if (res.partsApproved === true) {
                    $('#etaText').html("<span class='text-warning'><i class='fa-solid fa-tools fa-spin me-1'></i> Replacing clutch cable & adjusting tension...</span>");
                } else {
                    $('#etaText').html("<span class='text-warning'><i class='fa-solid fa-tools fa-spin me-1'></i> Re-tensioning brake pedal...</span>");
                }
            } else if (res.status === "Completed") {
                $('#etaText').html("<span class='text-success'><i class='fa-solid fa-face-smile me-1'></i> Service resolved. Payment escrow released.</span>");
            }

            // Check and trigger live approval popup modal for Custom Estimates, Extra Parts, and Towing
            checkAndShowApprovalModal(res);

            // Handle Parts estimate approval prompt
            if (res.status === "EstimatePending" && res.partsApproved === null) {
                $('#partsApprovalCard').removeClass('d-none');
                $('#partsCostText').text('₹' + res.partsEstimateAmount);
                $('#partsNameText').text(res.partsEstimateDetails);
            } else {
                $('#partsApprovalCard').addClass('d-none');
            }

            // Handle Towing estimate approval prompt
            if (res.towingNeeded === true && res.towingApproved === null) {
                $('#towingApprovalCard').removeClass('d-none');
                $('#towingCostText').text('₹' + res.towingCharge);
                $('#towingReasonText').text(res.towingReason);
            } else {
                $('#towingApprovalCard').addClass('d-none');
            }

            // Handle Escrow settlement panel showing
            // Show checkout either when completed or when mechanic marked inspection done (or towing approved)
            if ((res.status === "Completed" && res.partsApproved !== null) || (res.status === "Repairing" && res.partsApproved !== null && res.towingApproved === null) || ((res.status === "Inspecting" || res.status === "Arrived") && res.partsApproved === false)) {
                // If it is already completed in database, go straight to rating/review panel
                if (res.status === "Completed") {
                    $('#paymentCheckoutCard').addClass('d-none');
                    $('#ratingCard').removeClass('d-none');
                } else {
                    $('#paymentCheckoutCard').removeClass('d-none');
                    var partsCost = res.partsApproved === true ? (res.partsEstimateAmount + res.extraLabourCharge) : 0.0;
                    var towingCost = res.towingApproved === true ? res.towingCharge : 0.0;
                    var baseServiceCost = res.finalBillAmount - partsCost - towingCost;

                    $('#billVisiting').text('₹' + baseServiceCost.toFixed(2));
                    $('#billParts').text('₹' + partsCost.toFixed(2));
                    $('#billTowing').text('₹' + towingCost.toFixed(2));
                    $('#billTotal').text('₹' + res.finalBillAmount.toFixed(2));
                }
            } else {
                $('#paymentCheckoutCard').addClass('d-none');
            }
        }).always(function() {
            isTrackerPolling = false;
        });
    }

    function updateTimelineUI(status) {
        $('.timeline-step').removeClass('active completed');
        
        if (status === "Accepted") {
            $('#step-Accepted').addClass('active');
        } else if (status === "Driving") {
            $('#step-Accepted').addClass('completed');
            $('#step-Driving').addClass('active');
        } else if (status === "Inspecting" || status === "EstimatePending" || status === "Arrived") {
            $('#step-Accepted').addClass('completed');
            $('#step-Driving').addClass('completed');
            $('#step-Inspecting').addClass('active');
        } else if (status === "Repairing") {
            $('#step-Accepted').addClass('completed');
            $('#step-Driving').addClass('completed');
            $('#step-Inspecting').addClass('completed');
            $('#step-Repairing').addClass('active');
        } else if (status === "Completed") {
            $('#step-Accepted').addClass('completed');
            $('#step-Driving').addClass('completed');
            $('#step-Inspecting').addClass('completed');
            $('#step-Repairing').addClass('completed');
            $('#step-Completed').addClass('completed');
        }
    }

