@section Scripts {
<script>
    var map;
    var customerMarker, mechanicMarker;
    var linePath;
    
    var customerLat = @job.CustomerLat;
    var customerLng = @job.CustomerLng;
    
    var mechanicLat = 0;
    var mechanicLng = 0;

    var lastRouteFetchCoords = { mechLat: 0, mechLng: 0, custLat: 0, custLng: 0 };
    var isFetchingRoute = false;

    function updateRoadRoute(mLat, mLng, cLat, cLng) {
        if (!map || !mLat || !mLng || !cLat || !cLng) return;

        var dLat = Math.abs(lastRouteFetchCoords.mechLat - mLat);
        var dLng = Math.abs(lastRouteFetchCoords.mechLng - mLng);
        if (dLat < 0.00015 && dLng < 0.00015 && linePath) {
            return; // Cache route if position shift is negligible
        }

        if (isFetchingRoute) return;
        isFetchingRoute = true;

        var osrmUrl = 'https://router.project-osrm.org/route/v1/driving/' + 
                      mLng + ',' + mLat + ';' + cLng + ',' + cLat + 
                      '?overview=full&geometries=geojson';

        fetch(osrmUrl)
            .then(function(response) { return response.json(); })
            .then(function(data) {
                isFetchingRoute = false;
                if (data && data.routes && data.routes.length > 0 && data.routes[0].geometry) {
                    var routeCoords = data.routes[0].geometry.coordinates.map(function(coord) {
                        return [coord[1], coord[0]]; // Leaflet expects [lat, lng]
                    });

                    if (linePath) {
                        map.removeLayer(linePath);
                    }

                    // 🛣️ Glowing Turn-by-Turn Road Route Polyline (Uber / Zomato style)
                    linePath = L.polyline(routeCoords, {
                        color: '#ff6b00',
                        weight: 5,
                        opacity: 0.92,
                        lineJoin: 'round',
                        lineCap: 'round'
                    }).addTo(map);

                    lastRouteFetchCoords = { mechLat: mLat, mechLng: mLng, custLat: cLat, custLng: cLng };

                    // Auto-fit map bounds
                    var bounds = L.latLngBounds(routeCoords);
                    map.fitBounds(bounds, { padding: [50, 50] });

                    if (data.routes[0].distance && data.routes[0].duration) {
                        window.currentRoadDistanceKm = (data.routes[0].distance / 1000).toFixed(1);
                        window.currentRoadEtaMins = Math.max(2, Math.round(data.routes[0].duration / 60));
                    }
                } else {
                    drawFallbackStraightLine(mLat, mLng, cLat, cLng);
                }
            })
            .catch(function(err) {
                isFetchingRoute = false;
                drawFallbackStraightLine(mLat, mLng, cLat, cLng);
            });
    }

    function drawFallbackStraightLine(mLat, mLng, cLat, cLng) {
        if (linePath) {
            map.removeLayer(linePath);
        }
        linePath = L.polyline([
            [mLat, mLng],
            [cLat, cLng]
        ], { color: '#ff6b00', weight: 4, dashArray: '6, 8', opacity: 0.85 }).addTo(map);

        var bounds = L.latLngBounds([
            [mLat, mLng],
            [cLat, cLng]
        ]);
        map.fitBounds(bounds, { padding: [50, 50] });
    }

    function calculateDistance(lat1, lon1, lat2, lon2) {
        var R = 6371; // Radius of the earth in km
        var dLat = (lat2 - lat1) * Math.PI / 180;
        var dLon = (lon2 - lon1) * Math.PI / 180;
        var a = 
            Math.sin(dLat/2) * Math.sin(dLat/2) +
            Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * 
            Math.sin(dLon/2) * Math.sin(dLon/2);
        var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
        return R * c;
    }

