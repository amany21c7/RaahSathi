@using RaahSathi.Models
@{
    ViewData["Title"] = "Roadside Route Tracker & Security Hub";
    var job = ViewBag.Job as Job ?? new Job();
    var profile = ViewBag.MechanicProfile as MechanicProfile;
}

<style>
    .feedback-chip {
        cursor: pointer;
        user-select: none;
        transition: all 0.2s ease-in-out;
        border: 1px solid var(--border-glass, rgba(255,255,255,0.15));
        background: rgba(255, 255, 255, 0.05);
        color: #d1d5db;
        border-radius: 20px;
        padding: 6px 14px;
        font-size: 0.825rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .feedback-chip:hover {
        border-color: #f59e0b;
        color: #fff;
        transform: translateY(-1px);
    }
    .feedback-chip.active-positive {
        background: rgba(16, 185, 129, 0.25) !important;
        border-color: #10b981 !important;
        color: #10b981 !important;
        font-weight: 600;
        box-shadow: 0 0 10px rgba(16, 185, 129, 0.3);
    }
    .feedback-chip.active-negative {
        background: rgba(239, 68, 68, 0.25) !important;
        border-color: #ef4444 !important;
        color: #f87171 !important;
        font-weight: 600;
        box-shadow: 0 0 10px rgba(239, 68, 68, 0.3);
    }
    .cursor-pointer { cursor: pointer; }

    /* Timeline Roadmap Layout */
    .timeline-progress-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        position: relative;
        margin: 15px 0 5px 0;
        padding: 0 5px;
    }
    .timeline-progress-wrapper::before {
        content: '';
        position: absolute;
        top: 16px;
        left: 35px;
        right: 35px;
        height: 2px;
        background: rgba(255, 255, 255, 0.15);
        z-index: 1;
    }
    .timeline-item-col {
        display: flex;
        flex-direction: column;
        align-items: center;
        z-index: 2;
        position: relative;
        flex: 1 1 0;
        min-width: 48px;
        max-width: 85px;
    }
    .timeline-step {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #1e293b;
        border: 2px solid rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.8rem;
        transition: all 0.3s ease;
        color: #94a3b8;
    }
    .timeline-step.completed {
        background: #10b981 !important;
        border-color: #10b981 !important;
        color: #fff !important;
        box-shadow: 0 0 10px rgba(16, 185, 129, 0.4);
    }
    .timeline-step.active {
        background: #f59e0b !important;
        border-color: #f59e0b !important;
        color: #000 !important;
        font-weight: bold;
        box-shadow: 0 0 12px rgba(245, 158, 11, 0.6);
    }
    .timeline-label {
        margin-top: 6px;
        font-size: 0.7rem;
        font-weight: 500;
        text-align: center;
        color: #94a3b8;
        transition: color 0.3s ease;
        position: static !important;
        transform: none !important;
        width: 100% !important;
        word-break: break-word;
        line-height: 1.2;
    }
    .timeline-step.active ~ .timeline-label,
    .timeline-step.completed ~ .timeline-label {
        color: #ffffff !important;
        font-weight: 600;
    }

    /* Credit Card CSS */
    .card-wrapper {
        perspective: 1000px;
        width: 100%;
        max-width: 290px;
        margin: 0 auto 20px auto;
    }
    .credit-card-interactive {
        width: 100%;
        height: 160px;
        position: relative;
        transform-style: preserve-3d;
        transition: transform 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .credit-card-interactive.flipped {
        transform: rotateY(180deg);
    }
    .card-front, .card-back {
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
        border-radius: 12px;
        padding: 15px;
        color: #fff;
        box-shadow: 0 8px 20px rgba(0,0,0,0.25);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .card-front {
        background: linear-gradient(135deg, #0e1e38 0%, #1e3a66 100%);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .card-back {
        background: linear-gradient(135deg, #1e3a66 0%, #0e1e38 100%);
        transform: rotateY(180deg);
        padding: 0;
        justify-content: flex-start;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .card-chip {
        width: 35px;
        height: 25px;
        background: linear-gradient(135deg, #f1c40f, #f39c12);
        border-radius: 4px;
    }
    .card-number-display {
        font-size: 1.15rem;
        letter-spacing: 2px;
        font-family: 'Courier New', Courier, monospace;
        margin: 12px 0;
        text-align: center;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.6);
    }
    .card-holder-info {
        display: flex;
        justify-content: space-between;
        font-size: 0.75rem;
    }
    .card-label-small {
        font-size: 0.55rem;
        text-transform: uppercase;
        opacity: 0.6;
        margin-bottom: 2px;
    }
    .card-value-small {
        font-weight: 600;
        text-transform: uppercase;
    }
    .card-black-bar {
        width: 100%;
        height: 35px;
        background: #000;
        margin-top: 15px;
    }
    .card-signature-area {
        margin: 10px 15px;
        height: 30px;
        background: #fff;
        border-radius: 3px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        padding-right: 10px;
    }
    .card-cvv-text {
        font-family: 'Courier New', Courier, monospace;
        color: #000;
        font-weight: bold;
        letter-spacing: 1px;
    }
    /* Pulse indicator for UPI */
    .pulse-circle {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: rgba(13, 110, 253, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        position: relative;
    }
    .pulse-circle::before, .pulse-circle::after {
        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        border: 2px solid #0d6efd;
        opacity: 0;
        animation: pulseAnimation 2s infinite;
    }
    .pulse-circle::after {
        animation-delay: 1s;
    }
    @@keyframes pulseAnimation {
        0% { transform: scale(0.9); opacity: 0.8; }
        100% { transform: scale(1.6); opacity: 0; }
    }
    /* Success Checkmark Animation */
    .checkmark-circle {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: block;
        stroke-width: 4;
        stroke: #22c55e;
        stroke-miterlimit: 10;
        margin: 10% auto;
        box-shadow: inset 0px 0px 0px #22c55e;
        animation: fillCheck 0.4s ease-in-out 0.4s forwards, scaleCheck 0.3s ease-in-out 0.9s both;
    }
    .checkmark-kick {
        transform-origin: 50% 50%;
        stroke-dasharray: 48;
        stroke-dashoffset: 48;
        animation: strokeCheck 0.3s cubic-bezier(0.65, 0, 0.45, 1) 0.8s forwards;
    }
    @@keyframes strokeCheck { 100% { stroke-dashoffset: 0; } }
    @@keyframes scaleCheck { 0%, 100% { transform: none; } 50% { transform: scale3d(1.1, 1.1, 1); } }
    @@keyframes fillCheck { 100% { box-shadow: inset 0px 0px 0px 40px #22c55e; stroke: #fff; } }

    /* Print Styles */
    @@media print {
        body * {
            visibility: hidden;
        }
        #customerInvoiceModal, #customerInvoiceModal * {
            visibility: visible;
        }
        #customerInvoiceModal {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            margin: 0;
            padding: 0;
            border: none !important;
            box-shadow: none !important;
            background: #fff !important;
            color: #000 !important;
        }
        #custInvoicePrintArea, #custInvoicePrintArea * {
            visibility: visible;
        }
        #custInvoicePrintArea {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            background: #fff !important;
            color: #000 !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .d-print-none, .modal-header, .btn-close {
            display: none !important;
        }
        .bg-dark, .bg-black, .bg-opacity-80, .bg-opacity-40 {
            background: #fff !important;
            color: #000 !important;
            border: 1px solid #ccc !important;
        }
        .text-light, .text-muted, .text-warning, .text-info, .text-success, .text-white-50 {
            color: #000 !important;
        }
        .table-dark {
            background-color: #fff !important;
            color: #000 !important;
        }
        .table-dark th, .table-dark td {
            border: 1px solid #000 !important;
            color: #000 !important;
        }
        .badge {
            border: 1px solid #000 !important;
            color: #000 !important;
            background: #eee !important;
        }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="text-white mb-0"><i class="fa-solid fa-map-location-dot text-primary me-2"></i> Tracker & Security Hub</h4>
    <a href="/Customer/Dashboard" class="btn btn-outline-secondary btn-sm"><i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard</a>
</div>
<div class="row">
    <!-- Map & Route Column -->
    <div class="col-lg-8 mb-4 mb-lg-0">
        @if (job.DisputeStatus == "Active")
        {
            <div class="alert alert-danger bg-dark border-danger text-danger p-3 mb-4 rounded-3 d-flex align-items-center gap-3 shadow-lg">
                <i class="fa-solid fa-triangle-exclamation text-danger fa-2x animate-pulse"></i>
                <div>
                    <h6 class="text-danger mb-0 font-weight-bold">Complaint Logged (Under Investigation)</h6>
                    <p class="mb-0 small text-muted">You have reported an issue regarding this booking. Our 24x7 Support/Ops team is currently reviewing it. Escrow status is being managed by Admin.</p>
                </div>
            </div>
        }
        else if (job.DisputeStatus == "Resolved")
        {
            <div class="alert alert-success bg-dark border-success text-success p-3 mb-4 rounded-3 d-flex align-items-center gap-3 shadow-lg">
                <i class="fa-solid fa-circle-check text-success fa-2x"></i>
                <div>
                    <h6 class="text-success mb-0 font-weight-bold">Complaint Resolved by Admin</h6>
                    <p class="mb-0 small text-muted">Resolution: <b>@job.DisputeResolution</b></p>
                </div>
            </div>
        }

        <!-- Dispatch Timeout alert card -->
        <div id="dispatch-timeout-alert" class="alert alert-warning bg-dark border-warning text-warning p-4 mb-4 rounded-3 d-none shadow-lg">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="p-2 rounded-circle bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-clock-rotate-left text-warning fa-2x animate-pulse"></i>
                </div>
                <div>
                    <h6 class="text-warning mb-0 font-weight-bold">⚠️ Connection Timeout (No Response)</h6>
                    <p class="mb-0 small text-muted">We are unable to connect to a nearby mechanic at this moment. Please retry dispatch or return to dashboard.</p>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-warning text-dark font-weight-bold btn-sm px-4" onclick="retryDispatch()">
                    <i class="fa-solid fa-rotate-right me-1"></i> Retry Dispatch Request
                </button>
                <a href="/Customer/Dashboard" class="btn btn-outline-secondary btn-sm">
                    Cancel & Return to Dashboard
                </a>
            </div>
        </div>

        <!-- Vehicle & Issues Summary Card with Multi-Problem Breakdown -->
        <div class="glass-card p-3 mb-3 border-secondary">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                <div>
                    <span class="badge bg-warning text-dark font-weight-bold mb-1">JOB #@job.Id</span>
                    <h5 class="text-white font-weight-bold mb-1">@job.Vehicle?.Model (@job.Vehicle?.VehicleType)</h5>
                    <div id="trackerProblemsContainer" class="d-flex flex-wrap gap-2 align-items-center mt-2">
                        @{
                            var custJobProblems = (job.ProblemType ?? "").Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
                        }
                        @foreach (var p in custJobProblems)
                        {
                            bool isCancelled = !string.IsNullOrEmpty(job.CancelledProblemItem) &&
                                               (p.Equals(job.CancelledProblemItem, StringComparison.OrdinalIgnoreCase) || p.Contains(job.CancelledProblemItem, StringComparison.OrdinalIgnoreCase) || job.CancelledProblemItem.Contains(p, StringComparison.OrdinalIgnoreCase));
                            
                            if (isCancelled)
                            {
                                <div class="badge bg-danger bg-opacity-10 border border-danger text-light p-2 rounded-3 d-inline-flex align-items-center gap-1.5 tracker-prob-badge" data-prob-name="@p">
                                    <i class="fa-solid fa-circle-xmark text-danger"></i>
                                    <span class="text-decoration-line-through text-muted font-weight-bold">@p</span>
                                    <span class="text-danger small" style="font-size:0.7rem;">(Cancelled by mechanic)</span>
                                </div>
                            }
                            else
                            {
                                <div class="badge bg-dark border border-warning border-opacity-40 text-white p-2 rounded-3 d-inline-flex align-items-center gap-1.5 shadow-sm tracker-prob-badge" data-prob-name="@p">
                                    <i class="fa-solid fa-wrench text-warning"></i>
                                    <span class="prob-title">@p</span>
                                </div>
                            }
                        }
                    </div>
                </div>
                <div class="text-md-end">
                    <span class="text-muted small d-block font-weight-bold">Upfront Estimate</span>
                    <h4 class="text-warning font-weight-extrabold mb-0" id="trackerEstimatedBillText">₹@job.FinalBillAmount.ToString("N0")</h4>
                </div>
            </div>

            <div id="trackerCancelledAlert" class="alert alert-danger bg-dark border-danger text-light small p-2.5 mt-2.5 mb-0 rounded @(string.IsNullOrEmpty(job.CancelledProblemItem) ? "d-none" : "")">
                <i class="fa-solid fa-circle-info text-danger me-1"></i> <strong>Notice:</strong> Problem <strong><span id="trackerCancelledItemName">@job.CancelledProblemItem</span></strong> was removed by mechanic (<span id="trackerCancelledReasonText">@job.ProblemCancelReason</span>). Total estimate adjusted.
            </div>
        </div>

        <!-- Tracker Map Card -->
        <div class="glass-card p-0 mb-3 overflow-hidden" style="display:flex; flex-direction:column;">
            <div class="p-3 bg-dark border-bottom border-secondary d-flex align-items-center justify-content-between">
                <div>
                    <h5 class="mb-0 text-white"><i class="fa-solid fa-route text-warning me-2"></i> Live Mechanic Tracking</h5>
                    <span class="text-muted small" id="etaText">Awaiting updates...</span>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-info btn-sm" id="btnShareTrip" onclick="shareTrip()"><i class="fa-solid fa-share-nodes"></i> Share Trip</button>
                    <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#videoCallModal"><i class="fa-solid fa-video"></i> Video Call Verify</button>
                </div>
            </div>
            
            <div id="map-container" style="height: 290px; width: 100%;"></div>
        </div>

        <!-- Job Progress Checklist (Visual State Machine) -->
        <div class="glass-card p-3 mb-3">
            <h5 class="text-white mb-3"><i class="fa-solid fa-list-check text-warning me-2"></i> Service Roadmap Status</h5>
            <div class="timeline-progress-wrapper">
                <div class="timeline-item-col">
                    <div class="timeline-step" id="step-Accepted">1</div>
                    <div class="timeline-label">Accepted</div>
                </div>
                <div class="timeline-item-col">
                    <div class="timeline-step" id="step-Driving">2</div>
                    <div class="timeline-label">Driving</div>
                </div>
                <div class="timeline-item-col">
                    <div class="timeline-step" id="step-Inspecting">3</div>
                    <div class="timeline-label">Reached Spot & Inspection</div>
                </div>
                <div class="timeline-item-col">
                    <div class="timeline-step" id="step-Repairing">4</div>
                    <div class="timeline-label">Repairing</div>
                </div>
                <div class="timeline-item-col">
                    <div class="timeline-step" id="step-Completed">5</div>
                    <div class="timeline-label">Finished</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Status Console, SOS Panic Hub, Approvals, & Checkout -->
    <div class="col-lg-4">
        <!-- Mechanic Info Card & Verification -->
        <div class="glass-card mb-4" id="mechanicDetailsCard">
            <h5 class="text-white mb-3">Assigned Expert</h5>
            
            <!-- Inactivity Warning Alert -->
            <div id="customer-inactivity-warning" class="alert alert-danger bg-dark border-danger text-danger small p-3 mb-3 d-none">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="fa-solid fa-triangle-exclamation text-danger fa-lg"></i>
                    <span><strong>Mechanic Stopped Moving!</strong> No progress detected for 5 minutes.</span>
                </div>
                <div class="d-flex gap-2 mt-2">
                    <button type="button" class="btn btn-danger btn-sm font-weight-bold flex-fill py-2 shadow-sm" onclick="reassignMechanic()">
                        <i class="fa-solid fa-rotate me-1"></i> Reassign Mechanic
                    </button>
                    <button type="button" class="btn btn-outline-warning btn-sm font-weight-bold flex-fill py-2 shadow-sm" onclick="keepWaiting()">
                        <i class="fa-solid fa-hourglass-start me-1"></i> I Will Wait
                    </button>
                </div>
            </div>

            <div class="d-flex align-items-center mb-3">
                <div class="position-relative me-3">
                    <div class="rounded-circle bg-warning p-3 d-flex align-items-center justify-content-center text-dark" style="width: 55px; height: 55px; font-weight:bold; font-size:1.2rem;">
                        @job.Mechanic?.Name[0]
                    </div>
                    <span class="position-absolute bottom-0 end-0 badge rounded-pill bg-success border border-white" style="font-size:0.5rem;"><i class="fa-solid fa-check"></i> Verified</span>
                </div>
                <div>
                    <h6 class="text-white mb-0">@job.Mechanic?.Name</h6>
                    <div class="text-muted small">Rating: <span class="text-warning">@(profile?.Rating ?? 5.0) ★</span> | @(profile?.ExperienceYears ?? 5) Yrs Exp</div>
                    <div class="text-warning small"><i class="fa-solid fa-certificate me-1"></i> KYC Document Verified</div>
                </div>
            </div>
            
            <div class="d-flex gap-2 mb-2">
                <a href="tel:@job.Mechanic?.PhoneNumber" class="btn btn-warning font-weight-bold flex-fill py-2.5 shadow-sm">
                    <i class="fa-solid fa-phone me-1.5"></i> 📞 Call
                </a>
                <button type="button" class="btn btn-outline-info font-weight-bold flex-fill py-2.5 shadow-sm position-relative" data-bs-toggle="modal" data-bs-target="#liveChatModal" onclick="fetchChatMessages()">
                    <i class="fa-solid fa-comments me-1.5"></i> 💬 Chat
                    <span id="chat-unread-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">0</span>
                </button>
            </div>
            <button type="button" id="sidebarReceiptBtn" class="btn btn-outline-info font-weight-bold w-100 py-2.5 shadow-sm @(job.Status == "Completed" ? "" : "d-none")" onclick="showCustomerInvoiceModal(@job.Id)">
                <i class="fa-solid fa-receipt me-2"></i> View Itemized Tax Invoice / Receipt
            </button>
        </div>

        <!-- SOS & Safety Center -->
        <div class="glass-card mb-4 border-danger border-opacity-30">
            <h5 class="text-danger mb-3"><i class="fa-solid fa-shield-halved text-danger me-2"></i> Safety & SOS Moat</h5>
            <p class="text-muted small">Tap the panic button to share GPS coords with emergency contacts + police control instantly.</p>
            <div class="sos-btn-container">
                <button class="sos-button" onclick="triggerSOS()">
                    <i class="fa-solid fa-triangle-exclamation mb-1"></i>
                    <span>SOS</span>
                </button>
            </div>
        </div>

        <!-- Estimate / Parts Approval Panel (Dynamic depending on state) -->
        <div class="glass-card mb-4 border-warning border-opacity-30 d-none" id="partsApprovalCard">
            <h5 class="text-warning mb-3"><i class="fa-solid fa-screwdriver-wrench me-2"></i> Parts/Spares Estimate</h5>
            <div class="bg-black bg-opacity-40 p-3 rounded border border-secondary mb-3">
                <div class="font-weight-bold text-white" id="partsNameText">Clutch cable replacement</div>
                <div class="text-muted small" id="partsDetailsText">Required for proper clutch engagement. Source: local dealer.</div>
                <hr class="border-secondary my-2">
                <div class="d-flex justify-content-between text-white">
                    <span>Parts Estimate:</span>
                    <span class="font-weight-bold text-warning" id="partsCostText">₹650.00</span>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-premium-primary flex-grow-1" onclick="submitPartsApproval(true)"><i class="fa-solid fa-check"></i> Approve & Fix</button>
                <button class="btn btn-premium-secondary" onclick="submitPartsApproval(false)"><i class="fa-solid fa-xmark"></i> Decline</button>
            </div>
        </div>

        <!-- Towing Option Approval Panel -->
        <div class="glass-card mb-4 border-warning border-opacity-30 d-none" id="towingApprovalCard">
            <h5 class="text-warning mb-3"><i class="fa-solid fa-truck-pickup me-2"></i> Towing Approval Request</h5>
            <p class="text-muted small">Mechanic flagged that an on-spot repair is not possible. Photos uploaded as verification.</p>
            
            <div class="bg-black bg-opacity-40 p-3 rounded border border-secondary mb-3">
                <div class="text-muted small">Reason: <b class="text-light" id="towingReasonText">Gearbox leak / shaft broken</b></div>
                <div class="my-2 border border-secondary rounded overflow-hidden" style="max-height:120px;">
                    <img src="https://images.unsplash.com/photo-1597766333608-98897e4d3e6d?auto=format&fit=crop&q=80&w=400" alt="Diagnostic Proof" class="w-100 h-100" style="object-fit:cover;">
                </div>
                <hr class="border-secondary my-2">
                <div class="d-flex justify-content-between text-white">
                    <span>Towing Cost:</span>
                    <span class="font-weight-bold text-warning" id="towingCostText">₹750.00</span>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-premium-primary flex-grow-1" onclick="submitTowingApproval(true)"><i class="fa-solid fa-truck-monster"></i> Approve Towing</button>
                <button class="btn btn-premium-secondary" onclick="submitTowingApproval(false)"><i class="fa-solid fa-xmark"></i> Reject</button>
            </div>
        </div>

        <!-- Payment & Escrow Checkout Panel -->
        <div class="glass-card mb-4 border-success border-opacity-30 d-none" id="paymentCheckoutCard">
            <h5 class="text-success mb-3"><i class="fa-solid fa-wallet me-2"></i> Escrow Settlement Console</h5>
            <p class="text-muted small">Job marked complete by the mechanic. Review breakdown bill and pay below. Payment will be held in Escrow.</p>
            
