                $('#custInvVehicleInfo').text(res.vehicleModel + ' (' + res.vehicleType + ' - ' + res.fuelType + ') • Reg: ' + res.vehicleRegNumber);
                $('#custInvCustomerAddress').text(res.customerAddress);

                $('#custInvMechanicName').text(res.mechanicName);
                $('#custInvShopName').text(res.shopName);
                $('#custInvMechanicPhone').text(res.mechanicPhone);
                $('#custInvShopAddress').text(res.shopAddress);

                var rowsHtml = '';
                var itemNo = 1;

                rowsHtml += `<tr><td>${itemNo++}</td><td>Basic Visiting & Distance Charge</td><td class="text-end font-weight-bold">₹${res.visitingCharge.toFixed(2)}</td></tr>`;
                rowsHtml += `<tr><td>${itemNo++}</td><td>Breakdown Repair Service Fee (${res.problemType})</td><td class="text-end font-weight-bold">₹${res.serviceChargeMin.toFixed(2)}</td></tr>`;

                if (res.customEstimateAmount > 0) {
                    rowsHtml += `<tr><td>${itemNo++}</td><td>On-Spot Inspection Estimate (${res.customEstimateDetails || 'Custom Repair'})</td><td class="text-end font-weight-bold">₹${res.customEstimateAmount.toFixed(2)}</td></tr>`;
                }

                if (res.partsEstimateAmount > 0 || res.extraLabourCharge > 0) {
                    var partLabel = res.partsDetails || 'Spare Part';
                    if (res.partsMrp > res.partsEstimateAmount) {
                        partLabel += ` <span class="badge bg-secondary text-light">MRP: ₹${res.partsMrp.toFixed(2)}</span>`;
                    }
                    var partsTotal = res.partsEstimateAmount + res.extraLabourCharge;
                    rowsHtml += `<tr><td>${itemNo++}</td><td>Extra Spare Parts & Labour (${partLabel})</td><td class="text-end font-weight-bold">₹${partsTotal.toFixed(2)}</td></tr>`;
                }

                if (res.towingCharge > 0) {
                    rowsHtml += `<tr><td>${itemNo++}</td><td>Emergency Towing Assistance Charge</td><td class="text-end font-weight-bold">₹${res.towingCharge.toFixed(2)}</td></tr>`;
                }

                $('#custInvItemsTable').html(rowsHtml);
                $('#custInvTotalAmount').text('₹' + res.totalBillAmount.toFixed(2));

                var invModal = new bootstrap.Modal(document.getElementById('customerInvoiceModal'));
                invModal.show();
            } else {
                alert('Could not fetch receipt details.');
            }
        });
    }

    // Live Estimate / Parts Approval Modal Logic
    var activeApprovalType = null; // 'custom', 'parts', 'towing'

    function checkAndShowApprovalModal(res) {
        if ($('#estimateApprovalModal').hasClass('show')) return; // Modal already open

        if (res.customEstimateAmount > 0 && res.customEstimateApproved === null) {
            activeApprovalType = 'custom';
            $('#appModalTitle').html('<i class="fa-solid fa-calculator text-info me-2"></i> Custom Repair Estimate Approval');
            $('#appModalTypeBadge').text('ON-SPOT CUSTOM REPAIR ESTIMATE');
            $('#appModalScope').text(res.customEstimateDetails || 'On-spot repair & labour cost');
            $('#appModalItemPrice').text('₹' + res.customEstimateAmount.toFixed(2));
            $('#appModalLabourRow').hide();
            $('#appModalEstTotal').text('₹' + res.customEstimateAmount.toFixed(2));

            var updatedTotal = res.visitingCharge + res.serviceChargeMin + res.customEstimateAmount;
            $('#appModalUpdatedBill').text('₹' + updatedTotal.toFixed(2));

            var modal = new bootstrap.Modal(document.getElementById('estimateApprovalModal'));
            modal.show();
        } 
        else if ((res.partsEstimateAmount > 0 || res.extraLabourCharge > 0) && res.partsApproved === null) {
            activeApprovalType = 'parts';
            $('#appModalTitle').html('<i class="fa-solid fa-box-open text-warning me-2"></i> Extra Spare Parts & Labour Quote Approval');
            $('#appModalTypeBadge').text('EXTRA SPARE PARTS & LABOUR QUOTE');
            $('#appModalScope').text(res.partsEstimateDetails || res.extraPartsName || 'Replacement Spare Part');
            $('#appModalItemPrice').text('₹' + res.partsEstimateAmount.toFixed(2));
            
            if (res.extraLabourCharge > 0) {
                $('#appModalLabourPrice').text('₹' + res.extraLabourCharge.toFixed(2));
                $('#appModalLabourRow').show();
            } else {
                $('#appModalLabourRow').hide();
            }

            var partsTotal = res.partsEstimateAmount + res.extraLabourCharge;
            $('#appModalEstTotal').text('₹' + partsTotal.toFixed(2));

            var updatedTotal = res.finalBillAmount + partsTotal;
            $('#appModalUpdatedBill').text('₹' + updatedTotal.toFixed(2));

            var modal = new bootstrap.Modal(document.getElementById('estimateApprovalModal'));
            modal.show();
        }
        else if (res.towingNeeded === true && res.towingApproved === null) {
            activeApprovalType = 'towing';
            $('#appModalTitle').html('<i class="fa-solid fa-truck-pickup text-danger me-2"></i> Emergency Towing Request Approval');
            $('#appModalTypeBadge').text('EMERGENCY FLATBED TOWING ASSISTANCE');
            $('#appModalScope').text(res.towingReason || 'Vehicle unable to repair on spot');
            $('#appModalItemPrice').text('₹' + res.towingCharge.toFixed(2));
            $('#appModalLabourRow').hide();
            $('#appModalEstTotal').text('₹' + res.towingCharge.toFixed(2));

            var updatedTotal = res.finalBillAmount + res.towingCharge;
            $('#appModalUpdatedBill').text('₹' + updatedTotal.toFixed(2));

            var modal = new bootstrap.Modal(document.getElementById('estimateApprovalModal'));
            modal.show();
        }
    }

    function respondToApproval(approve) {
        var modal = bootstrap.Modal.getInstance(document.getElementById('estimateApprovalModal'));
        if (modal) modal.hide();

        if (activeApprovalType === 'custom') {
            $.post('/Customer/ApproveCustomEstimate', { id: @job.Id, approve: approve }, function (r) {
                alert(approve ? 'Custom Estimate APPROVED! Repair in progress.' : 'Custom Estimate REJECTED.');
                pollJobStatus();
            });
        } else if (activeApprovalType === 'parts') {
            $.post('/Customer/ApproveParts', { id: @job.Id, approve: approve }, function (r) {
                alert(approve ? 'Extra Parts Quote APPROVED! Added to final bill.' : 'Extra Parts Quote REJECTED.');
                pollJobStatus();
            });
        } else if (activeApprovalType === 'towing') {
            $.post('/Customer/ApproveTowing', { id: @job.Id, approve: approve }, function (r) {
                alert(approve ? 'Towing Request APPROVED! Flatbed dispatched.' : 'Towing Request REJECTED.');
                pollJobStatus();
            });
        }
    }

    function reassignMechanic() {
        if (confirm("Are you sure you want to reassign this mechanic? A new verified technician will be dispatched to your location immediately.")) {
            $.post('/Customer/ReassignMechanic', { id: @job.Id }, function(res) {
                if (res && res.success) {
                    alert("🔄 " + res.message);
                    window.location.href = '/Customer/Dashboard';
                } else {
                    alert(res.message || "Failed to reassign mechanic.");
                }
            });
        }
    }

    function retryDispatch() {
        $.post('/Customer/RetryDispatch', { id: @job.Id }, function(res) {
            if (res && res.success) {
                alert("🚀 Dispatch request renewed! We are searching for nearby verified mechanics again.");
                $('#dispatch-timeout-alert').addClass('d-none');
                pollJobStatus();
            } else {
                alert(res.message || "Failed to renew dispatch.");
            }
        });
    }

    function keepWaiting() {
        $.post('/Customer/KeepWaiting', { id: @job.Id }, function(res) {
            if (res && res.success) {
                alert("⏳ " + res.message);
                $('#customer-inactivity-warning').addClass('d-none');
                pollJobStatus();
            } else {
                alert(res.message || "Failed to submit request.");
            }
        });
    }
</script>
}

