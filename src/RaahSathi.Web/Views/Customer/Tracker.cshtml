    // Card View formatting & dynamic sync
    function formatCardNumber(input) {
        var value = input.value.replace(/\D/g, '');
        var formatted = value.match(/.{1,4}/g);
        if (formatted) {
            input.value = formatted.join(' ');
        } else {
            input.value = value;
        }
        $('#cardNumLabel').text(input.value || '•••• •••• •••• ••••');
    }

    function updateCardName(input) {
        $('#cardNameLabel').text(input.value.toUpperCase() || 'YOUR NAME');
    }

    function formatCardExpiry(input) {
        var value = input.value.replace(/\D/g, '');
        if (value.length > 2) {
            input.value = value.substring(0,2) + '/' + value.substring(2,4);
        } else {
            input.value = value;
        }
        $('#cardExpiryLabel').text(input.value || 'MM/YY');
    }

    function updateCardCvv(input) {
        var value = input.value.replace(/\D/g, '');
        input.value = value;
        var masked = '';
        for (var i = 0; i < value.length; i++) masked += '•';
        $('#cardCvvLabel').text(masked || '•••');
    }

