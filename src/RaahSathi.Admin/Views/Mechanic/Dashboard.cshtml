@section Scripts {
<script>
    // Dynamic Tab Navigation
    function switchMechTab(tabId) {
        $('.mech-tab-content').hide();
        $('#' + tabId).show();

        // On mobile screens (< 992px), hide overview card for sub-tabs to give clean native app-like screen
        if ($(window).width() < 992) {
            if (tabId === 'tab-home') {
                $('#mechMainOverviewCard').show();
            } else {
                $('#mechMainOverviewCard').hide();
            }
        } else {
            $('#mechMainOverviewCard').show();
        }

        window.scrollTo({ top: 0, behavior: 'smooth' });

        $('.bottom-mech-nav button, .glass-card button').removeClass('active');
        $('#navBtn-' + tabId).addClass('active');

        if (tabId === 'tab-support') {
            loadSupportMessages();
        }
    }

    var isOnline = @(profile.IsOnline ? "true" : "false");
    var hasActiveJob = @(activeJob != null ? "true" : "false");

    function updateOnlineUI(online) {
        isOnline = online;
        if (online) {
            $('#badgeOnlineStatus').removeClass('bg-secondary text-light').addClass('bg-success text-white').html('<i class="fa-solid fa-circle me-1" style="font-size:0.6rem;"></i> 🟢 ONLINE');
            $('#toggleOnlineSwitch, #toggleOnlineSwitchDesktop').prop('checked', true);
            $('#lblSwitchOnline, #lblSwitchOnlineDesktop').text('Status: Online');
            $('#dispatchTitleText').text('RaahSathi Dispatch Network Active');
            $('#dispatchDescText').text('Standing by for breakdown assistance requests within your selected service radius.');
            $('#goOnlineBtnContainer').html('');
        } else {
            $('#badgeOnlineStatus').removeClass('bg-success text-white').addClass('bg-secondary text-light').html('<i class="fa-solid fa-circle me-1" style="font-size:0.6rem;"></i> ⚪ OFFLINE');
            $('#toggleOnlineSwitch, #toggleOnlineSwitchDesktop').prop('checked', false);
            $('#lblSwitchOnline, #lblSwitchOnlineDesktop').text('Status: Offline');
            $('#dispatchTitleText').text('You Are Currently Offline');
            $('#dispatchDescText').text('Switch status to Online in the top bar to start receiving incoming assistance pings.');
            $('#goOnlineBtnContainer').html('<button class="btn btn-premium-primary btn-lg px-5 py-3 font-weight-bold" onclick="toggleMechanicOnlineState()"><i class="fa-solid fa-power-off me-2"></i> Go Online Now</button>');
        }
    }

    // Toggle Online/Offline State
    function toggleMechanicOnlineState() {
        try {
            if (typeof window.unlockSirenAudio === 'function') {
                window.unlockSirenAudio();
            }
            if (!window.sirenAudioCtx) {
                window.sirenAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (window.sirenAudioCtx.state === 'suspended') {
                window.sirenAudioCtx.resume();
            }
            if ('Notification' in window && Notification.permission === 'default') {
                Notification.requestPermission();
            }
        } catch(e) {}

        $.post('/Mechanic/ToggleOnline', function(res) {
            if (res.success) {
                updateOnlineUI(res.isOnline);
                if (res.isOnline) {
                    if (typeof window.unlockSirenAudio === 'function') {
                        window.unlockSirenAudio();
                    }
                }
            }
        });
    }

    $(document).ready(function() {
        // Start watching geolocation to update mechanic location in database
        if (navigator.geolocation) {
            navigator.geolocation.watchPosition(function(position) {
                var lat = position.coords.latitude;
                var lng = position.coords.longitude;
                $.post('/Mechanic/UpdateLocation', { lat: lat, lng: lng });
            }, function(err) {
                console.warn("Geolocation watch error:", err);
            }, {
                enableHighAccuracy: true,
                maximumAge: 10000,
                timeout: 5000
            });
        }
        
        // Initialize Completed Repair History to show last 7 days (weekly) by default
        resetHistoryDateFilter();
    });

    // Step Status Advances with Instant Touch Feedback & Payment Validation
    function advanceStatus(nextStatus, btnElement, directJobId) {
        var activeJobId = directJobId || parseInt("@(activeJob?.Id ?? 0)") || parseInt(currentActiveJobId) || 0;
        var $btn = btnElement ? $(btnElement) : $('button[onclick*="advanceStatus(\'' + nextStatus + '\'"]');
        var originalBtnHtml = $btn.length ? $btn.html() : '';
        
        if ($btn.length) {
            $btn.prop('disabled', true).html('<i class="fa-solid fa-circle-notch fa-spin me-2"></i> Updating...');
        }

        if (activeJobId > 0) {
            $.post('/Mechanic/AdvanceJobStatus', { jobId: activeJobId, newStatus: nextStatus }, function(res) {
                if (res && res.success) {
                    window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
                } else if (res && res.requiresPayment) {
                    if ($btn.length) { $btn.prop('disabled', false).html(originalBtnHtml); }
                    alert(res.message);
                    openPaymentQrModal(activeJobId);
                } else if (res) {
                    if ($btn.length) { $btn.prop('disabled', false).html(originalBtnHtml); }
                    alert(res.message || 'Could not update status.');
                }
            }).fail(function() {
                window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
            });
        } else {
            window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
        }
    }

    // Submit Custom Estimate with Touch Feedback
    function submitCustomEstimate(btnElement) {
        var activeJobId = parseInt("@(activeJob?.Id ?? 0)") || parseInt(currentActiveJobId) || 0;
        var amount = $('#txtCustomEstimateAmount').val();
        var details = $('#txtCustomEstimateDetails').val();
        var $btn = btnElement ? $(btnElement) : $('#btnSubmitCustomEst');
        var originalHtml = $btn.length ? $btn.html() : '';

        if (activeJobId > 0 && amount > 0) {
            if ($btn.length) { $btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Sending...'); }
            $.post('/Mechanic/SubmitCustomEstimate', { jobId: activeJobId, amount: amount, details: details }, function(res) {
                if (res && res.success) {
                    alert('✅ Custom Repair Estimate ₹' + amount + ' sent to customer for approval!');
                    window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
                } else {
                    if ($btn.length) { $btn.prop('disabled', false).html(originalHtml); }
                    alert(res?.message || 'Error submitting estimate.');
                }
            }).fail(function() {
                window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
            });
        } else {
            alert('Please enter a valid estimate amount.');
        }
    }

    // Submit Extra Parts Quote with Touch Feedback
    function submitSparesQuote(btnElement) {
        var activeJobId = parseInt("@(activeJob?.Id ?? 0)") || parseInt(currentActiveJobId) || 0;
        var partName = $('#txtExtraPartName').val();
        var partsMrp = $('#txtExtraPartMrp').val() || 0;
        var partPrice = $('#txtExtraPartPrice').val();
        var labourPrice = $('#txtExtraLabourPrice').val() || 0;
        var $btn = btnElement ? $(btnElement) : $('#btnSubmitSpares');
        var originalHtml = $btn.length ? $btn.html() : '';

        if (activeJobId > 0 && partPrice > 0) {
            if ($btn.length) { $btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Sending...'); }
            $.post('/Mechanic/SubmitSparesQuote', { jobId: activeJobId, partName: partName, partPrice: partPrice, labourPrice: labourPrice, partsMrp: partsMrp }, function(res) {
                if (res && res.success) {
                    alert('✅ Extra Parts quote sent for customer approval!');
                    window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
                } else {
                    if ($btn.length) { $btn.prop('disabled', false).html(originalHtml); }
                    alert(res?.message || 'Error submitting spare parts quote.');
                }
            }).fail(function() {
                window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
            });
        } else {
            alert('Please enter part name and offered price.');
        }
    }

    // Preview Selected Profile Photo
    function previewProfilePhoto(input) {
        if (input.files && input.files[0]) {
            var file = input.files[0];
            var reader = new FileReader();
            reader.onload = function(e) {
                $('#imgProfilePreview').attr('src', e.target.result);
            };
            reader.readAsDataURL(file);
        }
    }

    // Save Profile & Personal & Workshop Details Settings
    function saveProfileSettings() {
        var name = $('#txtProfileName').val();
        var phone = $('#txtProfilePhone').val();
        var email = $('#txtProfileEmail').val();
        var shopName = $('#txtProfileShopName').val();
        var shopAddress = $('#txtProfileShopAddress').val();
        var expYears = parseInt($('#txtProfileExperience').val()) || 1;
        var city = $('#txtProfileCity').val();

        if (!name || name.trim() === '') {
            alert('⚠️ Please enter your Full Name.');
            $('#txtProfileName').focus();
            return;
        }

        if (!phone || phone.trim() === '') {
            alert('⚠️ Please enter your Mobile Number.');
            $('#txtProfilePhone').focus();
            return;
        }

        var skills = [];
        $('input[name="chkSkills"]:checked').each(function() { 
            skills.push($(this).val()); 
        });

        var radius = $('input[name="radServiceRadius"]:checked').val() || 15;
        var upi = $('#txtProfileUpi').val();
        var bankName = $('#txtBankName').val();
        var accNo = ($('#txtAccountNo').val() || '').trim();
        var confirmAccNo = ($('#txtConfirmAccountNo').val() || '').trim();
        var ifsc = $('#txtIfscCode').val();
        var holderName = $('#txtProfileHolderName').val();
        var payoutMethod = $('input[name="radPayoutMethod"]:checked').val() || 'UPI';

        if (accNo !== '' && confirmAccNo !== '' && accNo !== confirmAccNo) {
            alert('⚠️ Bank Account Number and Confirm Account Number do not match! Please check and enter the same account number.');
            validateBankAccMatch();
            $('#txtConfirmAccountNo').focus();
            return;
        }

        var formData = new FormData();
        formData.append('name', name);
        formData.append('phoneNumber', phone);
        formData.append('email', email);
        formData.append('shopName', shopName);
        formData.append('shopAddress', shopAddress);
        formData.append('experienceYears', expYears);
        formData.append('city', city);
        formData.append('serviceRadiusKm', radius);
        formData.append('upiId', upi);
        formData.append('bankName', bankName);
        formData.append('accountNumber', accNo);
        formData.append('ifscCode', ifsc);
        formData.append('accountHolderName', holderName);
        formData.append('preferredPayoutMethod', payoutMethod);

        for (var i = 0; i < skills.length; i++) {
            formData.append('vehicleExpertise', skills[i]);
            formData.append('specialization', skills[i]);
        }

        var photoInput = document.getElementById('fileProfilePhotoInput');
        if (photoInput && photoInput.files && photoInput.files[0]) {
            formData.append('profilePhoto', photoInput.files[0]);
        }

        var saveBtn = $('#btnSaveProfileSettings');
        var originalBtnHtml = saveBtn.html();
        saveBtn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-2"></i> Saving Profile...');

        $.ajax({
            url: '/Mechanic/UpdateProfileSettings',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(res) {
                saveBtn.prop('disabled', false).html(originalBtnHtml);
                if (res.success) {
                    alert('✅ ' + (res.message || 'Profile & details saved successfully!'));
                    if (res.profilePhotoUrl) {
                        $('#imgProfilePreview, .glass-card img.rounded-circle').attr('src', res.profilePhotoUrl);
                    }
                    if (res.name) {
                        $('h4:contains("@user.Name"), .text-white:contains("@user.Name")').first().text(res.name);
                    }
                } else {
                    alert('❌ ' + (res.message || 'Error updating profile.'));
                }
            },
            error: function(err) {
                saveBtn.prop('disabled', false).html(originalBtnHtml);
                alert('❌ Server error updating profile. Please try again.');
            }
        });
    }

    function validateBankAccMatch() {
        var acc = ($('#txtAccountNo').val() || $('#txtMobileAccountNo').val() || '').trim();
        var confirmAcc = ($('#txtConfirmAccountNo').val() || $('#txtMobileConfirmAccountNo').val() || '').trim();
        
        if (acc && confirmAcc && acc !== confirmAcc) {
            $('#msgAccMismatchDesktop, #msgAccMismatchMobile').removeClass('d-none');
            return false;
        } else {
            $('#msgAccMismatchDesktop, #msgAccMismatchMobile').addClass('d-none');
            return true;
        }
    }

    function handlePayoutMethodChange(method) {
        syncPayoutRadio(method);
        if (method === 'UPI') {
            $('#secUpiFieldsMobile, #secUpiFieldsDesktop').removeClass('d-none');
            $('#secBankFieldsMobile, #secBankFieldsDesktop').addClass('d-none');
        } else {
            $('#secUpiFieldsMobile, #secUpiFieldsDesktop').addClass('d-none');
            $('#secBankFieldsMobile, #secBankFieldsDesktop').removeClass('d-none');
        }
    }

    function renderSavedDetailsPanel(data) {
        var html = '';
        var method = data.preferredPayoutMethod || 'UPI';
        if (method === 'UPI' && data.upiId) {
            html = '<div class="p-3 rounded-3 border border-success border-opacity-40 animate-fade-in" style="background: rgba(16, 185, 129, 0.1);">' +
                   '  <div class="d-flex align-items-center justify-content-between mb-1">' +
                   '    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 px-2 py-1 font-weight-bold" style="font-size: 0.72rem;">' +
                   '      <i class="fa-solid fa-circle-check me-1"></i> ACTIVE PAYOUT: UPI DIRECT' +
                   '    </span>' +
                   '    <span class="extra-small text-muted font-weight-medium"><i class="fa-solid fa-bolt text-warning me-1"></i> Instant Payouts</span>' +
                   '  </div>' +
