                if (res.towingCharge > 0) {
                    rowsHtml += `<tr><td>${itemNo++}</td><td>Emergency Towing Assistance Charge</td><td class="text-end font-weight-bold">₹${res.towingCharge.toFixed(2)}</td></tr>`;
