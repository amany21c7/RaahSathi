    var historyPageSize = 10;
    var historyVisibleLimit = 10;
    var historyMatchedItems = [];

    function renderHistoryPagination() {
        var totalMatched = historyMatchedItems.length;
        
        // Hide all table rows and cards first
        $('table.history-table tbody tr.history-job-row').addClass('d-none');
        $('.d-md-none .history-job-row.history-mobile-card').addClass('d-none');

        // Show items up to visible limit
        var currentlyShown = Math.min(historyVisibleLimit, totalMatched);
        for (var i = 0; i < currentlyShown; i++) {
            if (historyMatchedItems[i].tableRow) {
                $(historyMatchedItems[i].tableRow).removeClass('d-none');
            }
            if (historyMatchedItems[i].card) {
                $(historyMatchedItems[i].card).removeClass('d-none');
            }
        }

        if (totalMatched === 0) {
            $('#historyLoadMoreContainer').addClass('d-none');
            if ($('#historyNoJobsRow').length === 0) {
                $('table.history-table tbody').append('<tr id="historyNoJobsRow"><td colspan="7" class="text-center text-muted py-4">No completed jobs found for the selected date range.</td></tr>');
            } else {
                $('#historyNoJobsRow').removeClass('d-none');
            }
            $('#historyNoJobsCard').removeClass('d-none');
        } else {
            $('#historyNoJobsRow').addClass('d-none');
            $('#historyNoJobsCard').addClass('d-none');

            var $btnLoadMore = $('#btnLoadMoreHistory');
            if (currentlyShown < totalMatched) {
                $('#historyLoadMoreContainer').removeClass('d-none');
                $btnLoadMore.removeClass('disabled').prop('disabled', false)
                    .html('<i class="fa-solid fa-angles-down me-1"></i> Load More Jobs (' + (totalMatched - currentlyShown) + ' remaining)');
                $('#lblHistoryLoadedSummary').text('Showing ' + currentlyShown + ' of ' + totalMatched + ' completed jobs');
            } else {
                if (totalMatched > historyPageSize) {
                    $('#historyLoadMoreContainer').removeClass('d-none');
                    $btnLoadMore.addClass('disabled').prop('disabled', true)
                        .html('<i class="fa-solid fa-check-circle text-success me-1"></i> All ' + totalMatched + ' jobs loaded');
                    $('#lblHistoryLoadedSummary').text('Showing all ' + totalMatched + ' completed jobs');
                } else {
                    $('#historyLoadMoreContainer').addClass('d-none');
                }
            }
        }
    }

    function loadMoreHistoryJobs() {
        historyVisibleLimit += historyPageSize;
        renderHistoryPagination();
    }

    function applyHistoryDateFilter() {
        var startVal = $('#historyStartDate').val();
        var endVal = $('#historyEndDate').val();
        
        var startDate = null;
        var endDate = null;

        if (startVal) {
            startDate = new Date(startVal);
            startDate.setHours(0, 0, 0, 0);
        } else {
            // Default 1 month (30 days) ago
            startDate = new Date();
            startDate.setDate(startDate.getDate() - 30);
            startDate.setHours(0, 0, 0, 0);
        }

        if (endVal) {
            endDate = new Date(endVal);
            endDate.setHours(23, 59, 59, 999);
        } else {
            endDate = new Date();
            endDate.setHours(23, 59, 59, 999);
        }

        historyMatchedItems = [];
        historyVisibleLimit = historyPageSize;

        var $tableRows = $('table.history-table tbody tr.history-job-row');
        var $cards = $('.d-md-none .history-job-row.history-mobile-card');

        $tableRows.each(function(idx) {
            var rowDateStr = $(this).data('date');
            if (!rowDateStr) {
                rowDateStr = new Date().toISOString().split('T')[0];
            }
            var rowDate = new Date(rowDateStr);
            rowDate.setHours(0, 0, 0, 0);
            
            if (rowDate >= startDate && rowDate <= endDate) {
                historyMatchedItems.push({
                    tableRow: this,
                    card: $cards.get(idx)
                });
            }
        });

        renderHistoryPagination();
    }

    function resetHistoryDateFilter() {
        // Clear input boxes so they are blank by default
        $('#historyStartDate').val('');
        $('#historyEndDate').val('');
        
        // Show jobs from current date back 1 month (30 days)
        var oneMonthAgo = new Date();
        oneMonthAgo.setDate(oneMonthAgo.getDate() - 30);
        oneMonthAgo.setHours(0, 0, 0, 0);

        var now = new Date();
        now.setHours(23, 59, 59, 999);

        historyMatchedItems = [];
        historyVisibleLimit = historyPageSize;

        var $tableRows = $('table.history-table tbody tr.history-job-row');
        var $cards = $('.d-md-none .history-job-row.history-mobile-card');

        $tableRows.each(function(idx) {
            var rowDateStr = $(this).data('date');
            if (!rowDateStr) {
                rowDateStr = new Date().toISOString().split('T')[0];
            }
            var rowDate = new Date(rowDateStr);
            rowDate.setHours(0, 0, 0, 0);

            if (rowDate >= oneMonthAgo && rowDate <= now) {
                historyMatchedItems.push({
                    tableRow: this,
                    card: $cards.get(idx)
                });
            }
        });

        renderHistoryPagination();
    }

    $(document).ready(function() {
        $('#jobInvoiceModal').on('hidden.bs.modal', function () {
            location.reload();
        });

        if ($('#lblCardDispatchCountdown').length > 0) {
            var cardSeconds = 15;
            var cardInterval = setInterval(function() {
                cardSeconds--;
                if (cardSeconds < 0) cardSeconds = 0;
                $('#lblCardDispatchCountdown').text(cardSeconds);
