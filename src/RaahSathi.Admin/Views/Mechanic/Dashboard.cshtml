                    clearInterval(cardInterval);
                    var pingId = "@(pingJob?.Id ?? 0)";
                    if (pingId > 0 && typeof timeoutPing === 'function') {
                        timeoutPing(pingId);
                    }
                }
            }, 1000);
        }
    });

</script>
