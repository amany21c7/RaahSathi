    function saveBankDetailsOnly(btnElement) {
        var $btn = btnElement ? $(btnElement) : $('#btnSaveBankDetailsMobile');
        var originalBtnHtml = $btn.html();
        
        var payoutMethod = $('input[name="radPayoutMethodMobile"]:checked').val() || $('input[name="radPayoutMethod"]:checked').val() || 'UPI';
        var upi = ($('#txtMobileUpi').val() || $('#txtProfileUpi').val() || '').trim();
        var bankName = ($('#txtMobileBankName').val() || $('#txtBankName').val() || '').trim();
        var accNo = ($('#txtMobileAccountNo').val() || $('#txtAccountNo').val() || '').trim();
        var confirmAccNo = ($('#txtMobileConfirmAccountNo').val() || $('#txtConfirmAccountNo').val() || '').trim();
        var ifsc = ($('#txtMobileIfscCode').val() || $('#txtIfscCode').val() || '').trim();
        var holderName = ($('#txtMobileHolderName').val() || $('#txtProfileHolderName').val() || '').trim();

        // 1. Strict Validation Based on Selected Payout Method
        if (payoutMethod === 'UPI') {
            if (!upi || upi.indexOf('@@') === -1) {
                alert('⚠️ UPI ID is required when UPI Direct is selected! Please enter a valid UPI ID (e.g. 9876543210@@paytm or yourname@@okhdfcbank).');
                $('#txtMobileUpi, #txtProfileUpi').focus();
                return;
            }
        } else if (payoutMethod === 'Bank') {
            if (!holderName) {
                alert('⚠️ Account Holder Name is required! Please enter the name as per bank passbook.');
                $('#txtMobileHolderName, #txtProfileHolderName').focus();
                return;
            }
            if (!bankName) {
                alert('⚠️ Bank Name is required! Please enter your bank name (e.g. SBI, HDFC, ICICI).');
                $('#txtMobileBankName, #txtBankName').focus();
                return;
            }
            if (!accNo) {
                alert('⚠️ Bank Account Number is required! Please enter your bank account number.');
                $('#txtMobileAccountNo, #txtAccountNo').focus();
                return;
            }
            if (!confirmAccNo) {
                alert('⚠️ Please confirm your Bank Account Number in the confirm account field.');
                $('#txtMobileConfirmAccountNo, #txtConfirmAccountNo').focus();
                return;
            }
            if (accNo !== confirmAccNo) {
                alert('❌ Bank Account Number and Confirm Account Number do not match! Please check and enter the identical account number.');
                validateBankAccMatch();
                $('#txtMobileConfirmAccountNo, #txtConfirmAccountNo').focus();
                return;
            }
            if (!ifsc || ifsc.length < 5) {
                alert('⚠️ Valid IFSC Code is required! Please enter your bank IFSC (e.g. SBIN0001234).');
                $('#txtMobileIfscCode, #txtIfscCode').focus();
                return;
            }
        }

        var formData = new FormData();
        formData.append('preferredPayoutMethod', payoutMethod);
        formData.append('upiId', upi);
        formData.append('bankName', bankName);
        formData.append('accountNumber', accNo);
        formData.append('ifscCode', ifsc);
        formData.append('accountHolderName', holderName);

        $btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-2"></i> Saving Bank Details...');

        $.ajax({
            url: '/Mechanic/UpdateBankDetails',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(res) {
                $btn.prop('disabled', false).html(originalBtnHtml);
                if (res.success) {
                    alert('✅ ' + (res.message || 'Bank and payout details updated successfully!'));
                    // Sync inputs across tabs
                    $('#txtProfileUpi, #txtMobileUpi').val(res.upiId || upi);
                    $('#txtBankName, #txtMobileBankName').val(res.bankName || bankName);
                    $('#txtAccountNo, #txtMobileAccountNo').val(res.accountNumber || accNo);
                    $('#txtConfirmAccountNo, #txtMobileConfirmAccountNo').val(res.accountNumber || accNo);
                    $('#txtIfscCode, #txtMobileIfscCode').val(res.ifscCode || ifsc);
                    $('#txtProfileHolderName, #txtMobileHolderName').val(res.accountHolderName || holderName);
                    syncPayoutRadio(res.preferredPayoutMethod || payoutMethod);
                    $('#msgAccMismatchDesktop, #msgAccMismatchMobile').addClass('d-none');

                    // Update live saved payout display panel
                    renderSavedDetailsPanel(res);
                } else {
                    alert('❌ ' + (res.message || 'Error saving bank details.'));
                }
            },
            error: function() {
                $btn.prop('disabled', false).html(originalBtnHtml);
                alert('❌ Server error saving bank details. Please try again.');
            }
        });
    }

