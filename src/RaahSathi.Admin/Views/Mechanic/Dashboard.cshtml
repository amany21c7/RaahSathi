    // Dynamic Payment QR & Invoice Modal Functions
    var currentQrJobId = 0;
    var isOnlinePaymentConfirmed = false;

    function openPaymentQrModal(jobId, btnElement) {
        currentQrJobId = jobId;
        isOnlinePaymentConfirmed = false;
        
        var $btn = btnElement ? $(btnElement) : $('button[onclick*="openPaymentQrModal"]');
        var originalBtnHtml = $btn.length ? $btn.html() : '';
        if ($btn.length) {
            $btn.prop('disabled', true).html('<i class="fa-solid fa-circle-notch fa-spin me-2"></i> Opening QR...');
        }

        $('#qrCodeImg').parent().show();
        $('#qrSuccessContainer').remove();
        $('#btnConfirmQrPayment').prop('disabled', false)
                                 .html('<i class="fa-solid fa-check-circle me-2"></i> Confirm Customer Paid & Credit Wallet')
                                 .removeClass('btn-primary')
                                 .addClass('btn-success');
        
        // Instantly pop open the modal in 0ms!
        var modalEl = document.getElementById('paymentQrModal');
        var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();

        // Restore button state
        setTimeout(function() {
            if ($btn.length) { $btn.prop('disabled', false).html(originalBtnHtml); }
        }, 600);

        $.get('/Mechanic/GetJobInvoiceDetails?jobId=' + jobId + '&_t=' + Date.now(), function (res) {
            if (res && res.success) {
                $('#qrModalJobId').text('JOB #' + res.jobId);
                $('#qrModalTotalAmount').text('₹' + res.totalBillAmount.toFixed(2));
                $('#qrModalVisiting').text('₹' + res.visitingCharge.toFixed(2));
                $('#qrModalService').text('₹' + res.serviceChargeMin.toFixed(2));
                
                var extraTotal = res.customEstimateAmount + res.partsEstimateAmount + res.extraLabourCharge + res.towingCharge;
                if (extraTotal > 0) {
                    $('#qrModalExtra').text('₹' + extraTotal.toFixed(2));
                    $('#qrModalExtraRow').show();
                } else {
                    $('#qrModalExtraRow').hide();
                }

                $('#qrModalCommPct').text(res.commissionPercent.toFixed(0));
                $('#qrModalCommAmount').text(res.adminCommission.toFixed(2));
                $('#qrModalNetCredit').text('₹' + res.mechanicNetEarning.toFixed(2));

                // Generate Dynamic UPI QR Code URL
                var upiString = encodeURIComponent(`upi://pay?pa=${res.adminUpiId}&pn=${res.adminAccountHolderName}&am=${res.totalBillAmount.toFixed(2)}&cu=INR&tn=Job+RS-${res.jobId}`);
                var qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=${upiString}`;
                $('#qrCodeImg').attr('src', qrUrl);
            } else {
                alert('Could not fetch payment details.');
            }
        });
    }

    $('#btnConfirmQrPayment').click(function () {
        if (isOnlinePaymentConfirmed) {
            window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
            return;
        }
        if (!currentQrJobId) return;

        var $btn = $(this);
        var origHtml = $btn.html();
        $btn.prop('disabled', true).html('<i class="fa-solid fa-circle-notch fa-spin me-2"></i> Confirming & Crediting Wallet...');

        $.post('/Mechanic/CollectPaymentWithQr', { jobId: currentQrJobId }, function (res) {
            if (res && res.success) {
                var qrModal = bootstrap.Modal.getInstance(document.getElementById('paymentQrModal'));
                if (qrModal) qrModal.hide();

                alert(res.message);
                window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
            } else {
                $btn.prop('disabled', false).html(origHtml);
                alert(res?.message || 'Payment processing failed.');
            }
        }).fail(function() {
            window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
        });
    });

    function settleJobInCash(jobId, btnElement) {
        if (!confirm("Are you sure you collected the cash payment directly from the customer? Platform commission will be automatically debited from your wallet balance.")) {
            return;
        }

        var $btn = btnElement ? $(btnElement) : $('button[onclick*="settleJobInCash"]');
        var originalBtnHtml = $btn.length ? $btn.html() : '';
        if ($btn.length) {
            $btn.prop('disabled', true).html('<i class="fa-solid fa-circle-notch fa-spin me-1"></i> Settling Cash...');
        }

        $.post('/Mechanic/SettleCashPayment', { jobId: jobId }, function (res) {
            if (res && res.success) {
                alert(res.message);
                window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
            } else {
                if ($btn.length) { $btn.prop('disabled', false).html(originalBtnHtml); }
                alert(res?.message || 'Error processing cash settlement.');
            }
        }).fail(function() {
            window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
        });
