@{
    ViewData["Title"] = "How RaahSathi Works - Roadside Assistance in 6 Steps";
}

<div class="container py-4 py-md-5">
    <!-- Header -->
    <div class="text-center mb-5">
        <span class="badge bg-warning text-dark px-3 py-2 font-weight-bold mb-3 rounded-pill" style="font-size: 0.85rem; letter-spacing: 1px;">
            <i class="fa-solid fa-car me-1"></i> HOW RAAHSATHI WORKS
        </span>
        <h1 class="display-4 font-weight-bold text-white mb-3" style="font-family: 'Outfit', sans-serif;">
            Roadside Assistance in Just 6 Simple Steps
        </h1>
        <p class="lead text-muted max-w-700 mx-auto" style="font-size: 1.15rem; line-height: 1.6;">
            From breakdown to back on the road — fast, transparent and hassle-free.
        </p>
    </div>

    <!-- 6-Step Timeline Grid -->
    <div class="row g-4 mb-5">
        <!-- Step 1 -->
        <div class="col-md-6 col-lg-4">
            <div class="glass-card h-100 p-4 border-warning border-opacity-25 d-flex flex-column hover-lift position-relative">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="badge bg-warning text-dark font-weight-bold px-3 py-1 rounded-pill" style="font-size: 0.8rem;">Step 1</span>
                    <div class="rounded-circle bg-dark border border-warning border-opacity-50 p-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                        <i class="fa-solid fa-mobile-screen-button text-warning fa-lg"></i>
                    </div>
                </div>
                <h5 class="text-white font-weight-bold mb-2">Request Assistance</h5>
                <p class="text-muted small mb-3">Select your vehicle type, choose the problem you're facing, and share your live location.</p>
                <div class="border-top border-secondary pt-3 mt-auto">
                    <span class="text-muted d-block small mb-2 font-weight-semibold">Examples:</span>
                    <div class="d-flex flex-wrap gap-1">
                        <span class="badge bg-dark border border-secondary text-light"><i class="fa-solid fa-car text-warning me-1"></i> Flat Tyre</span>
                        <span class="badge bg-dark border border-secondary text-light"><i class="fa-solid fa-bolt text-warning me-1"></i> Battery Dead</span>
                        <span class="badge bg-dark border border-secondary text-light"><i class="fa-solid fa-wrench text-warning me-1"></i> Engine Issue</span>
                        <span class="badge bg-dark border border-secondary text-light"><i class="fa-solid fa-gas-pump text-warning me-1"></i> Fuel Delivery</span>
                        <span class="badge bg-dark border border-secondary text-light"><i class="fa-solid fa-truck-pickup text-warning me-1"></i> Towing</span>
                        <span class="badge bg-dark border border-secondary text-light"><i class="fa-solid fa-key text-warning me-1"></i> Lockout</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 2 -->
        <div class="col-md-6 col-lg-4">
            <div class="glass-card h-100 p-4 border-warning border-opacity-25 d-flex flex-column hover-lift position-relative">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="badge bg-warning text-dark font-weight-bold px-3 py-1 rounded-pill" style="font-size: 0.8rem;">Step 2</span>
                    <div class="rounded-circle bg-dark border border-warning border-opacity-50 p-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                        <i class="fa-solid fa-calculator text-warning fa-lg"></i>
                    </div>
                </div>
                <h5 class="text-white font-weight-bold mb-2">Get Instant Price Estimate</h5>
                <p class="text-muted small mb-3">Our smart pricing engine instantly calculates an estimated service cost based on:</p>
                <ul class="list-unstyled text-muted small mb-3">
                    <li class="mb-1"><i class="fa-solid fa-check text-warning me-2"></i><strong>Vehicle Type</strong></li>
                    <li class="mb-1"><i class="fa-solid fa-check text-warning me-2"></i><strong>Problem Type</strong></li>
                    <li class="mb-1"><i class="fa-solid fa-check text-warning me-2"></i><strong>Distance</strong></li>
                    <li class="mb-1"><i class="fa-solid fa-check text-warning me-2"></i><strong>Service Category</strong></li>
                </ul>
                <div class="p-2 rounded bg-dark border border-success border-opacity-50 text-center mt-auto">
                    <span class="text-success small font-weight-bold"><i class="fa-solid fa-shield-halved me-1"></i> No hidden charges. No surprises.</span>
                </div>
            </div>
        </div>

        <!-- Step 3 -->
        <div class="col-md-6 col-lg-4">
            <div class="glass-card h-100 p-4 border-warning border-opacity-25 d-flex flex-column hover-lift position-relative">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="badge bg-warning text-dark font-weight-bold px-3 py-1 rounded-pill" style="font-size: 0.8rem;">Step 3</span>
                    <div class="rounded-circle bg-dark border border-warning border-opacity-50 p-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                        <i class="fa-solid fa-user-gear text-warning fa-lg"></i>
                    </div>
                </div>
                <h5 class="text-white font-weight-bold mb-2">We Find the Best Mechanic</h5>
                <p class="text-muted small mb-3">RaahSathi automatically finds the most suitable verified mechanic near your location based on:</p>
                <div class="d-flex flex-wrap gap-1 mb-3">
                    <span class="badge bg-dark border border-info text-info">📍 Distance</span>
                    <span class="badge bg-dark border border-info text-info">🛠️ Skill &amp; Expertise</span>
                    <span class="badge bg-dark border border-info text-info">⭐ Customer Rating</span>
                    <span class="badge bg-dark border border-info text-info">🕒 Availability</span>
                    <span class="badge bg-dark border border-info text-info">⚡ Response Time</span>
                </div>
                <div class="p-2 rounded bg-dark border border-warning border-opacity-50 text-center mt-auto">
                    <span class="text-warning small font-weight-bold"><i class="fa-solid fa-user-check me-1"></i> Only verified mechanics receive your request.</span>
                </div>
            </div>
        </div>

        <!-- Step 4 -->
        <div class="col-md-6 col-lg-4">
            <div class="glass-card h-100 p-4 border-warning border-opacity-25 d-flex flex-column hover-lift position-relative">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="badge bg-warning text-dark font-weight-bold px-3 py-1 rounded-pill" style="font-size: 0.8rem;">Step 4</span>
                    <div class="rounded-circle bg-dark border border-warning border-opacity-50 p-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                        <i class="fa-solid fa-route text-warning fa-lg"></i>
                    </div>
                </div>
                <h5 class="text-white font-weight-bold mb-2">Track Your Mechanic Live</h5>
                <p class="text-muted small mb-3">Once a mechanic accepts your request, you can track their arrival in real time.</p>
                <div class="border-top border-secondary pt-3 mt-auto">
                    <span class="text-muted d-block small mb-2 font-weight-semibold">You'll also see:</span>
                    <ul class="list-unstyled text-muted small mb-0">
                        <li class="mb-1"><i class="fa-solid fa-clock text-info me-2"></i>Estimated Arrival Time</li>
                        <li class="mb-1"><i class="fa-solid fa-user me-2 text-info"></i>Mechanic Name</li>
                        <li class="mb-1"><i class="fa-solid fa-star me-2 text-warning"></i>Ratings &amp; Reviews</li>
                        <li class="mb-1"><i class="fa-solid fa-phone me-2 text-info"></i>Contact Number</li>
                        <li class="mb-1"><i class="fa-solid fa-truck-pickup me-2 text-info"></i>Vehicle Details</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Step 5 -->
        <div class="col-md-6 col-lg-4">
            <div class="glass-card h-100 p-4 border-warning border-opacity-25 d-flex flex-column hover-lift position-relative">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="badge bg-warning text-dark font-weight-bold px-3 py-1 rounded-pill" style="font-size: 0.8rem;">Step 5</span>
                    <div class="rounded-circle bg-dark border border-warning border-opacity-50 p-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                        <i class="fa-solid fa-screwdriver-wrench text-warning fa-lg"></i>
                    </div>
                </div>
                <h5 class="text-white font-weight-bold mb-2">Service at Your Location</h5>
                <p class="text-muted small mb-3">The mechanic arrives and repairs your vehicle on-site whenever possible.</p>
                <p class="text-muted small mb-3"><i class="fa-solid fa-truck-towing text-warning me-1"></i> If on-site repair isn't possible, towing assistance is arranged.</p>
                <div class="p-2 rounded bg-dark border border-secondary text-center mt-auto">
                    <span class="text-light small"><i class="fa-solid fa-circle-info text-info me-1"></i> Before any additional work starts, you'll be informed about extra costs.</span>
                </div>
            </div>
        </div>

        <!-- Step 6 -->
        <div class="col-md-6 col-lg-4">
            <div class="glass-card h-100 p-4 border-warning border-opacity-25 d-flex flex-column hover-lift position-relative">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="badge bg-warning text-dark font-weight-bold px-3 py-1 rounded-pill" style="font-size: 0.8rem;">Step 6</span>
                    <div class="rounded-circle bg-dark border border-warning border-opacity-50 p-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                        <i class="fa-solid fa-shield-heart text-warning fa-lg"></i>
                    </div>
                </div>
                <h5 class="text-white font-weight-bold mb-2">Pay Securely &amp; Rate</h5>
                <p class="text-muted small mb-2">After the service is completed:</p>
                <ul class="list-unstyled text-muted small mb-3">
                    <li class="mb-1"><i class="fa-solid fa-receipt text-success me-2"></i>Review the final bill</li>
                    <li class="mb-1"><i class="fa-solid fa-lock text-success me-2"></i>Pay securely</li>
                    <li class="mb-1"><i class="fa-solid fa-star text-warning me-2"></i>Rate your mechanic</li>
                    <li class="mb-1"><i class="fa-solid fa-comment-dots text-info me-2"></i>Share feedback or report any issue</li>
                </ul>
                <div class="p-2 rounded bg-dark border border-warning border-opacity-50 text-center mt-auto">
                    <span class="text-warning small font-weight-bold"><i class="fa-solid fa-heart me-1"></i> Your feedback helps us maintain service quality.</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ⭐ Why Choose RaahSathi? -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="glass-card p-4 p-md-5 border-warning border-opacity-30">
                <h3 class="text-white font-weight-bold text-center mb-4" style="font-family: 'Outfit', sans-serif;">
                    ⭐ Why Choose <span style="color: #ff6b00;">Raah</span><span class="text-white">Sathi</span>?
                </h3>
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-dark bg-opacity-60 rounded border border-secondary h-100 d-flex align-items-center">
                            <i class="fa-solid fa-circle-check text-success fa-lg me-2"></i>
                            <span class="text-white font-weight-semibold small">Verified Mechanics</span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-dark bg-opacity-60 rounded border border-secondary h-100 d-flex align-items-center">
                            <i class="fa-solid fa-circle-check text-success fa-lg me-2"></i>
                            <span class="text-white font-weight-semibold small">Transparent Pricing</span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-dark bg-opacity-60 rounded border border-secondary h-100 d-flex align-items-center">
                            <i class="fa-solid fa-circle-check text-success fa-lg me-2"></i>
                            <span class="text-white font-weight-semibold small">Live Tracking</span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-dark bg-opacity-60 rounded border border-secondary h-100 d-flex align-items-center">
                            <i class="fa-solid fa-circle-check text-success fa-lg me-2"></i>
                            <span class="text-white font-weight-semibold small">Quick Response</span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-dark bg-opacity-60 rounded border border-secondary h-100 d-flex align-items-center">
                            <i class="fa-solid fa-circle-check text-success fa-lg me-2"></i>
                            <span class="text-white font-weight-semibold small">24×7 Roadside Assistance</span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-dark bg-opacity-60 rounded border border-secondary h-100 d-flex align-items-center">
                            <i class="fa-solid fa-circle-check text-success fa-lg me-2"></i>
                            <span class="text-white font-weight-semibold small">Secure Payments</span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-dark bg-opacity-60 rounded border border-secondary h-100 d-flex align-items-center">
                            <i class="fa-solid fa-circle-check text-success fa-lg me-2"></i>
                            <span class="text-white font-weight-semibold small">Service History</span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 bg-dark bg-opacity-60 rounded border border-secondary h-100 d-flex align-items-center">
                            <i class="fa-solid fa-circle-check text-success fa-lg me-2"></i>
                            <span class="text-white font-weight-semibold small">Complaint Resolution</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 💡 What Makes RaahSathi Different? -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="glass-card p-4 p-md-5 border-info border-opacity-40" style="background: linear-gradient(135deg, rgba(30, 41, 59, 0.95) 0%, rgba(15, 23, 42, 0.95) 100%);">
                <div class="row align-items-center">
                    <div class="col-lg-8 text-start">
                        <h3 class="text-white font-weight-bold mb-3" style="font-family: 'Outfit', sans-serif;">
                            💡 What Makes <span style="color: #ff6b00;">Raah</span><span class="text-white">Sathi</span> Different?
                        </h3>
                        <p class="text-light mb-3" style="line-height: 1.7;">
                            Unlike traditional roadside services, RaahSathi doesn't simply assign the nearest mechanic.
                        </p>
                        <p class="text-muted small mb-3">Our intelligent dispatch system matches you with the right mechanic based on:</p>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="badge bg-dark border border-warning text-warning px-3 py-2">🚗 Vehicle category</span>
                            <span class="badge bg-dark border border-warning text-warning px-3 py-2">🛠️ Required expertise</span>
                            <span class="badge bg-dark border border-warning text-warning px-3 py-2">⚡ Response time</span>
                            <span class="badge bg-dark border border-warning text-warning px-3 py-2">📍 Distance</span>
                            <span class="badge bg-dark border border-warning text-warning px-3 py-2">⭐ Customer ratings</span>
                            <span class="badge bg-dark border border-warning text-warning px-3 py-2">🕒 Availability</span>
                        </div>
                        <p class="text-warning font-weight-bold mb-0">
                            <i class="fa-solid fa-bolt me-1"></i> This means faster arrival, better repairs, and a more reliable experience.
                        </p>
                    </div>
                    <div class="col-lg-4 text-center mt-4 mt-lg-0">
                        <div class="p-4 rounded-circle bg-warning bg-opacity-10 border border-warning d-inline-block">
                            <i class="fa-solid fa-brain text-warning" style="font-size: 4rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 🎯 Bottom Section (Call to Action) -->
    <div class="row">
        <div class="col-12 text-center">
            <div class="p-4 p-md-5 rounded-3 border border-warning border-opacity-50" style="background: linear-gradient(135deg, rgba(245, 158, 11, 0.2) 0%, rgba(30, 41, 59, 0.9) 100%); backdrop-filter: blur(10px); box-shadow: 0 10px 30px rgba(245, 158, 11, 0.15);">
                <h3 class="display-6 font-weight-bold text-white mb-2" style="font-family: 'Outfit', sans-serif;">Need Help Right Now?</h3>
                <p class="lead text-muted mb-4">Don't let a breakdown ruin your journey. Request assistance now and get connected with a verified mechanic in minutes.</p>
                <a href="/Customer/Book" class="btn btn-premium-primary btn-lg px-5 py-3 font-weight-bold shadow-lg" style="font-size: 1.15rem;">
                    <i class="fa-solid fa-car me-2"></i> Request Assistance
                </a>
            </div>
        </div>
    </div>
</div>
