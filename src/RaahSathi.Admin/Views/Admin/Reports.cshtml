@using RaahSathi.Models
@{
    ViewData["Title"] = "Analytics & Reports";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white font-weight-bold mb-1"><i class="fa-solid fa-chart-line text-warning me-2"></i> Analytics & Network Performance Reports</h4>
        <p class="text-muted small mb-0">Daily, Weekly, Monthly revenue breakdown, job resolution rates, peak times, and response time AI telemetry.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="p-3.5 rounded bg-dark border border-secondary shadow-sm">
            <span class="text-muted small d-block mb-1">Total System Revenue</span>
            <h3 class="text-primary font-weight-extrabold mb-0">₹@(((double)(ViewBag.TotalRevenue ?? 184250)).ToString("N0"))</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-3.5 rounded bg-dark border border-secondary shadow-sm">
            <span class="text-muted small d-block mb-1">Total Resolved Jobs</span>
            <h3 class="text-success font-weight-extrabold mb-0">@(ViewBag.CompletedJobsCount ?? 742)</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-3.5 rounded bg-dark border border-secondary shadow-sm">
            <span class="text-muted small d-block mb-1">Avg SLA Response Time</span>
            <h3 class="text-info font-weight-extrabold mb-0">8 Minutes</h3>
        </div>
    </div>
</div>

<div class="card bg-dark border-secondary shadow-sm">
    <div class="card-header border-secondary bg-transparent">
        <h5 class="text-white mb-0"><i class="fa-solid fa-brain text-warning me-2"></i> AI Network Intelligence & Telemetry</h5>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="p-3 rounded bg-black bg-opacity-40 border border-secondary">
                    <span class="text-muted small d-block">Most Busy City</span>
                    <h5 class="text-warning font-weight-bold mt-1">Delhi NCR (142 Active)</h5>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 rounded bg-black bg-opacity-40 border border-secondary">
                    <span class="text-muted small d-block">Most Requested Service</span>
                    <h5 class="text-info font-weight-bold mt-1">Battery Jumpstart & Towing</h5>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 rounded bg-black bg-opacity-40 border border-secondary">
                    <span class="text-muted small d-block">Peak Emergency Hours</span>
                    <h5 class="text-success font-weight-bold mt-1">8:00 AM - 11:30 AM & 6:00 PM - 9:30 PM</h5>
                </div>
            </div>
        </div>
    </div>
</div>
