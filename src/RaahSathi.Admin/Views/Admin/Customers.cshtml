@using RaahSathi.Models
@using System.Text.Encodings.Web
@model List<User>
@{
    ViewData["Title"] = "Customer Management - Admin Console";
    var vehicles = ViewBag.Vehicles as List<Vehicle> ?? new List<Vehicle>();
    var jobs = ViewBag.Jobs as List<Job> ?? new List<Job>();
    var cities = ViewBag.Cities as List<string> ?? new List<string>();

    int totalCust = ViewBag.TotalCustomers as int? ?? Model.Count;
    int activeCust = ViewBag.ActiveCustomers as int? ?? Model.Count(u => !u.IsBlocked);
    int pendingCust = ViewBag.PendingCustomers as int? ?? 0;
    int blockedCust = ViewBag.BlockedCustomers as int? ?? Model.Count(u => u.IsBlocked);
    int newTodayCust = ViewBag.NewTodayCustomers as int? ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <span class="badge bg-warning text-dark font-weight-bold px-3 py-1 mb-2">SYSTEM CONSOLE</span>
        <h4 class="text-white font-weight-bold mb-1"><i class="fa-solid fa-users text-warning me-2"></i> Customer Management</h4>
        <p class="text-muted small mb-0">View registered customers, vehicles, booking history, ratings, and account status.</p>
    </div>
</div>

<!-- Top Real-Time KPI Summary Cards -->
<div class="row g-3 mb-4">
    <!-- Total Customers -->
    <div class="col-6 col-md-4 col-xl">
        <div class="p-3 rounded-3 bg-dark border border-secondary border-opacity-40 shadow-sm position-relative overflow-hidden h-100" style="background: linear-gradient(135deg, rgba(30, 41, 59, 0.6), rgba(15, 23, 42, 0.8));">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted text-uppercase font-weight-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Total Customers</span>
                <div class="rounded-circle p-1.5 bg-primary bg-opacity-15 text-primary d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                    <i class="fa-solid fa-users fs-6"></i>
                </div>
            </div>
            <h3 class="text-white font-weight-bold mb-0" id="kpiTotalCustomers">@totalCust.ToString("N0")</h3>
            <small class="text-muted" style="font-size: 0.72rem;"><i class="fa-solid fa-database me-1 text-primary"></i> Registered Database</small>
        </div>
    </div>

    <!-- Active Customers -->
    <div class="col-6 col-md-4 col-xl">
        <div class="p-3 rounded-3 bg-dark border border-secondary border-opacity-40 shadow-sm position-relative overflow-hidden h-100" style="background: linear-gradient(135deg, rgba(30, 41, 59, 0.6), rgba(15, 23, 42, 0.8));">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted text-uppercase font-weight-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Active</span>
                <div class="rounded-circle p-1.5 bg-success bg-opacity-15 text-success d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                    <i class="fa-solid fa-circle-check fs-6"></i>
                </div>
            </div>
            <h3 class="text-success font-weight-bold mb-0" id="kpiActiveCustomers">@activeCust.ToString("N0")</h3>
            <small class="text-muted" style="font-size: 0.72rem;"><i class="fa-solid fa-bolt me-1 text-success"></i> Verified &amp; Active</small>
        </div>
    </div>

    <!-- Pending Verification -->
    <div class="col-6 col-md-4 col-xl">
        <div class="p-3 rounded-3 bg-dark border border-secondary border-opacity-40 shadow-sm position-relative overflow-hidden h-100" style="background: linear-gradient(135deg, rgba(30, 41, 59, 0.6), rgba(15, 23, 42, 0.8));">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted text-uppercase font-weight-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Pending Verification</span>
                <div class="rounded-circle p-1.5 bg-warning bg-opacity-15 text-warning d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                    <i class="fa-solid fa-clock-rotate-left fs-6"></i>
                </div>
            </div>
            <h3 class="text-warning font-weight-bold mb-0" id="kpiPendingCustomers">@pendingCust.ToString("N0")</h3>
            <small class="text-muted" style="font-size: 0.72rem;"><i class="fa-solid fa-triangle-exclamation me-1 text-warning"></i> Profile setup pending</small>
        </div>
    </div>

    <!-- Blocked -->
    <div class="col-6 col-md-4 col-xl">
        <div class="p-3 rounded-3 bg-dark border border-secondary border-opacity-40 shadow-sm position-relative overflow-hidden h-100" style="background: linear-gradient(135deg, rgba(30, 41, 59, 0.6), rgba(15, 23, 42, 0.8));">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted text-uppercase font-weight-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Blocked</span>
                <div class="rounded-circle p-1.5 bg-danger bg-opacity-15 text-danger d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                    <i class="fa-solid fa-user-slash fs-6"></i>
                </div>
            </div>
            <h3 class="text-danger font-weight-bold mb-0" id="kpiBlockedCustomers">@blockedCust.ToString("N0")</h3>
            <small class="text-muted" style="font-size: 0.72rem;"><i class="fa-solid fa-ban me-1 text-danger"></i> Restricted access</small>
        </div>
    </div>

    <!-- New Today -->
    <div class="col-6 col-md-4 col-xl">
        <div class="p-3 rounded-3 bg-dark border border-secondary border-opacity-40 shadow-sm position-relative overflow-hidden h-100" style="background: linear-gradient(135deg, rgba(30, 41, 59, 0.6), rgba(15, 23, 42, 0.8));">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="text-muted text-uppercase font-weight-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">New Today</span>
                <div class="rounded-circle p-1.5 bg-info bg-opacity-15 text-info d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                    <i class="fa-solid fa-calendar-plus fs-6"></i>
                </div>
            </div>
            <h3 class="text-info font-weight-bold mb-0" id="kpiNewTodayCustomers">@newTodayCust.ToString("N0")</h3>
            <small class="text-muted" style="font-size: 0.72rem;"><i class="fa-solid fa-sparkles me-1 text-info"></i> Joined Today</small>
        </div>
    </div>
</div>

<!-- Compact Single-Row Filter Bar (No Scrollbar, Inline Icon Buttons) -->
<div class="card bg-dark border-secondary shadow-sm mb-3">
    <div class="card-body p-2">
        <div class="d-flex align-items-center flex-nowrap gap-2 w-100">
            <!-- Search Text -->
            <div class="input-group input-group-sm flex-shrink-0" style="width: 130px;">
                <span class="input-group-text bg-black bg-opacity-50 border-secondary text-muted px-2" style="height: 32px;"><i class="fa-solid fa-magnifying-glass" style="font-size: 0.72rem;"></i></span>
                <input type="text" id="custSearchFilter" class="form-control bg-dark text-white border-secondary px-2" placeholder="ID, Name, Phone..." style="height: 32px; font-size: 0.75rem;" oninput="applyCustomerFilters()">
            </div>

            <!-- Status Filter -->
            <div class="d-flex align-items-center gap-1.5 bg-black bg-opacity-40 px-2 py-1 rounded border border-secondary flex-shrink-0" style="height: 32px;">
                <span class="text-muted" style="font-size: 0.7rem;"><i class="fa-solid fa-circle-dot text-warning me-1"></i>Status:</span>
                <select id="filterStatus" class="form-select form-select-sm bg-transparent border-0 text-white p-0" style="width: 88px; outline: none; font-size: 0.73rem;" onchange="applyCustomerFilters()">
                    <option value="All" class="bg-dark text-white">All Statuses</option>
                    <option value="Active" class="bg-dark text-white">Active</option>
                    <option value="Pending" class="bg-dark text-white">Pending</option>
                    <option value="Blocked" class="bg-dark text-white">Blocked</option>
                </select>
            </div>

            <!-- City Filter -->
            <div class="d-flex align-items-center gap-1.5 bg-black bg-opacity-40 px-2 py-1 rounded border border-secondary flex-shrink-0" style="height: 32px;">
                <span class="text-muted" style="font-size: 0.7rem;"><i class="fa-solid fa-location-dot text-info me-1"></i>City:</span>
                <select id="filterCity" class="form-select form-select-sm bg-transparent border-0 text-white p-0" style="width: 80px; outline: none; font-size: 0.73rem;" onchange="applyCustomerFilters()">
                    <option value="All" class="bg-dark text-white">All Cities</option>
                    <option value="Delhi NCR" class="bg-dark text-white">Delhi NCR</option>
                    <option value="Noida" class="bg-dark text-white">Noida</option>
                    <option value="Lucknow" class="bg-dark text-white">Lucknow</option>
                    <option value="Jaipur" class="bg-dark text-white">Jaipur</option>
                    <option value="Mumbai" class="bg-dark text-white">Mumbai</option>
                    @foreach (var c in cities)
                    {
                        if (c != "Delhi NCR" && c != "Noida" && c != "Lucknow" && c != "Jaipur" && c != "Mumbai")
                        {
                            <option value="@c" class="bg-dark text-white">@c</option>
                        }
                    }
                </select>
            </div>

            <!-- Two Separate Date Pickers: From & To -->
            <div class="d-flex align-items-center gap-1.5 bg-black bg-opacity-40 px-2 py-1 rounded border border-secondary flex-shrink-0" style="height: 32px; cursor: pointer;" onclick="document.getElementById('filterFromDate').showPicker?.() || document.getElementById('filterFromDate').focus();">
                <span class="text-muted" style="font-size: 0.7rem;"><i class="fa-solid fa-calendar-days text-warning me-1"></i>From:</span>
                <input type="date" id="filterFromDate" class="form-control form-control-sm bg-transparent border-0 text-white p-0" style="width: 90px; outline: none; font-size: 0.73rem; color-scheme: dark; cursor: pointer;" onchange="applyCustomerFilters()">
            </div>

            <div class="d-flex align-items-center gap-1.5 bg-black bg-opacity-40 px-2 py-1 rounded border border-secondary flex-shrink-0" style="height: 32px; cursor: pointer;" onclick="document.getElementById('filterToDate').showPicker?.() || document.getElementById('filterToDate').focus();">
                <span class="text-muted" style="font-size: 0.7rem;"><i class="fa-solid fa-calendar-days text-warning me-1"></i>To:</span>
                <input type="date" id="filterToDate" class="form-control form-control-sm bg-transparent border-0 text-white p-0" style="width: 90px; outline: none; font-size: 0.73rem; color-scheme: dark; cursor: pointer;" onchange="applyCustomerFilters()">
            </div>

            <!-- Vehicle Type Filter -->
            <div class="d-flex align-items-center gap-1.5 bg-black bg-opacity-40 px-2 py-1 rounded border border-secondary flex-shrink-0" style="height: 32px;">
                <span class="text-muted" style="font-size: 0.7rem;"><i class="fa-solid fa-car text-warning me-1"></i>Vehicle:</span>
                <select id="filterVehicleType" class="form-select form-select-sm bg-transparent border-0 text-white p-0" style="width: 80px; outline: none; font-size: 0.73rem;" onchange="applyCustomerFilters()">
                    <option value="All" class="bg-dark text-white">All Types</option>
                    <option value="Car" class="bg-dark text-white">Car</option>
                    <option value="2-Wheeler" class="bg-dark text-white">2-Wheeler</option>
                    <option value="Commercial" class="bg-dark text-white">Commercial</option>
                    <option value="Heavy" class="bg-dark text-white">Heavy</option>
                    <option value="None" class="bg-dark text-white">No Vehicle</option>
                </select>
            </div>

            <!-- Search & Reset Icon Buttons Inline -->
            <div class="d-flex align-items-center gap-1.5 ms-auto flex-shrink-0">
                <button type="button" class="btn btn-warning btn-sm p-0 text-dark font-weight-bold d-inline-flex align-items-center justify-content-center" onclick="applyCustomerFilters()" title="Search / Apply Filter" style="height: 32px; width: 32px; font-size: 0.78rem;">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm p-0 text-light border-secondary shadow-sm d-inline-flex align-items-center justify-content-center" onclick="resetCustomerFilters()" title="Reset All Filters" style="height: 32px; width: 32px; font-size: 0.78rem;">
                    <i class="fa-solid fa-arrow-rotate-left"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Customer Grid Table -->
<div class="card bg-dark border-secondary shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle" id="customersTable">
                <thead>
                    <tr class="border-secondary text-muted small">
                        <th class="ps-3">ID &amp; Customer</th>
                        <th>Phone Number</th>
                        <th>Registered</th>
                        <th>Registered Vehicles</th>
                        <th>Total Jobs</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr class="no-data-row">
                            <td colspan="7" class="text-center py-4 text-muted">No customers registered yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var c in Model)
                        {
                            var custVehicles = vehicles.Where(v => v.UserId == c.Id).ToList();
                            var custJobs = jobs.Where(j => j.CustomerId == c.Id).ToList();
                            var vehicleListStr = custVehicles.Any() 
                                ? string.Join(", ", custVehicles.Select(v => $"{v.Model} ({v.RegistrationNumber})"))
                                : "No vehicles registered";
                            
                            var vehicleTypes = custVehicles.Select(v => v.VehicleType ?? "Car").Distinct().ToList();
                            var vehicleTypesAttr = custVehicles.Any() ? string.Join(",", vehicleTypes) : "None";

                            // Latest job city or address for city filtering
                            var latestJob = custJobs.OrderByDescending(j => j.CreatedAt).FirstOrDefault();
                            var custCity = latestJob?.Address ?? "";

                            string statusCategory = c.IsBlocked ? "Blocked" 
                                                  : (custVehicles.Any() || custJobs.Any()) ? "Active" 
                                                  : "Pending";
                            
                            <tr class="border-secondary cust-row"
                                data-id="@c.DisplayId.ToLower()"
                                data-name="@(c.Name?.ToLower() ?? "")"
                                data-phone="@(c.PhoneNumber ?? "")"
                                data-status="@statusCategory"
                                data-city="@custCity.ToLower()"
                                data-created="@c.CreatedAt.ToString("yyyy-MM-dd")"
                                data-vehicletypes="@vehicleTypesAttr.ToLower()">
                                
                                <td class="ps-3">
                                    <div class="font-weight-bold text-white">@(c.Name ?? "Customer")</div>
                                    <span class="badge bg-warning text-dark font-weight-bold" style="font-size:0.68rem;">@c.DisplayId</span>
                                </td>
                                <td class="text-light">@(c.PhoneNumber ?? "N/A")</td>
                                <td>
                                    <div class="text-light font-weight-medium small">@c.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    <small class="text-muted" style="font-size: 0.7rem;">@c.CreatedAt.ToLocalTime().ToString("hh:mm tt")</small>
                                </td>
                                <td>
                                    @if (custVehicles.Count > 0)
                                    {
                                        @foreach (var v in custVehicles)
                                        {
                                            <span class="badge bg-secondary text-light me-1 mb-1" style="font-size: 0.72rem;">
                                                <i class="fa-solid fa-car-side text-warning me-1"></i>@v.Model (@v.RegistrationNumber)
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark text-muted border border-secondary" style="font-size: 0.7rem;">No vehicles</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark font-weight-bold">@custJobs.Count Jobs</span>
                                </td>
                                <td>
                                    @if (c.IsBlocked)
                                    {
                                        <span class="badge bg-danger text-white"><i class="fa-solid fa-ban me-1"></i>BLOCKED</span>
                                    }
                                    else if (custVehicles.Count > 0 || custJobs.Count > 0)
                                    {
                                        <span class="badge bg-success text-white"><i class="fa-solid fa-circle-check me-1"></i>ACTIVE</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i>PENDING</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-flex justify-content-end gap-1.5">
                                        <button class="btn btn-sm btn-outline-warning font-weight-bold" onclick="showCustDetails('@c.DisplayId', '@Html.Raw(JavaScriptEncoder.Default.Encode(c.Name ?? "Customer"))', '@(c.PhoneNumber ?? "N/A")', '@custJobs.Count', '@custVehicles.Count', '@statusCategory', '@Html.Raw(JavaScriptEncoder.Default.Encode(vehicleListStr))', '@c.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")')">
                                            <i class="fa-solid fa-eye me-1"></i> Details
                                        </button>
                                        <button class="btn btn-sm @(c.IsBlocked ? "btn-outline-success" : "btn-outline-danger") font-weight-bold" onclick="toggleUserBlock(@c.Id)">
                                            <i class="fa-solid @(c.IsBlocked ? "fa-unlock" : "fa-ban") me-1"></i> @(c.IsBlocked ? "Unblock" : "Block")
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Customer Details Modal -->
<div class="modal fade" id="custDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary text-white shadow-lg">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-warning font-weight-bold"><i class="fa-solid fa-user me-2 text-warning"></i> Customer Profile Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="p-3 bg-secondary bg-opacity-20 rounded border border-secondary mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong class="text-warning fs-5" id="lblDetName"></strong>
                        <span class="badge bg-warning text-dark font-weight-bold" id="lblDetId"></span>
                    </div>
                    <div class="d-flex justify-content-between text-muted small">
                        <span><i class="fa-solid fa-phone me-1 text-info"></i> <span id="lblDetPhone"></span></span>
                        <span><i class="fa-regular fa-calendar me-1 text-warning"></i> <span id="lblDetRegDate"></span></span>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="p-2.5 rounded bg-black bg-opacity-50 border border-secondary text-center">
                            <span class="text-muted small d-block">Assistance Jobs</span>
                            <strong class="text-info fs-5" id="lblDetJobs">0</strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2.5 rounded bg-black bg-opacity-50 border border-secondary text-center">
                            <span class="text-muted small d-block">Vehicles Count</span>
                            <strong class="text-info fs-5" id="lblDetVehicles">0</strong>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small font-weight-bold">Status</label>
                    <div id="lblDetStatus"></div>
                </div>

                <div class="mb-0">
                    <label class="form-label text-muted small font-weight-bold">Registered Vehicle Listing</label>
                    <div class="p-3 bg-black bg-opacity-50 rounded border border-secondary text-light small" id="lblDetVehList" style="max-height: 120px; overflow-y: auto; line-height: 1.6;">
                    </div>
                </div>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function applyCustomerFilters() {
        var query = $('#custSearchFilter').val().toLowerCase().trim();
        var status = $('#filterStatus').val();
        var city = $('#filterCity').val().toLowerCase().trim();
        var fromDate = $('#filterFromDate').val();
        var toDate = $('#filterToDate').val();
        var vehicleType = $('#filterVehicleType').val().toLowerCase().trim();

        var matches = 0;

        $('.cust-row').each(function () {
            var row = $(this);
            var id = row.data('id') || '';
            var name = row.data('name') || '';
            var phone = (row.data('phone') || '').toString();
            var rowStatus = row.data('status') || '';
            var rowCity = row.data('city') || '';
            var created = row.data('created') || '';
            var vTypes = (row.data('vehicletypes') || '').toLowerCase();

            // Search text check (ID, Name, Phone)
            var matchQuery = (query === "") || (id.indexOf(query) > -1 || name.indexOf(query) > -1 || phone.indexOf(query) > -1);

            // Status check
            var matchStatus = (status === "All") || (rowStatus === status);

            // City check
            var matchCity = (city === "all") || (rowCity.indexOf(city) > -1);

            // Date Range check
            var matchDate = true;
            if (fromDate && created < fromDate) matchDate = false;
            if (toDate && created > toDate) matchDate = false;

            // Vehicle Type check
            var matchVehicle = (vehicleType === "all") || 
                               (vehicleType === "none" && vTypes.indexOf("none") > -1) ||
                               (vTypes.indexOf(vehicleType) > -1);

            if (matchQuery && matchStatus && matchCity && matchDate && matchVehicle) {
                row.show();
                matches++;
            } else {
                row.hide();
            }
        });

        if (matches === 0) {
            if ($('.no-data-row').length === 0) {
                $('#customersTable tbody').append('<tr class="no-data-row"><td colspan="7" class="text-center py-4 text-muted">No matching customers found.</td></tr>');
            } else {
                $('.no-data-row').show().find('td').text('No matching customers found.');
            }
        } else {
            $('.no-data-row').hide();
        }
    }

    function resetCustomerFilters() {
        $('#custSearchFilter').val('');
        $('#filterStatus').val('All');
        $('#filterCity').val('All');
        $('#filterFromDate').val('');
        $('#filterToDate').val('');
        $('#filterVehicleType').val('All');
        applyCustomerFilters();
    }

    // Real-Time KPI Stats Poller (every 4 seconds)
    function pollCustomerKPIs() {
        $.get('/Admin/GetCustomerStats', function (res) {
            if (res && res.success) {
                $('#kpiTotalCustomers').text(Number(res.total).toLocaleString());
                $('#kpiActiveCustomers').text(Number(res.active).toLocaleString());
                $('#kpiPendingCustomers').text(Number(res.pending).toLocaleString());
                $('#kpiBlockedCustomers').text(Number(res.blocked).toLocaleString());
                $('#kpiNewTodayCustomers').text(Number(res.newToday).toLocaleString());
            }
        });
    }

    $(document).ready(function () {
        pollCustomerKPIs();
        setInterval(pollCustomerKPIs, 15000);
    });

    function showCustDetails(id, name, phone, jobsCount, vehiclesCount, status, vehiclesList, regDate) {
        $('#lblDetId').text(id);
        $('#lblDetName').text(name);
        $('#lblDetPhone').text(phone);
        $('#lblDetRegDate').text(regDate || 'N/A');
        $('#lblDetJobs').text(jobsCount);
        $('#lblDetVehicles').text(vehiclesCount);
        
        var statusHtml = status === 'Active' 
            ? '<span class="badge bg-success"><i class="fa-solid fa-circle-check me-1"></i> ACTIVE</span>'
            : status === 'Blocked'
            ? '<span class="badge bg-danger"><i class="fa-solid fa-ban me-1"></i> BLOCKED</span>'
            : '<span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i> PENDING VERIFICATION</span>';
        $('#lblDetStatus').html(statusHtml);

        $('#lblDetVehList').text(vehiclesList);

        var modal = new bootstrap.Modal(document.getElementById('custDetailsModal'));
        modal.show();
    }

    function toggleUserBlock(userId) {
        $.post('/Admin/ToggleUserBlock', { userId: userId }, function (res) {
            if (res && res.success) {
                location.reload();
            } else {
                alert(res.message || 'Action failed.');
            }
        });
    }
</script>
}
