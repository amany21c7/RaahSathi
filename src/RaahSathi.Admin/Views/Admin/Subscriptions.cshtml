@model RaahSathi.Models.AdminSubscriptionsPageViewModel
@{
    ViewData["Title"] = "Mechanic Subscriptions & Membership";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h4 class="text-white font-weight-bold mb-1">
            <i class="fa-solid fa-crown text-warning me-2"></i> Mechanic Monthly Subscription &amp; VIP Club Controls
        </h4>
        <p class="text-muted small mb-0">Manage platform monthly subscription rules, auto-enforcement eligibility, and monitor mechanic payment compliance.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge @(Model.IsMasterEnabled ? "bg-success" : "bg-danger") px-3 py-2 font-weight-bold" style="font-size: 0.85rem;">
            <i class="fa-solid @(Model.IsMasterEnabled ? "fa-circle-check" : "fa-circle-xmark") me-1.5"></i>
            @(Model.IsMasterEnabled ? "SYSTEM ACTIVE (ENFORCED)" : "SYSTEM DISABLED (FREE FOR ALL)")
        </span>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show bg-success bg-opacity-20 border-success text-white mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show bg-danger bg-opacity-20 border-danger text-white mb-4" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
    </div>
}

<!-- 1. Master Configuration Panel -->
<div class="card bg-dark border-secondary shadow-lg mb-4">
    <div class="card-header border-secondary bg-transparent py-3 d-flex justify-content-between align-items-center">
        <h5 class="text-warning mb-0 font-weight-bold">
            <i class="fa-solid fa-sliders me-2"></i> Subscription Plan &amp; Enforcement Rules
        </h5>
        <span class="badge bg-warning text-dark font-weight-bold px-2 py-1">Rule Engine</span>
    </div>
    <div class="card-body p-3 p-sm-4">
        <form action="/Admin/SaveSubscriptionSettings" method="POST">
            <div class="row g-3 align-items-center">
                <!-- Master Toggle Switch -->
                <div class="col-lg-3 col-md-6">
                    <div class="p-3 rounded-3 bg-black bg-opacity-40 border @(Model.IsMasterEnabled ? "border-success" : "border-secondary") h-100">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" role="switch" id="chkSubscriptionEnabled" name="isMasterEnabled" value="true" @(Model.IsMasterEnabled ? "checked" : "") style="cursor: pointer; width: 2.5em; height: 1.25em;">
                            <label class="form-check-label text-white font-weight-bold ms-2" for="chkSubscriptionEnabled">
                                Master Switch
                            </label>
                        </div>
                        <small class="text-muted d-block" style="font-size: 0.76rem;">
                            When ON, mechanics with &ge; 30 days &amp; &ge; 2 jobs must have an active subscription to go Online.
                        </small>
                    </div>
                </div>

                <!-- Monthly Price Input -->
                <div class="col-lg-3 col-md-6">
                    <div class="p-3 rounded-3 bg-black bg-opacity-40 border border-warning border-opacity-40 h-100">
                        <label class="form-label text-light small font-weight-bold mb-1.5">
                            <i class="fa-solid fa-indian-rupee-sign text-warning me-1"></i> Monthly Subscription Fee
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-secondary bg-opacity-30 text-warning font-weight-bold border-secondary">₹</span>
                            <input type="number" name="monthlyFee" step="1" min="0" max="99999" class="form-control bg-dark text-warning font-weight-bold border-secondary" value="@Model.MonthlyFee" required placeholder="499">
                            <span class="input-group-text bg-secondary bg-opacity-30 text-muted border-secondary">/ Month</span>
                        </div>
                    </div>
                </div>

                <!-- Free Trial Days -->
                <div class="col-lg-3 col-md-6">
                    <div class="p-3 rounded-3 bg-black bg-opacity-40 border border-info border-opacity-40 h-100">
                        <label class="form-label text-light small font-weight-bold mb-1.5">
                            <i class="fa-solid fa-gift text-info me-1"></i> New Mechanic Free Trial
                        </label>
                        <div class="input-group input-group-sm">
                            <input type="number" name="freeTrialDays" step="1" min="1" max="365" class="form-control bg-dark text-info font-weight-bold border-secondary" value="@Model.FreeTrialDays" required placeholder="30">
                            <span class="input-group-text bg-secondary bg-opacity-30 text-muted border-secondary">Days</span>
                        </div>
                    </div>
                </div>

                <!-- Min Jobs Required -->
                <div class="col-lg-3 col-md-6">
                    <div class="p-3 rounded-3 bg-black bg-opacity-40 border border-primary border-opacity-40 h-100">
                        <label class="form-label text-light small font-weight-bold mb-1.5">
                            <i class="fa-solid fa-briefcase text-primary me-1"></i> Min Completed Jobs Threshold
                        </label>
                        <div class="input-group input-group-sm">
                            <input type="number" name="minJobsRequired" step="1" min="1" max="50" class="form-control bg-dark text-primary font-weight-bold border-secondary" value="@Model.MinJobsRequired" required placeholder="2">
                            <span class="input-group-text bg-secondary bg-opacity-30 text-muted border-secondary">Jobs</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-3 d-flex justify-content-end">
                <button type="submit" class="btn btn-warning text-dark font-weight-bold px-3 py-1.5 shadow-sm">
                    <i class="fa-solid fa-floppy-disk me-1.5"></i> Save Rules
                </button>
            </div>
        </form>
    </div>
</div>

<!-- 1.5 Location / City Search & Filter Bar -->
<div class="card bg-dark border-secondary shadow-sm mb-4">
    <div class="card-body p-3">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-location-dot text-danger fs-5"></i>
                <div>
                    <span class="text-white font-weight-bold d-block" style="font-size: 0.88rem;">Filter by Location / City</span>
                    <small class="text-muted">
                        @if (Model.SelectedCity == "all")
                        {
                            <span>Showing all mechanics nationwide across India.</span>
                        }
                        else
                        {
                            <span>Filtered by: <strong class="text-warning">@Model.SelectedCity</strong> (@Model.TotalMechanics mechanics found)</span>
                        }
                    </small>
                </div>
                @if (Model.SelectedCity != "all")
                {
                    <a href="/Admin/Subscriptions?city=all&status=@Model.StatusFilter&page=1&pageSize=@Model.PageSize" 
                       class="btn btn-sm btn-outline-danger ms-2 py-1 px-2.5 font-weight-bold" style="font-size: 0.75rem;">
                        <i class="fa-solid fa-xmark me-1"></i> Reset to All India
                    </a>
                }
            </div>

            <!-- Instant Search by Location / City Input -->
            <div style="min-width: 320px; max-width: 450px;" class="w-100 w-md-auto">
                <form method="GET" action="/Admin/Subscriptions" class="input-group input-group-sm">
                    <input type="hidden" name="status" value="@Model.StatusFilter" />
                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                    <span class="input-group-text bg-black bg-opacity-50 border-secondary text-warning">
                        <i class="fa-solid fa-magnifying-glass-location"></i>
                    </span>
                    <input type="text" name="city" class="form-control bg-dark text-white border-secondary" 
                           placeholder="Enter City name (e.g. Noida, Delhi, Jaipur)..." 
                           value="@(Model.SelectedCity == "all" ? "" : Model.SelectedCity)" 
                           style="font-size: 0.82rem;">
                    <button type="submit" class="btn btn-warning text-dark font-weight-bold px-3">
                        <i class="fa-solid fa-filter me-1"></i> Search
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- 2. Summary KPI Counter Cards (Updated with City-Specific Stats) -->
<div class="row g-3 mb-4">
    <!-- Card 1: Active Subscribers -->
    <div class="col-6 col-md-4 col-xl">
        <div class="card bg-dark border-success border-opacity-40 shadow-sm h-100">
            <div class="card-body p-3 text-center">
                <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-40 mb-1" style="font-size: 0.68rem;">
                    <i class="fa-solid fa-shield-halved me-1"></i> ACTIVE VIP
                </span>
                <h2 class="text-success font-weight-bold mb-0">@Model.ActiveSubscribersCount</h2>
                <span class="text-muted extra-small">@(Model.SelectedCity == "all" ? "Subscribed Mechanics" : $"Subscribed in {Model.SelectedCity}")</span>
            </div>
        </div>
    </div>

    <!-- Card 2: Free Trial -->
    <div class="col-6 col-md-4 col-xl">
        <div class="card bg-dark border-info border-opacity-40 shadow-sm h-100">
            <div class="card-body p-3 text-center">
                <span class="badge bg-info bg-opacity-20 text-info border border-info border-opacity-40 mb-1" style="font-size: 0.68rem;">
                    <i class="fa-solid fa-gift me-1"></i> TRIAL (&lt; @Model.FreeTrialDays d)
                </span>
                <h2 class="text-info font-weight-bold mb-0">@Model.FreeTrialCount</h2>
                <span class="text-muted extra-small">@(Model.SelectedCity == "all" ? "New Mechanics" : $"New in {Model.SelectedCity}")</span>
            </div>
        </div>
    </div>

    <!-- Card 3: Subscription Due -->
    <div class="col-6 col-md-4 col-xl">
        <div class="card bg-dark border-danger border-opacity-40 shadow-sm h-100">
            <div class="card-body p-3 text-center">
                <span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-40 mb-1" style="font-size: 0.68rem;">
                    <i class="fa-solid fa-clock-rotate-left me-1"></i> DUE / EXPIRED
                </span>
                <h2 class="text-danger font-weight-bold mb-0">@Model.DueCount</h2>
                <span class="text-muted extra-small">Action Required</span>
            </div>
        </div>
    </div>

    <!-- Card 4: Exempt (< 2 Jobs) -->
    <div class="col-6 col-md-4 col-xl">
        <div class="card bg-dark border-secondary border-opacity-60 shadow-sm h-100">
            <div class="card-body p-3 text-center">
                <span class="badge bg-secondary bg-opacity-30 text-light border border-secondary mb-1" style="font-size: 0.68rem;">
                    <i class="fa-solid fa-user-clock me-1"></i> EXEMPT (&lt; @Model.MinJobsRequired Jobs)
                </span>
                <h2 class="text-white font-weight-bold mb-0">@Model.ExemptCount</h2>
                <span class="text-muted extra-small">30+ Days, &lt; @Model.MinJobsRequired Jobs</span>
            </div>
        </div>
    </div>

    <!-- Card 5: Revenue -->
    <div class="col-12 col-md-4 col-xl">
        <div class="card bg-dark border-warning border-opacity-40 shadow-sm h-100">
            <div class="card-body p-3 text-center">
                <span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-40 mb-1" style="font-size: 0.68rem;">
                    <i class="fa-solid fa-coins me-1"></i> TOTAL REVENUE
                </span>
                <h2 class="text-warning font-weight-bold mb-0">₹@Model.TotalSubscriptionRevenue.ToString("N0")</h2>
                <span class="text-muted extra-small">@(Model.SelectedCity == "all" ? "All Locations Revenue" : $"{Model.SelectedCity} Revenue")</span>
            </div>
        </div>
    </div>
</div>

<!-- 3. Filterable Mechanics Subscription Roster -->
<div class="card bg-dark border-secondary shadow-sm mb-4">
    <div class="card-header border-secondary bg-transparent py-3">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h5 class="text-white mb-0 font-weight-bold">
                    <i class="fa-solid fa-users-gear text-warning me-2"></i> Mechanic Subscription Status &amp; Compliance Roster
                    @if (Model.SelectedCity != "all")
                    {
                        <span class="badge bg-info text-dark font-weight-bold ms-2" style="font-size: 0.75rem;">
                            <i class="fa-solid fa-map-pin me-1"></i> @Model.SelectedCity
                        </span>
                    }
                </h5>
                <small class="text-muted">Live audit of trial, job history, and subscription compliance @(Model.SelectedCity == "all" ? "across all India" : $"in {Model.SelectedCity}").</small>
            </div>
            
            <!-- Filter Pills -->
            <div class="d-flex align-items-center flex-wrap gap-1.5">
                <a href="/Admin/Subscriptions?city=@Model.SelectedCity&status=all&page=1&pageSize=@Model.PageSize" class="btn btn-sm @(Model.StatusFilter == "all" ? "btn-warning active font-weight-bold" : "btn-outline-warning")">All (@Model.TotalMechanics)</a>
                <a href="/Admin/Subscriptions?city=@Model.SelectedCity&status=active&page=1&pageSize=@Model.PageSize" class="btn btn-sm @(Model.StatusFilter == "active" ? "btn-success active font-weight-bold" : "btn-outline-success")">Active (@Model.ActiveSubscribersCount)</a>
                <a href="/Admin/Subscriptions?city=@Model.SelectedCity&status=trial&page=1&pageSize=@Model.PageSize" class="btn btn-sm @(Model.StatusFilter == "trial" ? "btn-info active font-weight-bold text-dark" : "btn-outline-info")">Free Trial (@Model.FreeTrialCount)</a>
                <a href="/Admin/Subscriptions?city=@Model.SelectedCity&status=due&page=1&pageSize=@Model.PageSize" class="btn btn-sm @(Model.StatusFilter == "due" ? "btn-danger active font-weight-bold" : "btn-outline-danger")">Due / Expired (@Model.DueCount)</a>
                <a href="/Admin/Subscriptions?city=@Model.SelectedCity&status=exempt&page=1&pageSize=@Model.PageSize" class="btn btn-sm @(Model.StatusFilter == "exempt" ? "btn-secondary active font-weight-bold text-white" : "btn-outline-secondary")">Exempt (@Model.ExemptCount)</a>
            </div>
        </div>
    </div>
    
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0" id="tblMechanicSubscriptions">
                <thead class="text-muted small border-bottom border-secondary border-opacity-40" style="font-size: 0.78rem;">
                    <tr>
                        <th class="ps-3 py-3">Mechanic Details</th>
                        <th>Joined &amp; Age</th>
                        <th>Completed Jobs</th>
                        <th>Subscription Status</th>
                        <th>Validity Till</th>
                        <th>Total Paid</th>
                        <th class="pe-3 text-end">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-800">
                    @if (!Model.Mechanics.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-user-slash fa-2x mb-2 opacity-50"></i>
                                <p class="mb-0">No registered mechanics found for this filter.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var m in Model.Mechanics)
                    {
                        <tr class="mech-row" data-status="@m.Status">
                            <td class="ps-3 py-3">
                                <div class="d-flex align-items-center gap-2.5">
                                    <div class="avatar-circle bg-secondary bg-opacity-30 text-warning font-weight-bold d-flex align-items-center justify-content-center rounded-circle" style="width: 38px; height: 38px; font-size: 0.85rem;">
                                        @m.MechanicName.FirstOrDefault()
                                    </div>
                                    <div>
                                        <span class="text-white font-weight-bold d-block" style="font-size: 0.9rem;">@m.MechanicName</span>
                                        <span class="text-muted extra-small font-monospace">@m.PhoneNumber &bull; <strong class="text-info">@m.City</strong></span>
                                        @if (!string.IsNullOrWhiteSpace(m.ShopName))
                                        {
                                             <span class="text-muted extra-small d-block text-truncate" style="max-width: 180px;">@m.ShopName</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="text-light small d-block font-weight-bold">@m.DaysSinceJoined days ago</span>
                                <span class="text-muted extra-small font-monospace">@m.RegisteredAt.ToString("dd MMM yyyy")</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge @(m.CompletedJobsCount >= Model.MinJobsRequired ? "bg-success bg-opacity-20 text-success border border-success" : "bg-warning bg-opacity-20 text-warning border border-warning") font-weight-bold" style="font-size: 0.75rem;">
                                        <i class="fa-solid fa-briefcase me-1"></i> @m.CompletedJobsCount Jobs
                                    </span>
                                    @if (m.CompletedJobsCount < Model.MinJobsRequired)
                                    {
                                        <span class="text-muted extra-small" title="Need @(Model.MinJobsRequired - m.CompletedJobsCount) more job(s) for subscription enforcement">
                                            (@(Model.MinJobsRequired - m.CompletedJobsCount) more needed)
                                        </span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (m.Status == "Active")
                                {
                                    <span class="badge bg-success text-dark font-weight-bold px-2.5 py-1.5" style="font-size: 0.72rem;">
                                        <i class="fa-solid fa-crown text-warning me-1"></i> ACTIVE VIP
                                    </span>
                                }
                                else if (m.Status == "Trial")
                                {
                                    <span class="badge bg-info bg-opacity-20 text-info border border-info px-2.5 py-1.5" style="font-size: 0.72rem;">
                                        <i class="fa-solid fa-gift me-1"></i> FREE TRIAL (@m.RemainingTrialDays d left)
                                    </span>
                                }
                                else if (m.Status == "Exempt")
                                {
                                    <span class="badge bg-secondary bg-opacity-30 text-light border border-secondary px-2.5 py-1.5" style="font-size: 0.72rem;" title="30+ days joined, but less than @Model.MinJobsRequired completed jobs">
                                        <i class="fa-solid fa-shield-halved me-1"></i> EXEMPT (&lt; @Model.MinJobsRequired Jobs)
                                    </span>
                                }
                                else if (m.Status == "Due")
                                {
                                    <span class="badge bg-danger text-white font-weight-bold px-2.5 py-1.5" style="font-size: 0.72rem;">
                                        <i class="fa-solid fa-triangle-exclamation me-1"></i> SUBSCRIPTION DUE
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-dark border border-secondary text-muted px-2.5 py-1.5" style="font-size: 0.72rem;">
                                        FREE / UNRESTRICTED
                                    </span>
                                }
                            </td>
                            <td>
                                @if (m.ValidTill.HasValue && m.ValidTill.Value > DateTime.UtcNow)
                                {
                                    <span class="text-success small font-weight-bold d-block">@m.ValidTill.Value.ToString("dd MMM yyyy")</span>
                                    <span class="text-muted extra-small">@((int)(m.ValidTill.Value - DateTime.UtcNow).TotalDays) days remaining</span>
                                }
                                else if (m.ValidTill.HasValue)
                                {
                                    <span class="text-danger small font-weight-bold d-block">Expired (@m.ValidTill.Value.ToString("dd MMM yyyy"))</span>
                                }
                                else
                                {
                                    <span class="text-muted small">&mdash;</span>
                                }
                            </td>
                            <td>
                                <span class="text-warning font-weight-bold small">₹@m.AmountPaidTotal.ToString("N0")</span>
                            </td>
                            <td class="pe-3 text-end">
                                <button type="button" class="btn btn-outline-warning btn-sm font-weight-bold" onclick="openGrantModal(@m.MechanicId, '@m.MechanicName')" style="font-size: 0.75rem;">
                                    <i class="fa-solid fa-plus-circle me-1"></i> Grant / Extend
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalRecords > 0)
    {
        <div class="card-footer border-secondary bg-black bg-opacity-20 py-3 px-3 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small">
                    Showing <strong class="text-white">@((Model.CurrentPage - 1) * Model.PageSize + 1)</strong> to <strong class="text-white">@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalRecords))</strong> of <strong class="text-warning">@Model.TotalRecords</strong> mechanics
                </span>
                <div class="d-flex align-items-center gap-1.5">
                    <span class="text-muted extra-small">Per Page:</span>
                    <select class="form-select form-select-sm bg-dark text-white border-secondary" style="width: 85px; height: 31px; font-size: 0.78rem;" onchange="window.location.href='/Admin/Subscriptions?city=@Model.SelectedCity&status=@Model.StatusFilter&page=1&pageSize=' + this.value">
                        <option value="25" selected="@(Model.PageSize == 25)">25</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                        <option value="100" selected="@(Model.PageSize == 100)">100</option>
                        <option value="200" selected="@(Model.PageSize == 200)">200</option>
                    </select>
                </div>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Mechanics page navigation">
                    <ul class="pagination pagination-sm mb-0 gap-1">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link bg-dark text-white border-secondary" href="/Admin/Subscriptions?city=@Model.SelectedCity&status=@Model.StatusFilter&page=@(Model.CurrentPage - 1)&pageSize=@Model.PageSize">
                                <i class="fa-solid fa-chevron-left"></i> Prev
                            </a>
                        </li>
                        
                        @{
                            int startPage = Math.Max(1, Model.CurrentPage - 2);
                            int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                        }

                        @if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link bg-dark text-white border-secondary" href="/Admin/Subscriptions?city=@Model.SelectedCity&status=@Model.StatusFilter&page=1&pageSize=@Model.PageSize">1</a>
                            </li>
                            @if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link bg-dark text-muted border-secondary">&hellip;</span></li>
                            }
                        }

                        @for (int p = startPage; p <= endPage; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link @(p == Model.CurrentPage ? "bg-warning text-dark border-warning font-weight-bold" : "bg-dark text-white border-secondary")" href="/Admin/Subscriptions?city=@Model.SelectedCity&status=@Model.StatusFilter&page=@p&pageSize=@Model.PageSize">@p</a>
                            </li>
                        }

                        @if (endPage < Model.TotalPages)
                        {
                            @if (endPage < Model.TotalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link bg-dark text-muted border-secondary">&hellip;</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link bg-dark text-white border-secondary" href="/Admin/Subscriptions?city=@Model.SelectedCity&status=@Model.StatusFilter&page=@Model.TotalPages&pageSize=@Model.PageSize">@Model.TotalPages</a>
                            </li>
                        }

                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link bg-dark text-white border-secondary" href="/Admin/Subscriptions?city=@Model.SelectedCity&status=@Model.StatusFilter&page=@(Model.CurrentPage + 1)&pageSize=@Model.PageSize">
                                Next <i class="fa-solid fa-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
</div>

<!-- 4. Recent Subscription Transactions Table -->
<div class="card bg-dark border-secondary shadow-sm">
    <div class="card-header border-secondary bg-transparent py-3">
        <h5 class="text-white mb-0 font-weight-bold">
            <i class="fa-solid fa-receipt text-warning me-2"></i> Recent Subscription Payment Ledger
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="text-muted small border-bottom border-secondary border-opacity-40" style="font-size: 0.78rem;">
                    <tr>
                        <th class="ps-3 py-3">Transaction Date</th>
                        <th>Mechanic ID &amp; Name</th>
                        <th>Amount</th>
                        <th>Validity Period</th>
                        <th>Status</th>
                        <th>Gateway Ref / Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentTransactions.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted small">
                                No subscription transactions recorded yet.
                            </td>
                        </tr>
                    }
                    @foreach (var tx in Model.RecentTransactions)
                    {
                        <tr>
                            <td class="ps-3 text-muted small">@tx.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td class="text-white font-weight-bold">
                                @(tx.Mechanic?.Name ?? $"Mechanic #{tx.MechanicId}")
                            </td>
                            <td class="text-warning font-weight-bold">₹@tx.Amount.ToString("N2")</td>
                            <td class="text-light small">
                                @tx.StartDate.ToString("dd MMM") &mdash; @tx.EndDate.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                <span class="badge @(tx.PaymentStatus == "Success" ? "bg-success" : (tx.PaymentStatus == "ManualGrant" ? "bg-info" : "bg-warning")) text-dark font-weight-bold" style="font-size: 0.68rem;">
                                    @tx.PaymentStatus
                                </span>
                            </td>
                            <td class="text-muted extra-small font-monospace">
                                @(tx.RazorpayPaymentId ?? tx.Notes ?? "Direct Grant")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Grant / Extend Mechanic Subscription -->
<div class="modal fade" id="grantSubscriptionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-warning">
            <div class="modal-header border-secondary bg-black bg-opacity-30">
                <h5 class="modal-title text-warning font-weight-bold">
                    <i class="fa-solid fa-gift me-2"></i> Grant / Extend Subscription
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/Admin/GrantMechanicSubscription" method="POST">
                <div class="modal-body p-4">
                    <input type="hidden" id="grantMechId" name="mechanicId" value="">
                    
                    <div class="p-3 rounded-3 bg-black bg-opacity-40 border border-secondary mb-3">
                        <span class="text-muted small d-block">Target Mechanic:</span>
                        <strong class="text-white fs-6" id="grantMechName">Mechanic</strong>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small font-weight-bold">Select Extension Period</label>
                        <select name="daysToAdd" class="form-select bg-dark text-white border-secondary">
                            <option value="30" selected>+30 Days (1 Month Free / Manual Grant)</option>
                            <option value="60">+60 Days (2 Months)</option>
                            <option value="90">+90 Days (Quarterly / 3 Months)</option>
                            <option value="365">+365 Days (Annual / 1 Year)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small font-weight-bold">Admin Remarks / Reason</label>
                        <input type="text" name="notes" class="form-control bg-dark text-white border-secondary" placeholder="e.g. Free bonus granted by Admin / Offline payment received" value="Admin Manual VIP Grant">
                    </div>
                </div>
                <div class="modal-footer border-secondary bg-black bg-opacity-30">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning text-dark font-weight-bold px-4">
                        <i class="fa-solid fa-check me-1"></i> Apply Extension
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function filterMechanics(status, btn) {
        document.querySelectorAll('#tblMechanicSubscriptions tbody tr.mech-row').forEach(row => {
            if (status === 'all' || row.getAttribute('data-status') === status) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
        
        btn.parentElement.querySelectorAll('button').forEach(b => {
            b.classList.remove('active');
        });
        btn.classList.add('active');
    }

    function openGrantModal(mechId, mechName) {
        document.getElementById('grantMechId').value = mechId;
        document.getElementById('grantMechName').innerText = mechName;
        new bootstrap.Modal(document.getElementById('grantSubscriptionModal')).show();
    }
</script>
