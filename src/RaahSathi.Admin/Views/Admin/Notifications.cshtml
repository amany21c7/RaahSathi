@using RaahSathi.Models
@using System.Text.Encodings.Web
@model List<PushNotificationLog>
@{
    ViewData["Title"] = "Push Broadcast Announcements - Admin Console";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white font-weight-bold mb-1"><i class="fa-solid fa-bell text-warning me-2"></i> Push Broadcast System</h4>
        <p class="text-muted small mb-0">Broadcast instant targeted notifications to Customers, Mechanics, specific Cities, or All Users.</p>
    </div>
    <button type="button" class="btn btn-warning text-dark font-weight-bold" data-bs-toggle="modal" data-bs-target="#sendNotifModal">
        <i class="fa-solid fa-paper-plane me-1"></i> Send Push Notification
    </button>
</div>

<div class="card bg-dark border-secondary shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr class="border-secondary text-muted small">
                        <th class="ps-3">Sent Time</th>
                        <th>Target Audience</th>
                        <th>City Filter</th>
                        <th>Title</th>
                        <th>Message Content</th>
                        <th>Expires At</th>
                        <th>Devices Reached</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">No push notifications broadcasted yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var n in Model)
                        {
                            <tr class="border-secondary">
                                <td class="ps-3 text-muted small">@n.SentAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                                <td><span class="badge bg-info text-dark">@n.TargetAudience</span></td>
                                <td><span class="badge bg-secondary text-light">@n.SelectedCity</span></td>
                                <td class="font-weight-bold text-white">@n.Title</td>
                                <td class="text-muted small">@n.Message</td>
                                <td class="text-muted small">
                                    @(n.ExpiresAt.HasValue ? n.ExpiresAt.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm") : "Never")
                                </td>
                                <td>
                                    <span class="badge bg-success text-white">@n.SentCount Devices</span>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-flex justify-content-end gap-1.5">
                                        <!-- Edit Action -->
                                        <button class="btn btn-sm btn-outline-warning" title="Edit Announcement"
                                                onclick="openEditNotifModal(@n.Id, '@Html.Raw(JavaScriptEncoder.Default.Encode(n.TargetAudience))', '@Html.Raw(JavaScriptEncoder.Default.Encode(n.SelectedCity))', '@Html.Raw(JavaScriptEncoder.Default.Encode(n.Title))', '@Html.Raw(JavaScriptEncoder.Default.Encode(n.Message))', '@(n.ExpiresAt?.ToString("yyyy-MM-ddTHH:mm"))')">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                        <!-- Close / Delete Action -->
                                        <form action="/Admin/DeletePushNotification" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete/stop this broadcast announcement?');">
                                            <input type="hidden" name="id" value="@n.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="End Announcement / Delete">
                                                <i class="fa-solid fa-rectangle-xmark"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Send Push Notification -->
<div class="modal fade" id="sendNotifModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-warning font-weight-bold"><i class="fa-solid fa-paper-plane me-1.5"></i> Broadcast Announcement</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/Admin/SendPushNotification" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-muted small">Target Audience</label>
                        <select name="targetAudience" class="form-select glass-input text-white">
                            <option value="All Users">All Users (Customers & Partners)</option>
                            <option value="Customers">Customers Only</option>
                            <option value="Mechanics">Mechanics / Partners Only</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">City Filter</label>
                        <select name="selectedCity" class="form-select glass-input text-white">
                            <option value="All">All India Cities</option>
                            <option value="Delhi NCR">Delhi NCR</option>
                            <option value="Lucknow">Lucknow</option>
                            <option value="Jaipur">Jaipur</option>
                            <option value="Mumbai">Mumbai</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Notification Title</label>
                        <input type="text" name="title" class="form-control glass-input text-white" placeholder="e.g. Rainy Weather Surge Warning / 20% Discount" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Message Text</label>
                        <textarea name="message" class="form-control glass-input text-white" rows="3" placeholder="Enter message text..." required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Expires At (Optional - Date & Time until this notification is active)</label>
                        <input type="datetime-local" name="expiresAt" class="form-control glass-input text-white">
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="submit" class="btn btn-warning text-dark font-weight-bold w-100">Broadcast Push Now</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Edit Push Notification -->
<div class="modal fade" id="editNotifModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border border-warning shadow-lg">
            <div class="modal-header border-warning bg-warning bg-opacity-10 text-warning">
                <h5 class="modal-title font-weight-bold"><i class="fa-solid fa-pen-to-square me-2"></i> Modify Broadcast Announcement</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/Admin/UpdatePushNotification" method="POST">
                <div class="modal-body">
                    <input type="hidden" name="id" id="editNotifId" />
                    
                    <div class="mb-3">
                        <label class="form-label text-muted small">Target Audience</label>
                        <select name="targetAudience" id="editNotifAudience" class="form-select bg-dark text-white border-secondary">
                            <option value="All Users">All Users (Customers & Partners)</option>
                            <option value="Customers">Customers Only</option>
                            <option value="Mechanics">Mechanics / Partners Only</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">City Filter</label>
                        <select name="selectedCity" id="editNotifCity" class="form-select bg-dark text-white border-secondary">
                            <option value="All">All India Cities</option>
                            <option value="Delhi NCR">Delhi NCR</option>
                            <option value="Lucknow">Lucknow</option>
                            <option value="Jaipur">Jaipur</option>
                            <option value="Mumbai">Mumbai</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Notification Title</label>
                        <input type="text" name="title" id="editNotifTitle" class="form-control bg-dark text-white border-secondary" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Message Text</label>
                        <textarea name="message" id="editNotifMessage" class="form-control bg-dark text-white border-secondary" rows="3" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Expires At (Optional - Date & Time until this notification is active)</label>
                        <input type="datetime-local" name="expiresAt" id="editNotifExpiresAt" class="form-control bg-dark text-white border-secondary">
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning text-dark font-weight-bold px-4">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openEditNotifModal(id, audience, city, title, message, expiresAt) {
        $('#editNotifId').val(id);
        $('#editNotifAudience').val(audience);
        $('#editNotifCity').val(city);
        $('#editNotifTitle').val(decodeURIComponent(title));
        $('#editNotifMessage').val(decodeURIComponent(message));
        
        if (expiresAt) {
            $('#editNotifExpiresAt').val(expiresAt);
        } else {
            $('#editNotifExpiresAt').val('');
        }
        
        var modal = new bootstrap.Modal(document.getElementById('editNotifModal'));
        modal.show();
    }
</script>
}
