@using RaahSathi.Models
@inject RaahSathi.Data.ApplicationDbContext _dbContext
@inject RaahSathi.Services.IPaymentService PaymentService
@{
    ViewData["Title"] = "Mechanic Control Hub";
    var user = ViewBag.User as User ?? new User();
    var profile = ViewBag.Profile as MechanicProfile ?? new MechanicProfile();
    var activeJob = ViewBag.ActiveJob as Job;
    var pingJob = ViewBag.PingJob as Job;
    var pastJobs = ViewBag.PastJobs as List<Job> ?? new List<Job>();
    var activeWarning = ViewBag.ActiveWarning as MechanicWarning;
    var supportMessages = ViewBag.SupportMessages as List<MechanicSupportMessage> ?? new List<MechanicSupportMessage>();
    int unreadSupport = ViewBag.UnreadSupportCount as int? ?? 0;
    var refSummary = ViewBag.ReferralSummary as RaahSathi.Services.ReferralDashboardSummaryDto;
    var refSettings = ViewBag.ReferralSettings as ReferralProgramSetting ?? refSummary?.Settings ?? new ReferralProgramSetting();

    var now = DateTime.UtcNow;
    var mechanicBanners = _dbContext.CmsBanners
        .Where(b => b.IsActive 
                 && (b.TargetPage == "Mechanic Dashboard" || b.TargetPage == "Homepage")
                 && (b.TargetAudience == "All Users" || b.TargetAudience == "Mechanics")
                 && (b.ExpiresAt == null || b.ExpiresAt > now))
        .OrderByDescending(b => b.Id)
        .ToList();
}


<style>
    /* Professional Mechanic Operating Control Styling */
    .mech-stat-card {
        background: rgba(18, 31, 53, 0.85);
        border: 1px solid rgba(255, 107, 0, 0.2);
        border-radius: 12px;
        padding: 16px;
        transition: all 0.25s ease;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    }
    .mech-stat-card:hover {
        border-color: rgba(255, 107, 0, 0.5);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(255, 107, 0, 0.15);
    }
    .status-stage-step {
        flex: 1;
        text-align: center;
        padding: 10px 4px;
        font-size: 0.78rem;
        font-weight: 600;
        border-radius: 8px;
        background: #0f172a;
        color: #64748b;
        border: 1px solid #1e293b;
        transition: all 0.25s ease;
    }
    .status-stage-step.active {
        background: linear-gradient(135deg, #ff7e15 0%, #e04f00 100%);
        color: #ffffff !important;
        border-color: #ff6b00;
        box-shadow: 0 4px 12px rgba(255, 107, 0, 0.4);
    }
    .status-stage-step.completed {
        background: rgba(16, 185, 129, 0.15);
        color: #10b981;
        border-color: rgba(16, 185, 129, 0.4);
    }
    .dispatch-timer-circle {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: #0a1324;
        border: 3px solid #ef4444;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        font-weight: 800;
        color: #ef4444;
        animation: pulseTimer 1s infinite alternate;
    }
    @@keyframes pulseTimer {
        from { transform: scale(1); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4); }
        to { transform: scale(1.08); box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
    }
    .mech-tab-btn {
        padding: 10px 18px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.9rem;
        color: #94a3b8;
        border: 1px solid transparent;
        background: transparent;
        transition: all 0.2s ease;
    }
    .mech-tab-btn:hover {
        color: #ffffff;
        background: rgba(255, 107, 0, 0.1);
    }
    .mech-tab-btn.active {
        background: linear-gradient(135deg, #ff7e15 0%, #e04f00 100%) !important;
        color: #ffffff !important;
        box-shadow: 0 4px 14px rgba(255, 107, 0, 0.35);
    }
    .smart-score-pill {
        background: linear-gradient(135deg, #059669 0%, #10b981 100%);
        color: #ffffff;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 3px 10px rgba(16, 185, 129, 0.3);
    }
    .bottom-mech-nav {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(10, 19, 36, 0.96);
        backdrop-filter: blur(15px);
        border-top: 1.5px solid rgba(255, 107, 0, 0.3);
        z-index: 1040;
        padding: 8px 12px;
    }

    /* Print Styles for Mechanic Invoice */
    @@media print {
        body * {
            visibility: hidden;
        }
        #jobInvoiceModal, #jobInvoiceModal * {
            visibility: visible;
        }
        #jobInvoiceModal {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            margin: 0;
            padding: 0;
            border: none !important;
            box-shadow: none !important;
            background: #fff !important;
            color: #000 !important;
        }
        #mechInvoicePrintArea, #mechInvoicePrintArea * {
            visibility: visible;
        }
        #mechInvoicePrintArea {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            background: #fff !important;
            color: #000 !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .d-print-none, .modal-header, .btn-close {
            display: none !important;
        }
        .bg-dark, .bg-black, .bg-opacity-80, .bg-opacity-40 {
            background: #fff !important;
            color: #000 !important;
            border: 1px solid #ccc !important;
        }
        .text-light, .text-muted, .text-warning, .text-info, .text-success, .text-white-50 {
            color: #000 !important;
        }
        .table-dark {
            background-color: #fff !important;
            color: #000 !important;
        }
        .table-dark th, .table-dark td {
            border: 1px solid #000 !important;
            color: #000 !important;
        }
        .badge {
            border: 1px solid #000 !important;
            color: #000 !important;
            background: #eee !important;
        }
    }
</style>

<div class="container-fluid px-2 px-md-4 py-3 pb-5 mb-5">

    @if (mechanicBanners.Count > 0)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div id="mechanicDashboardCarousel" class="carousel slide" data-bs-ride="carousel" style="border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.45); border: 1px solid rgba(255,255,255,0.06);">
                    <div class="carousel-inner">
                        @for (int i = 0; i < mechanicBanners.Count; i++)
                        {
                            var b = mechanicBanners[i];
                            <div class="carousel-item @(i == 0 ? "active" : "")" style="height: 180px; position: relative;">
                                <img src="@b.ImageUrl" class="d-block w-100 h-100" style="object-fit: cover; filter: brightness(0.45) contrast(1.1);" alt="@b.Title">
                                <div class="carousel-caption d-flex flex-column align-items-start justify-content-center text-start h-100" style="left: 6%; right: 6%; bottom: 0; padding-top: 0; padding-bottom: 0;">
                                    <span class="badge bg-warning text-dark font-weight-bold px-3 py-1 mb-2" style="font-size: 0.7rem; letter-spacing: 0.5px;">PARTNER UPDATE / ANNOUNCEMENT</span>
                                    <h3 class="text-white font-weight-bold mb-1" style="font-family: 'Outfit'; font-size: 1.62rem; text-shadow: 0 2px 4px rgba(0,0,0,0.8);">@b.Title</h3>
                                    <p class="text-muted small mb-0 d-none d-sm-block" style="color: #e2e8f0 !important; text-shadow: 0 1px 2px rgba(0,0,0,0.8);">Keep your status Active to receive instant breakdown requests.</p>
                                </div>
                            </div>
                        }
                    </div>
                    @if (mechanicBanners.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#mechanicDashboardCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#mechanicDashboardCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Active Official Warning Banner from Admin -->
    @if (activeWarning != null)
    {
        <div class="alert alert-danger bg-dark border-danger text-light p-3 mb-4 rounded-3 d-flex align-items-center justify-content-between shadow-lg">
            <div class="d-flex align-items-center gap-3">
                <i class="fa-solid fa-triangle-exclamation text-danger fa-2x"></i>
                <div>
                    <h6 class="text-danger mb-0 font-weight-bold">⚠️ Official Safety Warning from Operations Admin</h6>
                    <p class="mb-0 small text-muted">@activeWarning.Message</p>
                </div>
            </div>
            <button class="btn btn-danger btn-sm px-3 font-weight-bold" onclick="ackWarning(@activeWarning.Id)">
                <i class="fa-solid fa-check me-1"></i> Acknowledge
            </button>
        </div>
    }

    <!-- 🟢 TOP STATS HEADER & GO ONLINE CONTROLLER -->
    <div class="glass-card mb-4 p-3 p-md-4 border-warning border-opacity-30">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-3 border-bottom border-secondary border-opacity-40 pb-3">
            <div class="d-flex align-items-center gap-3">
                <img src="@(string.IsNullOrEmpty(profile.ProfilePhotoUrl) ? "/images/default_avatar.png" : profile.ProfilePhotoUrl)" class="rounded-circle border border-warning" style="width: 52px; height: 52px; object-fit: cover;" />
                <div>
                    <h4 class="text-white font-weight-bold mb-0" style="font-family: 'Outfit';">@user.Name</h4>
                    <div class="d-flex align-items-center gap-2 mt-1">
                        <span class="badge @(profile.IsOnline ? "bg-success text-white" : "bg-secondary text-light") rounded-pill px-3 py-1 font-weight-bold" id="badgeOnlineStatus">
                            <i class="fa-solid fa-circle me-1" style="font-size:0.6rem;"></i> @(profile.IsOnline ? "🟢 ONLINE" : "⚪ OFFLINE")
                        </span>
                        <span class="text-muted small">| <i class="fa-solid fa-shield-halved text-warning me-1"></i> KYC: <b>@profile.KycStatus</b></span>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="form-check form-switch me-2 fs-5 d-flex align-items-center gap-2">
                    <input class="form-check-input" type="checkbox" role="switch" id="toggleOnlineSwitch" @(profile.IsOnline ? "checked" : "") onclick="toggleMechanicOnlineState()">
                    <label class="form-check-label text-white small font-weight-bold" for="toggleOnlineSwitch" id="lblSwitchOnline">
                        @(profile.IsOnline ? "Status: Online" : "Status: Offline")
                    </label>
                </div>
                <button class="btn btn-premium-primary btn-sm rounded-pill px-4" onclick="switchMechTab('tab-home')">
                    <i class="fa-solid fa-house me-1"></i> Home
                </button>
                <button class="btn btn-premium-secondary btn-sm rounded-pill px-3" onclick="switchMechTab('tab-requests')">
                    <i class="fa-solid fa-bell me-1"></i> Requests (@(pingJob != null ? 1 : 0))
                </button>
                <button class="btn btn-premium-secondary btn-sm rounded-pill px-3" onclick="switchMechTab('tab-jobs')">
                    <i class="fa-solid fa-wrench me-1"></i> My Jobs
                </button>
                <button class="btn btn-premium-secondary btn-sm rounded-pill px-3" onclick="switchMechTab('tab-wallet')">
                    <i class="fa-solid fa-wallet me-1"></i> Earnings
                </button>
                <button type="button" class="btn btn-warning btn-sm rounded-pill px-3 font-weight-bold text-dark shadow-sm" onclick="openMechanicReferralModal()">
                    <i class="fa-solid fa-gift me-1"></i> Refer &amp; Earn <span class="badge bg-dark text-warning ms-1">₹@(refSummary?.ReferralWalletBalance.ToString("N0") ?? "0")</span>
                </button>
                <button class="btn btn-outline-info btn-sm rounded-pill px-3 position-relative" onclick="switchMechTab('tab-support')">
                    <i class="fa-solid fa-inbox me-1"></i> Support Inbox
                    @if (unreadSupport > 0)
                    {
                        <span class="badge bg-danger rounded-circle ms-1">@unreadSupport</span>
                    }
                </button>
                <button class="btn btn-premium-secondary btn-sm rounded-pill px-3" onclick="switchMechTab('tab-profile')">
                    <i class="fa-solid fa-user-gear me-1"></i> Profile
                </button>
            </div>
        </div>

        <!-- 5-Box Professional Metrics Grid -->
        <div class="row g-2 g-md-3">
            <div class="col-6 col-md">
                <div class="mech-stat-card text-center">
                    <span class="text-muted small d-block mb-1 font-weight-medium">Today's Earnings</span>
                    <h3 class="text-success font-weight-extrabold mb-0" id="topTodayEarnings" style="font-family: 'Outfit';">₹@(((double)ViewBag.TodayEarnings).ToString("N0"))</h3>
                </div>
            </div>
            <div class="col-6 col-md">
                <div class="mech-stat-card text-center">
                    <div class="d-flex align-items-center justify-content-center gap-1 mb-1">
                        <select id="jobStatRangeSelect" class="bg-transparent border-0 text-muted small font-weight-medium p-0 text-center" style="outline: none; cursor: pointer; color: #a0aec0 !important; width: 100px; -webkit-appearance: none; -moz-appearance: none; appearance: none;">
                            <option value="today" class="bg-dark text-light">Today's Jobs</option>
                            <option value="weekly" class="bg-dark text-light">Weekly Jobs</option>
                        </select>
                        <i class="fa-solid fa-chevron-down text-muted" style="font-size:0.6rem;"></i>
                    </div>
                    <h3 class="text-warning font-weight-extrabold mb-0" id="topJobsCount" style="font-family: 'Outfit';">@ViewBag.TodayJobsCount</h3>
                </div>
            </div>
            <div class="col-6 col-md">
                <div class="mech-stat-card text-center">
                    <span class="text-muted small d-block mb-1 font-weight-medium">Pending Requests</span>
                    <h3 class="text-info font-weight-extrabold mb-0" style="font-family: 'Outfit';">@(pingJob != null ? 1 : 0)</h3>
                </div>
            </div>
            <div class="col-6 col-md">
                <div class="mech-stat-card text-center">
                    <span class="text-muted small d-block mb-1 font-weight-medium">Rating</span>
                    <h3 class="text-warning font-weight-extrabold mb-0" style="font-family: 'Outfit';">⭐ @profile.Rating.ToString("F1")</h3>
                </div>
            </div>
            <div class="col-12 col-md">
                <div class="mech-stat-card text-center">
                    <span class="text-muted small d-block mb-1 font-weight-medium">Acceptance Rate</span>
                    <h3 class="text-primary font-weight-extrabold mb-0" style="font-family: 'Outfit';">@profile.AcceptanceRatePercentage%</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT TAB CONTAINERS -->

    <!-- ==================== TAB 1: HOME ==================== -->
    <div id="tab-home" class="mech-tab-content">
        @if (activeJob != null)
        {
            <!-- ACTIVE JOB PROGRESSION WORKFLOW -->
            <div class="glass-card mb-4 border-warning border-opacity-50">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3 border-bottom border-secondary border-opacity-40 pb-3">
                    <div>
                        <span class="badge bg-warning text-dark px-3 py-1 font-weight-bold mb-1">JOB #@activeJob.Id • IN PROGRESS</span>
                        <h3 class="text-white font-weight-bold mb-0" style="font-family: 'Outfit';">@activeJob.Vehicle?.Model (@activeJob.Vehicle?.VehicleType)</h3>
                        <p class="text-muted small mb-0"><i class="fa-solid fa-wrench text-warning me-1"></i> Issue: <b class="text-light">@activeJob.ProblemType</b></p>
                    </div>
                    <div class="text-md-end">
                        <span class="text-muted small d-block font-weight-bold text-light">Job Total</span>
                        @{
                            double baseEstBill = activeJob.VisitingCharge + activeJob.ServiceChargeMin;
                            double currentBill = activeJob.FinalBillAmount > baseEstBill ? activeJob.FinalBillAmount : baseEstBill;
                            double activePartsAmt = (activeJob.PartsApproved == true) ? activeJob.PartsEstimateAmount : 0;
                            var commCalc = PaymentService.CalculateTieredCommissionAndNetEarnings(currentBill, activePartsAmt);
                        }
                        <h3 class="text-success font-weight-extrabold mb-0" style="font-family: 'Outfit';">₹@currentBill.ToString("N2")</h3>
                        <span class="text-muted extra-small d-block mt-1" style="font-size: 0.76rem;" title="Platform Fee calculated dynamically from live admin rules">
                            Platform Fee (deducted after payment): ₹@commCalc.AdminCommissionAmount.ToString("N2") <i class="fa-solid fa-circle-info text-info ms-1" data-bs-toggle="tooltip" title="Platform service fee will be deducted upon job payment completion. Net Mechanic Payout: ₹@commCalc.MechanicNetEarningAmount.ToString("N2")"></i>
                        </span>
                    </div>
                </div>

                <!-- Highly Visible General Inactivity Warning banner -->
                <div id="general-inactivity-warning" class="alert alert-danger bg-dark border-danger text-danger small mb-3 d-none">
                    <i class="fa-solid fa-triangle-exclamation me-1 animate-pulse"></i> 
                    <strong>CRITICAL WARNING:</strong> 
                    <span id="general-warning-msg">Inactivity detected! Please respond immediately to prevent job reassignment!</span>
                </div>

                <!-- 6-Stage Progress Indicator Bar -->
                <div class="mb-4">
                    <span class="text-muted small d-block mb-2 font-weight-bold">Live Breakdown Repair Progress:</span>
                    <div class="d-flex flex-wrap gap-1">
                        @{
                            var stages = new[] { "Accepted", "Driving", "Arrived", "Inspecting", "Repairing", "Completed" };
                            var stageLabels = new[] { "1. Accepted", "2. Driving", "3. Arrived", "4. Inspection", "5. Repairing", "6. Completed" };
                            int currentIndex = Array.IndexOf(stages, activeJob.Status);
                            if (currentIndex < 0) currentIndex = 0;
                        }
                        @for (int idx = 0; idx < stages.Length; idx++)
                        {
                            bool isCurrent = idx == currentIndex;
                            bool isPast = idx < currentIndex;
                            <div class="status-stage-step @(isCurrent ? "active" : "") @(isPast ? "completed" : "")">
                                @if(isPast) { <i class="fa-solid fa-check me-1"></i> }
                                @stageLabels[idx]
                            </div>
                        }
                    </div>
                </div>

                <!-- Customer Details & Quick Contact Action Bar -->
                <div class="p-3 bg-dark bg-opacity-60 rounded-3 border border-secondary mb-4">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3 border-bottom border-secondary border-opacity-30 pb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-warning bg-opacity-20 border border-warning p-2 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                <i class="fa-solid fa-user-check text-warning fs-4"></i>
                            </div>
                            <div>
                                <h5 class="text-white mb-0">@activeJob.Customer?.Name</h5>
                                <span class="text-warning small"><i class="fa-solid fa-star"></i> 4.9 Rating Customer</span>
                            </div>
                        </div>

                        <!-- Revealed Communications Buttons -->
                        <div class="d-flex flex-wrap gap-2">
                            <a href="tel:@activeJob.Customer?.PhoneNumber" class="btn btn-success font-weight-bold px-4 py-2">
                                <i class="fa-solid fa-phone me-1"></i> Call (@activeJob.Customer?.PhoneNumber)
                            </a>
                            <button type="button" class="btn btn-outline-info font-weight-bold px-3 py-2 position-relative" data-bs-toggle="modal" data-bs-target="#liveChatMechModal" onclick="fetchMechChatMessages()">
                                <i class="fa-solid fa-comments me-1"></i> Live Chat with Customer
                                <span id="mech-chat-unread-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">0</span>
                            </button>
                            <a href="https://maps.google.com/?q=@activeJob.CustomerLat,@activeJob.CustomerLng" target="_blank" class="btn btn-outline-warning font-weight-bold px-3 py-2">
                                <i class="fa-solid fa-diamond-turn-right me-1"></i> Navigate GPS
                            </a>
                        </div>
                    </div>

                    <div class="row g-2 text-muted small">
                        <div class="col-md-6">
                            <span class="d-block mb-1"><i class="fa-solid fa-location-dot text-warning me-1"></i> Exact Address: <strong class="text-light">@activeJob.Address</strong></span>
                            <span class="d-block"><i class="fa-solid fa-flag text-warning me-1"></i> Landmark: <strong class="text-light">@(string.IsNullOrEmpty(activeJob.Landmark) ? "Near Sector 62 Main Gate" : activeJob.Landmark)</strong></span>
                        </div>
                        <div class="col-md-6">
                            <span class="d-block mb-1"><i class="fa-solid fa-id-card text-warning me-1"></i> Reg Number: <strong class="text-light">UP32 AB 1234</strong></span>
                            <span class="d-block"><i class="fa-solid fa-credit-card text-warning me-1"></i> Payment Mode: <strong class="text-success">Online Escrow / Cash</strong></span>
                        </div>
                    </div>
                </div>

                <!-- MECHANIC INTERACTIVE WORKFLOW STAGE ACTIONS -->
                <div class="p-3 bg-dark bg-opacity-40 rounded-3 border border-secondary">
                    <h5 class="text-warning mb-3"><i class="fa-solid fa-sliders me-2"></i> Update Repair Progress</h5>

                    @if (activeJob.Status == "Accepted")
                    {
                        <div class="alert alert-info bg-dark border-info text-info small mb-3">
                            <i class="fa-solid fa-car-side me-2"></i> Confirm when you start driving towards the customer.
                        </div>
                        <button class="btn btn-premium-primary w-100 py-3 font-weight-bold" onclick="advanceStatus('Driving', this)">
                            <i class="fa-solid fa-car-side me-2"></i> Start Driving to Location
                        </button>
                    }
                    else if (activeJob.Status == "Driving")
                    {
                        <div class="alert alert-info bg-dark border-info text-info small mb-3">
                            <i class="fa-solid fa-location-dot me-2"></i> Click when you reach the customer breakdown spot.
                        </div>
                        <button class="btn btn-premium-primary w-100 py-3 font-weight-bold" onclick="advanceStatus('Arrived', this)">
                            <i class="fa-solid fa-location-dot me-2"></i> I Have Arrived at Location
                        </button>

                        <div class="glass-card p-3 border-secondary mb-3 mt-3">
                            <h6 class="text-white font-weight-bold mb-2"><i class="fa-solid fa-route text-warning me-1"></i> GPS Travel Simulation Control</h6>
                            <p class="text-muted small">You can pause/resume your travel simulation for testing. If travel is paused or inactive for 5 minutes (30 seconds for quick testing), warning will trigger.</p>
                            
                            <div id="sim-warning-container" class="alert alert-danger bg-dark border-danger text-danger small mb-3 d-none">
                                <i class="fa-solid fa-triangle-exclamation me-1"></i> <strong>WARNING:</strong> Inactivity detected! You have not moved for 5 minutes. Resume travel immediately to prevent job reassignment!
                            </div>
                            
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <span class="small text-muted">Simulation Status:</span>
                                    <strong id="simStatusText" class="@(activeJob.IsSimulationPaused ? "text-warning" : "text-success")">
                                        @(activeJob.IsSimulationPaused ? "PAUSED (Stopped)" : "ACTIVE (Driving)")
                                    </strong>
                                </div>
                                <button id="btnToggleSim" class="btn @(activeJob.IsSimulationPaused ? "btn-outline-success" : "btn-outline-warning") btn-sm" onclick="toggleSim()">
                                    @if(activeJob.IsSimulationPaused)
                                    {
                                        <i class="fa-solid fa-play me-1"></i> <span>Resume Travel</span>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-pause me-1"></i> <span>Pause Travel</span>
                                    }
                                </button>
                            </div>
                        </div>
                    }
                    else if (activeJob.Status == "Arrived")
                    {
                        <div class="alert alert-warning bg-dark border-warning text-warning small mb-3">
                            <i class="fa-solid fa-magnifying-glass me-2"></i> Perform on-spot inspection to diagnose the vehicle issue.
                        </div>
                        <button class="btn btn-warning text-dark w-100 py-3 font-weight-bold" onclick="advanceStatus('Inspecting', this)">
                            <i class="fa-solid fa-stethoscope me-2"></i> Begin On-Spot Inspection
                        </button>
                    }
                    else if (activeJob.Status == "Inspecting")
                    {
                        <!-- Custom Estimate Input Section -->
                        <div class="glass-card p-3 border-info border-opacity-30 mb-3">
                            <h6 class="text-info font-weight-bold mb-2"><i class="fa-solid fa-calculator me-1"></i> Add Custom Repair Estimate</h6>
                            <p class="text-muted small mb-3">Enter the repair cost agreed upon after understanding customer requirements on spot.</p>
                            
                            <div class="row g-2 mb-3">
                                <div class="col-md-4">
                                    <label class="form-label text-muted small">Estimated Repair Cost (₹)</label>
                                    <input type="number" id="txtCustomEstimateAmount" class="form-control glass-input text-warning font-weight-bold" value="@(activeJob.CustomEstimateAmount > 0 ? activeJob.CustomEstimateAmount.ToString() : "")" placeholder="Enter Cost (₹)">
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label text-muted small">Work Details / Scope</label>
                                    <input type="text" id="txtCustomEstimateDetails" class="form-control glass-input" value="@(activeJob.CustomEstimateDetails ?? "")" placeholder="Enter Work Scope / Repair Details">
                                </div>
                            </div>
                            <button class="btn btn-info text-dark font-weight-bold w-100 py-2.5" onclick="submitCustomEstimate(this)">
                                <i class="fa-solid fa-paper-plane me-1"></i> Send Estimate for Customer Approval
                            </button>

                            @if (activeJob.CustomEstimateApproved == true)
                            {
                                <div class="alert alert-success bg-dark border-success text-success small mt-3 mb-0">
                                    <i class="fa-solid fa-circle-check me-1"></i> Customer Approved Estimate ₹@activeJob.CustomEstimateAmount! You may start repair.
                                </div>
                            }
                            else if (activeJob.CustomEstimateApproved == false)
                            {
                                <div class="alert alert-danger bg-dark border-danger text-danger small mt-3 mb-0">
                                    <i class="fa-solid fa-circle-xmark me-1"></i> Customer Rejected Estimate. Please renegotiate or cancel.
                                </div>
                            }
                            else if (activeJob.CustomEstimateApproved == null && activeJob.CustomEstimateAmount > 0)
                            {
                                <div class="alert alert-warning bg-dark border-warning text-warning small mt-3 mb-0">
                                    <i class="fa-solid fa-spinner fa-spin me-1"></i> Estimate ₹@activeJob.CustomEstimateAmount sent to customer! Awaiting live approval...
                                </div>
                            }
                        </div>

                        <!-- Extra Parts Quote Input -->
                        <div class="glass-card p-3 border-secondary mb-3">
                            <h6 class="text-warning font-weight-bold mb-2"><i class="fa-solid fa-box-open me-1"></i> Add Extra Spare Parts (Optional)</h6>
                            <p class="text-muted small mb-3">Specify the part name, original MRP, offered bill price, and fitting labour charge.</p>

                            <div class="row g-2 mb-3">
                                <div class="col-md-3">
                                    <label class="form-label text-muted small">Part Name</label>
                                    <input type="text" id="txtExtraPartName" class="form-control glass-input text-white font-weight-bold" value="@(activeJob.ExtraPartsName ?? "")" placeholder="Enter Part Name">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label text-muted small">Part MRP (₹)</label>
                                    <input type="number" id="txtExtraPartMrp" class="form-control glass-input text-info font-weight-bold" value="@(activeJob.PartsMrp > 0 ? activeJob.PartsMrp.ToString() : "")" placeholder="MRP (₹)">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label text-muted small">Offered Part Price (₹)</label>
                                    <input type="number" id="txtExtraPartPrice" class="form-control glass-input text-warning font-weight-bold" value="@(activeJob.PartsEstimateAmount > 0 ? activeJob.PartsEstimateAmount.ToString() : "")" placeholder="Offered Price (₹)">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label text-muted small">Labour Charge (₹)</label>
                                    <input type="number" id="txtExtraLabourPrice" class="form-control glass-input text-warning font-weight-bold" value="@(activeJob.ExtraLabourCharge > 0 ? activeJob.ExtraLabourCharge.ToString() : "")" placeholder="Labour Charge (₹)">
                                </div>
                            </div>
                            <button class="btn btn-outline-warning font-weight-bold w-100 py-2" onclick="submitSparesQuote(this)">
                                <i class="fa-solid fa-plus me-1"></i> Send Extra Parts Quote to Customer
                            </button>

                            @if (activeJob.PartsApproved == true)
                            {
                                <div class="alert alert-success bg-dark border-success text-success small mt-2 mb-0">
                                    <i class="fa-solid fa-circle-check me-1"></i> Customer Approved Extra Parts Quote! Added to bill.
                                </div>
                            }
                            else if (activeJob.PartsApproved == false)
                            {
                                <div class="alert alert-danger bg-dark border-danger text-danger small mt-2 mb-0">
                                    <i class="fa-solid fa-circle-xmark me-1"></i> Customer Rejected Extra Parts Quote.
                                </div>
                            }
                            else if (activeJob.PartsApproved == null && activeJob.PartsEstimateAmount > 0)
                            {
                                <div class="alert alert-warning bg-dark border-warning text-warning small mt-2 mb-0">
                                    <i class="fa-solid fa-spinner fa-spin me-1"></i> Extra Parts quote sent! Awaiting live customer approval...
                                </div>
                            }
                        </div>

                        <button class="btn btn-success w-100 py-3 font-weight-bold fs-5 shadow-lg" onclick="advanceStatus('Repairing', this)">
                            <i class="fa-solid fa-play me-2"></i> Start Repair Work
                        </button>
                    }
                    else if (activeJob.Status == "Repairing" || activeJob.Status == "Completed")
                    {
                        @if (activeJob.Status == "Repairing")
                        {
                            <!-- Extra Parts Quote Input for mid-repair discoveries -->
                            <div class="glass-card p-3 border-secondary mb-3">
                                <h6 class="text-warning font-weight-bold mb-2"><i class="fa-solid fa-box-open me-1"></i> Add/Update Extra Spare Parts during Repair</h6>
                                <p class="text-muted small mb-3">If you discover additional issues during repair, specify the spare part details and extra labour below to request customer approval.</p>

                                <div class="row g-2 mb-3">
                                    <div class="col-md-3">
                                        <label class="form-label text-muted small">Part Name</label>
                                        <input type="text" id="txtExtraPartName" class="form-control glass-input text-white font-weight-bold" value="@(activeJob.ExtraPartsName)" placeholder="e.g. Brake Pads">
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label text-muted small">Part MRP (₹)</label>
                                        <input type="number" id="txtExtraPartMrp" class="form-control glass-input text-info font-weight-bold" value="@(activeJob.PartsMrp > 0 ? activeJob.PartsMrp.ToString() : "")" placeholder="e.g. 1500">
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label text-muted small">Offered Part Price (₹)</label>
                                        <input type="number" id="txtExtraPartPrice" class="form-control glass-input text-warning font-weight-bold" value="@(activeJob.PartsEstimateAmount > 0 ? activeJob.PartsEstimateAmount.ToString() : "")" placeholder="e.g. 1200">
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label text-muted small">Labour Charge (₹)</label>
                                        <input type="number" id="txtExtraLabourPrice" class="form-control glass-input text-warning font-weight-bold" value="@(activeJob.ExtraLabourCharge > 0 ? activeJob.ExtraLabourCharge.ToString() : "")" placeholder="e.g. 300">
                                    </div>
                                </div>
                                <button class="btn btn-outline-warning font-weight-bold w-100 py-2" onclick="submitSparesQuote(this)">
                                    <i class="fa-solid fa-plus me-1"></i> Send Extra Parts Quote to Customer
                                </button>

                                @if (activeJob.PartsApproved == true)
                                {
                                    <div class="alert alert-success bg-dark border-success text-success small mt-2 mb-0">
                                        <i class="fa-solid fa-circle-check me-1"></i> Customer Approved Extra Parts Quote! Added to bill.
                                    </div>
                                }
                                else if (activeJob.PartsApproved == false)
                                {
                                    <div class="alert alert-danger bg-dark border-danger text-danger small mt-2 mb-0">
                                        <i class="fa-solid fa-circle-xmark me-1"></i> Customer Rejected Extra Parts Quote.
                                    </div>
                                }
                                else if (activeJob.PartsApproved == null && activeJob.PartsEstimateAmount > 0)
                                {
                                    <div class="alert alert-warning bg-dark border-warning text-warning small mt-2 mb-0">
                                        <i class="fa-solid fa-spinner fa-spin me-1"></i> Extra Parts quote sent! Awaiting live customer approval...
                                    </div>
                                }
                            </div>
                        }

                        <div class="alert alert-success bg-dark border-success text-success small mb-3">
                            <i class="fa-solid fa-qrcode me-2"></i> Repair in progress. Show QR code to customer to collect total bill payment.
                        </div>

                        <div class="d-flex flex-column gap-2">
                            <div class="d-flex align-items-center gap-2 w-100">
                                <button type="button" class="btn btn-warning text-dark btn-lg flex-grow-1 py-3 font-weight-bold shadow" onclick="openPaymentQrModal(@activeJob.Id, this)">
                                    <i class="fa-solid fa-qrcode me-2"></i> Collect Payment (UPI QR)
                                </button>
                                @if (activeJob.Status != "Completed")
                                {
                                    <button type="button" class="btn btn-info text-dark py-2.5 px-3 font-weight-bold shadow" onclick="settleJobInCash(@activeJob.Id, this)" style="background: linear-gradient(135deg, #0dcaf0 0%, #0aa2c0 100%) !important; border: none; font-size: 0.9rem; min-width: 130px; border-radius: 8px;">
                                        <i class="fa-solid fa-money-bill-wave me-1"></i> Pay in Cash
                                    </button>
                                }
                            </div>
                            
                            @if (activeJob.Status != "Completed")
                            {
                                <button type="button" class="btn btn-success btn-lg w-100 py-3 font-weight-bold shadow" onclick="advanceStatus('Completed', this)">
                                    <i class="fa-solid fa-circle-check me-2"></i> Mark Repair Completed
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- STANDBY HOME SCREEN -->
            <div class="glass-card text-center p-5 mb-4 border-warning border-opacity-30">
                <div class="p-4 rounded-circle bg-warning bg-opacity-10 border border-warning d-inline-block mb-3">
                    <i class="fa-solid fa-tower-broadcast text-warning" style="font-size: 3.5rem;"></i>
                </div>
                <h3 class="text-white font-weight-bold mb-2" style="font-family: 'Outfit';" id="dispatchTitleText">
                    @(profile.IsOnline ? "RaahSathi Dispatch Network Active" : "You Are Currently Offline")
                </h3>
                <p class="lead text-muted max-w-600 mx-auto mb-4" style="font-size: 1.05rem;" id="dispatchDescText">
                    @(profile.IsOnline ? "Standing by for breakdown assistance requests within your selected service radius." : "Switch status to Online in the top bar to start receiving incoming assistance pings.")
                </p>
                <div id="goOnlineBtnContainer">
                    @if (!profile.IsOnline)
                    {
                        <button class="btn btn-premium-primary btn-lg px-5 py-3 font-weight-bold" onclick="toggleMechanicOnlineState()">
                            <i class="fa-solid fa-power-off me-2"></i> Go Online Now
                        </button>
                    }
                </div>
            </div>
        }
    </div>

    <!-- ==================== TAB 2: REQUESTS ==================== -->
    <div id="tab-requests" class="mech-tab-content" style="display:none;">
        <div class="glass-card mb-4 border-info border-opacity-30">
            <h4 class="text-white font-weight-bold mb-3"><i class="fa-solid fa-bell text-info me-2"></i> Incoming Assistance Requests</h4>

            @if (pingJob != null && activeJob == null)
            {
                <div class="p-4 bg-dark bg-opacity-60 rounded-3 border border-warning shadow-lg">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="smart-score-pill">
                            <i class="fa-solid fa-star"></i> ⭐⭐⭐⭐⭐ Recommended Job | Battery Expert Match
                        </span>
                        <span class="badge bg-danger text-white px-3 py-1 font-weight-bold" id="cardTimerBadge">
                            <i class="fa-solid fa-clock me-1"></i> <span id="lblCardDispatchCountdown">15</span>s TIMER ACTIVE
                        </span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <h5 class="text-warning font-weight-bold mb-1">@(pingJob.Vehicle?.Model ?? "Breakdown Vehicle") (@(pingJob.Vehicle?.VehicleType ?? "Car"))</h5>
                            <p class="text-muted small mb-2">Registration: <b>@(pingJob.Vehicle?.RegistrationNumber ?? "UP16-RS-AUTO")</b></p>
                            <span class="badge bg-secondary text-light mb-2">Problem: @(pingJob.ProblemType ?? "Breakdown Support")</span>
                            <span class="d-block text-muted small"><i class="fa-solid fa-location-dot text-warning me-1"></i> @(string.IsNullOrWhiteSpace(pingJob.Address) ? "Nearby Highway NH24" : pingJob.Address)</span>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <span class="text-muted small d-block font-weight-bold">Estimated Job Cost</span>
                            <h3 class="text-success font-weight-bold mb-2">₹@(pingJob.FinalBillAmount > 0 ? pingJob.FinalBillAmount.ToString("N0") : "450 – 650")</h3>
                            <button class="btn btn-success btn-lg px-5 font-weight-bold me-2" onclick="acceptPing(@pingJob.Id)">
                                <i class="fa-solid fa-check me-1"></i> Accept Request
                            </button>
                            <button class="btn btn-outline-danger btn-lg px-3 font-weight-bold" onclick="declinePing(@pingJob.Id)">
                                Decline
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <p class="text-muted text-center py-4 mb-0">No active dispatch requests pending right now.</p>
            }
        </div>
    </div>

    <!-- ==================== TAB 3: JOBS ==================== -->
    <div id="tab-jobs" class="mech-tab-content" style="display:none;">
        <div class="glass-card mb-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3 pb-2 border-bottom border-secondary border-opacity-30">
                <h4 class="text-white font-weight-bold mb-0"><i class="fa-solid fa-clock-rotate-left text-warning me-2"></i> Completed Repair History</h4>
                
                <!-- Date Filter Input Elements -->
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="text-muted small font-weight-medium">Filter Range:</span>
                    <input type="date" id="historyStartDate" class="form-control form-control-sm glass-input text-warning py-1" style="width: 140px; font-size: 0.85rem;" title="Start Date">
                    <span class="text-muted small">to</span>
                    <input type="date" id="historyEndDate" class="form-control form-control-sm glass-input text-warning py-1" style="width: 140px; font-size: 0.85rem;" title="End Date">
                    <button class="btn btn-warning btn-sm font-weight-bold px-3 py-1" onclick="applyHistoryDateFilter()">
                        <i class="fa-solid fa-filter me-1"></i> Apply
                    </button>
                    <button class="btn btn-outline-secondary btn-sm p-1 px-2.5" onclick="resetHistoryDateFilter()" title="Reset to Last 1 Month">
                        <i class="fa-solid fa-rotate me-1"></i> Reset (1 Month)
                    </button>
                </div>
            </div>

            @if (pastJobs.Count == 0)
            {
                <p class="text-muted text-center py-4 mb-0">No completed job history recorded yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle history-table">
                        <thead>
                            <tr>
                                <th>Job ID</th>
                                <th>Vehicle</th>
                                <th>Problem</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th>Total Bill</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var j in pastJobs)
                            {
                                var jobDate = j.CompletedAt ?? j.CreatedAt;
                                <tr class="history-job-row" data-date="@jobDate.ToLocalTime().ToString("yyyy-MM-dd")">
                                    <td>
                                        <b>#@j.Id</b>
                                        @if (j.DisputeStatus == "Active")
                                        {
                                            <span class="badge bg-danger text-white d-block mt-1 font-weight-bold" style="font-size: 0.65rem;"><i class="fa-solid fa-triangle-exclamation"></i> PAYMENT HELD</span>
                                        }
                                        else if (j.DisputeStatus == "Resolved")
                                        {
                                            <span class="badge bg-success text-white d-block mt-1 font-weight-bold" style="font-size: 0.65rem;"><i class="fa-solid fa-circle-check"></i> DISPUTE RESOLVED</span>
                                        }
                                    </td>
                                    <td>@j.Vehicle?.Model</td>
                                    <td><span class="badge bg-warning text-dark">@j.ProblemType</span></td>
                                    <td>@j.Customer?.Name</td>
                                    <td class="small text-muted">@jobDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td class="text-success font-weight-bold">₹@j.FinalBillAmount</td>
                                    <td>
                                        <button class="btn btn-outline-info btn-sm font-weight-bold" onclick="showJobInvoiceModal(@j.Id)">
                                            <i class="fa-solid fa-receipt me-1"></i> View Receipt
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- ==================== TAB 4: WALLET ==================== -->
    <div id="tab-wallet" class="mech-tab-content" style="display:none;">
        <div class="row g-4">
            <!-- Left: Neo-banking Card & Quick Actions -->
            <div class="col-lg-5">
                <div class="glass-card mb-4 p-4 border-success border-opacity-35 text-white position-relative overflow-hidden" 
                     style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(20, 83, 45, 0.3) 100%) !important;">
                    
                    <!-- Decorative background glow -->
                    <div style="position: absolute; top: -50px; right: -50px; width: 150px; height: 150px; background: rgba(16, 185, 129, 0.2); filter: blur(40px); border-radius: 50%;"></div>
                    
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <span class="text-success small font-weight-bold tracking-wider uppercase"><i class="fa-solid fa-shield-halved me-1"></i> Partner Security Escrow</span>
                            <h5 class="text-white font-weight-bold mt-1 mb-0">RaahSathi Vault</h5>
                        </div>
                        <i class="fa-solid fa-credit-card text-success fa-2x opacity-75"></i>
                    </div>

                    <!-- Glowing Balance -->
                    <div class="my-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small d-block">AVAILABLE BALANCE</span>
                                <h1 class="text-white font-weight-extrabold mb-0 mt-1" style="font-family: 'Outfit'; font-size: 2.2rem; text-shadow: 0 0 15px rgba(16, 185, 129, 0.4);" id="lblWalletPendingSettlement">₹@(((double)ViewBag.PendingSettlement).ToString("N2"))</h1>
                            </div>
                            @if (ViewBag.PendingPayoutAmount != null && (double)ViewBag.PendingPayoutAmount > 0)
                            {
                                <div class="text-end">
                                    <span class="text-warning small d-block font-weight-bold"><i class="fa-regular fa-clock me-1"></i> PENDING PAYOUT</span>
                                    <h3 class="text-warning font-weight-bold mb-0 mt-1" style="font-family: 'Outfit';">₹@(((double)ViewBag.PendingPayoutAmount).ToString("N2"))</h3>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-end mt-4 pt-2 border-top border-secondary border-opacity-30">
                        <div>
                            <div class="text-muted" style="font-size: 0.65rem; text-transform: uppercase;">Partner Name</div>
                            <div class="font-weight-bold text-white small">@user.Name</div>
                        </div>
                        <div>
                            <span class="badge bg-success-subtle text-success border border-success border-opacity-30 rounded-pill px-2.5 py-1 small" style="font-size: 0.7rem;">
                                <span class="d-inline-block rounded-circle bg-success me-1 animate-pulse" style="width: 6px; height: 6px;"></span> Active Account
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Wallet Quick Actions Card -->
                <div class="glass-card mb-4 p-4 border-secondary">
                    <h5 class="text-white font-weight-bold mb-3"><i class="fa-solid fa-sliders text-warning me-2"></i> Payout Quick Actions</h5>
                    <p class="text-muted small mb-4">Transfer your earnings to your linked bank account or UPI ID instantly. Transactions are settled using IMPS direct settlement SLA.</p>
                    
                    <button class="btn btn-success btn-lg w-100 py-3 font-weight-bold shadow-lg" onclick="openWithdrawModal()" 
                            style="background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important; border: none;">
                        <i class="fa-solid fa-building-columns me-2"></i> Withdraw Earnings Now
                    </button>
                    <a href="javascript:void(0)" class="btn btn-outline-secondary w-100 mt-2 py-2.5 font-weight-bold" onclick="switchMechTab('tab-profile')">
                        <i class="fa-solid fa-user-gear me-2"></i> Manage Payout Details
                    </a>
                </div>
            </div>

            <!-- Right: Wallet Stats & Statement -->
            <div class="col-lg-7">
                <div class="row g-2 g-md-3 mb-4">
                    <div class="col-6 col-md">
                        <div class="glass-card p-3 border-secondary text-center h-100">
                            <span class="text-muted small d-block mb-1">Today's Earnings</span>
                            <h4 class="text-success font-weight-extrabold mb-0" id="lblWalletTodayEarnings" style="font-family: 'Outfit';">₹@(((double)ViewBag.TodayEarnings).ToString("N2"))</h4>
                        </div>
                    </div>
                    <div class="col-6 col-md">
                        <div class="glass-card p-3 border-secondary text-center h-100">
                            <span class="text-muted small d-block mb-1">Weekly Earnings</span>
                            <h4 class="text-warning font-weight-extrabold mb-0" id="lblWalletWeeklyEarnings" style="font-family: 'Outfit';">₹@(((double)ViewBag.WeeklyEarnings).ToString("N2"))</h4>
                            <span class="text-muted" style="font-size: 0.68rem;">(Current Week)</span>
                        </div>
                    </div>
                    <div class="col-6 col-md">
                        <div class="glass-card p-3 border-secondary text-center h-100">
                            <span class="text-muted small d-block mb-1">Monthly Earnings</span>
                            <h4 class="text-info font-weight-extrabold mb-0" id="lblWalletMonthlyVolume" style="font-family: 'Outfit';">₹@(((double)(ViewBag.MonthlyEarnings ?? ViewBag.MonthlyVolume ?? 0)).ToString("N2"))</h4>
                            <span class="text-muted" style="font-size: 0.68rem;">(Current Month)</span>
                        </div>
                    </div>
                    <div class="col-6 col-md">
                        <div class="glass-card p-3 border-info border-opacity-30 text-center bg-info bg-opacity-10 h-100">
                            <span class="text-muted small d-block mb-1">Monthly Withdrawn</span>
                            <h4 class="text-white font-weight-extrabold mb-0" id="lblWalletMonthlyWithdrawal" style="font-family: 'Outfit';">₹@(((double)(ViewBag.MonthlyWithdrawals ?? 0)).ToString("N2"))</h4>
                            <span class="text-info" style="font-size: 0.68rem;">(Current Month)</span>
                        </div>
                    </div>
                    <div class="col-12 col-md">
                        <div class="glass-card p-3 border-danger border-opacity-40 text-center bg-danger bg-opacity-10 h-100">
                            <span class="text-muted small d-block mb-1">Held in Escrow</span>
                            <h4 class="text-danger font-weight-extrabold mb-0" id="lblWalletHeldEarnings" style="font-family: 'Outfit';">₹@(((double)ViewBag.HeldEarnings).ToString("N2"))</h4>
                        </div>
                    </div>
                </div>

                <!-- Recent Earnings Statement Card -->
                <div class="glass-card border-secondary">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3 border-bottom border-secondary border-opacity-30 pb-3">
                        <div>
                            <h5 class="text-white font-weight-bold mb-0">
                                <i class="fa-solid fa-file-invoice-dollar text-warning me-2"></i> Recent Earnings Statement
                            </h5>
                            <small class="text-muted" style="font-size: 0.75rem;">Live statements &amp; date range transactions</small>
                        </div>

                        <!-- Compact Date Filter Controls -->
                        <div class="d-flex align-items-center flex-nowrap gap-1.5">
                            <div class="d-flex align-items-center gap-1 bg-dark bg-opacity-75 px-2 py-1 rounded-2 border border-secondary" style="height: 30px;">
                                <span class="text-muted" style="font-size: 0.72rem;"><i class="fa-regular fa-calendar text-warning me-1"></i>From:</span>
                                <input type="date" id="txtStatementFromDate" class="form-control form-control-sm bg-transparent border-0 text-white p-0" style="width: 100px; outline: none; font-size: 0.75rem;" onchange="applyStatementDateFilter()">
                            </div>
                            <div class="d-flex align-items-center gap-1 bg-dark bg-opacity-75 px-2 py-1 rounded-2 border border-secondary" style="height: 30px;">
                                <span class="text-muted" style="font-size: 0.72rem;">To:</span>
                                <input type="date" id="txtStatementToDate" class="form-control form-control-sm bg-transparent border-0 text-white p-0" style="width: 100px; outline: none; font-size: 0.75rem;" onchange="applyStatementDateFilter()">
                            </div>
                            <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-1 text-light border-secondary shadow-sm" onclick="resetStatementFilter()" title="Reset Date Filter (Default 1 Month)" style="height: 30px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem;">
                                <i class="fa-solid fa-arrow-rotate-left"></i>
                            </button>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0">
                            <thead>
                                <tr class="border-secondary text-muted small">
                                    <th>Job ID</th>
                                    <th>Date &amp; Time</th>
                                    <th>Status</th>
                                    <th>Total Bill</th>
                                    <th class="text-end">Net Credited</th>
                                </tr>
                            </thead>
                            <tbody id="walletTransactionsTableBody">
                                @if (ViewBag.Payments == null || ((List<Payment>)ViewBag.Payments).Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-muted text-center py-4">No transactions recorded yet.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var p in (List<Payment>)ViewBag.Payments)
                                    {
                                        <tr class="border-secondary">
                                            <td><b>#@p.JobId</b></td>
                                            <td class="small text-muted">@p.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                                            <td>
                                                @if (p.PaymentStatus == "Released" || p.PaymentStatus == "Completed")
                                                {
                                                    <span class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-30 px-2.5 py-1">Escrow Released</span>
                                                }
                                                else if (p.PaymentStatus == "Held" || p.PaymentStatus == "Pending")
                                                {
                                                    <span class="badge bg-warning bg-opacity-15 text-warning border border-warning border-opacity-30 px-2.5 py-1"><i class="fa-solid fa-triangle-exclamation me-1"></i> Payment Held</span>
                                                }
                                                else if (p.PaymentStatus == "Refunded")
                                                {
                                                    <span class="badge bg-danger bg-opacity-15 text-danger border border-danger border-opacity-30 px-2.5 py-1">Refunded (Cancelled)</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary bg-opacity-15 text-secondary border border-secondary border-opacity-30 px-2.5 py-1">@p.PaymentStatus</span>
                                                }
                                            </td>
                                            <td class="text-white-50">₹@p.Amount.ToString("N2")</td>
                                            @if (p.PaymentStatus == "Released" || p.PaymentStatus == "Completed")
                                            {
                                                <td class="text-success font-weight-bold text-end">+₹@((p.MechanicEarningAmount != 0 ? p.MechanicEarningAmount : (p.Amount - p.AdminCommissionAmount)).ToString("N2"))</td>
                                            }
                                            else if (p.PaymentStatus == "Held" || p.PaymentStatus == "Pending")
                                            {
                                                <td class="text-warning font-weight-bold text-end">₹@((p.MechanicEarningAmount != 0 ? p.MechanicEarningAmount : (p.Amount - p.AdminCommissionAmount)).ToString("N2")) (Held)</td>
                                            }
                                            else if (p.PaymentStatus == "Refunded")
                                            {
                                                <td class="text-danger font-weight-bold text-end">₹0.00 (Refunded)</td>
                                            }
                                            else
                                            {
                                                <td class="text-muted text-end">₹@((p.MechanicEarningAmount != 0 ? p.MechanicEarningAmount : (p.Amount - p.AdminCommissionAmount)).ToString("N2"))</td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot id="walletTransactionsTableFoot" class="border-top border-secondary">
                                <tr class="fw-bold bg-dark bg-opacity-75">
                                    <td colspan="3" class="text-white py-3">
                                        <i class="fa-solid fa-calculator text-warning me-2"></i> 
                                        Total Summary (<span id="lblFilteredCount">0</span> Transactions)
                                    </td>
                                    <td class="text-info py-3" id="lblFilteredTotalBill">₹0.00</td>
                                    <td class="text-success text-end py-3 fs-6" id="lblFilteredNetCredited">+₹0.00</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== TAB 5: SUPPORT INBOX ==================== -->
    <div id="tab-support" class="mech-tab-content" style="display:none;">
        <div class="glass-card mb-4 border-info border-opacity-30">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 border-bottom border-secondary border-opacity-40 pb-3">
                <div>
                    <h4 class="text-white font-weight-bold mb-1"><i class="fa-solid fa-headset text-info me-2"></i> Operations & Support Team Inbox</h4>
                    <p class="text-muted small mb-0">Official updates, guidelines & direct communication with RaahSathi Support Team.</p>
                </div>
                <button class="btn btn-outline-info font-weight-bold px-4 py-2" onclick="openSupportReplyModal()">
                    <i class="fa-solid fa-paper-plane me-1"></i> Send Reply / Inquiry to Support
                </button>
            </div>

            <div id="supportMessagesContainer">
                @if (supportMessages.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fa-solid fa-inbox fa-3x mb-3 text-secondary d-block"></i>
                        <p class="mb-0">No support notifications in your inbox yet.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var m in supportMessages)
                        {
                            <div class="p-3.5 rounded-3 border @(m.IsFromAdmin ? "border-info bg-dark bg-opacity-60" : "border-secondary bg-black bg-opacity-40") shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge @(m.IsFromAdmin ? "bg-info text-dark" : "bg-warning text-dark") px-3 py-1 font-weight-bold">
                                        <i class="fa-solid @(m.IsFromAdmin ? "fa-user-shield" : "fa-wrench") me-1"></i> @m.SenderName (@m.SenderRole)
                                    </span>
                                    <span class="text-muted small"><i class="fa-regular fa-clock me-1"></i> @m.SentAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                                </div>
                                <h5 class="text-white font-weight-bold mb-2">@m.Title</h5>
                                <p class="text-light mb-0 small" style="white-space: pre-line; line-height: 1.6;">@m.MessageText</p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ==================== TAB 6: PROFILE & SKILLS ==================== -->
    <div id="tab-profile" class="mech-tab-content" style="display:none;">
        <div class="glass-card mb-4 border-warning border-opacity-30">
            <h4 class="text-white font-weight-bold mb-4"><i class="fa-solid fa-user-gear text-warning me-2"></i> Mechanic Profile & Settings</h4>

            <!-- Trust Badges Bar -->
            <div class="mb-4">
                <label class="form-label text-muted small font-weight-bold d-block mb-2">Verified Partner Badges &amp; Specializations:</label>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var badge in profile.GetBadges())
                    {
                        <span class="badge bg-dark border border-warning text-warning px-3 py-2 fs-6 font-weight-bold">@badge</span>
                    }
                    @if (profile.Rating >= 4.8)
                    {
                        <span class="badge bg-warning text-dark px-3 py-2 fs-6 font-weight-bold"><i class="fa-solid fa-trophy me-1"></i> Top Rated</span>
                    }
                    @if (profile.TotalJobs >= 10)
                    {
                        <span class="badge bg-dark border border-secondary text-light px-3 py-2 fs-6"><i class="fa-solid fa-award text-warning me-1"></i> @profile.TotalJobs+ Jobs Completed</span>
                    }
                    <span class="badge bg-success bg-opacity-25 text-success border border-success px-3 py-2 fs-6"><i class="fa-solid fa-circle-check me-1"></i> Verified Partner</span>
                </div>
            </div>

            <!-- Performance Metrics Grid -->
            <div class="p-3 bg-dark bg-opacity-60 rounded-3 border border-secondary mb-4">
                <h6 class="text-warning font-weight-bold mb-3">Verified Performance Metrics</h6>
                <div class="row g-3 text-center">
                    <div class="col-md-2.4 col-6">
                        <span class="text-muted small d-block">Jobs Completed</span>
                        <h4 class="text-white font-weight-extrabold mb-0">@(profile.TotalJobs > 0 ? profile.TotalJobs.ToString() : "1,284")</h4>
                    </div>
                    <div class="col-md-2.4 col-6">
                        <span class="text-muted small d-block">Rating</span>
                        <h4 class="text-warning font-weight-extrabold mb-0">⭐ @profile.Rating.ToString("F1")</h4>
                    </div>
                    <div class="col-md-2.4 col-6">
                        <span class="text-muted small d-block">Acceptance</span>
                        <h4 class="text-success font-weight-extrabold mb-0">97%</h4>
                    </div>
                    <div class="col-md-2.4 col-6">
                        <span class="text-muted small d-block">Cancellation</span>
                        <h4 class="text-danger font-weight-extrabold mb-0">1%</h4>
                    </div>
                    <div class="col-md-2.4 col-6">
                        <span class="text-muted small d-block">Repeat Customers</span>
                        <h4 class="text-info font-weight-extrabold mb-0">14</h4>
                    </div>
                </div>
            </div>

            <!-- Skills Checkboxes Selector -->
            <div class="mb-4">
                <label class="form-label text-white font-weight-bold mb-2"><i class="fa-solid fa-screwdriver-wrench text-warning me-1"></i> Mechanic Skills &amp; Specializations</label>
                <div class="d-flex flex-wrap gap-2 p-3 bg-dark bg-opacity-40 rounded-3 border border-secondary">
                    @foreach (var sk in new[] { "Battery", "Tyre", "Engine", "Electrical", "AC", "Clutch", "Brake", "E-Rickshaw EV", "Auto-Rickshaw", "CNG System", "BLDC Motor", "Controller", "Lithium Battery", "Diesel", "Petrol", "Truck", "JCB", "Crane" })
                    {
                        bool isChecked = (profile.Specialization ?? "").Contains(sk) 
                                      || (profile.VehicleExpertise ?? "").Contains(sk) 
                                      || (profile.ErickshawSkills ?? "").Contains(sk) 
                                      || (profile.AutoSkills ?? "").Contains(sk) 
                                      || sk == "Battery" || sk == "Engine";
                        var idSafe = sk.Replace(" ", "-").Replace("&", "and");
                        <input type="checkbox" class="btn-check" name="chkSkills" id="chkSkill-@idSafe" value="@sk" @(isChecked ? "checked" : "") autocomplete="off">
                        <label class="btn btn-outline-warning rounded-pill px-3 py-1 font-weight-medium" for="chkSkill-@idSafe">@sk</label>
                    }
                </div>
            </div>

            <!-- Service Area Radius Selector -->
            <div class="mb-4">
                <label class="form-label text-white font-weight-bold mb-2"><i class="fa-solid fa-map-location-dot text-warning me-1"></i> Service Area Radius Coverage</label>
                <div class="d-flex flex-wrap gap-3 p-3 bg-dark bg-opacity-40 rounded-3 border border-secondary">
                    @foreach (var r in new[] { 15, 20, 30, 50 })
                    {
                        string labelStr = r == 50 ? "Highway Coverage (50 KM)" : $"{r} KM";
                        <input type="radio" class="btn-check" name="radServiceRadius" id="radRadius-@r" value="@r" @(profile.ServiceRadiusKm == r ? "checked" : "") autocomplete="off">
                        <label class="btn btn-outline-warning rounded-pill px-4 py-2 font-weight-bold" for="radRadius-@r">@labelStr</label>
                    }
                </div>
            </div>

            <!-- Payment & Settlement Preferences (ALL OPTIONAL) -->
            <div class="mb-4">
                <label class="form-label text-white font-weight-bold mb-2">
                    <i class="fa-solid fa-wallet text-success me-1"></i> Payment & Payout Preferences <span class="badge bg-secondary font-weight-normal ms-2">All Optional</span>
                </label>
                <div class="p-3 bg-dark bg-opacity-40 rounded-3 border border-secondary">
                    
                    <!-- Preferred Payout Choice (Radio: UPI / Bank / Cash) -->
                    <div class="mb-3">
                        <label class="form-label text-muted small d-block font-weight-medium">Preferred Payout Mode:</label>
                        <div class="d-flex flex-wrap gap-2">
                            <input type="radio" class="btn-check" name="radPayoutMethod" id="radMethodUPI" value="UPI" @(profile.PreferredPayoutMethod == "UPI" || string.IsNullOrEmpty(profile.PreferredPayoutMethod) ? "checked" : "") autocomplete="off">
                            <label class="btn btn-outline-success rounded-pill px-3 py-1 font-weight-medium" for="radMethodUPI"><i class="fa-mobile-screen me-1"></i> UPI Direct</label>

                            <input type="radio" class="btn-check" name="radPayoutMethod" id="radMethodBank" value="Bank" @(profile.PreferredPayoutMethod == "Bank" ? "checked" : "") autocomplete="off">
                            <label class="btn btn-outline-info rounded-pill px-3 py-1 font-weight-medium" for="radMethodBank"><i class="fa-building-columns me-1"></i> Bank Account</label>

                            <input type="radio" class="btn-check" name="radPayoutMethod" id="radMethodCash" value="Cash" @(profile.PreferredPayoutMethod == "Cash" ? "checked" : "") autocomplete="off">
                            <label class="btn btn-outline-warning rounded-pill px-3 py-1 font-weight-medium" for="radMethodCash"><i class="fa-money-bill-1 me-1"></i> Cash Settle</label>
                        </div>
                    </div>

                    <div class="row g-3">
                        <!-- Operating City -->
                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1">Operating City</label>
                            <input type="text" id="txtProfileCity" class="form-control glass-input text-white font-weight-bold" value="@profile.City" placeholder="e.g. Noida, Delhi">
                        </div>

                        <!-- UPI ID Input -->
                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1">UPI ID (Optional)</label>
                            <input type="text" id="txtProfileUpi" class="form-control glass-input text-success font-weight-bold" value="@profile.UpiId" placeholder="e.g. 9876543210@paytm / name@upi">
                        </div>
                        
                        <!-- On-Spot Cash Acceptance -->
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check form-switch mb-2 fs-6">
                                <input class="form-check-input" type="checkbox" id="chkAcceptsCash" @(profile.AcceptsCash ? "checked" : "")>
                                <label class="form-check-label text-light small font-weight-bold" for="chkAcceptsCash">
                                    💵 Accept On-Spot Cash Payments from Customers
                                </label>
                            </div>
                        </div>

                        <!-- Bank Details (Optional) -->
                        <div class="col-12 border-top border-secondary border-opacity-30 pt-3">
                            <span class="text-muted small d-block mb-2 font-weight-bold"><i class="fa-solid fa-landmark me-1"></i> Bank Account Details (Optional):</span>
                            <div class="row g-2">
                                <div class="col-md-3">
                                    <input type="text" id="txtProfileHolderName" class="form-control glass-input" value="@profile.AccountHolderName" placeholder="Account Holder Name">
                                </div>
                                <div class="col-md-3">
                                    <input type="text" id="txtBankName" class="form-control glass-input" value="@profile.BankName" placeholder="Bank Name (e.g. SBI, HDFC)">
                                </div>
                                <div class="col-md-3">
                                    <input type="text" id="txtAccountNo" class="form-control glass-input" value="@profile.BankAccountNumber" placeholder="Account Number">
                                </div>
                                <div class="col-md-3">
                                    <input type="text" id="txtIfscCode" class="form-control glass-input" value="@profile.IfscCode" placeholder="IFSC Code">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <button class="btn btn-premium-primary font-weight-bold px-5 py-3 shadow-lg" onclick="saveProfileSettings()">
                <i class="fa-solid fa-floppy-disk me-1"></i> Save Profile Settings
            </button>
        </div>
    </div>

</div>

<!-- WITHDRAWAL PAYOUT MODAL -->
<div class="modal fade" id="withdrawModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-success" style="border-radius: 12px; overflow:hidden;">
            <div class="modal-header border-secondary" style="background: linear-gradient(135deg, #0f1f15 0%, #153a21 100%) !important;">
                <h5 class="modal-title text-success font-weight-bold"><i class="fa-solid fa-building-columns me-2"></i> Withdraw Wallet Earnings</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" onclick="resetWithdrawModal()"></button>
            </div>
            
            <!-- View 1: Input Form -->
            <div class="modal-body p-4" id="withdrawFormView">
                <div class="text-center mb-3">
                    <span class="text-muted small d-block">Available Wallet Balance</span>
                    <h2 class="@(profile.CurrentEarnings >= 0 ? "text-success" : "text-danger") font-weight-extrabold mb-0 mt-1" style="font-family: 'Outfit'; text-shadow: @(profile.CurrentEarnings >= 0 ? "0 0 10px rgba(16, 185, 129, 0.3)" : "0 0 10px rgba(239, 68, 68, 0.3)");">
                        @(profile.CurrentEarnings >= 0 ? "" : "-")₹@(Math.Abs(profile.CurrentEarnings).ToString("N2"))
                    </h2>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small font-weight-bold mb-1">WITHDRAWAL METHOD</label>
                    <div class="d-flex gap-2">
                        <input type="radio" class="btn-check" name="radWithdrawMethod" id="radWithdrawBank" value="Bank" @(profile.PreferredPayoutMethod == "Bank" || string.IsNullOrEmpty(profile.PreferredPayoutMethod) ? "checked" : "") onclick="toggleWithdrawFields('Bank')">
                        <label class="btn btn-outline-success flex-fill font-weight-bold" for="radWithdrawBank"><i class="fa-solid fa-building-columns me-1"></i> Bank Account</label>

                        <input type="radio" class="btn-check" name="radWithdrawMethod" id="radWithdrawUPI" value="UPI" @(profile.PreferredPayoutMethod == "UPI" ? "checked" : "") onclick="toggleWithdrawFields('UPI')">
                        <label class="btn btn-outline-success flex-fill font-weight-bold" for="radWithdrawUPI"><i class="fa-solid fa-mobile-screen me-1"></i> UPI ID</label>
                    </div>
                </div>

                <!-- Bank Details Fields -->
                <div id="divWithdrawBankFields" class="@(profile.PreferredPayoutMethod == "UPI" ? "d-none" : "")">
                    <div class="mb-2">
                        <label class="form-label text-muted small mb-0 font-weight-bold">ACCOUNT HOLDER NAME <span class="text-danger">*</span></label>
                        <input type="text" id="txtWithdrawHolderName" class="form-control glass-input text-white" value="@profile.AccountHolderName" placeholder="Enter Full Name">
                    </div>
                    <div class="mb-2">
                        <label class="form-label text-muted small mb-0 font-weight-bold">BANK NAME <span class="text-danger">*</span></label>
                        <input type="text" id="txtWithdrawBankName" class="form-control glass-input text-white" value="@profile.BankName" placeholder="e.g. SBI, HDFC, ICICI">
                    </div>
                    <div class="mb-2">
                        <label class="form-label text-muted small mb-0 font-weight-bold">BANK ACCOUNT NUMBER <span class="text-danger">*</span></label>
                        <input type="text" id="txtWithdrawAccNo" class="form-control glass-input text-white" value="@profile.BankAccountNumber" placeholder="Enter Account Number">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small mb-0 font-weight-bold">IFSC CODE <span class="text-danger">*</span></label>
                        <input type="text" id="txtWithdrawIfsc" class="form-control glass-input text-white" value="@profile.IfscCode" placeholder="Enter IFSC Code (e.g. SBIN0001234)">
                    </div>
                </div>

                <!-- UPI Fields -->
                <div id="divWithdrawUpiFields" class="@(profile.PreferredPayoutMethod == "UPI" ? "" : "d-none")">
                    <div class="mb-3">
                        <label class="form-label text-muted small mb-0 font-weight-bold">UPI ID <span class="text-danger">*</span></label>
                        <input type="text" id="txtWithdrawUpi" class="form-control glass-input text-success font-weight-bold" value="@profile.UpiId" placeholder="e.g. 9876543210@paytm / name@upi">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small font-weight-bold mb-1">WITHDRAWAL AMOUNT (₹)</label>
                    <input type="number" id="txtWithdrawAmount" class="form-control glass-input text-warning font-weight-bold fs-4 py-2" value="@((int)profile.CurrentEarnings)" max="@profile.CurrentEarnings" min="1" placeholder="e.g. 500">
                    <div class="d-flex gap-2 mt-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm flex-fill" onclick="setWithdrawAmount(500)">₹500</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm flex-fill" onclick="setWithdrawAmount(1000)">₹1000</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm flex-fill" onclick="setWithdrawAmount(2000)">₹2000</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm flex-fill" onclick="setWithdrawAmount(@((int)profile.CurrentEarnings))">Withdraw All</button>
                    </div>
                </div>

                <button class="btn btn-success w-100 py-3 font-weight-bold shadow mt-2" onclick="simulatePayoutWithdrawal()" id="btnSubmitWithdrawal">
                    <i class="fa-solid fa-arrow-up-from-bracket me-1"></i> Request Payout Verification
                </button>
            </div>

            <!-- View 2: Processing View -->
            <div class="modal-body p-5 text-center d-none" id="withdrawProcessingView">
                <div class="spinner-grow text-success mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
                <h5 class="font-weight-bold text-white mb-2">Initiating Instant Payout...</h5>
                <p class="text-muted small" id="withdrawStatusText">Contacting NPCI IMPS direct settlement node...</p>
            </div>

            <!-- View 3: Success View -->
            <div class="modal-body p-5 text-center d-none" id="withdrawSuccessView">
                <div class="checkmark-circle">
                    <div class="check-icon" style="border-color: #22c55e;"></div>
                </div>
                <h5 class="font-weight-bold text-success mb-2">Payout Transferred!</h5>
                <p class="text-muted small" id="withdrawSuccessMsg">Amount successfully deposited to your linked account.</p>
                <button type="button" class="btn btn-outline-success btn-sm mt-3 px-4 font-weight-bold" data-bs-dismiss="modal" onclick="reloadDashboard()">Okay</button>
            </div>
        </div>
    </div>
</div>

<!-- SUPPORT REPLY / INQUIRY MODAL -->
<div class="modal fade" id="supportReplyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-info">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-info"><i class="fa-solid fa-headset me-2"></i> Contact Operations Support</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="mechanicSupportForm" onsubmit="submitMechanicSupportForm(event)">
                <div class="modal-body p-3">
                    <input type="hidden" name="userRole" value="Mechanic" />
                    <input type="hidden" name="fullName" value="@(profile?.User?.Name ?? "Mechanic")" />
                    <input type="hidden" name="phone" value="@(profile?.User?.PhoneNumber ?? "0000000000")" />

                    <div class="mb-3">
                        <label class="form-label text-muted small">Your Email Address <span class="text-danger">*</span></label>
                        <input type="email" name="email" class="form-control glass-input" value="@(profile?.Email ?? "")" placeholder="e.g. mechanic@example.com" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small">Subject / Title <span class="text-danger">*</span></label>
                        <input type="text" name="subject" class="form-control glass-input" placeholder="e.g. Payment inquiry / KYC update help" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small">Your Message / Inquiry <span class="text-danger">*</span></label>
                        <textarea name="message" class="form-control glass-input" rows="4" placeholder="Type your message to RaahSathi Support Team..." required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small">Attach Screenshot / Photo <span class="text-warning">(Optional)</span></label>
                        <input type="file" name="photoFile" class="form-control glass-input text-white" accept="image/*">
                        <span class="text-muted extra-small d-block mt-1">Attach visual proof of payments, bank statements, or issue details.</span>
                    </div>

                    <button type="submit" class="btn btn-info text-dark font-weight-bold w-100 py-2.5">
                        <i class="fa-solid fa-paper-plane me-1"></i> Send to Support Team
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- LIVE CUSTOMER CHAT MODAL -->
<div class="modal fade" id="liveChatMechModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-info">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-info"><i class="fa-solid fa-comments me-2"></i> Live Chat with Customer</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div id="mechChatBox" class="p-3 bg-black rounded mb-3 d-flex flex-column" style="height: 280px; overflow-y: auto; border: 1px solid var(--border-color);">
                    <div class="text-center text-muted small py-3 my-auto">Connecting live customer chat stream...</div>
                </div>
                <div class="input-group">
                    <input type="text" id="txtMechChatMessage" class="form-control glass-input" placeholder="Type a message to customer..." onkeypress="handleMechChatKeyPress(event)">
                    <button class="btn btn-info font-weight-bold" onclick="sendMechChatMessage()"><i class="fa-solid fa-paper-plane me-1"></i> Send</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Dynamic Tab Navigation
    function switchMechTab(tabId) {
        $('.mech-tab-content').hide();
        $('#' + tabId).show();
        $('.bottom-mech-nav button, .glass-card button').removeClass('active');
        $('#navBtn-' + tabId).addClass('active');

        if (tabId === 'tab-support') {
            loadSupportMessages();
        }
    }

    var isOnline = @(profile.IsOnline ? "true" : "false");
    var hasActiveJob = @(activeJob != null ? "true" : "false");

    function updateOnlineUI(online) {
        isOnline = online;
        if (online) {
            $('#badgeOnlineStatus').removeClass('bg-secondary text-light').addClass('bg-success text-white').html('<i class="fa-solid fa-circle me-1" style="font-size:0.6rem;"></i> 🟢 ONLINE');
            $('#toggleOnlineSwitch').prop('checked', true);
            $('#lblSwitchOnline').text('Status: Online');
            $('#dispatchTitleText').text('RaahSathi Dispatch Network Active');
            $('#dispatchDescText').text('Standing by for breakdown assistance requests within your selected service radius.');
            $('#goOnlineBtnContainer').html('');
        } else {
            $('#badgeOnlineStatus').removeClass('bg-success text-white').addClass('bg-secondary text-light').html('<i class="fa-solid fa-circle me-1" style="font-size:0.6rem;"></i> ⚪ OFFLINE');
            $('#toggleOnlineSwitch').prop('checked', false);
            $('#lblSwitchOnline').text('Status: Offline');
            $('#dispatchTitleText').text('You Are Currently Offline');
            $('#dispatchDescText').text('Switch status to Online in the top bar to start receiving incoming assistance pings.');
            $('#goOnlineBtnContainer').html('<button class="btn btn-premium-primary btn-lg px-5 py-3 font-weight-bold" onclick="toggleMechanicOnlineState()"><i class="fa-solid fa-power-off me-2"></i> Go Online Now</button>');
        }
    }

    // Toggle Online/Offline State
    function toggleMechanicOnlineState() {
        try {
            if (!window.sirenAudioCtx) {
                window.sirenAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (window.sirenAudioCtx.state === 'suspended') {
                window.sirenAudioCtx.resume();
            }
        } catch(e) {}

        $.post('/Mechanic/ToggleOnline', function(res) {
            if (res.success) {
                updateOnlineUI(res.isOnline);
            }
        });
    }

    $(document).ready(function() {
        // Start watching geolocation to update mechanic location in database
        if (navigator.geolocation) {
            navigator.geolocation.watchPosition(function(position) {
                var lat = position.coords.latitude;
                var lng = position.coords.longitude;
                $.post('/Mechanic/UpdateLocation', { lat: lat, lng: lng });
            }, function(err) {
                console.warn("Geolocation watch error:", err);
            }, {
                enableHighAccuracy: true,
                maximumAge: 10000,
                timeout: 5000
            });
        }
        
        // Initialize Completed Repair History to show last 7 days (weekly) by default
        resetHistoryDateFilter();
    });

    // Step Status Advances with Instant Touch Feedback & Payment Validation
    function advanceStatus(nextStatus, btnElement, directJobId) {
        var activeJobId = directJobId || parseInt("@(activeJob?.Id ?? 0)") || parseInt(currentActiveJobId) || 0;
        var $btn = btnElement ? $(btnElement) : $('button[onclick*="advanceStatus(\'' + nextStatus + '\'"]');
        var originalBtnHtml = $btn.length ? $btn.html() : '';
        
        if ($btn.length) {
            $btn.prop('disabled', true).html('<i class="fa-solid fa-circle-notch fa-spin me-2"></i> Updating...');
        }

        if (activeJobId > 0) {
            $.post('/Mechanic/AdvanceJobStatus', { jobId: activeJobId, newStatus: nextStatus }, function(res) {
                if (res && res.success) {
                    window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
                } else if (res && res.requiresPayment) {
                    if ($btn.length) { $btn.prop('disabled', false).html(originalBtnHtml); }
                    alert(res.message);
                    openPaymentQrModal(activeJobId);
                } else if (res) {
                    if ($btn.length) { $btn.prop('disabled', false).html(originalBtnHtml); }
                    alert(res.message || 'Could not update status.');
                }
            }).fail(function() {
                window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
            });
        } else {
            window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
        }
    }

    // Submit Custom Estimate with Touch Feedback
    function submitCustomEstimate(btnElement) {
        var activeJobId = parseInt("@(activeJob?.Id ?? 0)") || parseInt(currentActiveJobId) || 0;
        var amount = $('#txtCustomEstimateAmount').val();
        var details = $('#txtCustomEstimateDetails').val();
        var $btn = btnElement ? $(btnElement) : $('#btnSubmitCustomEst');
        var originalHtml = $btn.length ? $btn.html() : '';

        if (activeJobId > 0 && amount > 0) {
            if ($btn.length) { $btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Sending...'); }
            $.post('/Mechanic/SubmitCustomEstimate', { jobId: activeJobId, amount: amount, details: details }, function(res) {
                if (res && res.success) {
                    alert('✅ Custom Repair Estimate ₹' + amount + ' sent to customer for approval!');
                    window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
                } else {
                    if ($btn.length) { $btn.prop('disabled', false).html(originalHtml); }
                    alert(res?.message || 'Error submitting estimate.');
                }
            }).fail(function() {
                window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
            });
        } else {
            alert('Please enter a valid estimate amount.');
        }
    }

    // Submit Extra Parts Quote with Touch Feedback
    function submitSparesQuote(btnElement) {
        var activeJobId = parseInt("@(activeJob?.Id ?? 0)") || parseInt(currentActiveJobId) || 0;
        var partName = $('#txtExtraPartName').val();
        var partsMrp = $('#txtExtraPartMrp').val() || 0;
        var partPrice = $('#txtExtraPartPrice').val();
        var labourPrice = $('#txtExtraLabourPrice').val() || 0;
        var $btn = btnElement ? $(btnElement) : $('#btnSubmitSpares');
        var originalHtml = $btn.length ? $btn.html() : '';

        if (activeJobId > 0 && partPrice > 0) {
            if ($btn.length) { $btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Sending...'); }
            $.post('/Mechanic/SubmitSparesQuote', { jobId: activeJobId, partName: partName, partPrice: partPrice, labourPrice: labourPrice, partsMrp: partsMrp }, function(res) {
                if (res && res.success) {
                    alert('✅ Extra Parts quote sent for customer approval!');
                    window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
                } else {
                    if ($btn.length) { $btn.prop('disabled', false).html(originalHtml); }
                    alert(res?.message || 'Error submitting spare parts quote.');
                }
            }).fail(function() {
                window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
            });
        } else {
            alert('Please enter part name and offered price.');
        }
    }

    // Save Profile & Service Radius Settings
    function saveProfileSettings() {
        var skills = [];
        $('input[name="chkSkills"]:checked').each(function() { skills.push($(this).val()); });
        var radius = $('input[name="radServiceRadius"]:checked').val() || 15;

        var upi = $('#txtProfileUpi').val();
        var bankName = $('#txtBankName').val();
        var accNo = $('#txtAccountNo').val();
        var ifsc = $('#txtIfscCode').val();
        var holderName = $('#txtProfileHolderName').val();
        var city = $('#txtProfileCity').val();
        var payoutMethod = $('input[name="radPayoutMethod"]:checked').val() || 'UPI';
        var acceptsCash = $('#chkAcceptsCash').is(':checked');

        $.post('/Mechanic/UpdateProfileSettings', {
            vehicleExpertise: skills,
            specialization: skills,
            serviceRadiusKm: radius,
            upiId: upi,
            bankName: bankName,
            accountNumber: accNo,
            ifscCode: ifsc,
            accountHolderName: holderName,
            city: city,
            preferredPayoutMethod: payoutMethod,
            acceptsCash: acceptsCash
        }, function(res) {
            if (res.success) {
                alert('✅ Profile & payment preferences saved successfully!');
            }
        });
    }

    function toggleWithdrawFields(method) {
        if (method === 'Bank') {
            $('#divWithdrawBankFields').removeClass('d-none');
            $('#divWithdrawUpiFields').addClass('d-none');
        } else {
            $('#divWithdrawBankFields').addClass('d-none');
            $('#divWithdrawUpiFields').removeClass('d-none');
        }
    }

    function openWithdrawModal() {
        resetWithdrawModal();
        var method = $('input[name="radWithdrawMethod"]:checked').val() || 'Bank';
        toggleWithdrawFields(method);
        var modal = new bootstrap.Modal(document.getElementById('withdrawModal'));
        modal.show();
    }

    function resetWithdrawModal() {
        $('#withdrawProcessingView').addClass('d-none');
        $('#withdrawSuccessView').addClass('d-none');
        $('#withdrawFormView').removeClass('d-none');
    }

    function setWithdrawAmount(val) {
        $('#txtWithdrawAmount').val(val);
    }

    function reloadDashboard() {
        location.reload();
    }

    function simulatePayoutWithdrawal() {
        var amt = parseFloat($('#txtWithdrawAmount').val());
        var maxAmt = parseFloat("@profile.CurrentEarnings");
        var payoutMethod = $('input[name="radWithdrawMethod"]:checked').val() || 'Bank';

        var holderName = $('#txtWithdrawHolderName').val();
        var bankName = $('#txtWithdrawBankName').val();
        var accNo = $('#txtWithdrawAccNo').val();
        var ifsc = $('#txtWithdrawIfsc').val();
        var upiId = $('#txtWithdrawUpi').val();

        if (isNaN(amt) || amt <= 0) {
            alert("Please enter a valid withdrawal amount.");
            return;
        }
        if (amt > maxAmt) {
            alert("Withdrawal amount cannot exceed your available wallet balance.");
            return;
        }

        if (payoutMethod === 'Bank') {
            if (!holderName || !holderName.trim()) { alert("Please enter Account Holder Name."); return; }
            if (!bankName || !bankName.trim()) { alert("Please enter Bank Name."); return; }
            if (!accNo || !accNo.trim()) { alert("Please enter Bank Account Number."); return; }
            if (!ifsc || !ifsc.trim()) { alert("Please enter IFSC Code."); return; }
        } else {
            if (!upiId || !upiId.trim()) { alert("Please enter UPI ID."); return; }
        }

        $('#withdrawFormView').addClass('d-none');
        $('#withdrawProcessingView').removeClass('d-none');

        var destinationLabel = payoutMethod === 'UPI' ? upiId : (bankName + " (A/C: " + accNo + ")");
        var steps = [
            "Contacting NPCI IMPS direct settlement node...",
            "Authorizing secure payment escrow payout request...",
            "Submitting payout request for verification..."
        ];

        var stepIdx = 0;
        $('#withdrawStatusText').text(steps[stepIdx]);
        var interval = setInterval(function() {
            stepIdx++;
            if (stepIdx < steps.length) {
                $('#withdrawStatusText').text(steps[stepIdx]);
            } else {
                clearInterval(interval);
                // Trigger actual backend withdrawal
                $.post('/Mechanic/WithdrawWallet', {
                    amount: amt,
                    payoutMethod: payoutMethod,
                    accountHolderName: holderName,
                    accountNumber: accNo,
                    bankName: bankName,
                    ifscCode: ifsc,
                    upiId: upiId
                }, function(res) {
                    if (res.success) {
                        $('#withdrawProcessingView').addClass('d-none');
                        $('#withdrawSuccessView').removeClass('d-none');
                        $('#withdrawSuccessMsg').text("Payout request of ₹" + amt.toFixed(2) + " submitted successfully! Status is pending Admin approval.");
                    } else {
                        alert(res.message || "Failed to process withdrawal.");
                        resetWithdrawModal();
                    }
                });
            }
        }, 1000);
    }

    // Customer-Mechanic Live Chat
    function fetchMechChatMessages() {
        var activeJobId = "@(activeJob?.Id ?? 0)";
        if (!activeJobId || activeJobId == 0) return;

        $.get('/Customer/GetChatMessages', { jobId: activeJobId, viewerRole: 'Mechanic' }, function(res) {
            if (res && res.success) {
                var html = '';
                if (res.messages.length === 0) {
                    html = '<div class="text-center text-muted small my-auto py-4"><i class="fa-solid fa-comments text-secondary fa-2x mb-2 d-block"></i>No messages yet. Send a message to your customer.</div>';
                } else {
                    res.messages.forEach(function(m) {
                        var isMe = m.senderRole === "Mechanic";
                        html += `
                            <div class="d-flex flex-column ${isMe ? 'align-items-end' : 'align-items-start'} mb-2">
                                <span class="text-muted" style="font-size:0.65rem;">${m.senderName} (${m.senderRole}) • ${m.sentTime}</span>
                                <div class="${isMe ? 'bg-info text-dark font-weight-bold' : 'bg-warning text-dark font-weight-bold'} px-3 py-2 rounded-3 shadow-sm" style="max-width:80%; font-size:0.85rem; word-break:break-word;">
                                    ${m.messageText}
                                </div>
                            </div>
                        `;
                    });
                }
                $('#mechChatBox').html(html);
                var box = document.getElementById('mechChatBox');
                if (box) box.scrollTop = box.scrollHeight;
            }
        });
    }

    function sendMechChatMessage() {
        var activeJobId = "@(activeJob?.Id ?? 0)";
        var text = $('#txtMechChatMessage').val();
        if (!text || !text.trim() || activeJobId == 0) return;

        $.post('/Customer/SendChatMessage', { jobId: activeJobId, message: text.trim(), role: "Mechanic" }, function(res) {
            if (res && res.success) {
                $('#txtMechChatMessage').val('');
                fetchMechChatMessages();
            }
        });
    }

    function handleMechChatKeyPress(e) {
        if (e.which === 13) {
            sendMechChatMessage();
        }
    }

    // Support Team Inbox & Reply System
    function openSupportReplyModal() {
        $('#mechanicSupportForm')[0].reset();
        var modal = new bootstrap.Modal(document.getElementById('supportReplyModal'));
        modal.show();
    }

    function submitMechanicSupportForm(e) {
        e.preventDefault();
        var form = $('#mechanicSupportForm')[0];
        var formData = new FormData(form);

        $.ajax({
            url: '/Home/SubmitSupportTicket',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(res) {
                if (res && res.success) {
                    alert('✅ ' + res.message);
                    var modalEl = document.getElementById('supportReplyModal');
                    var modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                    if (typeof loadSupportMessages === 'function') {
                        loadSupportMessages();
                    }
                } else {
                    alert('❌ Error: ' + (res.message || 'Could not submit support ticket.'));
                }
            },
            error: function() {
                alert('❌ Network error submitting support ticket. Please try again.');
            }
        });
    }

    function loadSupportMessages() {
        $.get('/Mechanic/GetSupportMessages', function(res) {
            if (res.success) {
                var html = '';
                if (res.messages.length === 0) {
                    html = '<div class="text-center py-5 text-muted"><i class="fa-solid fa-inbox fa-3x mb-3 text-secondary d-block"></i><p class="mb-0">No support notifications in your inbox yet.</p></div>';
                } else {
                    html = '<div class="d-flex flex-column gap-3">';
                    res.messages.forEach(function(m) {
                        html += `
                            <div class="p-3.5 rounded-3 border ${m.isFromAdmin ? 'border-info bg-dark bg-opacity-60' : 'border-secondary bg-black bg-opacity-40'} shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge ${m.isFromAdmin ? 'bg-info text-dark' : 'bg-warning text-dark'} px-3 py-1 font-weight-bold">
                                        <i class="fa-solid ${m.isFromAdmin ? 'fa-user-shield' : 'fa-wrench'} me-1"></i> ${m.senderName} (${m.senderRole})
                                    </span>
                                    <span class="text-muted small"><i class="fa-regular fa-clock me-1"></i> ${m.sentTime}</span>
                                </div>
                                <h5 class="text-white font-weight-bold mb-2">${m.title}</h5>
                                <p class="text-light mb-0 small" style="white-space: pre-line; line-height: 1.6;">${m.messageText}</p>
                            </div>
                        `;
                    });
                    html += '</div>';
                }
                $('#supportMessagesContainer').html(html);
            }
        });
    }

    // Start Polling Live Chat

    setInterval(function() {
        if ($('#liveChatMechModal').hasClass('show')) {
            fetchMechChatMessages();
        }
    }, 2500);

    var todayJobsCountVal = @(ViewBag.TodayJobsCount ?? 0);
    var weeklyJobsCountVal = @(ViewBag.WeeklyJobsCount ?? 0);

    var currentStatementFrom = '';
    var currentStatementTo = '';

    function applyStatementDateFilter() {
        currentStatementFrom = $('#txtStatementFromDate').val() || '';
        currentStatementTo = $('#txtStatementToDate').val() || '';
        updateWalletStats();
    }

    function resetStatementFilter() {
        $('#txtStatementFromDate').val('');
        $('#txtStatementToDate').val('');
        currentStatementFrom = '';
        currentStatementTo = '';
        updateWalletStats();
    }

    function updateWalletStats() {
        var query = '';
        if (currentStatementFrom || currentStatementTo) {
            query = '?fromDate=' + encodeURIComponent(currentStatementFrom) + '&toDate=' + encodeURIComponent(currentStatementTo);
        }
        $.get('/Mechanic/GetWalletStats' + query, function(res) {
            if (res && res.success) {
                $('#lblWalletTodayEarnings').text('₹' + (res.todayEarnings || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                $('#lblWalletWeeklyEarnings').text('₹' + (res.weeklyEarnings || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                $('#lblWalletMonthlyVolume').text('₹' + (res.monthlyEarnings || res.monthlyVolume || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                $('#lblWalletMonthlyWithdrawal').text('₹' + (res.monthlyWithdrawal || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                $('#lblWalletHeldEarnings').text('₹' + (res.heldEarnings || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                $('#lblWalletPendingSettlement').text('₹' + (res.pendingSettlement || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                $('#topTodayEarnings').text('₹' + Math.round(res.todayEarnings || 0).toLocaleString('en-IN'));

                // Update jobs count variables in real-time
                todayJobsCountVal = res.todayJobsCount || 0;
                weeklyJobsCountVal = res.weeklyJobsCount || 0;

                // Update visible count based on current select value
                var currentRange = $('#jobStatRangeSelect').val();
                if (currentRange === 'today') {
                    $('#topJobsCount').text(todayJobsCountVal);
                } else {
                    $('#topJobsCount').text(weeklyJobsCountVal);
                }

                // Update Recent Earnings Statement table
                var tableHtml = '';
                if (!res.transactions || res.transactions.length === 0) {
                    tableHtml = '<tr><td colspan="5" class="text-muted text-center py-4"><i class="fa-regular fa-calendar-xmark me-1"></i> No transactions found for selected date range.</td></tr>';
                } else {
                    res.transactions.forEach(function(tx) {
                        var isDebit = tx.mechanicEarning < 0;
                        var badgeText = isDebit ? "Platform Fee (Cash)" : "Job Earning";
                        var badgeClass = isDebit ? "bg-danger-subtle text-danger border border-danger border-opacity-35" : "bg-success-subtle text-success border border-success border-opacity-35";
                        var textClass = isDebit ? "text-danger font-weight-bold" : "text-success font-weight-bold";
                        var signPrefix = isDebit ? "-" : "+";
                        var absEarning = Math.abs(tx.mechanicEarning);

                        if (tx.status === "Held" || tx.status === "Pending") {
                            badgeText = "Payment Held";
                            badgeClass = "bg-warning bg-opacity-15 text-warning border border-warning border-opacity-30";
                            textClass = "text-warning font-weight-bold";
                            signPrefix = "";
                        } else if (tx.status === "Refunded") {
                            badgeText = "Refunded (Cancelled)";
                            badgeClass = "bg-danger bg-opacity-15 text-danger border border-danger border-opacity-30";
                            textClass = "text-danger font-weight-bold";
                            signPrefix = "";
                        }

                        tableHtml += `
                            <tr>
                                <td><b>#${tx.jobId}</b></td>
                                <td class="small text-muted">${tx.createdAt}</td>
                                <td><span class="badge ${badgeClass} px-2 py-1">${badgeText}</span></td>
                                <td class="text-white-50">₹${tx.amount.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                                <td class="${textClass} text-end">${signPrefix}₹${absEarning.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
                            </tr>
                        `;
                    });
                }
                $('#walletTransactionsTableBody').html(tableHtml);

                // Update Table Footer Totals
                var count = res.transactions ? res.transactions.length : 0;
                $('#lblFilteredCount').text(count);
                $('#lblFilteredTotalBill').text('₹' + (res.filteredTotalBill || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                $('#lblFilteredNetCredited').text('+₹' + (res.filteredTotalNetEarning || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            }
        });
    }

    // Run on load and poll every 5 seconds (throttled to avoid CPU spikes & DB lock contention)
    updateWalletStats();
    setInterval(updateWalletStats, 5000);

    // Job Stats Range Toggle Listener
    $('#jobStatRangeSelect').change(function() {
        var range = $(this).val();
        if (range === 'today') {
            $('#topJobsCount').text(todayJobsCountVal);
        } else {
            $('#topJobsCount').text(weeklyJobsCountVal);
        }
    });

    // Real-Time Active Job Approval Polling for Mechanic
    var currentActiveJobId = "@(activeJob?.Id ?? 0)";
    var lastCustomEstimateApproved = "@(activeJob?.CustomEstimateApproved?.ToString().ToLower() ?? "null")";
    var lastPartsApproved = "@(activeJob?.PartsApproved?.ToString().ToLower() ?? "null")";
    var lastTowingApproved = "@(activeJob?.TowingApproved?.ToString().ToLower() ?? "null")";
    var lastJobStatus = "@(activeJob?.Status ?? "")";

    function pollActiveJobState() {
        if (!currentActiveJobId || currentActiveJobId === "0") return;

        $.get('/Mechanic/GetActiveJobState?jobId=' + currentActiveJobId + '&_t=' + Date.now(), function(res) {
            if (res && res.success) {
                // Update unread chat message badge
                if (res.unreadChatCount > 0 && !$('#liveChatMechModal').hasClass('show')) {
                    $('#mech-chat-unread-badge').text(res.unreadChatCount).removeClass('d-none');
                } else {
                    $('#mech-chat-unread-badge').addClass('d-none');
                }

                // General inactivity warning updates (handles both Accepted and Driving statuses)
                if ((res.status === "Accepted" || res.status === "Driving") && res.inactiveSeconds >= 30) {
                    $('#general-inactivity-warning').removeClass('d-none');
                    if (res.status === "Accepted") {
                        $('#general-warning-msg').text("You accepted the job but have not started driving. Please click 'Start Driving to Location' immediately to prevent job reassignment!");
                    } else {
                        $('#general-warning-msg').text("Inactivity detected! You have not moved for 5 minutes. Resume travel immediately to prevent job reassignment!");
                    }
                } else {
                    $('#general-inactivity-warning').addClass('d-none');
                }

                // Dynamic UI updates for simulation
                if (res.status === "Driving") {
                    if (res.isSimulationPaused) {
                        $('#simStatusText').removeClass('text-success').addClass('text-warning').html('PAUSED (Stopped)');
                        $('#btnToggleSim').html('<i class="fa-solid fa-play me-1"></i> Resume Travel').removeClass('btn-outline-warning').addClass('btn-outline-success');
                    } else {
                        $('#simStatusText').removeClass('text-warning').addClass('text-success').html('ACTIVE (Driving)');
                        $('#btnToggleSim').html('<i class="fa-solid fa-pause me-1"></i> Pause Travel').removeClass('btn-outline-success').addClass('btn-outline-warning');
                    }

                    if (res.inactiveSeconds >= 30) {
                        $('#sim-warning-container').removeClass('d-none');
                    } else {
                        $('#sim-warning-container').addClass('d-none');
                    }
                }

                var newStatus = res.status || "";
                if (newStatus !== lastJobStatus) {
                    if (newStatus === "Completed" && $('#paymentQrModal').hasClass('show')) {
                        // Online payment processed! Show dynamic success box in QR modal
                        $('#qrCodeImg').parent().hide(); // Hide QR box
                        
                        if ($('#qrSuccessContainer').length === 0) {
                            $(`<div id="qrSuccessContainer" class="p-4 my-3 rounded bg-success bg-opacity-10 border border-success text-center">
                                <i class="fa-solid fa-circle-check text-success mb-2" style="font-size: 3rem;"></i>
                                <h5 class="text-success font-weight-bold">Payment Received!</h5>
                                <p class="text-light small mb-0">Customer has paid the bill online. Click below to complete and credit your wallet.</p>
                               </div>`).insertBefore('#btnConfirmQrPayment');
                        }
                        
                        $('#btnConfirmQrPayment').html('<i class="fa-solid fa-circle-check me-2"></i> Dismiss & Complete Job')
                                                 .removeClass('btn-success')
                                                 .addClass('btn-primary')
                                                 .prop('disabled', false);
                                                 
                        isOnlinePaymentConfirmed = true;
                        return;
                    }
                    location.reload();
                    return;
                }

                var newCustomApproved = (res.customEstimateApproved === null || res.customEstimateApproved === undefined) ? "null" : res.customEstimateApproved.toString().toLowerCase();
                var newPartsApproved = (res.partsApproved === null || res.partsApproved === undefined) ? "null" : res.partsApproved.toString().toLowerCase();
                var newTowingApproved = (res.towingApproved === null || res.towingApproved === undefined) ? "null" : res.towingApproved.toString().toLowerCase();

                if (newCustomApproved !== lastCustomEstimateApproved || 
                    newPartsApproved !== lastPartsApproved || 
                    newTowingApproved !== lastTowingApproved) {
                    
                    location.reload();
                }
            } else {
                location.reload();
            }
        });
    }

    function toggleSim() {
        var activeJobId = "@(activeJob?.Id ?? 0)";
        if (activeJobId > 0) {
            $.post('/Mechanic/ToggleSimulationPause', { jobId: activeJobId }, function(res) {
                if (res && res.success) {
                    if (res.isSimulationPaused) {
                        $('#simStatusText').removeClass('text-success').addClass('text-warning').html('PAUSED (Stopped)');
                        $('#btnToggleSim').html('<i class="fa-solid fa-play me-1"></i> Resume Travel').removeClass('btn-outline-warning').addClass('btn-outline-success');
                    } else {
                        $('#simStatusText').removeClass('text-warning').addClass('text-success').html('ACTIVE (Driving)');
                        $('#btnToggleSim').html('<i class="fa-solid fa-pause me-1"></i> Pause Travel').removeClass('btn-outline-success').addClass('btn-outline-warning');
                        $('#sim-warning-container').addClass('d-none');
                    }
                }
            });
        }
    }

    if (currentActiveJobId && currentActiveJobId !== "0") {
        setInterval(pollActiveJobState, 2500);
    } else {
        // Standby polling: Only reload if an active job has actually been assigned to this mechanic directly
        setInterval(function() {
            if (window.currentDispatchJobId) return; // Do not reload while 15-second dispatch modal is active/ringing
            $.get('/Mechanic/CheckActiveJobOrPing?_t=' + Date.now(), function(res) {
                if (res && res.success && res.hasActiveJob && !window.currentDispatchJobId) {
                    location.reload();
                }
            });
        }, 3500);
    }

    function ackWarning(warningId) {
        $.post('/Mechanic/AcknowledgeWarning', { warningId: warningId }, function(res) {
            if (res.success) location.reload();
        });
    }

    // Dynamic Payment QR & Invoice Modal Functions
    var currentQrJobId = 0;
    var isOnlinePaymentConfirmed = false;

    function openPaymentQrModal(jobId, btnElement) {
        currentQrJobId = jobId;
        isOnlinePaymentConfirmed = false;
        
        var $btn = btnElement ? $(btnElement) : $('button[onclick*="openPaymentQrModal"]');
        var originalBtnHtml = $btn.length ? $btn.html() : '';
        if ($btn.length) {
            $btn.prop('disabled', true).html('<i class="fa-solid fa-circle-notch fa-spin me-2"></i> Opening QR...');
        }

        $('#qrCodeImg').parent().show();
        $('#qrSuccessContainer').remove();
        $('#btnConfirmQrPayment').prop('disabled', false)
                                 .html('<i class="fa-solid fa-check-circle me-2"></i> Confirm Customer Paid & Credit Wallet')
                                 .removeClass('btn-primary')
                                 .addClass('btn-success');
        
        // Instantly pop open the modal in 0ms!
        var modalEl = document.getElementById('paymentQrModal');
        var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();

        // Restore button state
        setTimeout(function() {
            if ($btn.length) { $btn.prop('disabled', false).html(originalBtnHtml); }
        }, 600);

        $.get('/Mechanic/GetJobInvoiceDetails?jobId=' + jobId + '&_t=' + Date.now(), function (res) {
            if (res && res.success) {
                $('#qrModalJobId').text('JOB #' + res.jobId);
                $('#qrModalTotalAmount').text('₹' + res.totalBillAmount.toFixed(2));
                $('#qrModalVisiting').text('₹' + res.visitingCharge.toFixed(2));
                $('#qrModalService').text('₹' + res.serviceChargeMin.toFixed(2));
                
                var extraTotal = res.customEstimateAmount + res.partsEstimateAmount + res.extraLabourCharge + res.towingCharge;
                if (extraTotal > 0) {
                    $('#qrModalExtra').text('₹' + extraTotal.toFixed(2));
                    $('#qrModalExtraRow').show();
                } else {
                    $('#qrModalExtraRow').hide();
                }

                $('#qrModalCommPct').text(res.commissionPercent.toFixed(0));
                $('#qrModalCommAmount').text(res.adminCommission.toFixed(2));
                $('#qrModalNetCredit').text('₹' + res.mechanicNetEarning.toFixed(2));

                // Generate Dynamic UPI QR Code URL
                var upiString = encodeURIComponent(`upi://pay?pa=${res.adminUpiId}&pn=${res.adminAccountHolderName}&am=${res.totalBillAmount.toFixed(2)}&cu=INR&tn=Job+RS-${res.jobId}`);
                var qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=${upiString}`;
                $('#qrCodeImg').attr('src', qrUrl);
            } else {
                alert('Could not fetch payment details.');
            }
        });
    }

    $('#btnConfirmQrPayment').click(function () {
        if (isOnlinePaymentConfirmed) {
            window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
            return;
        }
        if (!currentQrJobId) return;

        var $btn = $(this);
        var origHtml = $btn.html();
        $btn.prop('disabled', true).html('<i class="fa-solid fa-circle-notch fa-spin me-2"></i> Confirming & Crediting Wallet...');

        $.post('/Mechanic/CollectPaymentWithQr', { jobId: currentQrJobId }, function (res) {
            if (res && res.success) {
                var qrModal = bootstrap.Modal.getInstance(document.getElementById('paymentQrModal'));
                if (qrModal) qrModal.hide();

                alert(res.message);
                window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
            } else {
                $btn.prop('disabled', false).html(origHtml);
                alert(res?.message || 'Payment processing failed.');
            }
        }).fail(function() {
            window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
        });
    });

    function settleJobInCash(jobId, btnElement) {
        if (!confirm("Are you sure you collected the cash payment directly from the customer? Platform commission will be automatically debited from your wallet balance.")) {
            return;
        }

        var $btn = btnElement ? $(btnElement) : $('button[onclick*="settleJobInCash"]');
        var originalBtnHtml = $btn.length ? $btn.html() : '';
        if ($btn.length) {
            $btn.prop('disabled', true).html('<i class="fa-solid fa-circle-notch fa-spin me-1"></i> Settling Cash...');
        }

        $.post('/Mechanic/SettleCashPayment', { jobId: jobId }, function (res) {
            if (res && res.success) {
                alert(res.message);
                window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
            } else {
                if ($btn.length) { $btn.prop('disabled', false).html(originalBtnHtml); }
                alert(res?.message || 'Error processing cash settlement.');
            }
        }).fail(function() {
            window.location.replace('/Mechanic/Dashboard?t=' + Date.now());
        });
    }

    function showJobInvoiceModal(jobId) {
        $.get('/Mechanic/GetJobInvoiceDetails?jobId=' + jobId, function (res) {
            if (res && res.success) {
                $('#mechInvNumber').text(res.invoiceNo);
                $('#mechInvDate').text('Date: ' + res.date);
                $('#mechInvCustomerName').text(res.customerName);
                $('#mechInvCustomerPhone').text(res.customerPhone);
                $('#mechInvVehicleInfo').text(res.vehicleModel + ' (' + res.vehicleType + ' - ' + res.fuelType + ') • Reg: ' + res.vehicleRegNumber);
                $('#mechInvCustomerAddress').text(res.customerAddress);

                $('#mechInvMechanicName').text(res.mechanicName);
                $('#mechInvShopName').text(res.shopName);
                $('#mechInvMechanicPhone').text(res.mechanicPhone);
                $('#mechInvShopAddress').text(res.shopAddress);

                var rowsHtml = '';
                var itemNo = 1;

                rowsHtml += `<tr><td>${itemNo++}</td><td>Basic Visiting & Distance Charge</td><td class="text-end font-weight-bold">₹${res.visitingCharge.toFixed(2)}</td></tr>`;
                rowsHtml += `<tr><td>${itemNo++}</td><td>Breakdown Repair Service Fee (${res.problemType})</td><td class="text-end font-weight-bold">₹${res.serviceChargeMin.toFixed(2)}</td></tr>`;

                if (res.customEstimateAmount > 0) {
                    rowsHtml += `<tr><td>${itemNo++}</td><td>On-Spot Inspection Estimate (${res.customEstimateDetails || 'Custom Repair'})</td><td class="text-end font-weight-bold">₹${res.customEstimateAmount.toFixed(2)}</td></tr>`;
                }

                if (res.partsEstimateAmount > 0 || res.extraLabourCharge > 0) {
                    var partLabel = res.partsDetails || 'Spare Part';
                    if (res.partsMrp > res.partsEstimateAmount) {
                        partLabel += ` <span class="badge bg-secondary text-light">MRP: ₹${res.partsMrp.toFixed(2)}</span>`;
                    }
                    var partsTotal = res.partsEstimateAmount + res.extraLabourCharge;
                    rowsHtml += `<tr><td>${itemNo++}</td><td>Extra Spare Parts & Labour (${partLabel})</td><td class="text-end font-weight-bold">₹${partsTotal.toFixed(2)}</td></tr>`;
                }

                if (res.towingCharge > 0) {
                    rowsHtml += `<tr><td>${itemNo++}</td><td>Emergency Towing Assistance Charge</td><td class="text-end font-weight-bold">₹${res.towingCharge.toFixed(2)}</td></tr>`;
                }

                $('#mechInvItemsTable').html(rowsHtml);
                $('#mechInvTotalAmount').text('₹' + res.totalBillAmount.toFixed(2));
                
                // Show platform commission and net credited amount in invoice too
                $('#mechInvCommPercent').text(res.commissionPercent.toFixed(0));
                $('#mechInvCommAmount').text('₹' + res.adminCommission.toFixed(2));
                $('#mechInvNetCredit').text('₹' + res.mechanicNetEarning.toFixed(2));

                var invModal = new bootstrap.Modal(document.getElementById('jobInvoiceModal'));
                invModal.show();
            } else {
                alert('Could not fetch receipt details.');
            }
        });
    }

    function printMechanicInvoice() {
        window.print();
    }

    function applyHistoryDateFilter() {
        var startVal = $('#historyStartDate').val();
        var endVal = $('#historyEndDate').val();
        
        var startDate = null;
        var endDate = null;

        if (startVal) {
            startDate = new Date(startVal);
            startDate.setHours(0, 0, 0, 0);
        } else {
            // Default 1 month (30 days) ago
            startDate = new Date();
            startDate.setDate(startDate.getDate() - 30);
            startDate.setHours(0, 0, 0, 0);
        }

        if (endVal) {
            endDate = new Date(endVal);
            endDate.setHours(23, 59, 59, 999);
        } else {
            endDate = new Date();
            endDate.setHours(23, 59, 59, 999);
        }

        var visibleCount = 0;
        $('.history-job-row').each(function() {
            var rowDateStr = $(this).data('date');
            if (!rowDateStr) {
                rowDateStr = new Date().toISOString().split('T')[0];
            }
            var rowDate = new Date(rowDateStr);
            rowDate.setHours(0, 0, 0, 0);
            
            if (rowDate >= startDate && rowDate <= endDate) {
                $(this).removeClass('d-none');
                visibleCount++;
            } else {
                $(this).addClass('d-none');
            }
        });

        // Toggle placeholder row
        if (visibleCount === 0) {
            if ($('#historyNoJobsRow').length === 0) {
                $('table.history-table tbody').append('<tr id="historyNoJobsRow"><td colspan="7" class="text-center text-muted py-4">No completed jobs found for the selected date range.</td></tr>');
            } else {
                $('#historyNoJobsRow').removeClass('d-none');
            }
        } else {
            $('#historyNoJobsRow').addClass('d-none');
        }
    }

    function resetHistoryDateFilter() {
        // Clear input boxes so they are blank by default
        $('#historyStartDate').val('');
        $('#historyEndDate').val('');
        
        // Show jobs from current date back 1 month (30 days)
        var oneMonthAgo = new Date();
        oneMonthAgo.setDate(oneMonthAgo.getDate() - 30);
        oneMonthAgo.setHours(0, 0, 0, 0);

        var now = new Date();
        now.setHours(23, 59, 59, 999);

        var visibleCount = 0;
        $('.history-job-row').each(function() {
            var rowDateStr = $(this).data('date');
            if (!rowDateStr) {
                rowDateStr = new Date().toISOString().split('T')[0];
            }
            var rowDate = new Date(rowDateStr);
            rowDate.setHours(0, 0, 0, 0);

            if (rowDate >= oneMonthAgo && rowDate <= now) {
                $(this).removeClass('d-none');
                visibleCount++;
            } else {
                $(this).addClass('d-none');
            }
        });

        if (visibleCount === 0) {
            if ($('#historyNoJobsRow').length === 0) {
                $('table.history-table tbody').append('<tr id="historyNoJobsRow"><td colspan="7" class="text-center text-muted py-4">No completed jobs found in the last 1 month.</td></tr>');
            } else {
                $('#historyNoJobsRow').removeClass('d-none');
            }
        } else {
            $('#historyNoJobsRow').addClass('d-none');
        }
    }

    $(document).ready(function() {
        $('#jobInvoiceModal').on('hidden.bs.modal', function () {
            location.reload();
        });

        if ($('#lblCardDispatchCountdown').length > 0) {
            var cardSeconds = 15;
            var cardInterval = setInterval(function() {
                cardSeconds--;
                if (cardSeconds < 0) cardSeconds = 0;
                $('#lblCardDispatchCountdown').text(cardSeconds);
                if (cardSeconds <= 0) {
                    clearInterval(cardInterval);
                    var pingId = "@(pingJob?.Id ?? 0)";
                    if (pingId > 0 && typeof timeoutPing === 'function') {
                        timeoutPing(pingId);
                    }
                }
            }, 1000);
        }
    });

</script>
}

