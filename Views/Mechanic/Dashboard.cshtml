                <!-- Map Preview Box -->
                <div class="p-2 bg-black rounded border border-secondary text-center mb-3">
                    <span class="text-muted small d-block mb-1"><i class="fa-solid fa-map-location-dot me-1"></i> Approximate Breakdown Location Preview</span>
                    <div style="height: 140px; background: #0f172a; border-radius: 8px;" class="d-flex align-items-center justify-content-center">
                        <span class="text-warning font-weight-bold"><i class="fa-solid fa-location-crosshairs fa-2x d-block mb-1"></i> GPS Coordinates Locked to Sector 62</span>
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-6">
                        <button type="button" class="btn btn-success btn-lg w-100 py-3 font-weight-bold fs-5 shadow-lg" id="btnAcceptDispatchModal">
                            <i class="fa-solid fa-check me-2"></i> Accept Request
                        </button>
                    </div>
                    <div class="col-3">
                        <button type="button" class="btn btn-outline-danger btn-lg w-100 py-3 font-weight-bold" id="btnDeclineDispatchModal" title="Decline job request permanently">
                            Decline
                        </button>
                    </div>
                    <div class="col-3">
                        <button type="button" class="btn btn-outline-secondary btn-lg w-100 py-3 font-weight-bold text-light" id="btnSnoozeDispatchModal" title="Close alert for 10 minutes">
                            Close
