                                <p class="mb-1 text-muted small"><i class="fa-solid fa-phone me-1"></i> <span id="mechInvCustomerPhone">--</span></p>
                                <p class="mb-1 text-muted small"><i class="fa-solid fa-car me-1"></i> <span id="mechInvVehicleInfo">--</span></p>
                                <p class="mb-0 text-muted small"><i class="fa-solid fa-location-dot me-1"></i> <span id="mechInvCustomerAddress">--</span></p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-black bg-opacity-40 rounded-3 border border-secondary h-100">
                                <h6 class="text-info font-weight-bold mb-2"><i class="fa-solid fa-screwdriver-wrench me-1"></i> Service Partner Details</h6>
                                <p class="mb-1 text-light font-weight-bold" id="mechInvMechanicName">--</p>
                                <p class="mb-1 text-muted small"><i class="fa-solid fa-shop me-1"></i> <span id="mechInvShopName">--</span></p>
                                <p class="mb-1 text-muted small"><i class="fa-solid fa-phone me-1"></i> <span id="mechInvMechanicPhone">--</span></p>
                                <p class="mb-0 text-muted small"><i class="fa-solid fa-map-pin me-1"></i> <span id="mechInvShopAddress">--</span></p>
                            </div>
                        </div>
                    </div>

                    <!-- Itemized Breakdown Table -->
                    <h6 class="text-white font-weight-bold mb-2"><i class="fa-solid fa-list-check me-1"></i> Itemized Price & Estimate Breakdown</h6>
                    <div class="table-responsive mb-4">
                        <table class="table table-dark table-striped table-bordered align-middle text-light mb-0">
                            <thead>
                                <tr class="table-secondary text-dark">
                                    <th>#</th>
                                    <th>Description / Service Item</th>
                                    <th class="text-end">Amount (₹)</th>
                                </tr>
                            </thead>
                            <tbody id="mechInvItemsTable">
                                <!-- Dynamic Items inserted via JS -->
                            </tbody>
                            <tfoot>
                                <tr class="table-dark fs-5 font-weight-bold">
                                    <td colspan="2" class="text-end text-warning">TOTAL PAID AMOUNT:</td>
                                    <td class="text-end text-success font-weight-extrabold" id="mechInvTotalAmount">₹0.00</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Platform Vault Net Credit Card -->
                    <div class="p-3 bg-black bg-opacity-60 rounded-3 border border-secondary" style="display: none !important;">
                        <div class="d-flex justify-content-between text-warning small font-weight-bold mb-1">
                            <span><i class="fa-solid fa-shield-halved text-warning me-1"></i> Platform Commission (<span id="mechInvCommPercent">10</span>%):</span>
                            <span class="text-warning font-weight-bold" id="mechInvCommAmount">-₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between text-success font-weight-bold fs-6">
                            <span><i class="fa-solid fa-wallet text-success me-1"></i> Net Wallet Credit:</span>
                            <span class="text-success font-weight-bold" id="mechInvNetCredit">₹0.00</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-secondary d-print-none">
                <button type="button" class="btn btn-outline-light font-weight-bold px-4 py-2" onclick="printMechanicInvoice()">
                    <i class="fa-solid fa-print me-1"></i> Print / Save PDF
                </button>
                <button type="button" class="btn btn-success font-weight-bold px-4 py-2" data-bs-dismiss="modal">
                    Close & Go Standby
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- 🎁 MECHANIC REFERRAL HUB & WALLET WITHDRAWAL MODAL -->
<!-- ======================================================== -->
<div class="modal fade" id="mechanicReferralModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark text-white border border-warning border-opacity-40 shadow-2xl" style="border-radius: 18px; overflow: hidden;">
            <div class="modal-header border-secondary p-3 px-4" style="background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(15, 23, 42, 0.95));">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-warning p-2 text-dark font-weight-bold">
                        <i class="fa-solid fa-gift fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title font-weight-bold mb-0 text-white" style="font-family: 'Outfit';">Mechanic Partner Referral Program</h5>
                        <span class="text-muted small">Refer fellow mechanics or onboard customers and earn extra wallet bonuses.</span>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            
            <div class="modal-body p-4">
                <!-- Top Earnings Stats -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="p-3 rounded-3 bg-black bg-opacity-40 border border-secondary text-center">
                            <span class="text-muted small text-uppercase font-weight-bold">Referral Balance</span>
                            <h3 class="text-success font-weight-extrabold mb-0 mt-1" style="font-family: 'Outfit';">₹@(refSummary?.ReferralWalletBalance.ToString("N2") ?? "0.00")</h3>
                            <span class="text-muted small">Withdrawable bonus</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded-3 bg-black bg-opacity-40 border border-secondary text-center">
                            <span class="text-muted small text-uppercase font-weight-bold">Pending Bonuses</span>
                            <h3 class="text-warning font-weight-extrabold mb-0 mt-1" style="font-family: 'Outfit';">₹@(refSummary?.PendingRewardAmount.ToString("N2") ?? "0.00")</h3>
                            <span class="text-muted small">@(refSummary?.PendingReferralCount ?? 0) partners/users pending 1st job</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded-3 bg-black bg-opacity-40 border border-secondary text-center">
                            <span class="text-muted small text-uppercase font-weight-bold">Total Disbursed</span>
                            <h3 class="text-info font-weight-extrabold mb-0 mt-1" style="font-family: 'Outfit';">₹@(refSummary?.LifetimeEarnings.ToString("N2") ?? "0.00")</h3>
                            <span class="text-muted small">@(refSummary?.SuccessfulReferralCount ?? 0) completed referrals</span>
                        </div>
                    </div>
                </div>

                <!-- Dual Share Cards: M2M & M2C -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 border border-warning border-opacity-30 bg-black bg-opacity-50 h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge bg-warning text-dark font-weight-bold">REFER MECHANIC (M2M)</span>
                                    <span class="text-warning font-weight-bold small">Earn ₹@refSettings.M2M_ReferrerReward.ToString("N0")</span>
                                </div>
                                <p class="text-muted small mb-2">Invite partner mechanics to join RaahSathi. Earn ₹@refSettings.M2M_ReferrerReward.ToString("N0") when they get verified and complete 1st job (New mechanic gets ₹@refSettings.M2M_RefereeReward.ToString("N0")).</p>
                            </div>
                            <button type="button" class="btn btn-warning btn-sm font-weight-bold text-dark w-100" onclick="shareMechanicM2MWhatsApp(@refSettings.M2M_RefereeReward)">
                                <i class="fa-brands fa-whatsapp me-1 fs-6"></i> Share with Mechanics
                            </button>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-3 border border-info border-opacity-30 bg-black bg-opacity-50 h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge bg-info text-dark font-weight-bold">REFER CUSTOMER (M2C)</span>
                                    <span class="text-info font-weight-bold small">Earn ₹@refSettings.M2C_ReferrerReward.ToString("N0")</span>
                                </div>
                                <p class="text-muted small mb-2">Give your code to vehicle owners at your garage. Earn ₹@refSettings.M2C_ReferrerReward.ToString("N0") commission on their 1st breakdown booking (Customer gets ₹@refSettings.M2C_RefereeReward.ToString("N0") discount).</p>
                            </div>
                            <button type="button" class="btn btn-info btn-sm font-weight-bold text-white w-100" onclick="shareMechanicM2CWhatsApp(@refSettings.M2C_RefereeReward)">
                                <i class="fa-brands fa-whatsapp me-1 fs-6"></i> Share with Customers
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Unique Referral Code Copy Bar -->
                <div class="p-3 rounded-3 border border-secondary bg-dark mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <span class="text-muted small font-weight-bold">YOUR UNIQUE PARTNER CODE:</span>
                        <span class="text-warning font-monospace font-weight-extrabold fs-5 ms-2" id="mechRefCodeText">@(refSummary?.ReferralCode ?? "RSM-PARTNER")</span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-warning btn-sm font-weight-bold px-3" onclick="copyMechanicReferralCode()">
                            <i class="fa-solid fa-copy me-1"></i> <span id="btnCopyMechText">Copy Code</span>
                        </button>
                        <button type="button" class="btn btn-outline-info btn-sm font-weight-bold px-3" onclick="shareMechanicSms()">
                            <i class="fa-solid fa-comment-sms me-1"></i> SMS
                        </button>
                    </div>
                </div>

                <!-- Navigation Tabs: Referred Network VS Withdrawal Request -->
                <ul class="nav nav-pills nav-fill mb-3 bg-dark bg-opacity-60 p-1 rounded-3 border border-secondary" id="mechRefModalTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active font-weight-bold text-white py-2" id="mechRefFriendsTab" data-bs-toggle="pill" data-bs-target="#mechRefFriendsContent" type="button">
                            <i class="fa-solid fa-network-wired me-1.5 text-warning"></i> My Referral Network (@(refSummary?.ReferredFriends.Count ?? 0))
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link font-weight-bold text-white py-2" id="mechRefWithdrawTab" data-bs-toggle="pill" data-bs-target="#mechRefWithdrawContent" type="button">
                            <i class="fa-solid fa-money-bill-wave me-1.5 text-success"></i> Request Bonus Payout
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link font-weight-bold text-white py-2" id="mechRefHistoryTab" data-bs-toggle="pill" data-bs-target="#mechRefHistoryContent" type="button">
                            <i class="fa-solid fa-clock-rotate-left me-1.5 text-info"></i> Payout Ledger
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="mechRefModalTabsContent">
                    <!-- Tab 1: Network Tracker -->
                    <div class="tab-pane fade show active" id="mechRefFriendsContent" role="tabpanel">
                        @if (refSummary == null || refSummary.ReferredFriends.Count == 0)
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="fa-solid fa-users-gear fa-2x mb-2 text-warning opacity-60"></i>
                                <p class="mb-1">No referrals recorded under your code yet.</p>
                                <span class="small text-muted">Share your code with fellow mechanics and customers to start earning bonuses!</span>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive" style="max-height: 240px; overflow-y: auto;">
                                <table class="table table-dark table-sm table-hover mb-0 align-middle">
                                    <thead class="text-muted small text-uppercase">
                                        <tr>
                                            <th>Invited Name</th>
                                            <th>Role / Stage</th>
                                            <th>Bonus</th>
                                            <th>Status</th>
                                            <th>Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var f in refSummary.ReferredFriends)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="font-weight-bold text-white">@f.FriendName</div>
                                                    <div class="text-muted small">@f.FriendPhone</div>
                                                </td>
                                                <td>
                                                    <span class="badge @(f.StageType == "M2M" ? "bg-warning text-dark" : "bg-info text-dark")">@f.StageType</span>
                                                </td>
                                                <td class="text-warning font-weight-bold">+₹@f.ExpectedReward.ToString("N0")</td>
                                                <td>
                                                    @if (f.Status == "Completed")
                                                    {
                                                        <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i> Reward Credited</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i> Pending 1st Service</span>
                                                    }
                                                </td>
                                                <td class="text-muted small">@f.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    <!-- Tab 2: Withdrawal Form -->
                    <div class="tab-pane fade" id="mechRefWithdrawContent" role="tabpanel">
                        <form action="/Mechanic/SubmitReferralWithdrawal" method="POST">
                            <div class="p-3 bg-black bg-opacity-40 rounded-3 border border-secondary mb-3">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label text-muted small font-weight-bold">Withdrawal Amount (₹) <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-dark border-secondary text-success">₹</span>
                                            <input type="number" step="1" min="@refSettings.MinWithdrawalAmount" max="@(refSummary?.ReferralWalletBalance ?? 0)" name="amount" class="form-control glass-input text-white font-weight-bold" placeholder="Min ₹@refSettings.MinWithdrawalAmount.ToString("N0")" required />
                                        </div>
                                        <span class="text-muted" style="font-size: 0.72rem;">Available: ₹@(refSummary?.ReferralWalletBalance.ToString("N2") ?? "0.00")</span>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label text-muted small font-weight-bold">Payout Method <span class="text-danger">*</span></label>
                                        <select name="payoutMethod" id="mechPayoutMethodSelect" class="form-select glass-input text-white bg-dark border-secondary" onchange="toggleMechPayoutFields()" required>
                                            <option value="UPI">UPI (PhonePe, GPay, Paytm)</option>
                                            <option value="Bank">Bank Account Transfer</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <!-- UPI Details -->
                            <div id="mechUpiSection" class="mb-3">
                                <label class="form-label text-muted small font-weight-bold">UPI ID (VPA) <span class="text-danger">*</span></label>
                                <input type="text" name="upiId" class="form-control glass-input text-white" value="@profile.UpiId" placeholder="e.g. 9876543210@upi" />
                            </div>

                            <!-- Bank Details -->
                            <div id="mechBankSection" class="row g-2 mb-3" style="display: none;">
                                <div class="col-md-6">
                                    <label class="form-label text-muted small font-weight-bold">Account Holder Name</label>
                                    <input type="text" name="accountHolder" class="form-control glass-input text-white" value="@(string.IsNullOrEmpty(profile.AccountHolderName) ? user.Name : profile.AccountHolderName)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small font-weight-bold">Bank Name</label>
                                    <input type="text" name="bankName" class="form-control glass-input text-white" value="@profile.BankName" placeholder="e.g. SBI" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small font-weight-bold">Account Number</label>
                                    <input type="text" name="bankAccount" class="form-control glass-input text-white font-monospace" value="@profile.BankAccountNumber" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small font-weight-bold">IFSC Code</label>
                                    <input type="text" name="ifsc" class="form-control glass-input text-white text-uppercase" value="@profile.IfscCode" />
                                </div>
                            </div>

                            <button type="submit" class="btn btn-success w-100 font-weight-bold py-2.5 shadow" @((refSummary?.ReferralWalletBalance ?? 0) < refSettings.MinWithdrawalAmount ? "disabled" : "")>
                                <i class="fa-solid fa-paper-plane me-1"></i> Submit Referral Payout Request
                            </button>
                            @if ((refSummary?.ReferralWalletBalance ?? 0) < refSettings.MinWithdrawalAmount)
                            {
                                <div class="text-center text-muted small mt-2">
                                    <i class="fa-solid fa-circle-info text-warning me-1"></i> Minimum withdrawal balance is ₹@refSettings.MinWithdrawalAmount.ToString("N0").
                                </div>
                            }
                        </form>
                    </div>

                    <!-- Tab 3: History -->
                    <div class="tab-pane fade" id="mechRefHistoryContent" role="tabpanel">
                        @if (refSummary == null || refSummary.WithdrawalHistory.Count == 0)
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="fa-solid fa-receipt fa-2x mb-2 text-secondary opacity-60"></i>
                                <p class="mb-0">No past referral payout requests.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive" style="max-height: 240px; overflow-y: auto;">
                                <table class="table table-dark table-sm table-hover mb-0 align-middle">
                                    <thead class="text-muted small text-uppercase">
                                        <tr>
                                            <th>Req ID</th>
                                            <th>Amount</th>
                                            <th>Method</th>
                                            <th>Status</th>
                                            <th>Date</th>
                                            <th>Reference / Remarks</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var w in refSummary.WithdrawalHistory)
                                        {
                                            <tr>
                                                <td class="font-monospace text-warning font-weight-bold">#REF-W@w.Id.ToString("D4")</td>
                                                <td class="text-white font-weight-bold">₹@w.Amount.ToString("N2")</td>
                                                <td><span class="badge bg-secondary">@w.PayoutMethod</span></td>
                                                <td>
                                                    @if (w.Status == "Approved")
                                                    {
                                                        <span class="badge bg-success">Paid</span>
                                                    }
                                                    else if (w.Status == "Pending")
                                                    {
                                                        <span class="badge bg-warning text-dark">Pending</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">Rejected</span>
                                                    }
                                                </td>
                                                <td class="text-muted small">@w.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                                <td class="text-muted small">
                                                    @(string.IsNullOrEmpty(w.TransactionReference) ? w.AdminRemarks : $"{w.TransactionReference} - {w.AdminRemarks}")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function openMechanicReferralModal() {
        new bootstrap.Modal(document.getElementById('mechanicReferralModal')).show();
    }

    function toggleMechPayoutFields() {
        var method = document.getElementById('mechPayoutMethodSelect').value;
        if (method === 'UPI') {
            document.getElementById('mechUpiSection').style.display = 'block';
            document.getElementById('mechBankSection').style.display = 'none';
        } else {
            document.getElementById('mechUpiSection').style.display = 'none';
            document.getElementById('mechBankSection').style.display = 'flex';
        }
    }

    function copyMechanicReferralCode() {
        var code = document.getElementById('mechRefCodeText').textContent.trim();
        navigator.clipboard.writeText(code).then(function() {
            var btnText = document.getElementById('btnCopyMechText');
            btnText.textContent = 'Copied!';
            setTimeout(function() { btnText.textContent = 'Copy Code'; }, 2000);
        });
    }

    function shareMechanicM2MWhatsApp(refereeReward) {
        var code = document.getElementById('mechRefCodeText').textContent.trim();
        var shareLink = window.location.origin + '/Auth/Login?ref=' + encodeURIComponent(code) + '&role=Mechanic';
        var rewardAmt = refereeReward || 150;
        var msg = "Bhai! 🧰 RaahSathi mechanic partner network join karo aur daily breakdown jobs pao. Mera Referral Code: *" + code + "* use karo to ₹" + rewardAmt + " welcome bonus milega. Register now: " + shareLink;
        window.open('https://api.whatsapp.com/send?text=' + encodeURIComponent(msg), '_blank');
    }

    function shareMechanicM2CWhatsApp(refereeReward) {
        var code = document.getElementById('mechRefCodeText').textContent.trim();
        var shareLink = window.location.origin + '/Auth/Login?ref=' + encodeURIComponent(code);
        var rewardAmt = refereeReward || 100;
        var msg = "Namaste! 🚗 Kabhi bhi raste me car ya bike breakdown ho, to RaahSathi se instant mechanic book karein. Mera coupon code *" + code + "* lagakar pehli service par ₹" + rewardAmt + " discount paayein: " + shareLink;
        window.open('https://api.whatsapp.com/send?text=' + encodeURIComponent(msg), '_blank');
    }

    function shareMechanicSms() {
        var code = document.getElementById('mechRefCodeText').textContent.trim();
        var shareLink = window.location.origin + '/Auth/Login?ref=' + encodeURIComponent(code);
        var msg = "Join RaahSathi roadside network! Use referral code: " + code + ". Link: " + shareLink;
        window.location.href = 'sms:?body=' + encodeURIComponent(msg);
    }
</script>


