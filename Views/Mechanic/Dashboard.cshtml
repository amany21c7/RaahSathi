@using RaahSathi.Models
@{
    ViewData["Title"] = "Mechanic Control Hub";
    var user = ViewBag.User as User ?? new User();
    var profile = ViewBag.Profile as MechanicProfile ?? new MechanicProfile();
    var activeJob = ViewBag.ActiveJob as Job;
    var pingJob = ViewBag.PingJob as Job;
    var pastJobs = ViewBag.PastJobs as List<Job> ?? new List<Job>();
    var activeWarning = ViewBag.ActiveWarning as MechanicWarning;
    var supportMessages = ViewBag.SupportMessages as List<MechanicSupportMessage> ?? new List<MechanicSupportMessage>();
    int unreadSupport = ViewBag.UnreadSupportCount as int? ?? 0;
}

<style>
    /* Professional Mechanic Operating Control Styling */
    .mech-stat-card {
        background: rgba(18, 31, 53, 0.85);
        border: 1px solid rgba(255, 107, 0, 0.2);
        border-radius: 12px;
        padding: 16px;
        transition: all 0.25s ease;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    }
    .mech-stat-card:hover {
        border-color: rgba(255, 107, 0, 0.5);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(255, 107, 0, 0.15);
    }
    .status-stage-step {
        flex: 1;
        text-align: center;
        padding: 10px 4px;
        font-size: 0.78rem;
        font-weight: 600;
        border-radius: 8px;
        background: #0f172a;
        color: #64748b;
        border: 1px solid #1e293b;
        transition: all 0.25s ease;
    }
    .status-stage-step.active {
        background: linear-gradient(135deg, #ff7e15 0%, #e04f00 100%);
        color: #ffffff !important;
        border-color: #ff6b00;
        box-shadow: 0 4px 12px rgba(255, 107, 0, 0.4);
    }
    .status-stage-step.completed {
        background: rgba(16, 185, 129, 0.15);
        color: #10b981;
        border-color: rgba(16, 185, 129, 0.4);
    }
    .dispatch-timer-circle {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: #0a1324;
        border: 3px solid #ef4444;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        font-weight: 800;
        color: #ef4444;
        animation: pulseTimer 1s infinite alternate;
    }
    @@keyframes pulseTimer {
        from { transform: scale(1); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4); }
        to { transform: scale(1.08); box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
    }
    .mech-tab-btn {
        padding: 10px 18px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.9rem;
        color: #94a3b8;
        border: 1px solid transparent;
        background: transparent;
        transition: all 0.2s ease;
    }
    .mech-tab-btn:hover {
        color: #ffffff;
        background: rgba(255, 107, 0, 0.1);
    }
    .mech-tab-btn.active {
        background: linear-gradient(135deg, #ff7e15 0%, #e04f00 100%) !important;
        color: #ffffff !important;
        box-shadow: 0 4px 14px rgba(255, 107, 0, 0.35);
    }
    .smart-score-pill {
        background: linear-gradient(135deg, #059669 0%, #10b981 100%);
        color: #ffffff;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 3px 10px rgba(16, 185, 129, 0.3);
    }
    .bottom-mech-nav {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(10, 19, 36, 0.96);
        backdrop-filter: blur(15px);
        border-top: 1.5px solid rgba(255, 107, 0, 0.3);
        z-index: 1040;
        padding: 8px 12px;
    }

    /* Print Styles for Mechanic Invoice */
    @@media print {
        body * {
            visibility: hidden;
        }
        #jobInvoiceModal, #jobInvoiceModal * {
            visibility: visible;
        }
        #jobInvoiceModal {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            margin: 0;
            padding: 0;
            border: none !important;
            box-shadow: none !important;
            background: #fff !important;
            color: #000 !important;
        }
        #mechInvoicePrintArea, #mechInvoicePrintArea * {
            visibility: visible;
        }
        #mechInvoicePrintArea {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            background: #fff !important;
            color: #000 !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        .d-print-none, .modal-header, .btn-close {
            display: none !important;
        }
        .bg-dark, .bg-black, .bg-opacity-80, .bg-opacity-40 {
            background: #fff !important;
            color: #000 !important;
            border: 1px solid #ccc !important;
        }
        .text-light, .text-muted, .text-warning, .text-info, .text-success, .text-white-50 {
            color: #000 !important;
        }
        .table-dark {
            background-color: #fff !important;
            color: #000 !important;
        }
        .table-dark th, .table-dark td {
            border: 1px solid #000 !important;
            color: #000 !important;
        }
        .badge {
            border: 1px solid #000 !important;
            color: #000 !important;
            background: #eee !important;
        }
    }
</style>

<div class="container-fluid px-2 px-md-4 py-3 pb-5 mb-5">

    <!-- Active Official Warning Banner from Admin -->
    @if (activeWarning != null)
    {
        <div class="alert alert-danger bg-dark border-danger text-light p-3 mb-4 rounded-3 d-flex align-items-center justify-content-between shadow-lg">
            <div class="d-flex align-items-center gap-3">
                <i class="fa-solid fa-triangle-exclamation text-danger fa-2x"></i>
                <div>
                    <h6 class="text-danger mb-0 font-weight-bold">⚠️ Official Safety Warning from Operations Admin</h6>
                    <p class="mb-0 small text-muted">@activeWarning.Message</p>
                </div>
            </div>
            <button class="btn btn-danger btn-sm px-3 font-weight-bold" onclick="ackWarning(@activeWarning.Id)">
                <i class="fa-solid fa-check me-1"></i> Acknowledge
            </button>
        </div>
    }

    <!-- 🟢 TOP STATS HEADER & GO ONLINE CONTROLLER -->
    <div class="glass-card mb-4 p-3 p-md-4 border-warning border-opacity-30">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-3 border-bottom border-secondary border-opacity-40 pb-3">
            <div class="d-flex align-items-center gap-3">
                <img src="@(string.IsNullOrEmpty(profile.ProfilePhotoUrl) ? "/images/default_avatar.png" : profile.ProfilePhotoUrl)" class="rounded-circle border border-warning" style="width: 52px; height: 52px; object-fit: cover;" />
                <div>
                    <h4 class="text-white font-weight-bold mb-0" style="font-family: 'Outfit';">@user.Name</h4>
                    <div class="d-flex align-items-center gap-2 mt-1">
                        <span class="badge @(profile.IsOnline ? "bg-success text-white" : "bg-secondary text-light") rounded-pill px-3 py-1 font-weight-bold" id="badgeOnlineStatus">
                            <i class="fa-solid fa-circle me-1" style="font-size:0.6rem;"></i> @(profile.IsOnline ? "🟢 ONLINE" : "⚪ OFFLINE")
                        </span>
                        <span class="text-muted small">| <i class="fa-solid fa-shield-halved text-warning me-1"></i> KYC: <b>@profile.KycStatus</b></span>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="form-check form-switch me-2 fs-5 d-flex align-items-center gap-2">
                    <input class="form-check-input" type="checkbox" role="switch" id="toggleOnlineSwitch" @(profile.IsOnline ? "checked" : "") onclick="toggleMechanicOnlineState()">
                    <label class="form-check-label text-white small font-weight-bold" for="toggleOnlineSwitch" id="lblSwitchOnline">
                        @(profile.IsOnline ? "Status: Online" : "Status: Offline")
                    </label>
                </div>
                <button class="btn btn-premium-primary btn-sm rounded-pill px-4" onclick="switchMechTab('tab-home')">
                    <i class="fa-solid fa-house me-1"></i> Home
                </button>
                <button class="btn btn-premium-secondary btn-sm rounded-pill px-3" onclick="switchMechTab('tab-requests')">
                    <i class="fa-solid fa-bell me-1"></i> Requests (@(pingJob != null ? 1 : 0))
                </button>
                <button class="btn btn-premium-secondary btn-sm rounded-pill px-3" onclick="switchMechTab('tab-jobs')">
                    <i class="fa-solid fa-wrench me-1"></i> My Jobs
                </button>
                <button class="btn btn-premium-secondary btn-sm rounded-pill px-3" onclick="switchMechTab('tab-wallet')">
                    <i class="fa-solid fa-wallet me-1"></i> Earnings
                </button>
                <button class="btn btn-outline-info btn-sm rounded-pill px-3 position-relative" onclick="switchMechTab('tab-support')">
                    <i class="fa-solid fa-inbox me-1"></i> Support Inbox
                    @if (unreadSupport > 0)
                    {
                        <span class="badge bg-danger rounded-circle ms-1">@unreadSupport</span>
                    }
                </button>
                <button class="btn btn-premium-secondary btn-sm rounded-pill px-3" onclick="switchMechTab('tab-profile')">
                    <i class="fa-solid fa-user-gear me-1"></i> Profile
                </button>
            </div>
        </div>

        <!-- 5-Box Professional Metrics Grid -->
        <div class="row g-2 g-md-3">
            <div class="col-6 col-md">
                <div class="mech-stat-card text-center">
                    <span class="text-muted small d-block mb-1 font-weight-medium">Today's Earnings</span>
                    <h3 class="text-success font-weight-extrabold mb-0" id="topTodayEarnings" style="font-family: 'Outfit';">₹@(((double)ViewBag.TodayEarnings).ToString("N0"))</h3>
                </div>
            </div>
            <div class="col-6 col-md">
                <div class="mech-stat-card text-center">
                    <div class="d-flex align-items-center justify-content-center gap-1 mb-1">
                        <select id="jobStatRangeSelect" class="bg-transparent border-0 text-muted small font-weight-medium p-0 text-center" style="outline: none; cursor: pointer; color: #a0aec0 !important; width: 100px; -webkit-appearance: none; -moz-appearance: none; appearance: none;">
                            <option value="today" class="bg-dark text-light">Today's Jobs</option>
                            <option value="weekly" class="bg-dark text-light">Weekly Jobs</option>
                        </select>
                        <i class="fa-solid fa-chevron-down text-muted" style="font-size:0.6rem;"></i>
                    </div>
                    <h3 class="text-warning font-weight-extrabold mb-0" id="topJobsCount" style="font-family: 'Outfit';">@ViewBag.TodayJobsCount</h3>
                </div>
            </div>
            <div class="col-6 col-md">
                <div class="mech-stat-card text-center">
                    <span class="text-muted small d-block mb-1 font-weight-medium">Pending Requests</span>
                    <h3 class="text-info font-weight-extrabold mb-0" style="font-family: 'Outfit';">@(pingJob != null ? 1 : 0)</h3>
                </div>
            </div>
            <div class="col-6 col-md">
                <div class="mech-stat-card text-center">
                    <span class="text-muted small d-block mb-1 font-weight-medium">Rating</span>
                    <h3 class="text-warning font-weight-extrabold mb-0" style="font-family: 'Outfit';">⭐ @profile.Rating.ToString("F1")</h3>
                </div>
            </div>
            <div class="col-12 col-md">
                <div class="mech-stat-card text-center">
                    <span class="text-muted small d-block mb-1 font-weight-medium">Acceptance Rate</span>
                    <h3 class="text-primary font-weight-extrabold mb-0" style="font-family: 'Outfit';">@profile.AcceptanceRatePercentage%</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT TAB CONTAINERS -->

    <!-- ==================== TAB 1: HOME ==================== -->
    <div id="tab-home" class="mech-tab-content">
        @if (activeJob != null)
        {
            <!-- ACTIVE JOB PROGRESSION WORKFLOW -->
            <div class="glass-card mb-4 border-warning border-opacity-50">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3 border-bottom border-secondary border-opacity-40 pb-3">
                    <div>
                        <span class="badge bg-warning text-dark px-3 py-1 font-weight-bold mb-1">JOB #@activeJob.Id • IN PROGRESS</span>
                        <h3 class="text-white font-weight-bold mb-0" style="font-family: 'Outfit';">@activeJob.Vehicle?.Model (@activeJob.Vehicle?.VehicleType)</h3>
                        <p class="text-muted small mb-0"><i class="fa-solid fa-wrench text-warning me-1"></i> Issue: <b class="text-light">@activeJob.ProblemType</b></p>
                    </div>
                    <div class="text-md-end">
                        <span class="text-muted small d-block font-weight-bold text-light">Estimated Earnings</span>
                        @{
                            double baseEstBill = activeJob.VisitingCharge + activeJob.ServiceChargeMin;
                            double currentBill = activeJob.FinalBillAmount > baseEstBill ? activeJob.FinalBillAmount : baseEstBill;
                            double mechEarnings = Math.Round(currentBill * (1 - profile.CommissionRate), 2);
                        }
                        <h3 class="text-success font-weight-extrabold mb-0" style="font-family: 'Outfit';">₹@mechEarnings.ToString("N2")</h3>
                        <span class="text-muted extra-small d-block mt-1" style="font-size: 0.76rem;" title="Includes Basic Visiting Charge + Per KM Distance + Vehicle Problem Service Charge">
                            Job Total: ₹@currentBill.ToString("N0") <i class="fa-solid fa-circle-info text-info ms-1" data-bs-toggle="tooltip" title="Basic Visiting Charge + Distance Fee (Per KM) + Vehicle Problem Service Charge"></i>
                        </span>
                    </div>
                </div>

                <!-- Highly Visible General Inactivity Warning banner -->
                <div id="general-inactivity-warning" class="alert alert-danger bg-dark border-danger text-danger small mb-3 d-none">
                    <i class="fa-solid fa-triangle-exclamation me-1 animate-pulse"></i> 
                    <strong>CRITICAL WARNING:</strong> 
                    <span id="general-warning-msg">Inactivity detected! Please respond immediately to prevent job reassignment!</span>
                </div>

                <!-- 6-Stage Progress Indicator Bar -->
                <div class="mb-4">
                    <span class="text-muted small d-block mb-2 font-weight-bold">Live Breakdown Repair Progress:</span>
                    <div class="d-flex flex-wrap gap-1">
                        @{
                            var stages = new[] { "Accepted", "Driving", "Arrived", "Inspecting", "Repairing", "Completed" };
                            var stageLabels = new[] { "1. Accepted", "2. Driving", "3. Arrived", "4. Inspection", "5. Repairing", "6. Completed" };
                            int currentIndex = Array.IndexOf(stages, activeJob.Status);
                            if (currentIndex < 0) currentIndex = 0;
                        }
                        @for (int idx = 0; idx < stages.Length; idx++)
                        {
                            bool isCurrent = idx == currentIndex;
                            bool isPast = idx < currentIndex;
                            <div class="status-stage-step @(isCurrent ? "active" : "") @(isPast ? "completed" : "")">
                                @if(isPast) { <i class="fa-solid fa-check me-1"></i> }
                                @stageLabels[idx]
                            </div>
                        }
                    </div>
                </div>

                <!-- Customer Details & Quick Contact Action Bar -->
                <div class="p-3 bg-dark bg-opacity-60 rounded-3 border border-secondary mb-4">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3 border-bottom border-secondary border-opacity-30 pb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-warning bg-opacity-20 border border-warning p-2 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                <i class="fa-solid fa-user-check text-warning fs-4"></i>
                            </div>
                            <div>
                                <h5 class="text-white mb-0">@activeJob.Customer?.Name</h5>
                                <span class="text-warning small"><i class="fa-solid fa-star"></i> 4.9 Rating Customer</span>
                            </div>
                        </div>

                        <!-- Revealed Communications Buttons -->
                        <div class="d-flex flex-wrap gap-2">
                            <a href="tel:@activeJob.Customer?.PhoneNumber" class="btn btn-success font-weight-bold px-4 py-2">
                                <i class="fa-solid fa-phone me-1"></i> Call (@activeJob.Customer?.PhoneNumber)
                            </a>
                            <button type="button" class="btn btn-outline-info font-weight-bold px-3 py-2 position-relative" data-bs-toggle="modal" data-bs-target="#liveChatMechModal" onclick="fetchMechChatMessages()">
                                <i class="fa-solid fa-comments me-1"></i> Live Chat with Customer
                                <span id="mech-chat-unread-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">0</span>
                            </button>
                            <a href="https://maps.google.com/?q=@activeJob.CustomerLat,@activeJob.CustomerLng" target="_blank" class="btn btn-outline-warning font-weight-bold px-3 py-2">
                                <i class="fa-solid fa-diamond-turn-right me-1"></i> Navigate GPS
                            </a>
                        </div>
                    </div>

                    <div class="row g-2 text-muted small">
                        <div class="col-md-6">
                            <span class="d-block mb-1"><i class="fa-solid fa-location-dot text-warning me-1"></i> Exact Address: <strong class="text-light">@activeJob.Address</strong></span>
                            <span class="d-block"><i class="fa-solid fa-flag text-warning me-1"></i> Landmark: <strong class="text-light">@(string.IsNullOrEmpty(activeJob.Landmark) ? "Near Sector 62 Main Gate" : activeJob.Landmark)</strong></span>
                        </div>
                        <div class="col-md-6">
                            <span class="d-block mb-1"><i class="fa-solid fa-id-card text-warning me-1"></i> Reg Number: <strong class="text-light">UP32 AB 1234</strong></span>
                            <span class="d-block"><i class="fa-solid fa-credit-card text-warning me-1"></i> Payment Mode: <strong class="text-success">Online Escrow / Cash</strong></span>
                        </div>
                    </div>
                </div>

                <!-- MECHANIC INTERACTIVE WORKFLOW STAGE ACTIONS -->
                <div class="p-3 bg-dark bg-opacity-40 rounded-3 border border-secondary">
                    <h5 class="text-warning mb-3"><i class="fa-solid fa-sliders me-2"></i> Update Repair Progress</h5>

                    @if (activeJob.Status == "Accepted")
                    {
                        <div class="alert alert-info bg-dark border-info text-info small mb-3">
                            <i class="fa-solid fa-car-side me-2"></i> Confirm when you start driving towards the customer.
                        </div>
                        <button class="btn btn-premium-primary w-100 py-3 font-weight-bold" onclick="advanceStatus('Driving')">
                            <i class="fa-solid fa-car-side me-2"></i> Start Driving to Location
                        </button>
                    }
                    else if (activeJob.Status == "Driving")
                    {
                        <div class="alert alert-info bg-dark border-info text-info small mb-3">
                            <i class="fa-solid fa-location-dot me-2"></i> Click when you reach the customer breakdown spot.
                        </div>
                        <button class="btn btn-premium-primary w-100 py-3 font-weight-bold" onclick="advanceStatus('Arrived')">
                            <i class="fa-solid fa-location-dot me-2"></i> I Have Arrived at Location
                        </button>

                        <div class="glass-card p-3 border-secondary mb-3 mt-3">
                            <h6 class="text-white font-weight-bold mb-2"><i class="fa-solid fa-route text-warning me-1"></i> GPS Travel Simulation Control</h6>
                            <p class="text-muted small">You can pause/resume your travel simulation for testing. If travel is paused or inactive for 5 minutes (30 seconds for quick testing), warning will trigger.</p>
                            
                            <div id="sim-warning-container" class="alert alert-danger bg-dark border-danger text-danger small mb-3 d-none">
                                <i class="fa-solid fa-triangle-exclamation me-1"></i> <strong>WARNING:</strong> Inactivity detected! You have not moved for 5 minutes. Resume travel immediately to prevent job reassignment!
                            </div>
                            
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <span class="small text-muted">Simulation Status:</span>
                                    <strong id="simStatusText" class="@(activeJob.IsSimulationPaused ? "text-warning" : "text-success")">
                                        @(activeJob.IsSimulationPaused ? "PAUSED (Stopped)" : "ACTIVE (Driving)")
                                    </strong>
                                </div>
                                <button id="btnToggleSim" class="btn @(activeJob.IsSimulationPaused ? "btn-outline-success" : "btn-outline-warning") btn-sm" onclick="toggleSim()">
                                    @if(activeJob.IsSimulationPaused)
                                    {
                                        <i class="fa-solid fa-play me-1"></i> <span>Resume Travel</span>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-pause me-1"></i> <span>Pause Travel</span>
                                    }
                                </button>
                            </div>
                        </div>
                    }
                    else if (activeJob.Status == "Arrived")
                    {
                        <div class="alert alert-warning bg-dark border-warning text-warning small mb-3">
                            <i class="fa-solid fa-magnifying-glass me-2"></i> Perform on-spot inspection to diagnose the vehicle issue.
                        </div>
                        <button class="btn btn-warning text-dark w-100 py-3 font-weight-bold" onclick="advanceStatus('Inspecting')">
                            <i class="fa-solid fa-stethoscope me-2"></i> Begin On-Spot Inspection
                        </button>
                    }
                    else if (activeJob.Status == "Inspecting")
                    {
                        <!-- Custom Estimate Input Section -->
                        <div class="glass-card p-3 border-info border-opacity-30 mb-3">
                            <h6 class="text-info font-weight-bold mb-2"><i class="fa-solid fa-calculator me-1"></i> Add Custom Repair Estimate</h6>
                            <p class="text-muted small mb-3">Enter the repair cost agreed upon after understanding customer requirements on spot.</p>
                            
                            <div class="row g-2 mb-3">
                                <div class="col-md-4">
                                    <label class="form-label text-muted small">Estimated Repair Cost (₹)</label>
                                    <input type="number" id="txtCustomEstimateAmount" class="form-control glass-input text-warning font-weight-bold" value="@(activeJob.CustomEstimateAmount > 0 ? activeJob.CustomEstimateAmount : 850)" placeholder="e.g. 850">
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label text-muted small">Work Details / Scope</label>
                                    <input type="text" id="txtCustomEstimateDetails" class="form-control glass-input" value="@(string.IsNullOrEmpty(activeJob.CustomEstimateDetails) ? "On-spot repair & Labour cost" : activeJob.CustomEstimateDetails)" placeholder="e.g. Battery jumpstart & alternator check">
                                </div>
                            </div>
                            <button class="btn btn-info text-dark font-weight-bold w-100 py-2.5" onclick="submitCustomEstimate()">
                                <i class="fa-solid fa-paper-plane me-1"></i> Send Estimate for Customer Approval
                            </button>

                            @if (activeJob.CustomEstimateApproved == true)
                            {
                                <div class="alert alert-success bg-dark border-success text-success small mt-3 mb-0">
                                    <i class="fa-solid fa-circle-check me-1"></i> Customer Approved Estimate ₹@activeJob.CustomEstimateAmount! You may start repair.
                                </div>
                            }
                            else if (activeJob.CustomEstimateApproved == false)
                            {
                                <div class="alert alert-danger bg-dark border-danger text-danger small mt-3 mb-0">
                                    <i class="fa-solid fa-circle-xmark me-1"></i> Customer Rejected Estimate. Please renegotiate or cancel.
                                </div>
                            }
                            else if (activeJob.CustomEstimateApproved == null && activeJob.CustomEstimateAmount > 0)
                            {
                                <div class="alert alert-warning bg-dark border-warning text-warning small mt-3 mb-0">
                                    <i class="fa-solid fa-spinner fa-spin me-1"></i> Estimate ₹@activeJob.CustomEstimateAmount sent to customer! Awaiting live approval...
                                </div>
                            }
                        </div>

                        <!-- Extra Parts Quote Input -->
                        <div class="glass-card p-3 border-secondary mb-3">
                            <h6 class="text-warning font-weight-bold mb-2"><i class="fa-solid fa-box-open me-1"></i> Add Extra Spare Parts (Optional)</h6>
                            <p class="text-muted small mb-3">Specify the part name, original MRP, offered bill price, and fitting labour charge.</p>

                            <div class="row g-2 mb-3">
                                <div class="col-md-3">
                                    <label class="form-label text-muted small">Part Name</label>
                                    <input type="text" id="txtExtraPartName" class="form-control glass-input text-white font-weight-bold" value="@(string.IsNullOrEmpty(activeJob.ExtraPartsName) ? "Exide 12V Battery" : activeJob.ExtraPartsName)" placeholder="e.g. Battery">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label text-muted small">Part MRP (₹)</label>
                                    <input type="number" id="txtExtraPartMrp" class="form-control glass-input text-info font-weight-bold" value="@(activeJob.PartsMrp > 0 ? activeJob.PartsMrp : 3500)" placeholder="e.g. 3500">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label text-muted small">Offered Part Price (₹)</label>
                                    <input type="number" id="txtExtraPartPrice" class="form-control glass-input text-warning font-weight-bold" value="@(activeJob.PartsEstimateAmount > 0 ? activeJob.PartsEstimateAmount : 3200)" placeholder="e.g. 3200">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label text-muted small">Labour Charge (₹)</label>
                                    <input type="number" id="txtExtraLabourPrice" class="form-control glass-input text-warning font-weight-bold" value="@(activeJob.ExtraLabourCharge > 0 ? activeJob.ExtraLabourCharge : 400)" placeholder="e.g. 400">
                                </div>
                            </div>
                            <button class="btn btn-outline-warning font-weight-bold w-100 py-2" onclick="submitSparesQuote()">
                                <i class="fa-solid fa-plus me-1"></i> Send Extra Parts Quote to Customer
                            </button>

                            @if (activeJob.PartsApproved == true)
                            {
                                <div class="alert alert-success bg-dark border-success text-success small mt-2 mb-0">
                                    <i class="fa-solid fa-circle-check me-1"></i> Customer Approved Extra Parts Quote! Added to bill.
                                </div>
                            }
                            else if (activeJob.PartsApproved == false)
                            {
                                <div class="alert alert-danger bg-dark border-danger text-danger small mt-2 mb-0">
                                    <i class="fa-solid fa-circle-xmark me-1"></i> Customer Rejected Extra Parts Quote.
                                </div>
                            }
                            else if (activeJob.PartsApproved == null && activeJob.PartsEstimateAmount > 0)
                            {
                                <div class="alert alert-warning bg-dark border-warning text-warning small mt-2 mb-0">
                                    <i class="fa-solid fa-spinner fa-spin me-1"></i> Extra Parts quote sent! Awaiting live customer approval...
                                </div>
                            }
                        </div>

                        <button class="btn btn-success w-100 py-3 font-weight-bold fs-5 shadow-lg" onclick="advanceStatus('Repairing')">
                            <i class="fa-solid fa-play me-2"></i> Start Repair Work
                        </button>
                    }
                    else if (activeJob.Status == "Repairing" || activeJob.Status == "Completed")
                    {
                        @if (activeJob.Status == "Repairing")
                        {
                            <!-- Extra Parts Quote Input for mid-repair discoveries -->
                            <div class="glass-card p-3 border-secondary mb-3">
                                <h6 class="text-warning font-weight-bold mb-2"><i class="fa-solid fa-box-open me-1"></i> Add/Update Extra Spare Parts during Repair</h6>
                                <p class="text-muted small mb-3">If you discover additional issues during repair, specify the spare part details and extra labour below to request customer approval.</p>

                                <div class="row g-2 mb-3">
                                    <div class="col-md-3">
                                        <label class="form-label text-muted small">Part Name</label>
                                        <input type="text" id="txtExtraPartName" class="form-control glass-input text-white font-weight-bold" value="@(activeJob.ExtraPartsName)" placeholder="e.g. Brake Pads">
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label text-muted small">Part MRP (₹)</label>
                                        <input type="number" id="txtExtraPartMrp" class="form-control glass-input text-info font-weight-bold" value="@(activeJob.PartsMrp > 0 ? activeJob.PartsMrp.ToString() : "")" placeholder="e.g. 1500">
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label text-muted small">Offered Part Price (₹)</label>
                                        <input type="number" id="txtExtraPartPrice" class="form-control glass-input text-warning font-weight-bold" value="@(activeJob.PartsEstimateAmount > 0 ? activeJob.PartsEstimateAmount.ToString() : "")" placeholder="e.g. 1200">
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label text-muted small">Labour Charge (₹)</label>
                                        <input type="number" id="txtExtraLabourPrice" class="form-control glass-input text-warning font-weight-bold" value="@(activeJob.ExtraLabourCharge > 0 ? activeJob.ExtraLabourCharge.ToString() : "")" placeholder="e.g. 300">
                                    </div>
                                </div>
                                <button class="btn btn-outline-warning font-weight-bold w-100 py-2" onclick="submitSparesQuote()">
                                    <i class="fa-solid fa-plus me-1"></i> Send Extra Parts Quote to Customer
                                </button>

                                @if (activeJob.PartsApproved == true)
                                {
                                    <div class="alert alert-success bg-dark border-success text-success small mt-2 mb-0">
                                        <i class="fa-solid fa-circle-check me-1"></i> Customer Approved Extra Parts Quote! Added to bill.
                                    </div>
                                }
                                else if (activeJob.PartsApproved == false)
                                {
                                    <div class="alert alert-danger bg-dark border-danger text-danger small mt-2 mb-0">
                                        <i class="fa-solid fa-circle-xmark me-1"></i> Customer Rejected Extra Parts Quote.
                                    </div>
                                }
                                else if (activeJob.PartsApproved == null && activeJob.PartsEstimateAmount > 0)
                                {
                                    <div class="alert alert-warning bg-dark border-warning text-warning small mt-2 mb-0">
                                        <i class="fa-solid fa-spinner fa-spin me-1"></i> Extra Parts quote sent! Awaiting live customer approval...
                                    </div>
                                }
                            </div>
                        }

                        <div class="alert alert-success bg-dark border-success text-success small mb-3">
                            <i class="fa-solid fa-qrcode me-2"></i> Repair in progress. Show QR code to customer to collect total bill payment.
                        </div>

                        <div class="d-flex flex-column gap-2">
                            <div class="d-flex align-items-center gap-2 w-100">
                                <button type="button" class="btn btn-warning text-dark btn-lg flex-grow-1 py-3 font-weight-bold shadow" onclick="openPaymentQrModal(@activeJob.Id)">
                                    <i class="fa-solid fa-qrcode me-2"></i> Collect Payment (UPI QR)
                                </button>
                                @if (activeJob.Status != "Completed")
                                {
                                    <button type="button" class="btn btn-info text-dark py-2.5 px-3 font-weight-bold shadow" onclick="settleJobInCash(@activeJob.Id)" style="background: linear-gradient(135deg, #0dcaf0 0%, #0aa2c0 100%) !important; border: none; font-size: 0.9rem; min-width: 130px; border-radius: 8px;">
                                        <i class="fa-solid fa-money-bill-wave me-1"></i> Pay in Cash
                                    </button>
                                }
                            </div>
                            
                            @if (activeJob.Status != "Completed")
                            {
                                <button type="button" class="btn btn-success btn-lg w-100 py-3 font-weight-bold shadow" onclick="advanceStatus('Completed')">
                                    <i class="fa-solid fa-circle-check me-2"></i> Mark Repair Completed
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- STANDBY HOME SCREEN -->
            <div class="glass-card text-center p-5 mb-4 border-warning border-opacity-30">
                <div class="p-4 rounded-circle bg-warning bg-opacity-10 border border-warning d-inline-block mb-3">
                    <i class="fa-solid fa-tower-broadcast text-warning" style="font-size: 3.5rem;"></i>
                </div>
                <h3 class="text-white font-weight-bold mb-2" style="font-family: 'Outfit';" id="dispatchTitleText">
                    @(profile.IsOnline ? "RaahSathi Dispatch Network Active" : "You Are Currently Offline")
                </h3>
                <p class="lead text-muted max-w-600 mx-auto mb-4" style="font-size: 1.05rem;" id="dispatchDescText">
                    @(profile.IsOnline ? "Standing by for breakdown assistance requests within your selected service radius." : "Switch status to Online in the top bar to start receiving incoming assistance pings.")
                </p>
                <div id="goOnlineBtnContainer">
                    @if (!profile.IsOnline)
                    {
                        <button class="btn btn-premium-primary btn-lg px-5 py-3 font-weight-bold" onclick="toggleMechanicOnlineState()">
                            <i class="fa-solid fa-power-off me-2"></i> Go Online Now
                        </button>
                    }
                </div>
            </div>
        }
    </div>

    <!-- ==================== TAB 2: REQUESTS ==================== -->
    <div id="tab-requests" class="mech-tab-content" style="display:none;">
        <div class="glass-card mb-4 border-info border-opacity-30">
            <h4 class="text-white font-weight-bold mb-3"><i class="fa-solid fa-bell text-info me-2"></i> Incoming Assistance Requests</h4>

            @if (pingJob != null && activeJob == null)
            {
                <div class="p-4 bg-dark bg-opacity-60 rounded-3 border border-warning shadow-lg">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="smart-score-pill">
                            <i class="fa-solid fa-star"></i> ⭐⭐⭐⭐⭐ Recommended Job | Battery Expert Match
                        </span>
                        <span class="badge bg-danger text-white px-3 py-1 font-weight-bold" id="cardTimerBadge">
                            <i class="fa-solid fa-clock me-1"></i> <span id="lblCardDispatchCountdown">15</span>s TIMER ACTIVE
                        </span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <h5 class="text-warning font-weight-bold mb-1">Hyundai i20 (Car)</h5>
                            <p class="text-muted small mb-2">Registration: <b>UP32 AB 1234</b></p>
                            <span class="badge bg-secondary text-light mb-2">Problem: Battery Dead</span>
                            <span class="d-block text-muted small"><i class="fa-solid fa-location-dot text-warning me-1"></i> Sector 62 Noida (Approx 3.8 KM)</span>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <span class="text-muted small d-block">Estimated Earnings</span>
                            <h3 class="text-success font-weight-bold mb-2">₹450 – ₹650</h3>
                            <button class="btn btn-success btn-lg px-5 font-weight-bold me-2" onclick="acceptPing(@pingJob.Id)">
                                <i class="fa-solid fa-check me-1"></i> Accept Request
                            </button>
                            <button class="btn btn-outline-danger btn-lg px-3 font-weight-bold" onclick="declinePing(@pingJob.Id)">
                                Decline
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <p class="text-muted text-center py-4 mb-0">No active dispatch requests pending right now.</p>
            }
        </div>
    </div>

    <!-- ==================== TAB 3: JOBS ==================== -->
    <div id="tab-jobs" class="mech-tab-content" style="display:none;">
        <div class="glass-card mb-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3 pb-2 border-bottom border-secondary border-opacity-30">
                <h4 class="text-white font-weight-bold mb-0"><i class="fa-solid fa-clock-rotate-left text-warning me-2"></i> Completed Repair History</h4>
                
                <!-- Date Filter Input Elements -->
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="text-muted small font-weight-medium">Select Range:</span>
                    <input type="date" id="historyStartDate" class="form-control form-control-sm glass-input text-warning py-1" style="width: 135px; font-size: 0.85rem;" title="Start Date">
                    <span class="text-muted small">to</span>
                    <input type="date" id="historyEndDate" class="form-control form-control-sm glass-input text-warning py-1" style="width: 135px; font-size: 0.85rem;" title="End Date">
                    <button class="btn btn-warning btn-sm font-weight-bold px-3 py-1" onclick="applyHistoryDateFilter()">
                        <i class="fa-solid fa-filter me-1"></i> Apply
                    </button>
                    <button class="btn btn-outline-secondary btn-sm p-1 px-2" onclick="resetHistoryDateFilter()" title="Reset to Weekly">
                        <i class="fa-solid fa-rotate"></i>
                    </button>
                </div>
            </div>

            @if (pastJobs.Count == 0)
            {
                <p class="text-muted text-center py-4 mb-0">No completed job history recorded yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle history-table">
                        <thead>
                            <tr>
                                <th>Job ID</th>
                                <th>Vehicle</th>
                                <th>Problem</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th>Total Bill</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var j in pastJobs)
                            {
                                <tr class="history-job-row" data-date="@(j.CompletedAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "")">
                                    <td>
                                        <b>#@j.Id</b>
                                        @if (j.DisputeStatus == "Active")
                                        {
                                            <span class="badge bg-danger text-white d-block mt-1 font-weight-bold" style="font-size: 0.65rem;"><i class="fa-solid fa-triangle-exclamation"></i> PAYMENT HELD</span>
                                        }
                                        else if (j.DisputeStatus == "Resolved")
                                        {
                                            <span class="badge bg-success text-white d-block mt-1 font-weight-bold" style="font-size: 0.65rem;"><i class="fa-solid fa-circle-check"></i> DISPUTE RESOLVED</span>
                                        }
                                    </td>
                                    <td>@j.Vehicle?.Model</td>
                                    <td><span class="badge bg-warning text-dark">@j.ProblemType</span></td>
                                    <td>@j.Customer?.Name</td>
                                    <td class="small text-muted">@(j.CompletedAt?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt") ?? "-")</td>
                                    <td class="text-success font-weight-bold">₹@j.FinalBillAmount</td>
                                    <td>
                                        <button class="btn btn-outline-info btn-sm font-weight-bold" onclick="showJobInvoiceModal(@j.Id)">
                                            <i class="fa-solid fa-receipt me-1"></i> View Receipt
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- ==================== TAB 4: WALLET ==================== -->
    <div id="tab-wallet" class="mech-tab-content" style="display:none;">
        <div class="row g-4">
            <!-- Left: Neo-banking Card & Quick Actions -->
            <div class="col-lg-5">
                <div class="glass-card mb-4 p-4 border-success border-opacity-35 text-white position-relative overflow-hidden" 
                     style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(20, 83, 45, 0.3) 100%) !important;">
                    
                    <!-- Decorative background glow -->
                    <div style="position: absolute; top: -50px; right: -50px; width: 150px; height: 150px; background: rgba(16, 185, 129, 0.2); filter: blur(40px); border-radius: 50%;"></div>
                    
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <span class="text-success small font-weight-bold tracking-wider uppercase"><i class="fa-solid fa-shield-halved me-1"></i> Partner Security Escrow</span>
                            <h5 class="text-white font-weight-bold mt-1 mb-0">RaahSathi Vault</h5>
                        </div>
                        <i class="fa-solid fa-credit-card text-success fa-2x opacity-75"></i>
                    </div>

                    <!-- Glowing Balance -->
                    <div class="my-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small d-block">AVAILABLE BALANCE</span>
                                <h1 class="text-white font-weight-extrabold mb-0 mt-1" style="font-family: 'Outfit'; font-size: 2.2rem; text-shadow: 0 0 15px rgba(16, 185, 129, 0.4);" id="lblWalletPendingSettlement">₹@(((double)ViewBag.PendingSettlement).ToString("N2"))</h1>
                            </div>
                            @if (ViewBag.PendingPayoutAmount != null && (double)ViewBag.PendingPayoutAmount > 0)
                            {
                                <div class="text-end">
                                    <span class="text-warning small d-block font-weight-bold"><i class="fa-regular fa-clock me-1"></i> PENDING PAYOUT</span>
                                    <h3 class="text-warning font-weight-bold mb-0 mt-1" style="font-family: 'Outfit';">₹@(((double)ViewBag.PendingPayoutAmount).ToString("N2"))</h3>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-end mt-4 pt-2 border-top border-secondary border-opacity-30">
                        <div>
                            <div class="text-muted" style="font-size: 0.65rem; text-transform: uppercase;">Partner Name</div>
                            <div class="font-weight-bold text-white small">@user.Name</div>
                        </div>
                        <div>
                            <span class="badge bg-success-subtle text-success border border-success border-opacity-30 rounded-pill px-2.5 py-1 small" style="font-size: 0.7rem;">
                                <span class="d-inline-block rounded-circle bg-success me-1 animate-pulse" style="width: 6px; height: 6px;"></span> Active Account
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Wallet Quick Actions Card -->
                <div class="glass-card mb-4 p-4 border-secondary">
                    <h5 class="text-white font-weight-bold mb-3"><i class="fa-solid fa-sliders text-warning me-2"></i> Payout Quick Actions</h5>
                    <p class="text-muted small mb-4">Transfer your earnings to your linked bank account or UPI ID instantly. Transactions are settled using IMPS direct settlement SLA.</p>
                    
                    <button class="btn btn-success btn-lg w-100 py-3 font-weight-bold shadow-lg" onclick="openWithdrawModal()" 
                            style="background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important; border: none;">
                        <i class="fa-solid fa-building-columns me-2"></i> Withdraw Earnings Now
                    </button>
                    <a href="javascript:void(0)" class="btn btn-outline-secondary w-100 mt-2 py-2.5 font-weight-bold" onclick="switchMechTab('tab-profile')">
                        <i class="fa-solid fa-user-gear me-2"></i> Manage Payout Details
                    </a>
                </div>
            </div>

            <!-- Right: Wallet Stats & Statement -->
            <div class="col-lg-7">
                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3">
                        <div class="glass-card p-3 border-secondary text-center">
                            <span class="text-muted small d-block mb-1">Today's Earnings</span>
                            <h4 class="text-success font-weight-extrabold mb-0" id="lblWalletTodayEarnings" style="font-family: 'Outfit';">₹@(((double)ViewBag.TodayEarnings).ToString("N2"))</h4>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="glass-card p-3 border-secondary text-center">
                            <span class="text-muted small d-block mb-1">Weekly Earnings</span>
                            <h4 class="text-warning font-weight-extrabold mb-0" id="lblWalletWeeklyEarnings" style="font-family: 'Outfit';">₹@(((double)ViewBag.WeeklyEarnings).ToString("N2"))</h4>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="glass-card p-3 border-secondary text-center">
                            <span class="text-muted small d-block mb-1">Monthly Volume</span>
                            <h4 class="text-info font-weight-extrabold mb-0" id="lblWalletMonthlyVolume" style="font-family: 'Outfit';">₹@(((double)ViewBag.MonthlyVolume).ToString("N2"))</h4>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="glass-card p-3 border-danger border-opacity-40 text-center bg-danger bg-opacity-10">
                            <span class="text-muted small d-block mb-1">Held in Escrow</span>
                            <h4 class="text-danger font-weight-extrabold mb-0" id="lblWalletHeldEarnings" style="font-family: 'Outfit';">₹@(((double)ViewBag.HeldEarnings).ToString("N2"))</h4>
                        </div>
                    </div>
                </div>

                <!-- Recent Earnings Statement Card -->
                <div class="glass-card border-secondary">
                    <h5 class="text-white font-weight-bold mb-3"><i class="fa-solid fa-file-invoice-dollar text-warning me-2"></i> Recent Earnings Statement</h5>
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0">
                            <thead>
                                <tr class="border-secondary text-muted small">
                                    <th>Job ID</th>
                                    <th>Date & Time</th>
                                    <th>Status</th>
                                    <th>Total Bill</th>
                                    <th class="text-end">Net Credited</th>
                                </tr>
                            </thead>
                            <tbody id="walletTransactionsTableBody">
                                @if (ViewBag.Payments == null || ((List<Payment>)ViewBag.Payments).Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-muted text-center py-4">No transactions recorded yet.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var p in (List<Payment>)ViewBag.Payments)
                                    {
                                        <tr class="border-secondary">
                                            <td><b>#@p.JobId</b></td>
                                            <td class="small text-muted">@p.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                                            <td>
                                                @if (p.PaymentStatus == "Released" || p.PaymentStatus == "Completed")
                                                {
                                                    <span class="badge bg-success bg-opacity-15 text-success border border-success border-opacity-30 px-2.5 py-1">Escrow Released</span>
                                                }
                                                else if (p.PaymentStatus == "Held" || p.PaymentStatus == "Pending")
                                                {
                                                    <span class="badge bg-warning bg-opacity-15 text-warning border border-warning border-opacity-30 px-2.5 py-1"><i class="fa-solid fa-triangle-exclamation me-1"></i> Payment Held</span>
                                                }
                                                else if (p.PaymentStatus == "Refunded")
                                                {
                                                    <span class="badge bg-danger bg-opacity-15 text-danger border border-danger border-opacity-30 px-2.5 py-1">Refunded (Cancelled)</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary bg-opacity-15 text-secondary border border-secondary border-opacity-30 px-2.5 py-1">@p.PaymentStatus</span>
                                                }
                                            </td>
                                            <td class="text-white-50">₹@p.Amount.ToString("N2")</td>
                                            @if (p.PaymentStatus == "Released" || p.PaymentStatus == "Completed")
                                            {
                                                <td class="text-success font-weight-bold text-end">+₹@p.MechanicEarningAmount.ToString("N2")</td>
                                            }
                                            else if (p.PaymentStatus == "Held" || p.PaymentStatus == "Pending")
                                            {
                                                <td class="text-warning font-weight-bold text-end">₹@p.MechanicEarningAmount.ToString("N2") (Held)</td>
                                            }
                                            else if (p.PaymentStatus == "Refunded")
                                            {
                                                <td class="text-danger font-weight-bold text-end">₹0.00 (Refunded)</td>
                                            }
                                            else
                                            {
                                                <td class="text-muted text-end">₹@p.MechanicEarningAmount.ToString("N2")</td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>             </div>
            </div>
        </div>
    </div>

    <!-- ==================== TAB 5: SUPPORT INBOX ==================== -->
    <div id="tab-support" class="mech-tab-content" style="display:none;">
        <div class="glass-card mb-4 border-info border-opacity-30">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 border-bottom border-secondary border-opacity-40 pb-3">
                <div>
                    <h4 class="text-white font-weight-bold mb-1"><i class="fa-solid fa-headset text-info me-2"></i> Operations & Support Team Inbox</h4>
                    <p class="text-muted small mb-0">Official updates, guidelines & direct communication with RaahSathi Support Team.</p>
                </div>
                <button class="btn btn-outline-info font-weight-bold px-4 py-2" onclick="openSupportReplyModal()">
                    <i class="fa-solid fa-paper-plane me-1"></i> Send Reply / Inquiry to Support
                </button>
            </div>

            <div id="supportMessagesContainer">
                @if (supportMessages.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fa-solid fa-inbox fa-3x mb-3 text-secondary d-block"></i>
                        <p class="mb-0">No support notifications in your inbox yet.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var m in supportMessages)
                        {
                            <div class="p-3.5 rounded-3 border @(m.IsFromAdmin ? "border-info bg-dark bg-opacity-60" : "border-secondary bg-black bg-opacity-40") shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge @(m.IsFromAdmin ? "bg-info text-dark" : "bg-warning text-dark") px-3 py-1 font-weight-bold">
                                        <i class="fa-solid @(m.IsFromAdmin ? "fa-user-shield" : "fa-wrench") me-1"></i> @m.SenderName (@m.SenderRole)
                                    </span>
                                    <span class="text-muted small"><i class="fa-regular fa-clock me-1"></i> @m.SentAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span>
                                </div>
                                <h5 class="text-white font-weight-bold mb-2">@m.Title</h5>
                                <p class="text-light mb-0 small" style="white-space: pre-line; line-height: 1.6;">@m.MessageText</p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ==================== TAB 6: PROFILE & SKILLS ==================== -->
    <div id="tab-profile" class="mech-tab-content" style="display:none;">
        <div class="glass-card mb-4 border-warning border-opacity-30">
            <h4 class="text-white font-weight-bold mb-4"><i class="fa-solid fa-user-gear text-warning me-2"></i> Mechanic Profile & Settings</h4>

            <!-- Trust Badges Bar -->
            <div class="mb-4">
                <label class="form-label text-muted small font-weight-bold d-block mb-2">Verified Partner Badges:</label>
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-warning text-dark px-3 py-2 fs-6 font-weight-bold"><i class="fa-solid fa-trophy me-1"></i> Top Rated</span>
                    <span class="badge bg-info text-dark px-3 py-2 fs-6 font-weight-bold"><i class="fa-solid fa-bolt me-1"></i> Fast Response</span>
                    <span class="badge bg-success text-white px-3 py-2 fs-6 font-weight-bold"><i class="fa-solid fa-battery-full me-1"></i> Battery Expert</span>
                    <span class="badge bg-primary text-white px-3 py-2 fs-6 font-weight-bold"><i class="fa-solid fa-plug text-warning me-1"></i> EV Certified</span>
                    <span class="badge bg-dark border border-secondary text-light px-3 py-2 fs-6"><i class="fa-solid fa-award text-warning me-1"></i> 1000+ Jobs Completed</span>
                    <span class="badge bg-success bg-opacity-25 text-success border border-success px-3 py-2 fs-6"><i class="fa-solid fa-circle-check me-1"></i> Verified Partner</span>
                </div>
            </div>

            <!-- Performance Metrics Grid -->
            <div class="p-3 bg-dark bg-opacity-60 rounded-3 border border-secondary mb-4">
                <h6 class="text-warning font-weight-bold mb-3">Verified Performance Metrics</h6>
                <div class="row g-3 text-center">
                    <div class="col-md-2.4 col-6">
                        <span class="text-muted small d-block">Jobs Completed</span>
                        <h4 class="text-white font-weight-extrabold mb-0">1,284</h4>
                    </div>
                    <div class="col-md-2.4 col-6">
                        <span class="text-muted small d-block">Rating</span>
                        <h4 class="text-warning font-weight-extrabold mb-0">⭐ 4.9</h4>
                    </div>
                    <div class="col-md-2.4 col-6">
                        <span class="text-muted small d-block">Acceptance</span>
                        <h4 class="text-success font-weight-extrabold mb-0">97%</h4>
                    </div>
                    <div class="col-md-2.4 col-6">
                        <span class="text-muted small d-block">Cancellation</span>
                        <h4 class="text-danger font-weight-extrabold mb-0">1%</h4>
                    </div>
                    <div class="col-md-2.4 col-6">
                        <span class="text-muted small d-block">Repeat Customers</span>
                        <h4 class="text-info font-weight-extrabold mb-0">14</h4>
                    </div>
                </div>
            </div>

            <!-- Skills Checkboxes Selector -->
            <div class="mb-4">
                <label class="form-label text-white font-weight-bold mb-2"><i class="fa-solid fa-screwdriver-wrench text-warning me-1"></i> Mechanic Skills & Specializations</label>
                <div class="d-flex flex-wrap gap-2 p-3 bg-dark bg-opacity-40 rounded-3 border border-secondary">
                    @foreach (var sk in new[] { "Battery", "Tyre", "Engine", "Electrical", "AC", "Clutch", "Brake", "Diesel", "Petrol", "EV", "Truck", "JCB", "Crane" })
                    {
                        bool isChecked = (profile.Specialization ?? "").Contains(sk) || (profile.VehicleExpertise ?? "").Contains(sk) || sk == "Battery" || sk == "Engine";
                        <input type="checkbox" class="btn-check" name="chkSkills" id="chkSkill-@sk" value="@sk" @(isChecked ? "checked" : "") autocomplete="off">
                        <label class="btn btn-outline-warning rounded-pill px-3 py-1 font-weight-medium" for="chkSkill-@sk">@sk</label>
                    }
                </div>
            </div>

            <!-- Service Area Radius Selector -->
            <div class="mb-4">
                <label class="form-label text-white font-weight-bold mb-2"><i class="fa-solid fa-map-location-dot text-warning me-1"></i> Service Area Radius Coverage</label>
                <div class="d-flex flex-wrap gap-3 p-3 bg-dark bg-opacity-40 rounded-3 border border-secondary">
                    @foreach (var r in new[] { 15, 20, 30, 50 })
                    {
                        string labelStr = r == 50 ? "Highway Coverage (50 KM)" : $"{r} KM";
                        <input type="radio" class="btn-check" name="radServiceRadius" id="radRadius-@r" value="@r" @(profile.ServiceRadiusKm == r ? "checked" : "") autocomplete="off">
                        <label class="btn btn-outline-warning rounded-pill px-4 py-2 font-weight-bold" for="radRadius-@r">@labelStr</label>
                    }
                </div>
            </div>

            <!-- Payment & Settlement Preferences (ALL OPTIONAL) -->
            <div class="mb-4">
                <label class="form-label text-white font-weight-bold mb-2">
                    <i class="fa-solid fa-wallet text-success me-1"></i> Payment & Payout Preferences <span class="badge bg-secondary font-weight-normal ms-2">All Optional</span>
                </label>
                <div class="p-3 bg-dark bg-opacity-40 rounded-3 border border-secondary">
                    
                    <!-- Preferred Payout Choice (Radio: UPI / Bank / Cash) -->
                    <div class="mb-3">
                        <label class="form-label text-muted small d-block font-weight-medium">Preferred Payout Mode:</label>
                        <div class="d-flex flex-wrap gap-2">
                            <input type="radio" class="btn-check" name="radPayoutMethod" id="radMethodUPI" value="UPI" @(profile.PreferredPayoutMethod == "UPI" || string.IsNullOrEmpty(profile.PreferredPayoutMethod) ? "checked" : "") autocomplete="off">
                            <label class="btn btn-outline-success rounded-pill px-3 py-1 font-weight-medium" for="radMethodUPI"><i class="fa-mobile-screen me-1"></i> UPI Direct</label>

                            <input type="radio" class="btn-check" name="radPayoutMethod" id="radMethodBank" value="Bank" @(profile.PreferredPayoutMethod == "Bank" ? "checked" : "") autocomplete="off">
                            <label class="btn btn-outline-info rounded-pill px-3 py-1 font-weight-medium" for="radMethodBank"><i class="fa-building-columns me-1"></i> Bank Account</label>

                            <input type="radio" class="btn-check" name="radPayoutMethod" id="radMethodCash" value="Cash" @(profile.PreferredPayoutMethod == "Cash" ? "checked" : "") autocomplete="off">
                            <label class="btn btn-outline-warning rounded-pill px-3 py-1 font-weight-medium" for="radMethodCash"><i class="fa-money-bill-1 me-1"></i> Cash Settle</label>
                        </div>
                    </div>

                    <div class="row g-3">
                        <!-- Operating City -->
                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1">Operating City</label>
                            <input type="text" id="txtProfileCity" class="form-control glass-input text-white font-weight-bold" value="@profile.City" placeholder="e.g. Noida, Delhi">
                        </div>

                        <!-- UPI ID Input -->
                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1">UPI ID (Optional)</label>
                            <input type="text" id="txtProfileUpi" class="form-control glass-input text-success font-weight-bold" value="@profile.UpiId" placeholder="e.g. 9876543210@paytm / name@upi">
                        </div>
                        
                        <!-- On-Spot Cash Acceptance -->
                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check form-switch mb-2 fs-6">
                                <input class="form-check-input" type="checkbox" id="chkAcceptsCash" @(profile.AcceptsCash ? "checked" : "")>
                                <label class="form-check-label text-light small font-weight-bold" for="chkAcceptsCash">
                                    💵 Accept On-Spot Cash Payments from Customers
                                </label>
                            </div>
                        </div>

                        <!-- Bank Details (Optional) -->
                        <div class="col-12 border-top border-secondary border-opacity-30 pt-3">
                            <span class="text-muted small d-block mb-2 font-weight-bold"><i class="fa-solid fa-landmark me-1"></i> Bank Account Details (Optional):</span>
                            <div class="row g-2">
                                <div class="col-md-3">
                                    <input type="text" id="txtProfileHolderName" class="form-control glass-input" value="@profile.AccountHolderName" placeholder="Account Holder Name">
                                </div>
                                <div class="col-md-3">
                                    <input type="text" id="txtBankName" class="form-control glass-input" value="@profile.BankName" placeholder="Bank Name (e.g. SBI, HDFC)">
                                </div>
                                <div class="col-md-3">
                                    <input type="text" id="txtAccountNo" class="form-control glass-input" value="@profile.BankAccountNumber" placeholder="Account Number">
                                </div>
                                <div class="col-md-3">
                                    <input type="text" id="txtIfscCode" class="form-control glass-input" value="@profile.IfscCode" placeholder="IFSC Code">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <button class="btn btn-premium-primary font-weight-bold px-5 py-3 shadow-lg" onclick="saveProfileSettings()">
                <i class="fa-solid fa-floppy-disk me-1"></i> Save Profile Settings
            </button>
        </div>
    </div>

</div>

<!-- 🚨 15-SECOND SIREN DISPATCH NOTIFICATION MODAL -->
<div class="modal fade" id="incomingDispatchModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark text-white border-warning border-2 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header border-secondary bg-warning bg-opacity-10 py-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="dispatch-timer-circle" id="lblDispatchCountdown">15</div>
                    <div>
                        <h5 class="modal-title font-weight-bold text-warning mb-0">🚨 New Assistance Request</h5>
                        <span class="text-muted small" id="lblDispatchHeaderSub">Approx 3.8 KM Away | Estimated Arrival 12 Mins</span>
                    </div>
                </div>
            </div>

            <div class="modal-body p-4">
                <!-- Smart Job Score Badge -->
                <div class="text-center mb-3">
                    <span class="smart-score-pill fs-6 py-2 px-4">
                        <i class="fa-solid fa-star"></i> ⭐⭐⭐⭐⭐ Recommended Job | High Earnings | Battery Expert Match | Acceptance Chance: High
