                        <div class="d-flex justify-content-between text-success font-weight-bold fs-6">
                            <span><i class="fa-solid fa-wallet text-success me-1"></i> Net Wallet Credit:</span>
                            <span class="text-success font-weight-bold" id="mechInvNetCredit">₹0.00</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-secondary d-print-none">
                <button type="button" class="btn btn-outline-light font-weight-bold px-4 py-2" onclick="printMechanicInvoice()">
                    <i class="fa-solid fa-print me-1"></i> Print / Save PDF
                </button>
                <button type="button" class="btn btn-success font-weight-bold px-4 py-2" data-bs-dismiss="modal">
                    Close & Go Standby
                </button>
            </div>
        </div>
    </div>
</div>

