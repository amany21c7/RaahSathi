@using RaahSathi.Models
@{
    ViewData["Title"] = "Pricing Engine Controls";
    var pricingRules = ViewBag.PricingRules as List<PricingRule> ?? new List<PricingRule>();
    var problemTypes = ViewBag.ProblemTypes as List<ProblemTypePricing> ?? new List<ProblemTypePricing>();
    var cities = ViewBag.Cities as List<CityServiceArea> ?? new List<CityServiceArea>();
    var cityNamesList = cities.Select(c => c.CityName).Distinct().OrderBy(c => c).ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary border-opacity-30 pb-3">
    <div>
        <h4 class="text-white font-weight-bold mb-1"><i class="fa-solid fa-tags text-warning me-2"></i> City-Wise Pricing Engine Controls</h4>
        <p class="text-muted small mb-0">Configure base rates, per-KM rates, towing fees, breakdown problem prices, and tiered admin commission rules.</p>
    </div>
</div>

<!-- Tiered Admin Commission Rules & Vault Controls Grid -->
<div class="p-4 rounded-3 bg-gradient bg-dark border border-warning border-opacity-50 mb-4 shadow-lg">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
        <div>
            <h5 class="text-warning font-weight-bold mb-1">
                <i class="fa-solid fa-percent me-2"></i> Tiered Admin Commission Rules & Vault Controls
            </h5>
            <p class="text-muted small mb-0">Configure tiered admin commission rates automatically applied during payment escrow settlement based on job total value.</p>
        </div>
    </div>
    
    <form action="/Admin/SaveCommissionSettings" method="POST">
        <div class="row g-3">
            <div class="col-6 col-md-3">
                <div class="p-3 rounded-3 bg-black bg-opacity-40 border border-warning border-opacity-30 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge bg-warning text-dark font-weight-bold">TIER 1</span>
                        <span class="text-muted extra-small font-monospace">&lt; ₹1,000</span>
                    </div>
                    <label class="text-light small font-weight-bold d-block mb-1.5">Jobs under ₹1,000</label>
                    <div class="input-group input-group-sm">
                        <input type="number" name="phase1" step="0.1" min="0" max="50" class="form-control bg-dark text-warning font-weight-bold border-secondary" value="@(ViewBag.CommPhase1 ?? 8)" required placeholder="e.g. 8">
                        <span class="input-group-text bg-secondary bg-opacity-30 text-warning font-weight-bold border-secondary">%</span>
                    </div>
                </div>
            </div>
            
            <div class="col-6 col-md-3">
                <div class="p-3 rounded-3 bg-black bg-opacity-40 border border-warning border-opacity-30 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge bg-warning text-dark font-weight-bold">TIER 2</span>
                        <span class="text-muted extra-small font-monospace">₹1,000 - ₹3,000</span>
                    </div>
                    <label class="text-light small font-weight-bold d-block mb-1.5">Jobs ₹1,000 to ₹3,000</label>
                    <div class="input-group input-group-sm">
                        <input type="number" name="phase2" step="0.1" min="0" max="50" class="form-control bg-dark text-warning font-weight-bold border-secondary" value="@(ViewBag.CommPhase2 ?? 10)" required placeholder="e.g. 10">
                        <span class="input-group-text bg-secondary bg-opacity-30 text-warning font-weight-bold border-secondary">%</span>
                    </div>
                </div>
            </div>
            
            <div class="col-6 col-md-3">
                <div class="p-3 rounded-3 bg-black bg-opacity-40 border border-warning border-opacity-30 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge bg-warning text-dark font-weight-bold">TIER 3</span>
                        <span class="text-muted extra-small font-monospace">&gt; ₹3,000</span>
                    </div>
                    <label class="text-light small font-weight-bold d-block mb-1.5">Jobs above ₹3,000</label>
                    <div class="input-group input-group-sm">
                        <input type="number" name="phase3" step="0.1" min="0" max="50" class="form-control bg-dark text-warning font-weight-bold border-secondary" value="@(ViewBag.CommPhase3 ?? 12)" required placeholder="e.g. 12">
                        <span class="input-group-text bg-secondary bg-opacity-30 text-warning font-weight-bold border-secondary">%</span>
                    </div>
                </div>
            </div>
            
            <div class="col-6 col-md-3">
                <div class="p-3 rounded-3 bg-black bg-opacity-40 border border-info border-opacity-30 h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge bg-info text-dark font-weight-bold">PARTS</span>
                        <span class="text-muted extra-small font-monospace">Spare Parts</span>
                    </div>
                    <label class="text-light small font-weight-bold d-block mb-1.5">Extra Spare Parts</label>
                    <div class="input-group input-group-sm">
                        <input type="number" name="parts" step="0.1" min="0" max="50" class="form-control bg-dark text-info font-weight-bold border-secondary" value="@(ViewBag.CommParts ?? 5)" required placeholder="e.g. 5">
                        <span class="input-group-text bg-secondary bg-opacity-30 text-info font-weight-bold border-secondary">%</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-3 text-end">
            <button type="submit" class="btn btn-warning font-weight-bold px-4 py-2 text-dark shadow-sm">
                <i class="fa-solid fa-floppy-disk me-1"></i> Save Tiered Commission Rules
            </button>
        </div>
    </form>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show bg-success bg-opacity-20 border-success text-white mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- Problem Types Price Registry -->
    <div class="col-lg-7">
        <div class="card bg-dark border-secondary shadow-sm">
            <div class="card-header border-secondary bg-transparent d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 py-3">
                <div>
                    <h5 class="text-white mb-0"><i class="fa-solid fa-list-check text-warning me-2"></i> Service Problem Types Price Overrides</h5>
                    <span class="text-muted extra-small" style="font-size:0.75rem;">Total @problemTypes.Count active problem fix rates configured</span>
                </div>
                <button type="button" class="btn btn-warning btn-sm font-weight-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addProblemModal">
                    <i class="fa-solid fa-plus me-1"></i> Add City Problem Rate
                </button>
            </div>

            <!-- Filter Tabs & Search Bar -->
            <div class="p-3 border-bottom border-secondary bg-black bg-opacity-30">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-7">
                        <div class="d-flex flex-wrap gap-1" id="categoryFilterTabs">
                            <button type="button" class="btn btn-sm btn-warning text-dark font-weight-bold cat-filter-btn active" onclick="filterProblemCategory('ALL', this)">All (@problemTypes.Count)</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary text-light cat-filter-btn" onclick="filterProblemCategory('Car', this)"><i class="fa-solid fa-car me-1 text-warning"></i>Car</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary text-light cat-filter-btn" onclick="filterProblemCategory('2-Wheeler', this)"><i class="fa-solid fa-motorcycle me-1 text-warning"></i>Bike</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary text-light cat-filter-btn" onclick="filterProblemCategory('E-Rickshaw', this)"><i class="fa-solid fa-bolt text-success me-1"></i>E-Rickshaw</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary text-light cat-filter-btn" onclick="filterProblemCategory('Auto-Rickshaw', this)"><i class="fa-solid fa-auto-rickshaw text-warning me-1"></i>Auto</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary text-light cat-filter-btn" onclick="filterProblemCategory('Commercial', this)"><i class="fa-solid fa-truck text-warning me-1"></i>Commercial</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary text-light cat-filter-btn" onclick="filterProblemCategory('Heavy', this)"><i class="fa-solid fa-tractor text-warning me-1"></i>Heavy</button>
                        </div>
                    </div>
                    <div class="col-12 col-md-5">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-dark border-secondary text-warning"><i class="fa-solid fa-magnifying-glass"></i></span>
                            <input type="text" id="problemSearchTableInput" class="form-control bg-dark text-white border-secondary" placeholder="Search problem or city..." oninput="searchProblemTable(this.value)">
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 650px; overflow-y: auto;">
                    <table class="table table-dark table-hover mb-0 align-middle" id="adminProblemsTable">
                        <thead class="sticky-top bg-dark border-secondary">
                            <tr class="border-secondary text-muted small">
                                <th class="ps-3 py-3">Problem Name</th>
                                <th>Category</th>
                                <th>Target City</th>
                                <th>Min Charge</th>
                                <th>Max Charge</th>
                                <th class="text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (problemTypes.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No problem types defined. Click "Add City Problem Rate" to create one.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var p in problemTypes)
                                {
                                    string catBadgeClass = "bg-secondary text-light";
                                    string catIcon = "fa-car";
                                    if (p.VehicleCategory == "E-Rickshaw") { catBadgeClass = "bg-success bg-opacity-20 text-success border border-success border-opacity-40"; catIcon = "fa-bolt-lightning"; }
                                    else if (p.VehicleCategory == "Auto-Rickshaw") { catBadgeClass = "bg-warning bg-opacity-20 text-warning border border-warning border-opacity-40"; catIcon = "fa-auto-rickshaw"; }
                                    else if (p.VehicleCategory == "2-Wheeler" || p.VehicleCategory == "Bike") { catBadgeClass = "bg-info bg-opacity-20 text-info border border-info border-opacity-40"; catIcon = "fa-motorcycle"; }
                                    else if (p.VehicleCategory == "Commercial") { catBadgeClass = "bg-primary bg-opacity-20 text-primary border border-primary border-opacity-40"; catIcon = "fa-truck"; }
                                    else if (p.VehicleCategory == "Heavy") { catBadgeClass = "bg-danger bg-opacity-20 text-danger border border-danger border-opacity-40"; catIcon = "fa-tractor"; }

                                    <tr class="border-secondary admin-prob-row" data-category="@p.VehicleCategory" data-name="@p.ProblemName.ToLower()" data-city="@p.CityName.ToLower()">
                                        <td class="ps-3 font-weight-bold text-white">@p.ProblemName</td>
                                        <td>
                                            <span class="badge @catBadgeClass">
                                                <i class="fa-solid @catIcon me-1"></i>@p.VehicleCategory
                                            </span>
                                        </td>
                                        <td>
                                            @if (p.CityName == "All Cities")
                                            {
                                                <span class="badge bg-info bg-opacity-20 text-info border border-info border-opacity-30"><i class="fa-solid fa-earth-americas me-1"></i> All Cities</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-30"><i class="fa-solid fa-city me-1"></i> @p.CityName</span>
                                            }
                                        </td>
                                        <td class="text-warning font-weight-bold">₹@p.MinServiceCharge.ToString("N0")</td>
                                        <td class="text-success font-weight-bold">₹@p.MaxServiceCharge.ToString("N0")</td>
                                        <td class="text-end pe-3">
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-warning me-1 px-2"
                                                    onclick="openEditProblemModal(@p.Id, '@p.ProblemName.Replace("'", "\\'")', '@p.VehicleCategory', '@p.CityName.Replace("'", "\\'")', @p.MinServiceCharge, @p.MaxServiceCharge)"
                                                    title="Edit Price Rate">
                                                <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                                            </button>
                                            <form action="/Admin/DeleteProblemType" method="POST" class="d-inline">
                                                <input type="hidden" name="id" value="@p.Id">
                                                <button type="submit" class="btn btn-sm btn-outline-danger px-2" onclick="return confirm('Delete price rate for @p.ProblemName (@p.CityName)?')"><i class="fa-solid fa-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Pricing Engine Tuning Card (All 6 Vehicles) -->
    <div class="col-lg-5">
        <div class="card bg-dark border-secondary shadow-sm">
            <div class="card-header border-secondary bg-transparent py-3">
                <h5 class="text-white mb-0"><i class="fa-solid fa-sliders text-warning me-2"></i> Pricing Engine Base Tuning</h5>
                <span class="text-muted extra-small" style="font-size:0.75rem;">Configure Layer 1 Visiting &amp; Towing rates for each vehicle type</span>
            </div>
            <div class="card-body" style="max-height: 720px; overflow-y: auto;">
                <div class="d-flex flex-column gap-3">
                    @foreach (var r in pricingRules)
                    {
                        string headerBorder = "border-secondary";
                        string headerBadge = "bg-secondary";
                        string catIcon = "fa-car";
                        
                        if (r.VehicleCategory == "E-Rickshaw") 
                        { 
                            headerBorder = "border-success border-opacity-50"; 
                            headerBadge = "bg-success text-white"; 
                            catIcon = "fa-bolt-lightning text-success";
                        }
                        else if (r.VehicleCategory == "Auto-Rickshaw") 
                        { 
                            headerBorder = "border-warning border-opacity-50"; 
                            headerBadge = "bg-warning text-dark"; 
                            catIcon = "fa-auto-rickshaw text-warning";
                        }
                        else if (r.VehicleCategory == "2-Wheeler" || r.VehicleCategory == "Bike") 
                        { 
                            headerBorder = "border-info border-opacity-40"; 
                            headerBadge = "bg-info text-dark"; 
                            catIcon = "fa-motorcycle text-info";
                        }
                        else if (r.VehicleCategory == "Commercial") 
                        { 
                            headerBorder = "border-primary border-opacity-40"; 
                            headerBadge = "bg-primary text-white"; 
                            catIcon = "fa-truck text-primary";
                        }
                        else if (r.VehicleCategory == "Heavy") 
                        { 
                            headerBorder = "border-danger border-opacity-40"; 
                            headerBadge = "bg-danger text-white"; 
                            catIcon = "fa-tractor text-danger";
                        }

                        <div class="p-3 bg-black bg-opacity-40 rounded-3 border @headerBorder shadow-sm">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <h6 class="text-white font-weight-bold mb-0">
                                    <i class="fa-solid @catIcon me-2"></i>@r.VehicleCategory
                                </h6>
                                <span class="badge @headerBadge font-weight-bold">Layer 1 Base Rates</span>
                            </div>

                            <form action="/Admin/UpdatePricingRule" method="POST">
                                <input type="hidden" name="ruleId" value="@r.Id">
                                <input type="hidden" name="returnUrl" value="/Admin/Pricing">
                                <div class="mb-2">
                                    <label class="form-label text-muted small font-weight-bold mb-1" style="font-size:0.72rem;">Target City / Region</label>
                                    <select name="cityName" class="form-select glass-input text-warning font-weight-bold py-1" style="font-size:0.8rem;">
                                        <option value="All Cities" selected="@(r.CityName == "All Cities")">🌐 All Cities (National Default)</option>
                                        @foreach (var c in cityNamesList)
                                        {
                                            <option value="@c" selected="@(r.CityName == c)">📍 @c</option>
                                        }
                                    </select>
                                </div>
                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <label class="form-label text-muted small mb-1" style="font-size:0.72rem;">Base Visiting (₹)</label>
                                        <input type="number" class="form-control glass-input text-white font-weight-bold form-control-sm" name="baseFee" value="@r.BaseFee" step="1" required>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label text-muted small mb-1" style="font-size:0.72rem;">Visiting Per-KM (₹)</label>
                                        <input type="number" class="form-control glass-input text-white font-weight-bold form-control-sm" name="perKmRate" value="@r.PerKmRate" step="1" required>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label text-muted small mb-1" style="font-size:0.72rem;">Base Towing (₹)</label>
                                        <input type="number" class="form-control glass-input text-white font-weight-bold form-control-sm" name="baseTowingFee" value="@r.BaseTowingFee" step="1" required>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label text-muted small mb-1" style="font-size:0.72rem;">Towing Per-KM (₹)</label>
                                        <input type="number" class="form-control glass-input text-white font-weight-bold form-control-sm" name="perKmTowingRate" value="@r.PerKmTowingRate" step="1" required>
                                    </div>
                                </div>
                                <button type="submit" class="btn text-white font-weight-bold btn-sm w-100 py-1.5 shadow-sm" style="background: linear-gradient(135deg, #ff6b00 0%, #e05d00 100%); border: none;">
                                    <i class="fa-solid fa-circle-check me-1"></i> Update @r.VehicleCategory Rates
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Add Problem Rate -->
<div class="modal fade" id="addProblemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border border-secondary shadow-lg">
            <div class="modal-header border-secondary bg-black bg-opacity-40">
                <h5 class="modal-title text-warning font-weight-bold"><i class="fa-solid fa-plus me-2"></i>Add City-Wise Problem Rate</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/Admin/AddProblemType" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-muted small font-weight-bold">Target City / Region</label>
                        <select name="cityName" class="form-select glass-input text-warning font-weight-bold">
                            <option value="All Cities">🌐 All Cities (National Default)</option>
                            @foreach (var c in cityNamesList)
                            {
                                <option value="@c">📍 @c</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small font-weight-bold">Problem Name</label>
                        <input type="text" name="problemName" class="form-control glass-input text-white font-weight-bold" placeholder="e.g. Battery Jumpstart, Controller Fault" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small font-weight-bold">Vehicle Category</label>
                        <select name="vehicleCategory" class="form-select glass-input text-white font-weight-bold">
                            <option value="Car">🚗 Car / SUV / Sedan</option>
                            <option value="2-Wheeler">🏍️ 2-Wheeler (Bike/Scooter)</option>
                            <option value="E-Rickshaw">⚡ E-Rickshaw (EV 3-Wheeler)</option>
                            <option value="Auto-Rickshaw">🛺 Auto-Rickshaw (CNG / Petrol / LPG)</option>
                            <option value="Commercial">🚚 Commercial (Truck / Bus / Loader / Pickup)</option>
                            <option value="Heavy">🚜 Heavy Equipment (JCB / Tractor / Crane)</option>
                            <option value="All">🌐 All Vehicle Types</option>
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label text-muted small font-weight-bold">Min Service Charge (₹)</label>
                            <input type="number" step="1" name="minServiceCharge" class="form-control glass-input text-warning font-weight-bold" value="199" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label text-muted small font-weight-bold">Max Service Charge (₹)</label>
                            <input type="number" step="1" name="maxServiceCharge" class="form-control glass-input text-success font-weight-bold" value="499" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary bg-black bg-opacity-40">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning text-dark font-weight-bold px-4"><i class="fa-solid fa-check me-1"></i> Add City Rate Override</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Edit Problem Rate -->
<div class="modal fade" id="editProblemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border border-secondary shadow-lg">
            <div class="modal-header border-secondary bg-black bg-opacity-40">
                <h5 class="modal-title text-warning font-weight-bold"><i class="fa-solid fa-pen-to-square me-2"></i>Edit City Price Rate</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="/Admin/UpdateProblemTypePrice" method="POST">
                <input type="hidden" name="id" id="editProblemId">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-muted small font-weight-bold">Target City / Region</label>
                        <select name="cityName" id="editCityName" class="form-select glass-input text-warning font-weight-bold">
                            <option value="All Cities">🌐 All Cities (National Default)</option>
                            @foreach (var c in cityNamesList)
                            {
                                <option value="@c">📍 @c</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small font-weight-bold">Problem Name</label>
                        <input type="text" name="problemName" id="editProblemName" class="form-control glass-input text-white font-weight-bold" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small font-weight-bold">Vehicle Category</label>
                        <select name="vehicleCategory" id="editVehicleCategory" class="form-select glass-input text-white font-weight-bold">
                            <option value="Car">🚗 Car / SUV / Sedan</option>
                            <option value="2-Wheeler">🏍️ 2-Wheeler (Bike/Scooter)</option>
                            <option value="E-Rickshaw">⚡ E-Rickshaw (EV 3-Wheeler)</option>
                            <option value="Auto-Rickshaw">🛺 Auto-Rickshaw (CNG / Petrol / LPG)</option>
                            <option value="Commercial">🚚 Commercial (Truck / Bus / Loader / Pickup)</option>
                            <option value="Heavy">🚜 Heavy Equipment (JCB / Tractor / Crane)</option>
                            <option value="All">🌐 All Vehicle Types</option>
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label text-muted small font-weight-bold">Min Service Charge (₹)</label>
                            <input type="number" step="1" name="minServiceCharge" id="editMinServiceCharge" class="form-control glass-input text-warning font-weight-bold" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label text-muted small font-weight-bold">Max Service Charge (₹)</label>
                            <input type="number" step="1" name="maxServiceCharge" id="editMaxServiceCharge" class="form-control glass-input text-success font-weight-bold" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary bg-black bg-opacity-40">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning text-dark font-weight-bold px-4"><i class="fa-solid fa-check me-1"></i> Save City Price</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    let activeFilterCategory = 'ALL';

    function filterProblemCategory(cat, btn) {
        activeFilterCategory = cat;
        document.querySelectorAll('.cat-filter-btn').forEach(b => {
            b.classList.remove('btn-warning', 'text-dark', 'active');
            b.classList.add('btn-outline-secondary', 'text-light');
        });
        btn.classList.remove('btn-outline-secondary', 'text-light');
        btn.classList.add('btn-warning', 'text-dark', 'active');

        applyFilters();
    }

    function searchProblemTable(query) {
        applyFilters();
    }

    function applyFilters() {
        var query = (document.getElementById('problemSearchTableInput').value || '').toLowerCase().trim();
        document.querySelectorAll('.admin-prob-row').forEach(row => {
            var cat = row.getAttribute('data-category');
            var name = row.getAttribute('data-name') || '';
            var city = row.getAttribute('data-city') || '';

            var matchesCategory = (activeFilterCategory === 'ALL' || cat === activeFilterCategory || cat === 'All');
            var matchesSearch = (!query || name.includes(query) || city.includes(query) || cat.toLowerCase().includes(query));

            if (matchesCategory && matchesSearch) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    function openEditProblemModal(id, name, category, city, minCharge, maxCharge) {
        document.getElementById('editProblemId').value = id;
        document.getElementById('editProblemName').value = name;
        document.getElementById('editVehicleCategory').value = category;
        document.getElementById('editCityName').value = city || "All Cities";
        document.getElementById('editMinServiceCharge').value = minCharge;
        document.getElementById('editMaxServiceCharge').value = maxCharge;

        var modal = new bootstrap.Modal(document.getElementById('editProblemModal'));
        modal.show();
    }
</script>
