@model RaahSathi.Models.MechanicProfile
@{
    if (ViewData["IsPartial"] as bool? == true)
    {
        Layout = null;
    }
    else
    {
        ViewData["Title"] = "Review KYC Application";
    }
}


<div class="row justify-content-center py-4">
    <div class="col-lg-10">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="text-white font-weight-bold mb-0">
                <i class="fa-solid fa-id-card text-info me-2"></i> Review KYC: @Model.User?.Name
            </h3>
            <a href="/Admin/ManageUsers" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-1"></i> Back to Users</a>
        </div>

        @if (Model.KycStatus == "Approved")
        {
            <div class="alert alert-success bg-dark border-success">
                <i class="fa-solid fa-check-circle me-1"></i> This profile is already <strong>Approved</strong>.
            </div>
        }
        else if (Model.KycStatus == "Rejected" || Model.KycStatus == "Suspended")
        {
            <div class="alert alert-danger bg-dark border-danger">
                <i class="fa-solid fa-ban me-1"></i> This profile ID is <strong>Suspended</strong>.
            </div>
        }

        <div class="row g-4">
            <!-- Personal Info -->
            <div class="col-md-6">
                <div class="glass-card p-4 h-100">
                    <h5 class="text-warning mb-3">1. Personal Information</h5>
                    <table class="table table-borderless text-light table-sm">
                        <tr><td class="text-muted w-50">Name:</td><td class="font-weight-bold">@Model.User?.Name</td></tr>
                        <tr><td class="text-muted">Phone:</td><td>@Model.User?.PhoneNumber</td></tr>
                        <tr><td class="text-muted">Email:</td><td>@(string.IsNullOrEmpty(Model.Email) ? "N/A" : Model.Email)</td></tr>
                        <tr><td class="text-muted">DOB:</td><td>@(Model.DateOfBirth?.ToString("dd MMM yyyy") ?? "N/A")</td></tr>
                        <tr><td class="text-muted">Gender:</td><td>@Model.Gender</td></tr>
                    </table>
                    @if (!string.IsNullOrEmpty(Model.ProfilePhotoUrl))
                    {
                        <div class="mt-3">
                            <span class="text-muted small d-block mb-1">Profile Photo</span>
                            <img src="@Model.ProfilePhotoUrl" alt="Profile" class="img-thumbnail bg-dark border-secondary" style="max-height: 150px; border-radius: 10px;">
                        </div>
                    }
                </div>
            </div>

            <!-- Identity Info -->
            <div class="col-md-6">
                <div class="glass-card p-4 h-100">
                    <h5 class="text-warning mb-3">2. Identity (KYC)</h5>
                    <table class="table table-borderless text-light table-sm mb-3">
                        <tr><td class="text-muted w-50">Aadhaar No:</td><td class="font-weight-bold">@Model.AadhaarNumber</td></tr>
                    </table>
                    
                    <div class="row g-2">
                        @if (!string.IsNullOrEmpty(Model.AadhaarFrontUrl))
                        {
                            <div class="col-6">
                                <span class="text-muted small">Aadhaar Front</span>
                                <a href="@Model.AadhaarFrontUrl" target="_blank">
                                    <img src="@Model.AadhaarFrontUrl" class="img-fluid rounded border border-secondary mt-1" style="height: 100px; object-fit: cover;">
                                </a>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.AadhaarBackUrl))
                        {
                            <div class="col-6">
                                <span class="text-muted small">Aadhaar Back</span>
                                <a href="@Model.AadhaarBackUrl" target="_blank">
                                    <img src="@Model.AadhaarBackUrl" class="img-fluid rounded border border-secondary mt-1" style="height: 100px; object-fit: cover;">
                                </a>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.DrivingLicenceUrl))
                        {
                            <div class="col-6 mt-3">
                                <span class="text-muted small">Driving Licence</span>
                                <a href="@Model.DrivingLicenceUrl" target="_blank">
                                    <img src="@Model.DrivingLicenceUrl" class="img-fluid rounded border border-secondary mt-1" style="height: 100px; object-fit: cover;">
                                </a>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.PanCardUrl))
                        {
                            <div class="col-6 mt-3">
                                <span class="text-muted small">PAN Card</span>
                                <a href="@Model.PanCardUrl" target="_blank">
                                    <img src="@Model.PanCardUrl" class="img-fluid rounded border border-secondary mt-1" style="height: 100px; object-fit: cover;">
                                </a>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.SelfieUrl))
                        {
                            <div class="col-6 mt-3">
                                <span class="text-muted small">Selfie Verification</span>
                                <a href="@Model.SelfieUrl" target="_blank">
                                    <img src="@Model.SelfieUrl" class="img-fluid rounded border border-secondary mt-1" style="height: 100px; object-fit: cover;">
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Shop Info -->
            <div class="col-md-6">
                <div class="glass-card p-4 h-100">
                    <h5 class="text-warning mb-3">3. Shop Information</h5>
                    <table class="table table-borderless text-light table-sm">
                        <tr><td class="text-muted w-50">Shop Name:</td><td class="font-weight-bold">@Model.ShopName</td></tr>
                        <tr><td class="text-muted">Address:</td><td>@Model.ShopAddress</td></tr>
                        <tr><td class="text-muted">Pincode:</td><td>@Model.Pincode</td></tr>
                        <tr><td class="text-muted">Timing:</td><td>@Model.ShopTiming</td></tr>
                    </table>
                    @if (!string.IsNullOrEmpty(Model.ShopPhotoUrl))
                    {
                        <div class="mt-2">
                            <span class="text-muted small d-block mb-1">Shop Photo</span>
                            <img src="@Model.ShopPhotoUrl" class="img-fluid rounded border border-secondary" style="max-height: 150px;">
                        </div>
                    }
                </div>
            </div>

            <!-- Experience & Expertise -->
            <div class="col-md-6">
                <div class="glass-card p-4 h-100">
                    <h5 class="text-warning mb-3">4. Experience & Expertise</h5>
                    <table class="table table-borderless text-light table-sm">
                        <tr><td class="text-muted w-50">Total Experience:</td><td class="font-weight-bold">@Model.ExperienceYears Years</td></tr>
                        <tr><td class="text-muted">Certified:</td><td>@(Model.IsCertified ? "Yes" : "No")</td></tr>
                        <tr><td class="text-muted">Garage Name:</td><td>@(string.IsNullOrEmpty(Model.GarageName) ? "None" : Model.GarageName)</td></tr>
                        <tr><td class="text-muted">Service Radius:</td><td>@Model.ServiceRadiusKm KM</td></tr>
                    </table>
                    
                    <hr class="border-secondary my-3">
                    
                    <span class="text-muted small d-block mb-2">Vehicles:</span>
                    <div class="d-flex flex-wrap gap-1 mb-3">
                        @foreach (var v in (Model.VehicleExpertise ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <span class="badge bg-secondary text-light">@v.Trim()</span>
                        }
                    </div>

                    <span class="text-muted small d-block mb-2">Specializations:</span>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var s in (Model.Specialization ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <span class="badge bg-primary text-light">@s.Trim()</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Bar -->
        <div class="glass-card p-4 mt-4 d-flex justify-content-end gap-3">
            <form action="/Admin/ApproveKyc" method="post">
                <input type="hidden" name="userId" value="@Model.UserId" />
                <input type="hidden" name="status" value="Suspended" />
                <button type="submit" class="btn btn-outline-danger px-4" onclick="return confirm('Are you sure you want to Reject this application and Suspend this mechanic ID?');">
                    <i class="fa-solid fa-ban me-1"></i> Reject Application
                </button>
            </form>

            @if (ViewData["IsPartial"] as bool? == true)
            {
                <button type="button" class="btn btn-secondary px-5 font-weight-bold" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark me-1"></i> Close
                </button>
            }
            else
            {
                <a href="/Admin/ManageUsers" class="btn btn-secondary px-5 font-weight-bold">
                    <i class="fa-solid fa-xmark me-1"></i> Close
                </a>
            }
        </div>
    </div>
</div>

@if (ViewData["IsPartial"] as bool? == true)
{
    <script>
        $(document).off('submit', '#kycReviewModal form').on('submit', '#kycReviewModal form', function(e) {
            e.preventDefault();
            var form = $(this);
            var url = form.attr('action');
            var data = form.serialize();
            
            $.ajax({
                type: 'POST',
                url: url,
                data: data,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                success: function(res) {
                    if (res.success) {
                        // Close modal
                        var modalEl = document.getElementById('kycReviewModal');
                        var modal = bootstrap.Modal.getInstance(modalEl);
                        if (modal) modal.hide();
                        
                        // Reload screen to refresh grid
                        window.location.reload();
                    } else {
                        alert('Something went wrong. Please try again.');
                    }
                },
                error: function() {
                    alert('Error submitting request.');
                }
            });
        });
    </script>
}

