@model RaahSathi.Models.MechanicProfile
@{
    bool isPartial = ViewData["IsPartial"] as bool? == true;
    if (isPartial)
    {
        Layout = null;
    }
    else
    {
        ViewData["Title"] = "Review KYC Application";
    }
}

<div class="@(isPartial ? "" : "row justify-content-center py-4")">
    <div class="@(isPartial ? "" : "col-lg-10")">
        <!-- Top Bar with Status and Back Button -->
        <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom border-secondary border-opacity-30">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <h4 class="text-white font-weight-bold mb-0">
                    <i class="fa-solid fa-id-card text-warning me-2"></i> Review KYC: @Model.User?.Name
                </h4>
                @if (Model.KycStatus == "Approved")
                {
                    <span class="badge bg-success text-white px-2 py-1"><i class="fa-solid fa-circle-check me-1"></i> Verified & Approved</span>
                }
                else if (Model.KycStatus == "Rejected" || Model.KycStatus == "Suspended")
                {
                    <span class="badge bg-danger text-white px-2 py-1"><i class="fa-solid fa-ban me-1"></i> @Model.KycStatus</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark px-2 py-1"><i class="fa-solid fa-clock me-1"></i> Pending Verification</span>
                }
            </div>
            <div>
                @if (isPartial)
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm font-weight-bold px-3" data-bs-dismiss="modal" onclick="var m = bootstrap.Modal.getOrCreateInstance(document.getElementById('kycReviewModal')); if(m) m.hide();">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to Users
                    </button>
                }
                else
                {
                    <a href="/Admin/ManageUsers" class="btn btn-outline-secondary btn-sm font-weight-bold px-3">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to Users
                    </a>
                }
            </div>
        </div>

        @if (Model.KycStatus == "Approved")
        {
            <div class="alert alert-success bg-dark bg-opacity-75 border-success text-success mb-3 py-2">
                <i class="fa-solid fa-circle-check me-1"></i> This mechanic profile is currently <strong>Approved & Active</strong>.
            </div>
        }
        else if (Model.KycStatus == "Rejected" || Model.KycStatus == "Suspended")
        {
            <div class="alert alert-danger bg-dark bg-opacity-75 border-danger text-danger mb-3 py-2">
                <i class="fa-solid fa-ban me-1"></i> This mechanic profile is currently <strong>@Model.KycStatus</strong>.
            </div>
        }
        else
        {
            <div class="alert alert-warning bg-dark bg-opacity-75 border-warning text-warning mb-3 py-2">
                <i class="fa-solid fa-triangle-exclamation me-1"></i> KYC application is <strong>Pending Review</strong>. Please audit the documents below and choose <strong>Approve</strong> or <strong>Reject</strong>.
            </div>
        }

        <div class="row g-3">
            <!-- 1. Personal Info -->
            <div class="col-md-6">
                <div class="p-3 rounded-3 bg-black bg-opacity-40 border border-secondary border-opacity-40 h-100 shadow-sm">
                    <h6 class="text-warning font-weight-bold mb-3 d-flex align-items-center">
                        <i class="fa-solid fa-user me-2 text-warning"></i> 1. Personal Information
                    </h6>
                    <table class="table table-borderless text-light table-sm mb-2" style="font-size: 0.85rem;">
                        <tr><td class="text-muted w-40">Name:</td><td class="font-weight-bold text-white">@Model.User?.Name</td></tr>
                        <tr><td class="text-muted">Phone:</td><td class="text-info font-weight-bold"><i class="fa-solid fa-phone me-1"></i>@Model.User?.PhoneNumber</td></tr>
                        <tr><td class="text-muted">Email:</td><td>@(string.IsNullOrEmpty(Model.Email) ? "N/A" : Model.Email)</td></tr>
                        <tr><td class="text-muted">DOB:</td><td>@(Model.DateOfBirth?.ToString("dd MMM yyyy") ?? "N/A")</td></tr>
                        <tr><td class="text-muted">Gender:</td><td>@Model.Gender</td></tr>
                    </table>
                    @if (!string.IsNullOrEmpty(Model.ProfilePhotoUrl))
                    {
                        <div class="mt-2 pt-2 border-top border-secondary border-opacity-30">
                            <span class="text-muted small d-block mb-1">Profile Photo:</span>
                            <a href="@Model.ProfilePhotoUrl" target="_blank" title="Click to view full photo">
                                <img src="@Model.ProfilePhotoUrl" alt="Profile" class="img-thumbnail bg-dark border-secondary" style="max-height: 120px; border-radius: 8px; cursor: zoom-in;">
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- 2. Identity Info (KYC Docs) -->
            <div class="col-md-6">
                <div class="p-3 rounded-3 bg-black bg-opacity-40 border border-secondary border-opacity-40 h-100 shadow-sm">
                    <h6 class="text-warning font-weight-bold mb-3 d-flex align-items-center">
                        <i class="fa-solid fa-file-shield me-2 text-warning"></i> 2. Identity (KYC Documents)
                    </h6>
                    <table class="table table-borderless text-light table-sm mb-2" style="font-size: 0.85rem;">
                        <tr>
                            <td class="text-muted w-40">Aadhaar No:</td>
                            <td class="font-weight-bold text-warning font-monospace">@(string.IsNullOrEmpty(Model.AadhaarNumber) ? "Not Provided" : Model.AadhaarNumber)</td>
                        </tr>
                    </table>
                    
                    <div class="row g-2 mt-1">
                        @if (!string.IsNullOrEmpty(Model.AadhaarFrontUrl))
                        {
                            <div class="col-6">
                                <span class="text-muted small d-block mb-1">Aadhaar Front</span>
                                <a href="@Model.AadhaarFrontUrl" target="_blank" class="d-block" title="Click to open image">
                                    <img src="@Model.AadhaarFrontUrl" class="img-fluid rounded border border-secondary" style="height: 85px; width: 100%; object-fit: cover; cursor: zoom-in;">
                                </a>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.AadhaarBackUrl))
                        {
                            <div class="col-6">
                                <span class="text-muted small d-block mb-1">Aadhaar Back</span>
                                <a href="@Model.AadhaarBackUrl" target="_blank" class="d-block" title="Click to open image">
                                    <img src="@Model.AadhaarBackUrl" class="img-fluid rounded border border-secondary" style="height: 85px; width: 100%; object-fit: cover; cursor: zoom-in;">
                                </a>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.DrivingLicenceUrl))
                        {
                            <div class="col-6 mt-2">
                                <span class="text-muted small d-block mb-1">Driving Licence</span>
                                <a href="@Model.DrivingLicenceUrl" target="_blank" class="d-block" title="Click to open image">
                                    <img src="@Model.DrivingLicenceUrl" class="img-fluid rounded border border-secondary" style="height: 85px; width: 100%; object-fit: cover; cursor: zoom-in;">
                                </a>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.PanCardUrl))
                        {
                            <div class="col-6 mt-2">
                                <span class="text-muted small d-block mb-1">PAN Card</span>
                                <a href="@Model.PanCardUrl" target="_blank" class="d-block" title="Click to open image">
                                    <img src="@Model.PanCardUrl" class="img-fluid rounded border border-secondary" style="height: 85px; width: 100%; object-fit: cover; cursor: zoom-in;">
                                </a>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.SelfieUrl))
                        {
                            <div class="col-6 mt-2">
                                <span class="text-muted small d-block mb-1">Selfie Verification</span>
                                <a href="@Model.SelfieUrl" target="_blank" class="d-block" title="Click to open image">
                                    <img src="@Model.SelfieUrl" class="img-fluid rounded border border-secondary" style="height: 85px; width: 100%; object-fit: cover; cursor: zoom-in;">
                                </a>
                            </div>
                        }
                        @if (string.IsNullOrEmpty(Model.AadhaarFrontUrl) && string.IsNullOrEmpty(Model.AadhaarBackUrl) && string.IsNullOrEmpty(Model.DrivingLicenceUrl) && string.IsNullOrEmpty(Model.PanCardUrl) && string.IsNullOrEmpty(Model.SelfieUrl))
                        {
                            <div class="col-12 py-3 text-center text-muted small">
                                <i class="fa-solid fa-file-excel me-1"></i> No document images uploaded yet.
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- 3. Shop Info -->
            <div class="col-md-6">
                <div class="p-3 rounded-3 bg-black bg-opacity-40 border border-secondary border-opacity-40 h-100 shadow-sm">
                    <h6 class="text-warning font-weight-bold mb-3 d-flex align-items-center">
                        <i class="fa-solid fa-shop me-2 text-warning"></i> 3. Shop & Location Information
                    </h6>
                    <table class="table table-borderless text-light table-sm mb-2" style="font-size: 0.85rem;">
                        <tr><td class="text-muted w-40">Shop Name:</td><td class="font-weight-bold text-white">@(string.IsNullOrEmpty(Model.ShopName) ? "Individual (No Shop)" : Model.ShopName)</td></tr>
                        <tr><td class="text-muted">Address:</td><td>@(string.IsNullOrEmpty(Model.ShopAddress) ? "N/A" : Model.ShopAddress)</td></tr>
                        <tr><td class="text-muted">Pincode:</td><td class="text-info font-weight-bold">@(string.IsNullOrEmpty(Model.Pincode) ? "N/A" : Model.Pincode)</td></tr>
                        <tr><td class="text-muted">Timings:</td><td>@(string.IsNullOrEmpty(Model.ShopTiming) ? "24x7 Emergency" : Model.ShopTiming)</td></tr>
                    </table>
                    @if (!string.IsNullOrEmpty(Model.ShopPhotoUrl))
                    {
                        <div class="mt-2 pt-2 border-top border-secondary border-opacity-30">
                            <span class="text-muted small d-block mb-1">Shop Front Photo:</span>
                            <a href="@Model.ShopPhotoUrl" target="_blank" title="Click to open shop photo">
                                <img src="@Model.ShopPhotoUrl" class="img-fluid rounded border border-secondary" style="max-height: 110px; cursor: zoom-in;">
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- 4. Experience & Expertise -->
            <div class="col-md-6">
                <div class="p-3 rounded-3 bg-black bg-opacity-40 border border-secondary border-opacity-40 h-100 shadow-sm">
                    <h6 class="text-warning font-weight-bold mb-3 d-flex align-items-center">
                        <i class="fa-solid fa-screwdriver-wrench me-2 text-warning"></i> 4. Experience & Expertise
                    </h6>
                    <table class="table table-borderless text-light table-sm mb-2" style="font-size: 0.85rem;">
                        <tr><td class="text-muted w-40">Experience:</td><td class="font-weight-bold text-success">@Model.ExperienceYears Years</td></tr>
                        <tr><td class="text-muted">Certified:</td><td>@(Model.IsCertified ? "Yes (Certified)" : "No")</td></tr>
                        <tr><td class="text-muted">Garage:</td><td>@(string.IsNullOrEmpty(Model.GarageName) ? "Independent" : Model.GarageName)</td></tr>
                        <tr><td class="text-muted">Service Radius:</td><td class="text-warning font-weight-bold">@Model.ServiceRadiusKm KM</td></tr>
                    </table>
                    
                    <hr class="border-secondary border-opacity-30 my-2">
                    
                    <span class="text-muted small d-block mb-1">Vehicles Supported:</span>
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        @foreach (var v in (Model.VehicleExpertise ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <span class="badge bg-secondary text-light font-weight-normal" style="font-size:0.75rem;">@v.Trim()</span>
                        }
                    </div>

                    <span class="text-muted small d-block mb-1">Specializations:</span>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var s in (Model.Specialization ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <span class="badge bg-primary text-light font-weight-normal" style="font-size:0.75rem;">@s.Trim()</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 🚀 Action Bar: Approve KYC, Reject KYC, Close -->
        <div class="p-3 rounded-3 bg-black bg-opacity-60 border border-secondary border-opacity-50 mt-4 d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-3 shadow-lg">
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small"><i class="fa-solid fa-gavel text-warning me-1"></i> Admin Decision:</span>
            </div>
            
            <div class="d-flex align-items-center gap-2 flex-column flex-sm-row w-100 w-sm-auto">
                <!-- Approve Button -->
                <form action="/Admin/ApproveKyc" method="post" class="d-inline kyc-action-form w-100 w-sm-auto">
                    <input type="hidden" name="userId" value="@Model.UserId" />
                    <input type="hidden" name="status" value="Approved" />
                    <button type="submit" class="btn btn-success font-weight-bold px-4 py-2 w-100 shadow-sm" onclick="return confirm('Confirm Approve: Verify and activate KYC for mechanic @(Model.User?.Name)?');">
                        <i class="fa-solid fa-circle-check me-1"></i> Approve KYC
                    </button>
                </form>

                <!-- Reject Button -->
                <form action="/Admin/ApproveKyc" method="post" class="d-inline kyc-action-form w-100 w-sm-auto">
                    <input type="hidden" name="userId" value="@Model.UserId" />
                    <input type="hidden" name="status" value="Rejected" />
                    <button type="submit" class="btn btn-danger font-weight-bold px-4 py-2 w-100 shadow-sm" onclick="return confirm('Confirm Reject: Reject KYC application for mechanic @(Model.User?.Name)?');">
                        <i class="fa-solid fa-circle-xmark me-1"></i> Reject KYC
                    </button>
                </form>

                <!-- Close / Back Button -->
                @if (isPartial)
                {
                    <button type="button" class="btn btn-outline-secondary font-weight-bold px-4 py-2 w-100 w-sm-auto" data-bs-dismiss="modal" onclick="var m = bootstrap.Modal.getOrCreateInstance(document.getElementById('kycReviewModal')); if(m) m.hide();">
                        <i class="fa-solid fa-xmark me-1"></i> Close
                    </button>
                }
                else
                {
                    <a href="/Admin/ManageUsers" class="btn btn-outline-secondary font-weight-bold px-4 py-2 w-100 w-sm-auto text-center">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to Users
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@if (isPartial)
{
    <script>
        $(document).off('submit', '#kycReviewModal form.kyc-action-form').on('submit', '#kycReviewModal form.kyc-action-form', function(e) {
            e.preventDefault();
            var form = $(this);
            var url = form.attr('action');
            var data = form.serialize();
            var btn = form.find('button[type="submit"]');
            var originalHtml = btn.html();
            btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Processing...');
            
            $.ajax({
                type: 'POST',
                url: url,
                data: data,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                success: function(res) {
                    if (res && res.success) {
                        // Close modal
                        var modalEl = document.getElementById('kycReviewModal');
                        if (modalEl) {
                            var modal = bootstrap.Modal.getInstance(modalEl) || bootstrap.Modal.getOrCreateInstance(modalEl);
                            if (modal) modal.hide();
                        }
                        
                        if (typeof window.submitKycDecisionSuccess === 'function') {
                            window.submitKycDecisionSuccess(res.userId, res.status, res.name);
                        } else {
                            window.location.reload();
                        }
                    } else {
                        alert(res.message || 'Something went wrong. Please try again.');
                        btn.prop('disabled', false).html(originalHtml);
                    }
                },
                error: function() {
                    alert('Error submitting request. Please try again.');
                    btn.prop('disabled', false).html(originalHtml);
                }
            });
        });
    </script>
}

