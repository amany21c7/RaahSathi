@using RaahSathi.Models
@{
    ViewData["Title"] = "Admin Account & Treasury Vault";
    var withdrawalHistory = ViewBag.WithdrawalHistory as List<AdminWithdrawal> ?? new List<AdminWithdrawal>();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 border-bottom border-secondary border-opacity-30 pb-3">
    <div>
        <h3 class="text-white font-weight-bold mb-1" style="font-family: 'Outfit', sans-serif;">
            <i class="fa-solid fa-building-columns text-warning me-2"></i> Admin Account & Treasury Vault
        </h3>
        <p class="text-muted small mb-0">Configure platform payout destinations, manage your commission vault, and execute treasury withdrawals.</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-success bg-success bg-opacity-10 text-white alert-dismissible fade show mb-4 font-weight-bold shadow-sm" role="alert">
        <i class="fa-solid fa-circle-check me-2 text-success"></i> @TempData["Success"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Admin Tiered Commission Vault Banner -->
<div class="p-4 rounded-3 bg-gradient bg-dark border border-warning border-opacity-50 mb-4 shadow-lg">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-warning text-dark font-weight-bold px-3 py-1">ADMIN COMMISSION VAULT</span>
            </div>
            <h2 class="text-warning font-weight-extrabold mt-2 mb-1" style="font-family: 'Outfit';">
                ₹@(((double)(ViewBag.AdminVaultBalance ?? 0.0)).ToString("N2"))
            </h2>
            <p class="text-muted small mb-0">
                Total Commission Earned: <strong class="text-light">₹@(((double)(ViewBag.TotalCommissionEarned ?? 0.0)).ToString("N2"))</strong> | 
                Total Withdrawn: <strong class="text-light">₹@(((double)(ViewBag.TotalWithdrawn ?? 0.0)).ToString("N2"))</strong>
            </p>
        </div>
        <div>
            <button type="button" class="btn btn-warning font-weight-bold px-4 py-2 shadow" data-bs-toggle="modal" data-bs-target="#adminWithdrawModal">
                <i class="fa-solid fa-money-bill-transfer me-2"></i> Withdraw Vault Funds
            </button>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Bank & UPI details setup -->
    <div class="col-lg-6">
        <div class="card bg-dark border-secondary shadow-sm h-100">
            <div class="card-header border-secondary bg-transparent py-3">
                <h5 class="text-warning mb-0"><i class="fa-solid fa-address-card me-2"></i> Payout Details Setup</h5>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-4">Set up the default bank account and UPI details. The customer QR Code will be dynamically generated based on this UPI ID for online payments.</p>
                
                <form action="/Admin/SaveAdminAccountSettings" method="POST">
                    <div class="mb-3">
                        <label class="form-label text-muted small font-weight-bold">UPI ID (VPA) <span class="text-danger">*</span></label>
                        <input type="text" name="upiId" class="form-control glass-input text-warning font-weight-bold" placeholder="e.g. raahsathi@upi" value="@ViewBag.AdminUpiId" required>
                        <div class="text-muted small mt-1" style="font-size:0.75rem;"><i class="fa-solid fa-info-circle me-1"></i> Used to generate payment QR Code for customer dispatch.</div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label text-muted small font-weight-bold">Account Holder Name <span class="text-danger">*</span></label>
                        <input type="text" name="holderName" class="form-control glass-input text-light" placeholder="e.g. RaahSathi Private Limited" value="@ViewBag.AdminAccountHolderName" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small font-weight-bold">Bank Name</label>
                        <input type="text" name="bankName" class="form-control glass-input text-light" placeholder="e.g. HDFC Bank" value="@ViewBag.AdminBankName">
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small font-weight-bold">Bank Account Number</label>
                        <input type="text" name="accountNumber" class="form-control glass-input text-light" placeholder="e.g. 50100293847261" value="@ViewBag.AdminAccountNumber">
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small font-weight-bold">IFSC Code</label>
                        <input type="text" name="ifscCode" class="form-control glass-input text-light text-uppercase" placeholder="e.g. HDFC0000102" value="@ViewBag.AdminIfscCode">
                    </div>

                    <button type="submit" class="btn btn-warning text-dark font-weight-bold w-100 py-2.5">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Save Settlement Details
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Right Column: Recent Withdrawals Transaction Ledger -->
    <div class="col-lg-6">
        <div class="card bg-dark border-secondary shadow-sm h-100">
            <div class="card-header border-secondary bg-transparent py-3">
                <h5 class="text-info mb-0"><i class="fa-solid fa-clock-rotate-left me-2"></i> Recent Treasury Withdrawals</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0 align-middle small" style="border-color: rgba(255,255,255,0.05);">
                        <thead>
                            <tr class="text-muted" style="border-bottom: 2px solid rgba(255,255,255,0.08);">
                                <th class="ps-3">Date / Time</th>
                                <th>Amount</th>
                                <th>Method</th>
                                <th>Reference Number</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (withdrawalHistory.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">No withdrawals recorded yet.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var w in withdrawalHistory)
                                {
                                    <tr>
                                        <td class="ps-3 text-light">@w.WithdrawnAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                                        <td class="text-warning font-weight-bold">₹@w.Amount.ToString("N2")</td>
                                        <td><span class="badge bg-secondary text-light">@w.PayoutMethod</span></td>
                                        <td class="text-muted font-monospace">@w.ReferenceNumber</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Admin Commission Vault Withdrawal Modal -->
<div class="modal fade" id="adminWithdrawModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light border border-warning">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-warning font-weight-bold">
                    <i class="fa-solid fa-building-columns me-2"></i> Withdraw Admin Commission Vault
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="p-3 bg-dark bg-opacity-60 rounded border border-secondary mb-3">
                    <span class="text-muted small d-block mb-1">Available Vault Balance</span>
                    <h3 class="text-warning font-weight-bold mb-0">₹@(((double)(ViewBag.AdminVaultBalance ?? 0.0)).ToString("N2"))</h3>
                </div>
                <form id="formAdminWithdraw">
                    <div class="mb-3">
                        <label class="form-label text-light small font-weight-bold">Withdrawal Amount (₹)</label>
                        <input type="number" step="0.01" max="@(ViewBag.AdminVaultBalance ?? 100000)" class="form-control glass-input text-warning font-weight-bold" id="admWithdrawAmount" value="@(ViewBag.AdminVaultBalance ?? 1000)" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-light small font-weight-bold">Payout Destination / Method</label>
                        <select id="admWithdrawMethod" class="form-select glass-input text-light">
                            <option value="Bank Direct Transfer">Bank Direct Transfer (@(string.IsNullOrEmpty(ViewBag.AdminBankName) ? "Default Bank" : ViewBag.AdminBankName))</option>
                            <option value="UPI Primary Account">UPI Primary Account (@(string.IsNullOrEmpty(ViewBag.AdminUpiId) ? "Default UPI" : ViewBag.AdminUpiId))</option>
                            <option value="Escrow Treasury Settlement">Escrow Treasury Settlement</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-light small font-weight-bold">Reference / Transaction Note (Optional)</label>
                        <input type="text" id="admWithdrawRef" class="form-control glass-input text-light" placeholder="e.g. Monthly Admin Treasury Transfer">
                    </div>
                    <button type="submit" class="btn btn-warning w-100 font-weight-bold py-2">
                        <i class="fa-solid fa-check-circle me-1"></i> Process Vault Withdrawal
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $('#formAdminWithdraw').on('submit', function (e) {
        e.preventDefault();
        var amount = parseFloat($('#admWithdrawAmount').val());
        var method = $('#admWithdrawMethod').val();
        var ref = $('#admWithdrawRef').val();

        if (!amount || amount <= 0) {
            alert('Please enter a valid withdrawal amount.');
            return;
        }

        $.post('/Admin/WithdrawAdminCommission', { amount: amount, payoutMethod: method, referenceNumber: ref }, function (res) {
            if (res.success) {
                alert(res.message);
                window.location.reload();
            } else {
                alert(res.message || 'Error executing withdrawal.');
            }
        });
    });
</script>
}
