@model IEnumerable<RaahSathi.Models.ContactMessage>
@{
    ViewData["Title"] = "Customer Contact Messages - Admin Console";
    string currentFilter = ViewBag.StatusFilter as string ?? "All";
    int totalCount = ViewBag.TotalCount ?? 0;
    int pendingCount = ViewBag.PendingCount ?? 0;
    int contactedCount = ViewBag.ContactedCount ?? 0;
    int resolvedCount = ViewBag.ResolvedCount ?? 0;
}

<div class="container-fluid py-4">
    <!-- Header & Navigation -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom border-secondary">
        <div>
            <span class="badge bg-warning text-dark font-weight-bold px-3 py-1 mb-2">ADMIN CONSOLE</span>
            <h2 class="text-white font-weight-bold mb-0" style="font-family: 'Outfit', sans-serif;">
                <i class="fa-solid fa-headset text-warning me-2"></i> Customer Contact Enquiries
            </h2>
            <p class="text-muted small mb-0">Read customer breakdown &amp; partnership messages, manage follow-ups, and contact directly.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a href="/Admin/Dashboard" class="btn btn-outline-light btn-sm px-3">
                <i class="fa-solid fa-gauge me-1"></i> Dashboard
            </a>
            <a href="/Admin/ManagePricing" class="btn btn-outline-warning btn-sm px-3">
                <i class="fa-solid fa-indian-rupee-sign me-1"></i> Pricing Rules
            </a>
        </div>
    </div>

    <!-- Summary Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <a href="/Admin/Messages?statusFilter=All" class="text-decoration-none">
                <div class="glass-card p-3 border-secondary text-center hover-lift @(currentFilter == "All" ? "border-warning bg-dark" : "")">
                    <div class="text-muted small">Total Messages</div>
                    <h3 class="text-white font-weight-bold mb-0 mt-1">@totalCount</h3>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/Admin/Messages?statusFilter=Pending" class="text-decoration-none">
                <div class="glass-card p-3 border-warning text-center hover-lift @(currentFilter == "Pending" ? "border-warning bg-dark" : "")">
                    <div class="text-warning small font-weight-bold"><i class="fa-solid fa-clock me-1"></i> Pending Follow-up</div>
                    <h3 class="text-warning font-weight-bold mb-0 mt-1">@pendingCount</h3>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/Admin/Messages?statusFilter=Contacted" class="text-decoration-none">
                <div class="glass-card p-3 border-info text-center hover-lift @(currentFilter == "Contacted" ? "border-info bg-dark" : "")">
                    <div class="text-info small font-weight-bold"><i class="fa-solid fa-phone me-1"></i> Contacted</div>
                    <h3 class="text-info font-weight-bold mb-0 mt-1">@contactedCount</h3>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a href="/Admin/Messages?statusFilter=Resolved" class="text-decoration-none">
                <div class="glass-card p-3 border-success text-center hover-lift @(currentFilter == "Resolved" ? "border-success bg-dark" : "")">
                    <div class="text-success small font-weight-bold"><i class="fa-solid fa-circle-check me-1"></i> Resolved</div>
                    <h3 class="text-success font-weight-bold mb-0 mt-1">@resolvedCount</h3>
                </div>
            </a>
        </div>
    </div>

    <!-- Filter Buttons Toolbar -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="btn-group" role="group">
            <a href="/Admin/Messages?statusFilter=All" class="btn btn-sm @(currentFilter == "All" ? "btn-warning font-weight-bold" : "btn-outline-secondary text-light")">All (@totalCount)</a>
            <a href="/Admin/Messages?statusFilter=Pending" class="btn btn-sm @(currentFilter == "Pending" ? "btn-warning font-weight-bold" : "btn-outline-secondary text-light")">Pending (@pendingCount)</a>
            <a href="/Admin/Messages?statusFilter=Contacted" class="btn btn-sm @(currentFilter == "Contacted" ? "btn-warning font-weight-bold" : "btn-outline-secondary text-light")">Contacted (@contactedCount)</a>
            <a href="/Admin/Messages?statusFilter=Resolved" class="btn btn-sm @(currentFilter == "Resolved" ? "btn-warning font-weight-bold" : "btn-outline-secondary text-light")">Resolved (@resolvedCount)</a>
        </div>
    </div>

    <!-- Messages Table -->
    <div class="glass-card p-3 border-secondary">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fa-solid fa-inbox text-muted fa-3x mb-3"></i>
                <h5 class="text-white">No Messages Found</h5>
                <p class="text-muted small">There are no customer contact messages matching filter "@currentFilter".</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
                    <thead>
                        <tr class="text-muted small border-bottom border-secondary">
                            <th>ID &amp; Date</th>
                            <th>Customer Info</th>
                            <th>Subject &amp; Inquiry</th>
                            <th>Message Snippet</th>
                            <th>Status</th>
                            <th class="text-end">Direct Contact Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var msg in Model)
                        {
                            var cleanPhone = msg.Phone.Replace(" ", "").Replace("-", "").Replace("+", "");
                            if (cleanPhone.Length == 10) cleanPhone = "91" + cleanPhone;

                            <tr class="border-bottom border-secondary border-opacity-30">
                                <td>
                                    <div class="font-weight-bold text-white">#MSG-@msg.Id</div>
                                    <div class="text-muted style-small" style="font-size: 0.75rem;">
                                        @msg.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")
                                    </div>
                                </td>
                                <td>
                                    <div class="font-weight-bold text-white">@msg.FullName</div>
                                    <div class="small text-warning">
                                        <i class="fa-solid fa-phone me-1"></i> @msg.Phone
                                    </div>
                                    @if (!string.IsNullOrEmpty(msg.Email))
                                    {
                                        <div class="small text-muted">
                                            <i class="fa-solid fa-envelope me-1"></i> @msg.Email
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-dark border border-warning text-warning mb-1">
                                        @msg.Subject
                                    </span>
                                </td>
                                <td>
                                    <div class="text-light text-truncate" style="max-width: 250px;" title="@msg.Message">
                                        @msg.Message
                                    </div>
                                    @if (!string.IsNullOrEmpty(msg.AdminNotes))
                                    {
                                        <div class="small text-info mt-1">
                                            <i class="fa-solid fa-sticky-note me-1"></i> Note: @msg.AdminNotes
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (msg.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark font-weight-bold px-2 py-1"><i class="fa-solid fa-clock me-1"></i> Pending</span>
                                    }
                                    else if (msg.Status == "Contacted")
                                    {
                                        <span class="badge bg-info text-dark font-weight-bold px-2 py-1"><i class="fa-solid fa-phone me-1"></i> Contacted</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success text-white font-weight-bold px-2 py-1"><i class="fa-solid fa-circle-check me-1"></i> Resolved</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <!-- Call Button -->
                                        <a href="tel:@msg.Phone" class="btn btn-outline-warning btn-sm" title="Call Customer">
                                            <i class="fa-solid fa-phone"></i>
                                        </a>

                                        <!-- WhatsApp Button -->
                                        <a href="https://wa.me/@cleanPhone?text=Hello%20@Uri.EscapeDataString(msg.FullName),%20this%20is%20RaahSathi%20Support%20regarding%20your%20inquiry:%20@Uri.EscapeDataString(msg.Subject)" target="_blank" class="btn btn-outline-success btn-sm" title="WhatsApp Customer">
                                            <i class="fa-brands fa-whatsapp"></i>
                                        </a>

                                        <!-- Email Button -->
                                        @if (!string.IsNullOrEmpty(msg.Email))
                                        {
                                            <a href="mailto:@msg.Email?subject=Re:%20RaahSathi%20Inquiry%20-%20@Uri.EscapeDataString(msg.Subject)" class="btn btn-outline-info btn-sm" title="Send Email">
                                                <i class="fa-solid fa-envelope"></i>
                                            </a>
                                        }

                                        <!-- Action / Manage Modal Trigger -->
                                        <button type="button" class="btn btn-primary btn-sm px-2" onclick="openManageModal(@msg.Id, '@msg.FullName', '@msg.Phone', '@msg.Email', '@Uri.EscapeDataString(msg.Subject)', '@Uri.EscapeDataString(msg.Message)', '@msg.Status', '@Uri.EscapeDataString(msg.AdminNotes ?? "")')">
                                            <i class="fa-solid fa-pen-to-square me-1"></i> Manage
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Manage Status & Notes Modal -->
<div class="modal fade" id="manageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary text-white">
            <div class="modal-header border-secondary">
                <h5 class="modal-title font-weight-bold" id="modalTitle"><i class="fa-solid fa-headset me-2 text-warning"></i> Manage Message</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="modalMsgId" />
                
                <div class="p-3 bg-secondary bg-opacity-20 rounded mb-3 border border-secondary">
                    <div class="d-flex justify-content-between mb-1">
                        <strong class="text-warning" id="modalName"></strong>
                        <span class="small text-muted" id="modalPhone"></span>
                    </div>
                    <div class="small text-info mb-2" id="modalSubject"></div>
                    <div class="p-2 bg-dark rounded text-light small" id="modalMessageText" style="max-height: 120px; overflow-y: auto;"></div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">Update Status</label>
                    <select id="modalStatus" class="form-select bg-dark text-white border-secondary">
                        <option value="Pending">Pending (Needs Attention)</option>
                        <option value="Contacted">Contacted (Customer Called/Messaged)</option>
                        <option value="Resolved">Resolved (Completed / Closed)</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">Admin Notes / Follow-up Record</label>
                    <textarea id="modalNotes" class="form-control bg-dark text-white border-secondary" rows="3" placeholder="Add private notes on conversation details..."></textarea>
                </div>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning font-weight-bold" onclick="saveMessageStatus()">
                    <i class="fa-solid fa-floppy-disk me-1"></i> Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openManageModal(id, name, phone, email, subject, message, status, notes) {
        $('#modalMsgId').val(id);
        $('#modalName').text(name);
        $('#modalPhone').text(phone + (email ? ' | ' + email : ''));
        $('#modalSubject').text('Subject: ' + decodeURIComponent(subject));
        $('#modalMessageText').text(decodeURIComponent(message));
        $('#modalStatus').val(status);
        $('#modalNotes').val(decodeURIComponent(notes));

        var modal = new bootstrap.Modal(document.getElementById('manageModal'));
        modal.show();
    }

    function saveMessageStatus() {
        var id = $('#modalMsgId').val();
        var status = $('#modalStatus').val();
        var notes = $('#modalNotes').val();

        $.post('/Admin/UpdateMessageStatus', { id: id, status: status, adminNotes: notes }, function(res) {
            if (res && res.success) {
                location.reload();
            } else {
                alert('Error updating status: ' + (res.message || 'Unknown error'));
            }
        }).fail(function() {
            alert('Failed to update status. Please try again.');
        });
    }
</script>
}
