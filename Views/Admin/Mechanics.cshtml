@using RaahSathi.Models
@using System.Text.Encodings.Web
@model List<MechanicProfile>
@{
    ViewData["Title"] = "Mechanic Network Fleet";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <span class="badge bg-warning text-dark font-weight-bold px-3 py-1 mb-2">SYSTEM CONSOLE</span>
        <h4 class="text-white font-weight-bold mb-1"><i class="fa-solid fa-wrench text-warning me-2"></i> Mechanic Network Fleet</h4>
        <p class="text-muted small mb-0">Partner onboarding, KYC document verification, skills, rating, wallet, and live online status.</p>
    </div>
</div>

<!-- Search & Location Filter Bar -->
<div class="row g-2 mb-3">
    <div class="col-md-6 col-lg-4">
        <div class="input-group shadow-sm">
            <span class="input-group-text bg-dark border-secondary text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="text" id="mechSearchFilter" class="form-control bg-dark text-white border-secondary" placeholder="Search by ID, Name, or Mobile...">
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="input-group shadow-sm">
            <span class="input-group-text bg-dark border-secondary text-muted"><i class="fa-solid fa-location-dot text-danger"></i></span>
            <input type="text" id="locationFilter" class="form-control bg-dark text-white border-secondary" placeholder="Filter by Location, City, Shop or Address...">
        </div>
    </div>
</div>

<div class="card bg-dark border-secondary shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle" id="mechanicsTable">
                <thead>
                    <tr class="border-secondary text-muted small">
                        <th class="ps-3">Mechanic & ID</th>
                        <th>Phone</th>
                        <th>Category & City</th>
                        <th>KYC Status</th>
                        <th>Online / Status</th>
                        <th>Rating & Wallet</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr class="no-data-row">
                            <td colspan="7" class="text-center py-4 text-muted">No mechanics registered yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var m in Model)
                        {
                            var name = m.User?.Name ?? "Partner";
                            var phone = m.User?.PhoneNumber ?? "N/A";
                            var blockStatus = m.User?.IsBlocked == true ? "Blocked" : "Active";
                            
                            <tr class="border-secondary mech-row">
                                <td class="ps-3">
                                    <div class="font-weight-bold text-white">@name</div>
                                    <span class="badge bg-warning text-dark font-weight-bold" style="font-size:0.68rem;">@m.DisplayId</span>
                                </td>
                                <td class="text-light">@phone</td>
                                <td>
                                    <span class="badge bg-secondary text-light">@m.SkillCategory</span>
                                    <div class="text-muted small">Exp: @m.ExperienceYears Years</div>
                                    <div class="text-info font-weight-bold small mt-0.5"><i class="fa-solid fa-map-pin me-1"></i> <span class="row-city-text">@m.City</span></div>
                                </td>
                                <td>
                                    @if (m.KycStatus == "Approved")
                                    {
                                        <span class="badge bg-success text-white"><i class="fa-solid fa-check me-1"></i> Verified</span>
                                    }
                                    else if (m.KycStatus == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i> Pending KYC</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger text-white">@m.KycStatus</span>
                                    }
                                </td>
                                <td>
                                    @if (m.IsOnline)
                                    {
                                        <span class="badge bg-success text-white">🟢 ONLINE</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary text-light">OFFLINE</span>
                                    }
                                </td>
                                <td>
                                    <div class="text-warning font-weight-bold">@m.Rating.ToString("0.0") ★</div>
                                    <span class="text-info small font-weight-bold">@m.TotalJobs Jobs Completed</span>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-flex justify-content-end gap-1">
                                        <button class="btn btn-sm btn-outline-warning font-weight-bold" onclick="showMechDetails('@m.DisplayId', '@Html.Raw(JavaScriptEncoder.Default.Encode(name))', '@phone', '@m.Email', '@m.SkillCategory', '@m.ExperienceYears', '@m.KycStatus', '@(m.IsOnline ? "Online" : "Offline")', '@m.Rating.ToString("0.0")', '@m.TotalJobs', '@blockStatus', '@Html.Raw(JavaScriptEncoder.Default.Encode(m.ShopName))', '@Html.Raw(JavaScriptEncoder.Default.Encode(m.ShopAddress))', '@m.City')">
                                            <i class="fa-solid fa-eye me-1"></i> Details
                                        </button>
                                        <a href="/Admin/ReviewKyc/@m.UserId" class="btn btn-sm btn-outline-info font-weight-bold"><i class="fa-solid fa-file-shield me-1"></i> KYC</a>
                                        <button class="btn btn-sm @(m.User?.IsBlocked == true ? "btn-outline-success" : "btn-outline-danger") font-weight-bold" onclick="toggleUserBlock(@m.UserId)">
                                            <i class="fa-solid @(m.User?.IsBlocked == true ? "fa-unlock" : "fa-ban")"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Mechanic Details Modal -->
<div class="modal fade" id="mechDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary text-white shadow-lg">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-warning font-weight-bold"><i class="fa-solid fa-screwdriver-wrench me-2 text-warning"></i> Mechanic Partner Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="p-3 bg-secondary bg-opacity-20 rounded border border-secondary mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong class="text-warning fs-5" id="lblMechDetName"></strong>
                        <span class="badge bg-warning text-dark font-weight-bold" id="lblMechDetId"></span>
                    </div>
                    <div class="text-muted small mb-1"><i class="fa-solid fa-phone me-1"></i> <span id="lblMechDetPhone"></span></div>
                    <div class="text-muted small mb-1"><i class="fa-solid fa-envelope me-1"></i> <span id="lblMechDetEmail"></span></div>
                    <div class="text-info small font-weight-bold"><i class="fa-solid fa-map-pin me-1"></i> Operating City: <span id="lblMechDetCity"></span></div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="p-2.5 rounded bg-dark border border-secondary text-center">
                            <span class="text-muted small d-block">Rating</span>
                            <strong class="text-warning fs-5" id="lblMechDetRating">5.0 ★</strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-2.5 rounded bg-dark border border-secondary text-center">
                            <span class="text-muted small d-block">Jobs Completed</span>
                            <strong class="text-info fs-5" id="lblMechDetJobs">0</strong>
                        </div>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6 col-sm-4">
                        <span class="text-muted small d-block font-weight-bold">Category</span>
                        <span class="badge bg-secondary text-light font-weight-bold mt-1" id="lblMechDetCategory"></span>
                    </div>
                    <div class="col-6 col-sm-4">
                        <span class="text-muted small d-block font-weight-bold">Experience</span>
                        <div class="text-white mt-1" id="lblMechDetExp">0 Years</div>
                    </div>
                    <div class="col-12 col-sm-4 mt-2 mt-sm-0">
                        <span class="text-muted small d-block font-weight-bold">KYC Status</span>
                        <div class="mt-1" id="lblMechDetKyc"></div>
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <span class="text-muted small d-block font-weight-bold">Online Status</span>
                        <div class="mt-1" id="lblMechDetOnline"></div>
                    </div>
                    <div class="col-6">
                        <span class="text-muted small d-block font-weight-bold">Account Block Status</span>
                        <div class="mt-1" id="lblMechDetBlock"></div>
                    </div>
                </div>

                <div class="p-3 bg-black bg-opacity-40 rounded border border-secondary text-light small mb-0">
                    <div class="mb-2">
                        <strong class="text-warning small d-block">Garage / Shop Name:</strong>
                        <span id="lblMechDetShopName">Not Specified</span>
                    </div>
                    <div>
                        <strong class="text-warning small d-block">Shop / Garage Address:</strong>
                        <span id="lblMechDetShopAddress">Not Specified</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        // Combined robust text-matching search and location filter
        function filterMechanicsTable() {
            var searchVal = $('#mechSearchFilter').val().toLowerCase().trim();
            var locationVal = $('#locationFilter').val().toLowerCase().trim();
            var matches = 0;

            $('.mech-row').each(function() {
                var rowText = $(this).text().toLowerCase();
                var cityText = $(this).find('.row-city-text').text().toLowerCase().trim();

                var textMatch = (searchVal === "") || (rowText.indexOf(searchVal) > -1);
                var locationMatch = (locationVal === "") || (rowText.indexOf(locationVal) > -1) || (cityText.indexOf(locationVal) > -1);

                if (textMatch && locationMatch) {
                    $(this).show();
                    matches++;
                } else {
                    $(this).hide();
                }
            });

            if (matches === 0) {
                if ($('.no-data-row').length === 0) {
                    $('#mechanicsTable tbody').append('<tr class="no-data-row"><td colspan="7" class="text-center py-4 text-muted">No matching mechanics found.</td></tr>');
                } else {
                    $('.no-data-row').show().find('td').text('No matching mechanics found.');
                }
            } else {
                $('.no-data-row').hide();
            }
        }

        $('#mechSearchFilter').on('keyup', filterMechanicsTable);
        $('#locationFilter').on('keyup', filterMechanicsTable);
    });

    function showMechDetails(id, name, phone, email, category, exp, kyc, online, rating, jobsCount, blockStatus, shopName, shopAddress, city) {
        $('#lblMechDetId').text(id);
        $('#lblMechDetName').text(name);
        $('#lblMechDetPhone').text(phone);
        $('#lblMechDetEmail').text(email || 'No email registered');
        $('#lblMechDetCity').text(city);
        
        $('#lblMechDetCategory').text(category);
        $('#lblMechDetExp').text(exp + ' Years');
        
        $('#lblMechDetRating').text(rating + ' ★');
        $('#lblMechDetJobs').text(jobsCount);

        var kycHtml = kyc === 'Approved'
            ? '<span class="badge bg-success"><i class="fa-solid fa-circle-check me-1"></i> Verified</span>'
            : '<span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i> Pending KYC</span>';
        $('#lblMechDetKyc').html(kycHtml);

        var onlineHtml = online === 'Online'
            ? '<span class="badge bg-success">🟢 ONLINE</span>'
            : '<span class="badge bg-secondary text-light">OFFLINE</span>';
        $('#lblMechDetOnline').html(onlineHtml);

        var blockHtml = blockStatus === 'Active'
            ? '<span class="badge bg-success">ACTIVE</span>'
            : '<span class="badge bg-danger">BLOCKED</span>';
        $('#lblMechDetBlock').html(blockHtml);

        $('#lblMechDetShopName').text(shopName || 'Not specified');
        $('#lblMechDetShopAddress').text(shopAddress || 'Not specified');

        var modal = new bootstrap.Modal(document.getElementById('mechDetailsModal'));
        modal.show();
    }

    function toggleUserBlock(userId) {
        $.post('/Admin/ToggleUserBlock', { userId: userId }, function(res) {
            if (res && res.success) {
                alert(res.message);
                location.reload();
            }
        });
    }
</script>
}
