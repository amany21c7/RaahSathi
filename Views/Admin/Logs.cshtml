@using RaahSathi.Models
@model List<AuditLog>
@{
    ViewData["Title"] = "Audit Logs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white font-weight-bold mb-1"><i class="fa-solid fa-rectangle-list text-warning me-2"></i> System Audit Logs</h4>
        <p class="text-muted small mb-0">Immutable Security Trail: Every admin action recorded (Admin, Action Type, Time, IP Address, Browser User Agent).</p>
    </div>
</div>

<div class="card bg-dark border-secondary shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr class="border-secondary text-muted small">
                        <th class="ps-3">Timestamp (UTC)</th>
                        <th>Admin User</th>
                        <th>Action Type</th>
                        <th>Details & Action Log</th>
                        <th>IP Address</th>
                        <th class="text-end pe-3">User Agent</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No audit logs recorded yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var l in Model)
                        {
                            <tr class="border-secondary">
                                <td class="ps-3 text-muted small">@l.TimeStamp.ToString("dd MMM yyyy, HH:mm:ss")</td>
                                <td class="font-weight-bold text-white"><i class="fa-solid fa-user-shield text-warning me-1"></i> @l.AdminName</td>
                                <td><span class="badge bg-warning text-dark font-weight-bold">@l.ActionType</span></td>
                                <td class="text-light small">@l.Details</td>
                                <td><span class="badge bg-secondary text-light">@l.IpAddress</span></td>
                                <td class="text-end pe-3 text-muted small" style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@l.UserAgent</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
