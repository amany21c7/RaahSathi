@using RaahSathi.Models
@model List<AuditLog>
@{
    ViewData["Title"] = "System Audit Logs";
    
    var adminLogs = Model.Where(l => l.UserRole == "Admin" || string.IsNullOrEmpty(l.UserRole)).ToList();
    var mechanicLogs = Model.Where(l => l.UserRole == "Mechanic").ToList();
    var customerLogs = Model.Where(l => l.UserRole == "Customer").ToList();

    var fromDateVal = ViewBag.FromDate as string ?? "";
    var toDateVal = ViewBag.ToDate as string ?? "";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="text-white font-weight-bold mb-1">
            <i class="fa-solid fa-rectangle-list text-warning me-2"></i> System Audit Logs
        </h4>
        <p class="text-muted small mb-0">Immutable Security Trail: Actions performed by Admins, Mechanics, and Customers are categorized below.</p>
    </div>
    <div>
        <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary px-3 py-1.5">
            <i class="fa-solid fa-database text-warning me-1"></i> Total Logs: <strong class="text-white ms-1">@Model.Count</strong>
        </span>
    </div>
</div>

<!-- 📅 Integrated Tabs & Date Filter Bar (Placed directly above the grids) -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom border-secondary pb-2 mb-3">
    <!-- Left Side: Tabs -->
    <ul class="nav nav-tabs border-0 flex-nowrap text-nowrap mb-0" id="auditTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active text-warning font-weight-bold bg-transparent border-0 border-bottom border-warning border-3 px-2.5 px-sm-3 py-2" id="admin-tab" data-bs-toggle="tab" data-bs-target="#admin-logs" type="button" role="tab" aria-controls="admin-logs" aria-selected="true" style="border-radius: 0; font-size: 0.88rem;">
                <i class="fa-solid fa-user-shield me-1.5"></i> Admin &amp; System (<span id="adminLogsBadge">@adminLogs.Count</span>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link text-info font-weight-bold bg-transparent border-0 px-2.5 px-sm-3 py-2" id="mechanic-tab" data-bs-toggle="tab" data-bs-target="#mechanic-logs" type="button" role="tab" aria-controls="mechanic-logs" aria-selected="false" style="border-radius: 0; font-size: 0.88rem;">
                <i class="fa-solid fa-screwdriver-wrench me-1.5"></i> Mechanic Logs (<span id="mechanicLogsBadge">@mechanicLogs.Count</span>)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link text-success font-weight-bold bg-transparent border-0 px-2.5 px-sm-3 py-2" id="customer-tab" data-bs-toggle="tab" data-bs-target="#customer-logs" type="button" role="tab" aria-controls="customer-logs" aria-selected="false" style="border-radius: 0; font-size: 0.88rem;">
                <i class="fa-solid fa-user me-1.5"></i> Customer Logs (<span id="customerLogsBadge">@customerLogs.Count</span>)
            </button>
        </li>
    </ul>

    <!-- Right Side: Date Range Filter Bar (From Date & To Date Pickers) -->
    <div class="d-flex flex-wrap align-items-center gap-2">
        <!-- From Date Picker -->
        <div class="d-flex align-items-center gap-1.5 bg-dark border border-secondary rounded-3 px-2 py-1 shadow-sm">
            <span class="text-warning small font-weight-bold"><i class="fa-regular fa-calendar me-1"></i> From:</span>
            <input type="date" id="logFromDate" value="@fromDateVal" class="form-control form-control-sm bg-dark text-white border-0 py-0 px-1" style="font-size: 0.84rem; width: 130px; box-shadow: none;" title="Filter From Date" onchange="applyLogsFilter()" />
        </div>

        <!-- To Date Picker -->
        <div class="d-flex align-items-center gap-1.5 bg-dark border border-secondary rounded-3 px-2 py-1 shadow-sm">
            <span class="text-info small font-weight-bold"><i class="fa-regular fa-calendar-check me-1"></i> To:</span>
            <input type="date" id="logToDate" value="@toDateVal" class="form-control form-control-sm bg-dark text-white border-0 py-0 px-1" style="font-size: 0.84rem; width: 130px; box-shadow: none;" title="Filter To Date" onchange="applyLogsFilter()" />
        </div>

        <!-- Filter & Reset Buttons -->
        <button type="button" class="btn btn-warning btn-sm font-weight-bold px-3 py-1.5 text-dark shadow-sm d-inline-flex align-items-center gap-1.5" onclick="applyLogsFilter()" style="border-radius: 8px;">
            <i class="fa-solid fa-filter"></i> <span>Filter</span>
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm text-light px-2.5 py-1.5 shadow-sm d-inline-flex align-items-center gap-1" onclick="resetLogsFilter()" title="Clear date filter" style="border-radius: 8px;">
            <i class="fa-solid fa-rotate-left"></i> <span>Reset</span>
        </button>
    </div>
</div>

<!-- Tab Content -->
<div class="tab-content" id="auditTabsContent">
    <!-- 1. Admin Logs Pane -->
    <div class="tab-pane fade show active" id="admin-logs" role="tabpanel" aria-labelledby="admin-tab">
        <div class="card bg-dark border-secondary shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0 align-middle" id="adminLogsTable">
                        <thead>
                            <tr class="border-secondary text-muted small">
                                <th class="ps-3" style="min-width: 170px;">Timestamp (UTC)</th>
                                <th style="min-width: 140px;">User (Actor)</th>
                                <th style="min-width: 120px;">Action Type</th>
                                <th style="min-width: 320px;">Details &amp; Action Log</th>
                                <th style="min-width: 120px;">IP Address</th>
                                <th class="text-end pe-3" style="min-width: 150px;">User Agent</th>
                            </tr>
                        </thead>
                        <tbody id="adminLogsTbody">
                            @if (adminLogs.Count == 0)
                            {
                                <tr class="no-records-row">
                                    <td colspan="6" class="text-center py-4 text-muted">No admin audit logs recorded yet.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var l in adminLogs)
                                {
                                    <tr class="border-secondary log-row" 
                                        data-date="@l.TimeStamp.ToString("yyyy-MM-dd")">
                                        <td class="ps-3 text-muted small font-monospace">@l.TimeStamp.ToString("dd MMM yyyy, HH:mm:ss")</td>
                                        <td class="font-weight-bold text-white"><i class="fa-solid fa-user-shield text-warning me-1"></i> @l.AdminName</td>
                                        <td><span class="badge bg-warning text-dark font-weight-bold">@l.ActionType</span></td>
                                        <td class="text-light small" style="word-break: break-word; max-width: 450px;">@l.Details</td>
                                        <td><span class="badge bg-secondary text-light">@l.IpAddress</span></td>
                                        <td class="text-end pe-3 text-muted small" style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@l.UserAgent">@l.UserAgent</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- Pagination Controls Footer (Max 100 per page) -->
            <div class="card-footer bg-dark border-secondary p-2.5 d-flex flex-wrap justify-content-between align-items-center gap-2" id="adminPaginationCard">
                <div class="text-muted small" id="adminPageInfo">
                    Showing 0 of 0 logs (Max 100 per page)
                </div>
                <nav aria-label="Admin logs pagination">
                    <ul class="pagination pagination-sm mb-0 justify-content-end" id="adminPaginationList"></ul>
                </nav>
            </div>
        </div>
    </div>

    <!-- 2. Mechanic Logs Pane -->
    <div class="tab-pane fade" id="mechanic-logs" role="tabpanel" aria-labelledby="mechanic-tab">
        <div class="card bg-dark border-secondary shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0 align-middle" id="mechanicLogsTable">
                        <thead>
                            <tr class="border-secondary text-muted small">
                                <th class="ps-3" style="min-width: 170px;">Timestamp (UTC)</th>
                                <th style="min-width: 140px;">User (Actor)</th>
                                <th style="min-width: 120px;">Action Type</th>
                                <th style="min-width: 320px;">Details &amp; Action Log</th>
                                <th style="min-width: 120px;">IP Address</th>
                                <th class="text-end pe-3" style="min-width: 150px;">User Agent</th>
                            </tr>
                        </thead>
                        <tbody id="mechanicLogsTbody">
                            @if (mechanicLogs.Count == 0)
                            {
                                <tr class="no-records-row">
                                    <td colspan="6" class="text-center py-4 text-muted">No mechanic audit logs recorded yet.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var l in mechanicLogs)
                                {
                                    <tr class="border-secondary log-row" 
                                        data-date="@l.TimeStamp.ToString("yyyy-MM-dd")">
                                        <td class="ps-3 text-muted small font-monospace">@l.TimeStamp.ToString("dd MMM yyyy, HH:mm:ss")</td>
                                        <td class="font-weight-bold text-white"><i class="fa-solid fa-screwdriver-wrench text-info me-1"></i> @l.AdminName</td>
                                        <td><span class="badge bg-info text-dark font-weight-bold">@l.ActionType</span></td>
                                        <td class="text-light small" style="word-break: break-word; max-width: 450px;">@l.Details</td>
                                        <td><span class="badge bg-secondary text-light">@l.IpAddress</span></td>
                                        <td class="text-end pe-3 text-muted small" style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@l.UserAgent">@l.UserAgent</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- Pagination Controls Footer (Max 100 per page) -->
            <div class="card-footer bg-dark border-secondary p-2.5 d-flex flex-wrap justify-content-between align-items-center gap-2" id="mechanicPaginationCard">
                <div class="text-muted small" id="mechanicPageInfo">
                    Showing 0 of 0 logs (Max 100 per page)
                </div>
                <nav aria-label="Mechanic logs pagination">
                    <ul class="pagination pagination-sm mb-0 justify-content-end" id="mechanicPaginationList"></ul>
                </nav>
            </div>
        </div>
    </div>

    <!-- 3. Customer Logs Pane -->
    <div class="tab-pane fade" id="customer-logs" role="tabpanel" aria-labelledby="customer-tab">
        <div class="card bg-dark border-secondary shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0 align-middle" id="customerLogsTable">
                        <thead>
                            <tr class="border-secondary text-muted small">
                                <th class="ps-3" style="min-width: 170px;">Timestamp (UTC)</th>
                                <th style="min-width: 140px;">User (Actor)</th>
                                <th style="min-width: 120px;">Action Type</th>
                                <th style="min-width: 320px;">Details &amp; Action Log</th>
                                <th style="min-width: 120px;">IP Address</th>
                                <th class="text-end pe-3" style="min-width: 150px;">User Agent</th>
                            </tr>
                        </thead>
                        <tbody id="customerLogsTbody">
                            @if (customerLogs.Count == 0)
                            {
                                <tr class="no-records-row">
                                    <td colspan="6" class="text-center py-4 text-muted">No customer audit logs recorded yet.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var l in customerLogs)
                                {
                                    <tr class="border-secondary log-row" 
                                        data-date="@l.TimeStamp.ToString("yyyy-MM-dd")">
                                        <td class="ps-3 text-muted small font-monospace">@l.TimeStamp.ToString("dd MMM yyyy, HH:mm:ss")</td>
                                        <td class="font-weight-bold text-white"><i class="fa-solid fa-user text-success me-1"></i> @l.AdminName</td>
                                        <td><span class="badge bg-success text-white font-weight-bold">@l.ActionType</span></td>
                                        <td class="text-light small" style="word-break: break-word; max-width: 450px;">@l.Details</td>
                                        <td><span class="badge bg-secondary text-light">@l.IpAddress</span></td>
                                        <td class="text-end pe-3 text-muted small" style="max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@l.UserAgent">@l.UserAgent</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- Pagination Controls Footer (Max 100 per page) -->
            <div class="card-footer bg-dark border-secondary p-2.5 d-flex flex-wrap justify-content-between align-items-center gap-2" id="customerPaginationCard">
                <div class="text-muted small" id="customerPageInfo">
                    Showing 0 of 0 logs (Max 100 per page)
                </div>
                <nav aria-label="Customer logs pagination">
                    <ul class="pagination pagination-sm mb-0 justify-content-end" id="customerPaginationList"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        var PAGE_SIZE = 100; // Max 100 records per page

        var gridStates = {
            admin: {
                tbodyId: 'adminLogsTbody',
                pageInfoId: 'adminPageInfo',
                paginationListId: 'adminPaginationList',
                badgeId: 'adminLogsBadge',
                currentPage: 1,
                filteredRows: []
            },
            mechanic: {
                tbodyId: 'mechanicLogsTbody',
                pageInfoId: 'mechanicPageInfo',
                paginationListId: 'mechanicPaginationList',
                badgeId: 'mechanicLogsBadge',
                currentPage: 1,
                filteredRows: []
            },
            customer: {
                tbodyId: 'customerLogsTbody',
                pageInfoId: 'customerPageInfo',
                paginationListId: 'customerPaginationList',
                badgeId: 'customerLogsBadge',
                currentPage: 1,
                filteredRows: []
            }
        };

        function filterAndPaginateAll() {
            var fromDate = $('#logFromDate').val();
            var toDate = $('#logToDate').val();

            Object.keys(gridStates).forEach(function (key) {
                var state = gridStates[key];
                var tbody = document.getElementById(state.tbodyId);
                if (!tbody) return;

                var allRows = tbody.querySelectorAll('tr.log-row');
                state.filteredRows = [];

                allRows.forEach(function (row) {
                    var rowDate = row.getAttribute('data-date') || '';

                    var matchesFrom = !fromDate || rowDate >= fromDate;
                    var matchesTo = !toDate || rowDate <= toDate;

                    if (matchesFrom && matchesTo) {
                        state.filteredRows.push(row);
                    } else {
                        row.style.display = 'none';
                    }
                });

                // Update badge count
                var badgeEl = document.getElementById(state.badgeId);
                if (badgeEl) {
                    badgeEl.innerText = state.filteredRows.length;
                }

                // Reset to page 1
                state.currentPage = 1;
                renderGridPage(key);
            });
        }

        function renderGridPage(key) {
            var state = gridStates[key];
            var totalRecords = state.filteredRows.length;
            var totalPages = Math.ceil(totalRecords / PAGE_SIZE) || 1;

            if (state.currentPage > totalPages) state.currentPage = totalPages;
            if (state.currentPage < 1) state.currentPage = 1;

            var startIndex = (state.currentPage - 1) * PAGE_SIZE;
            var endIndex = Math.min(startIndex + PAGE_SIZE, totalRecords);

            // Display current slice
            state.filteredRows.forEach(function (row, idx) {
                if (idx >= startIndex && idx < endIndex) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });

            // Handle empty state message
            var tbody = document.getElementById(state.tbodyId);
            if (tbody) {
                var emptyRow = tbody.querySelector('.no-records-row');
                if (emptyRow) {
                    emptyRow.style.display = (totalRecords === 0) ? '' : 'none';
                }
            }

            // Update Info label
            var infoEl = document.getElementById(state.pageInfoId);
            if (infoEl) {
                if (totalRecords === 0) {
                    infoEl.innerHTML = '<span class="text-muted">No logs found in this date range</span>';
                } else {
                    infoEl.innerHTML = 'Showing <strong>' + (startIndex + 1) + '</strong> to <strong>' + endIndex + '</strong> of <strong>' + totalRecords + '</strong> logs (Page ' + state.currentPage + ' of ' + totalPages + ' &bull; Max 100/page)';
                }
            }

            // Render Pagination Buttons
            var pagList = document.getElementById(state.paginationListId);
            if (!pagList) return;
            pagList.innerHTML = '';

            if (totalPages <= 1) {
                return;
            }

            // First & Prev Buttons
            var prevDisabled = (state.currentPage === 1) ? ' disabled' : '';
            pagList.innerHTML += '<li class="page-item' + prevDisabled + '"><a class="page-link bg-dark border-secondary text-light" href="javascript:void(0)" onclick="window.goToGridPage(\'' + key + '\', 1)" title="First Page"><i class="fa-solid fa-angles-left"></i></a></li>';
            pagList.innerHTML += '<li class="page-item' + prevDisabled + '"><a class="page-link bg-dark border-secondary text-light" href="javascript:void(0)" onclick="window.goToGridPage(\'' + key + '\', ' + (state.currentPage - 1) + ')" title="Previous Page"><i class="fa-solid fa-chevron-left"></i></a></li>';

            // Page numbers window (display up to 5 surrounding pages)
            var startPage = Math.max(1, state.currentPage - 2);
            var endPage = Math.min(totalPages, startPage + 4);
            if (endPage - startPage < 4) {
                startPage = Math.max(1, endPage - 4);
            }

            for (var p = startPage; p <= endPage; p++) {
                var activeClass = (p === state.currentPage) ? ' active' : '';
                var itemStyle = (p === state.currentPage) ? ' style="background-color: #ff6b00; border-color: #ff6b00; color: #000; font-weight: bold;"' : ' class="page-link bg-dark border-secondary text-light"';
                pagList.innerHTML += '<li class="page-item' + activeClass + '"><a class="page-link"' + itemStyle + ' href="javascript:void(0)" onclick="window.goToGridPage(\'' + key + '\', ' + p + ')">' + p + '</a></li>';
            }

            // Next & Last Buttons
            var nextDisabled = (state.currentPage === totalPages) ? ' disabled' : '';
            pagList.innerHTML += '<li class="page-item' + nextDisabled + '"><a class="page-link bg-dark border-secondary text-light" href="javascript:void(0)" onclick="window.goToGridPage(\'' + key + '\', ' + (state.currentPage + 1) + ')" title="Next Page"><i class="fa-solid fa-chevron-right"></i></a></li>';
            pagList.innerHTML += '<li class="page-item' + nextDisabled + '"><a class="page-link bg-dark border-secondary text-light" href="javascript:void(0)" onclick="window.goToGridPage(\'' + key + '\', ' + totalPages + ')" title="Last Page"><i class="fa-solid fa-angles-right"></i></a></li>';
        }

        window.goToGridPage = function (key, pageNum) {
            if (!gridStates[key]) return;
            gridStates[key].currentPage = pageNum;
            renderGridPage(key);
        };

        window.applyLogsFilter = function () {
            filterAndPaginateAll();
        };

        window.resetLogsFilter = function () {
            $('#logFromDate').val('');
            $('#logToDate').val('');
            filterAndPaginateAll();
        };

        // Tab indicator update
        $('#auditTabs button').on('shown.bs.tab', function (e) {
            $('#auditTabs button').removeClass('border-bottom border-warning border-info border-success border-3');
            var targetId = $(e.target).attr('id');
            if (targetId === 'admin-tab') {
                $(e.target).addClass('border-bottom border-warning border-3');
            } else if (targetId === 'mechanic-tab') {
                $(e.target).addClass('border-bottom border-info border-3');
            } else if (targetId === 'customer-tab') {
                $(e.target).addClass('border-bottom border-success border-3');
            }
        });

        $(document).ready(function () {
            filterAndPaginateAll();
        });
    })();
</script>
}
