@model RaahSathi.Models.ReferralProgramSetting
@using RaahSathi.Models
@{
    ViewData["Title"] = "4-Stage Referral Program & Payouts";
    var withdrawals = ViewBag.Withdrawals as List<ReferralWithdrawalRequest> ?? new List<ReferralWithdrawalRequest>();
    var transactions = ViewBag.Transactions as List<ReferralTransaction> ?? new List<ReferralTransaction>();

    int totalReferrals = ViewBag.TotalReferralsCount as int? ?? 0;
    int completedReferrals = ViewBag.CompletedReferralsCount as int? ?? 0;
    int pendingReferrals = ViewBag.PendingReferralsCount as int? ?? 0;
    double totalDisbursed = ViewBag.TotalRewardsDisbursed as double? ?? 0.0;
    double pendingPayouts = ViewBag.PendingPayoutsAmount as double? ?? 0.0;
    double settledPayouts = ViewBag.SettledPayoutsAmount as double? ?? 0.0;

    var pendingWithdrawals = withdrawals.Where(w => w.Status == "Pending").ToList();
}

<style>
    .ref-stage-card {
        background: linear-gradient(145deg, rgba(30, 41, 59, 0.7), rgba(15, 23, 42, 0.9));
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }
    .ref-stage-card:hover {
        border-color: rgba(245, 158, 11, 0.4);
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
    }
    .ref-badge {
        font-size: 0.72rem;
        letter-spacing: 0.5px;
        padding: 4px 10px;
        border-radius: 20px;
        font-weight: 700;
    }
    .form-switch .form-check-input {
        width: 3em;
        height: 1.5em;
        cursor: pointer;
    }
    .form-switch .form-check-input:checked {
        background-color: #10B981;
        border-color: #10B981;
    }
</style>

<!-- Header & Quick Actions -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h4 class="text-white font-weight-bold mb-1" style="font-family: 'Outfit', sans-serif;">
            <i class="fa-solid fa-gift text-warning me-2"></i> 4-Stage Referral Program &amp; Payouts
        </h4>
        <p class="text-muted small mb-0">Configure M2M, M2C, C2C &amp; C2M reward rules, monitor live referral ledger, and disburse wallet payout requests.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a href="#withdrawalSection" class="btn btn-outline-warning btn-sm font-weight-bold">
            <i class="fa-solid fa-indian-rupee-sign me-1"></i> Review Payout Requests (@pendingWithdrawals.Count)
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show bg-success bg-opacity-20 border border-success text-white py-2 px-3 mb-4 rounded-3" role="alert">
        <i class="fa-solid fa-circle-check me-2 text-success"></i> @TempData["Success"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show bg-danger bg-opacity-20 border border-danger text-white py-2 px-3 mb-4 rounded-3" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2 text-danger"></i> @TempData["Error"]
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Telemetry Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-sm-6">
        <div class="glass-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted small text-uppercase font-weight-bold">Total Referrals</span>
                <h3 class="text-white font-weight-extrabold mb-0 mt-1" style="font-family: 'Outfit';">@totalReferrals</h3>
                <span class="text-success small"><i class="fa-solid fa-check me-1"></i> @completedReferrals Successful</span>
            </div>
            <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning">
                <i class="fa-solid fa-people-arrows fa-2x"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="glass-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted small text-uppercase font-weight-bold">Pending Jobs</span>
                <h3 class="text-warning font-weight-extrabold mb-0 mt-1" style="font-family: 'Outfit';">@pendingReferrals</h3>
                <span class="text-muted small">Awaiting 1st booking</span>
            </div>
            <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning">
                <i class="fa-solid fa-clock-rotate-left fa-2x"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="glass-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted small text-uppercase font-weight-bold">Total Disbursed</span>
                <h3 class="text-info font-weight-extrabold mb-0 mt-1" style="font-family: 'Outfit';">₹@totalDisbursed.ToString("N0")</h3>
                <span class="text-muted small">Rewards credited</span>
            </div>
            <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info">
                <i class="fa-solid fa-coins fa-2x"></i>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="glass-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted small text-uppercase font-weight-bold">Pending Payouts</span>
                <h3 class="text-danger font-weight-extrabold mb-0 mt-1" style="font-family: 'Outfit';">₹@pendingPayouts.ToString("N0")</h3>
                <span class="text-muted small">@pendingWithdrawals.Count requests waiting</span>
            </div>
            <div class="rounded-circle bg-danger bg-opacity-10 p-3 text-danger">
                <i class="fa-solid fa-hand-holding-dollar fa-2x"></i>
            </div>
        </div>
    </div>
</div>

<!-- Form to Update All 4 Stages & Conditions -->
<form action="/Admin/SaveReferralSettings" method="POST" class="mb-5">
    <div class="card bg-dark border-secondary shadow-sm mb-4">
        <div class="card-header border-secondary bg-transparent py-3 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="text-white font-weight-bold mb-0"><i class="fa-solid fa-sliders text-warning me-2"></i> 4-Stage Referral Rules Configuration</h5>
                <p class="text-muted small mb-0">Enable/disable individual stages and customize bonus amounts for both referrer and newly joined referee.</p>
            </div>
            <div class="form-check form-switch d-flex align-items-center gap-2">
                <input class="form-check-input" type="checkbox" role="switch" id="masterSwitch" name="IsMasterEnabled" value="true" @(Model.IsMasterEnabled ? "checked" : "")>
                <input type="hidden" name="IsMasterEnabled" value="false" />
                <label class="form-check-label text-white font-weight-bold small" for="masterSwitch">Master Referral Engine</label>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row g-4">
                
                <!-- Stage 1: Mechanic to Mechanic (M2M) -->
                <div class="col-lg-6">
                    <div class="ref-stage-card p-4 h-100 border-start border-4 border-warning">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded p-2 bg-warning bg-opacity-20 text-warning">
                                    <i class="fa-solid fa-wrench fs-5"></i>
                                    <i class="fa-solid fa-arrow-right mx-1 small"></i>
                                    <i class="fa-solid fa-wrench fs-5"></i>
                                </div>
                                <div>
                                    <h6 class="text-white font-weight-bold mb-0">Stage 1: Mechanic → Mechanic (M2M)</h6>
                                    <span class="text-muted small">Existing mechanic invites a new mechanic</span>
                                </div>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="M2M_Enabled" value="true" @(Model.M2M_Enabled ? "checked" : "")>
                                <input type="hidden" name="M2M_Enabled" value="false" />
                            </div>
                        </div>
                        <p class="text-muted small mb-3">Reward unlocks when newly onboarded mechanic gets KYC verified and completes their first job.</p>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label text-muted small font-weight-bold">Referrer Bonus (₹)</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-dark border-secondary text-warning">₹</span>
                                    <input type="number" step="1" min="0" name="M2M_ReferrerReward" class="form-control glass-input text-white font-weight-bold" value="@Model.M2M_ReferrerReward" required>
                                </div>
                            </div>
                            <div class="col-6">
                                <label class="form-label text-muted small font-weight-bold">New Mechanic Bonus (₹)</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-dark border-secondary text-info">₹</span>
                                    <input type="number" step="1" min="0" name="M2M_RefereeReward" class="form-control glass-input text-white font-weight-bold" value="@Model.M2M_RefereeReward" required>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Stage 2: Mechanic to Customer (M2C) -->
                <div class="col-lg-6">
                    <div class="ref-stage-card p-4 h-100 border-start border-4 border-info">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded p-2 bg-info bg-opacity-20 text-info">
                                    <i class="fa-solid fa-wrench fs-5"></i>
                                    <i class="fa-solid fa-arrow-right mx-1 small"></i>
                                    <i class="fa-solid fa-user fs-5"></i>
                                </div>
                                <div>
                                    <h6 class="text-white font-weight-bold mb-0">Stage 2: Mechanic → Customer (M2C)</h6>
                                    <span class="text-muted small">Mechanic shares app with vehicle owners</span>
                                </div>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="M2C_Enabled" value="true" @(Model.M2C_Enabled ? "checked" : "")>
                                <input type="hidden" name="M2C_Enabled" value="false" />
                            </div>
                        </div>
                        <p class="text-muted small mb-3">Reward unlocks when customer books &amp; successfully completes their first roadside assistance job.</p>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label text-muted small font-weight-bold">Mechanic Commission (₹)</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-dark border-secondary text-warning">₹</span>
                                    <input type="number" step="1" min="0" name="M2C_ReferrerReward" class="form-control glass-input text-white font-weight-bold" value="@Model.M2C_ReferrerReward" required>
                                </div>
                            </div>
                            <div class="col-6">
                                <label class="form-label text-muted small font-weight-bold">Customer Discount/Wallet (₹)</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-dark border-secondary text-info">₹</span>
                                    <input type="number" step="1" min="0" name="M2C_RefereeReward" class="form-control glass-input text-white font-weight-bold" value="@Model.M2C_RefereeReward" required>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Stage 3: Customer to Customer (C2C) -->
                <div class="col-lg-6">
                    <div class="ref-stage-card p-4 h-100 border-start border-4 border-success">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded p-2 bg-success bg-opacity-20 text-success">
                                    <i class="fa-solid fa-user fs-5"></i>
                                    <i class="fa-solid fa-arrow-right mx-1 small"></i>
                                    <i class="fa-solid fa-user fs-5"></i>
                                </div>
                                <div>
                                    <h6 class="text-white font-weight-bold mb-0">Stage 3: Customer → Customer (C2C)</h6>
                                    <span class="text-muted small">Existing user refers friends &amp; family</span>
                                </div>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="C2C_Enabled" value="true" @(Model.C2C_Enabled ? "checked" : "")>
                                <input type="hidden" name="C2C_Enabled" value="false" />
                            </div>
                        </div>
                        <p class="text-muted small mb-3">Reward credited to referrer wallet when referred friend completes their 1st service.</p>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label text-muted small font-weight-bold">Referrer Reward (₹)</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-dark border-secondary text-warning">₹</span>
                                    <input type="number" step="1" min="0" name="C2C_ReferrerReward" class="form-control glass-input text-white font-weight-bold" value="@Model.C2C_ReferrerReward" required>
                                </div>
                            </div>
                            <div class="col-6">
                                <label class="form-label text-muted small font-weight-bold">Friend Joining Reward (₹)</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-dark border-secondary text-info">₹</span>
                                    <input type="number" step="1" min="0" name="C2C_RefereeReward" class="form-control glass-input text-white font-weight-bold" value="@Model.C2C_RefereeReward" required>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Stage 4: Customer to Mechanic (C2M) -->
                <div class="col-lg-6">
                    <div class="ref-stage-card p-4 h-100 border-start border-4 border-danger">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded p-2 bg-danger bg-opacity-20 text-danger">
                                    <i class="fa-solid fa-user fs-5"></i>
                                    <i class="fa-solid fa-arrow-right mx-1 small"></i>
                                    <i class="fa-solid fa-wrench fs-5"></i>
                                </div>
                                <div>
                                    <h6 class="text-white font-weight-bold mb-0">Stage 4: Customer → Mechanic (C2M)</h6>
                                    <span class="text-muted small">Customer onboards a local mechanic</span>
                                </div>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="C2M_Enabled" value="true" @(Model.C2M_Enabled ? "checked" : "")>
                                <input type="hidden" name="C2M_Enabled" value="false" />
                            </div>
                        </div>
                        <p class="text-muted small mb-3">Customer gets referral bounty when onboarded mechanic passes verification &amp; performs 1st repair.</p>
                        <div class="row g-3">
                            <div class="col-6">
                                <label class="form-label text-muted small font-weight-bold">Customer Bounty (₹)</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-dark border-secondary text-warning">₹</span>
                                    <input type="number" step="1" min="0" name="C2M_ReferrerReward" class="form-control glass-input text-white font-weight-bold" value="@Model.C2M_ReferrerReward" required>
                                </div>
                            </div>
                            <div class="col-6">
                                <label class="form-label text-muted small font-weight-bold">Mechanic Welcome Bonus (₹)</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-dark border-secondary text-info">₹</span>
                                    <input type="number" step="1" min="0" name="C2M_RefereeReward" class="form-control glass-input text-white font-weight-bold" value="@Model.C2M_RefereeReward" required>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Global Thresholds & Minimums -->
                <div class="col-12">
                    <div class="p-3 rounded-3 bg-dark bg-opacity-80 border border-secondary">
                        <div class="row g-3 align-items-center">
                            <div class="col-md-6">
                                <label class="form-label text-muted small font-weight-bold mb-1">
                                    <i class="fa-solid fa-shield-halved text-warning me-1"></i> Min Job Bill Amount to Trigger Reward (₹)
                                </label>
                                <input type="number" step="1" min="0" name="MinJobAmountForReward" class="form-control glass-input text-white font-weight-bold" value="@Model.MinJobAmountForReward" required>
                                <span class="text-muted" style="font-size: 0.72rem;">Prevents fraud/zero-value bookings from redeeming referral cash.</span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small font-weight-bold mb-1">
                                    <i class="fa-solid fa-wallet text-success me-1"></i> Minimum Referral Withdrawal Limit (₹)
                                </label>
                                <input type="number" step="1" min="1" name="MinWithdrawalAmount" class="form-control glass-input text-white font-weight-bold" value="@Model.MinWithdrawalAmount" required>
                                <span class="text-muted" style="font-size: 0.72rem;">Minimum balance required before a user can submit a withdrawal request.</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <div class="card-footer border-secondary bg-transparent py-3 text-end">
            <button type="submit" class="btn btn-warning font-weight-bold text-dark px-4 shadow">
                <i class="fa-solid fa-floppy-disk me-1"></i> Save Referral Configuration
            </button>
        </div>
    </div>
</form>

<!-- Section: Referral Withdrawal Requests Review & Payouts -->
<div class="card bg-dark border-secondary shadow-sm mb-5" id="withdrawalSection">
    <div class="card-header border-secondary bg-transparent py-3 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="text-white font-weight-bold mb-0">
                <i class="fa-solid fa-money-bill-transfer text-success me-2"></i> Referral Wallet Withdrawal Requests
            </h5>
            <span class="text-muted small">Review customer and mechanic wallet payout requests and mark as Paid / Rejected.</span>
        </div>
        <span class="badge bg-danger">@pendingWithdrawals.Count Pending Approvals</span>
    </div>
    <div class="card-body p-0">
        @if (withdrawals.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="fa-solid fa-wallet fa-3x mb-3 text-secondary opacity-50"></i>
                <p class="mb-0">No referral withdrawal requests found.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle">
                    <thead class="text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4">Request ID</th>
                            <th>User Details</th>
                            <th>Role</th>
                            <th>Amount</th>
                            <th>Payout Destination</th>
                            <th>Status</th>
                            <th>Requested At</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var w in withdrawals)
                        {
                            <tr>
                                <td class="ps-4 font-monospace text-warning font-weight-bold">#REF-W@w.Id.ToString("D4")</td>
                                <td>
                                    <div class="font-weight-bold text-white">@(w.User?.Name ?? "User")</div>
                                    <div class="text-muted small">@(w.User?.PhoneNumber ?? "")</div>
                                </td>
                                <td>
                                    <span class="badge @(w.UserRole == "Mechanic" ? "bg-warning text-dark" : "bg-info text-dark")">@w.UserRole</span>
                                </td>
                                <td class="text-white font-weight-bold fs-6">₹@w.Amount.ToString("N2")</td>
                                <td>
                                    @if (w.PayoutMethod == "UPI" || !string.IsNullOrEmpty(w.UpiId))
                                    {
                                        <div class="text-white small font-monospace"><i class="fa-brands fa-google-pay text-info me-1"></i> UPI: @w.UpiId</div>
                                    }
                                    else
                                    {
                                        <div class="text-white small"><i class="fa-solid fa-building-columns text-warning me-1"></i> @w.BankName - @w.BankAccountNumber</div>
                                        <div class="text-muted" style="font-size: 0.72rem;">IFSC: @w.IfscCode | A/C Holder: @w.AccountHolderName</div>
                                    }
                                </td>
                                <td>
                                    @if (w.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i> Pending Review</span>
                                    }
                                    else if (w.Status == "Approved")
                                    {
                                        <span class="badge bg-success"><i class="fa-solid fa-check-circle me-1"></i> Paid / Settled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="fa-solid fa-circle-xmark me-1"></i> Rejected</span>
                                    }
                                </td>
                                <td class="text-muted small">@w.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                                <td class="text-end pe-4">
                                    @if (w.Status == "Pending")
                                    {
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-success font-weight-bold" onclick="openApproveModal(@w.Id, '@(w.User?.Name)', @w.Amount, '@w.PayoutMethod', '@(string.IsNullOrEmpty(w.UpiId) ? w.BankAccountNumber : w.UpiId)')">
                                                <i class="fa-solid fa-check me-1"></i> Pay / Approve
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" onclick="openRejectModal(@w.Id, @w.Amount)">
                                                <i class="fa-solid fa-xmark"></i>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">@w.TransactionReference</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Section: Live Referral Ledger & Transactions -->
<div class="card bg-dark border-secondary shadow-sm">
    <div class="card-header border-secondary bg-transparent py-3 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="text-white font-weight-bold mb-0">
                <i class="fa-solid fa-list-check text-info me-2"></i> Live Referral Tracking Ledger
            </h5>
            <span class="text-muted small">Real-time breakdown of all invited users, current conversion status, and trigger milestones.</span>
        </div>
        <span class="badge bg-secondary">@transactions.Count Records</span>
    </div>
    <div class="card-body p-0">
        @if (transactions.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="fa-solid fa-users fa-3x mb-3 text-secondary opacity-50"></i>
                <p class="mb-0">No referral transactions logged yet.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle">
                    <thead class="text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4">Stage</th>
                            <th>Referrer User</th>
                            <th>Referred Friend</th>
                            <th>Code Used</th>
                            <th>Referrer Reward</th>
                            <th>Referee Reward</th>
                            <th>Status</th>
                            <th>Date Logged</th>
                            <th class="pe-4">Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in transactions)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="ref-badge @(t.StageType == "M2M" ? "bg-warning text-dark" : t.StageType == "M2C" ? "bg-info text-dark" : t.StageType == "C2C" ? "bg-success text-white" : "bg-danger text-white")">
                                        @t.StageType
                                    </span>
                                </td>
                                <td>
                                    <div class="text-white font-weight-bold">@(t.ReferrerUser?.Name ?? "Referrer")</div>
                                    <div class="text-muted small">@(t.ReferrerUser?.PhoneNumber ?? "") (@t.ReferrerUser?.Role)</div>
                                </td>
                                <td>
                                    <div class="text-white font-weight-bold">@(t.RefereeUser?.Name ?? "Friend")</div>
                                    <div class="text-muted small">@(t.RefereeUser?.PhoneNumber ?? "") (@t.RefereeUser?.Role)</div>
                                </td>
                                <td>
                                    <span class="badge bg-dark border border-secondary font-monospace text-warning">@t.ReferralCodeUsed</span>
                                </td>
                                <td class="text-warning font-weight-bold">+₹@t.ReferrerRewardAmount.ToString("N0")</td>
                                <td class="text-info font-weight-bold">+₹@t.RefereeRewardAmount.ToString("N0")</td>
                                <td>
                                    @if (t.Status == "Completed")
                                    {
                                        <span class="badge bg-success"><i class="fa-solid fa-circle-check me-1"></i> Completed &amp; Credited</span>
                                    }
                                    else if (t.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i> 1st Service Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@t.Status</span>
                                    }
                                </td>
                                <td class="text-muted small">@t.CreatedAt.ToLocalTime().ToString("dd MMM, hh:mm tt")</td>
                                <td class="pe-4 text-muted small" style="max-width: 240px;">
                                    <span title="@t.Remarks">@t.Remarks</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal: Approve Referral Payout -->
<div class="modal fade" id="approvePayoutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border border-success border-opacity-40 text-white shadow-lg">
            <form action="/Admin/ApproveReferralWithdrawal" method="POST">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title font-weight-bold"><i class="fa-solid fa-check-circle text-success me-2"></i> Approve &amp; Disburse Payout</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" name="requestId" id="approveReqId" />
                    <div class="p-3 bg-black bg-opacity-40 rounded-3 border border-secondary mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Recipient:</span>
                            <span class="text-white font-weight-bold" id="approveUserName">-</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Payout Amount:</span>
                            <span class="text-success font-weight-bold fs-5" id="approveAmount">-</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted small">Destination:</span>
                            <span class="text-warning small font-monospace" id="approveDest">-</span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small font-weight-bold">Bank UTR / UPI Reference ID</label>
                        <input type="text" name="transactionRef" class="form-control glass-input text-white font-monospace" placeholder="e.g. UTR8829012903" required>
                    </div>
                    <div class="mb-2">
                        <label class="form-label text-muted small font-weight-bold">Admin Remarks (Optional)</label>
                        <input type="text" name="remarks" class="form-control glass-input text-white" value="Referral reward withdrawal transferred successfully">
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success btn-sm font-weight-bold px-4">
                        <i class="fa-solid fa-check me-1"></i> Confirm &amp; Mark as Paid
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Reject Referral Payout -->
<div class="modal fade" id="rejectPayoutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border border-danger border-opacity-40 text-white shadow-lg">
            <form action="/Admin/RejectReferralWithdrawal" method="POST">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title font-weight-bold text-danger"><i class="fa-solid fa-circle-xmark text-danger me-2"></i> Reject Withdrawal Request</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" name="requestId" id="rejectReqId" />
                    <p class="text-muted small mb-3">Rejecting will immediately refund <span class="text-warning font-weight-bold" id="rejectAmount">₹0</span> back to the user's referral balance.</p>
                    <div class="mb-2">
                        <label class="form-label text-muted small font-weight-bold">Reason for Rejection</label>
                        <input type="text" name="remarks" class="form-control glass-input text-white" placeholder="e.g. Incorrect bank account number / Invalid UPI ID" required>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm font-weight-bold px-4">
                        <i class="fa-solid fa-ban me-1"></i> Reject &amp; Refund
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openApproveModal(id, name, amount, method, dest) {
        document.getElementById('approveReqId').value = id;
        document.getElementById('approveUserName').textContent = name;
        document.getElementById('approveAmount').textContent = '₹' + amount.toLocaleString('en-IN', { minimumFractionDigits: 2 });
        document.getElementById('approveDest').textContent = method + ': ' + dest;
        new bootstrap.Modal(document.getElementById('approvePayoutModal')).show();
    }

    function openRejectModal(id, amount) {
        document.getElementById('rejectReqId').value = id;
        document.getElementById('rejectAmount').textContent = '₹' + amount.toLocaleString('en-IN', { minimumFractionDigits: 2 });
        new bootstrap.Modal(document.getElementById('rejectPayoutModal')).show();
    }
</script>
