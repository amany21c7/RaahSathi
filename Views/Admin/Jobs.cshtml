@using RaahSathi.Models
@model List<Job>
@{
    ViewData["Title"] = "All Jobs Master Ledger";
}

@functions {
    string GetCityFromAddress(string address) {
        if (string.IsNullOrEmpty(address)) return "Noida";
        if (address.Contains("Noida", StringComparison.OrdinalIgnoreCase)) return "Noida";
        if (address.Contains("Delhi", StringComparison.OrdinalIgnoreCase)) return "Delhi";
        if (address.Contains("Gurgaon", StringComparison.OrdinalIgnoreCase)) return "Gurgaon";
        if (address.Contains("Ghaziabad", StringComparison.OrdinalIgnoreCase)) return "Ghaziabad";
        return "Noida"; // Default fallback
    }
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <span class="badge bg-warning text-dark font-weight-bold px-3 py-1 mb-2">SYSTEM CONSOLE</span>
        <h4 class="text-white font-weight-bold mb-1"><i class="fa-solid fa-briefcase text-warning me-2"></i> All Jobs Master Ledger</h4>
        <p class="text-muted small mb-0">Master breakdown assistance job registry: Job ID, Customer, Mechanic, Vehicle, Price, Duration, Status, and Ratings.</p>
    </div>
</div>

<!-- Search & Date Range Filters Bar -->
<div class="card bg-dark border-secondary shadow-sm mb-3">
    <div class="card-body p-2.5">
        <div class="mob-filter-bar">
            <div class="mob-filter-item">
                <label class="form-label text-muted small font-weight-bold mb-1" style="font-size:0.75rem;">Search</label>
                <div class="input-group input-group-sm shadow-sm">
                    <span class="input-group-text bg-dark border-secondary text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" id="jobSearchFilter" class="form-control bg-dark text-white border-secondary small" placeholder="ID or Customer...">
                </div>
            </div>
            <div class="mob-filter-item">
                <label class="form-label text-muted small font-weight-bold mb-1" style="font-size:0.75rem;">Location</label>
                <div class="input-group input-group-sm shadow-sm">
                    <span class="input-group-text bg-dark border-secondary text-muted"><i class="fa-solid fa-location-dot text-danger"></i></span>
                    <input type="text" id="locationFilter" class="form-control bg-dark text-white border-secondary small" placeholder="City or Address...">
                </div>
            </div>
            <div class="mob-filter-item-half">
                <label class="form-label text-muted small font-weight-bold mb-1" style="font-size:0.75rem;">From Date</label>
                <div class="input-group input-group-sm shadow-sm">
                    <span class="input-group-text bg-dark border-secondary text-muted"><i class="fa-solid fa-calendar-alt"></i></span>
                    <input type="date" id="fromDateFilter" class="form-control bg-dark text-white border-secondary small">
                </div>
            </div>
            <div class="mob-filter-item-half">
                <label class="form-label text-muted small font-weight-bold mb-1" style="font-size:0.75rem;">To Date</label>
                <div class="input-group input-group-sm shadow-sm">
                    <span class="input-group-text bg-dark border-secondary text-muted"><i class="fa-solid fa-calendar-alt"></i></span>
                    <input type="date" id="toDateFilter" class="form-control bg-dark text-white border-secondary small">
                </div>
            </div>
            <div class="mob-filter-item" style="flex: 0 0 auto; min-width: 80px;">
                <label class="form-label d-none d-sm-block mb-1" style="font-size:0.75rem;">&nbsp;</label>
                <button type="button" class="btn btn-outline-secondary btn-sm w-100 border-secondary text-muted font-weight-bold py-1.5 shadow-sm" onclick="clearAllFilters()">
                    <i class="fa-solid fa-arrow-rotate-left me-1"></i> Reset
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card bg-dark border-secondary shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle" id="jobsTable">
                <thead>
                    <tr class="border-secondary text-muted small">
                        <th class="ps-3">Job ID & Date</th>
                        <th>Customer</th>
                        <th>Mechanic</th>
                        <th>Vehicle & Problem</th>
                        <th>Location (City)</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Rating</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr class="no-data-row">
                            <td colspan="8" class="text-center py-4 text-muted">No jobs recorded in master ledger.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var j in Model)
                        {
                            var city = GetCityFromAddress(j.Address);
                            var dateVal = j.CreatedAt.ToString("yyyy-MM-dd");
                            
                            <tr class="border-secondary job-row" data-date="@dateVal">
                                <td class="ps-3">
                                    <span class="badge bg-warning text-dark font-weight-bold">#RS-@j.Id</span>
                                    <div class="text-muted extra-small mt-1" style="font-size: 0.74rem;">@j.CreatedAt.ToString("dd-MMM-yyyy")</div>
                                </td>
                                <td class="text-light font-weight-bold">@(j.Customer?.Name ?? "Customer")</td>
                                <td class="text-light">@(j.Mechanic?.Name ?? "Unassigned")</td>
                                <td>
                                    <div class="text-white font-weight-bold">@j.ProblemType</div>
                                    <div class="text-muted small">@(j.Vehicle?.Model ?? "Car") (@(j.Vehicle?.RegistrationNumber ?? ""))</div>
                                </td>
                                <td>
                                    <div class="text-white small text-truncate" style="max-width: 180px;" title="@j.Address">@j.Address</div>
                                    <span class="badge bg-info text-dark extra-small font-weight-bold row-city-text" style="font-size:0.68rem;">@city</span>
                                </td>
                                <td class="text-success font-weight-bold">₹@j.FinalBillAmount.ToString("N2")</td>
                                <td>
                                    @if (j.Status == "Completed")
                                    {
                                        <span class="badge bg-success text-white">Completed</span>
                                    }
                                    else if (j.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger text-white">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@j.Status</span>
                                    }
                                </td>
                                <td class="text-end pe-3 text-warning font-weight-bold">
                                    @(j.RatingFromCustomer.HasValue ? $"{j.RatingFromCustomer:0.0} ★" : "-")
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function() {
        // Live master ledger search, location, and date range filters
        function filterJobsTable() {
            var searchVal = $('#jobSearchFilter').val().toLowerCase().trim();
            var locationVal = $('#locationFilter').val().toLowerCase().trim();
            var fromDateVal = $('#fromDateFilter').val();
            var toDateVal = $('#toDateFilter').val();
            var matches = 0;

            $('.job-row').each(function() {
                var rowText = $(this).text().toLowerCase();
                var cityText = $(this).find('.row-city-text').text().toLowerCase().trim();
                var rowDateStr = $(this).data('date') || ''; // "yyyy-MM-dd"

                var textMatch = (searchVal === "") || (rowText.indexOf(searchVal) > -1);
                var locationMatch = (locationVal === "") || (rowText.indexOf(locationVal) > -1) || (cityText.indexOf(locationVal) > -1);
                
                var dateMatch = true;
                if (rowDateStr) {
                    if (fromDateVal && rowDateStr < fromDateVal) {
                        dateMatch = false;
                    }
                    if (toDateVal && rowDateStr > toDateVal) {
                        dateMatch = false;
                    }
                }

                if (textMatch && locationMatch && dateMatch) {
                    $(this).show();
                    matches++;
                } else {
                    $(this).hide();
                }
            });

            if (matches === 0) {
                if ($('.no-data-row').length === 0) {
                    $('#jobsTable tbody').append('<tr class="no-data-row"><td colspan="8" class="text-center py-4 text-muted">No matching jobs found.</td></tr>');
                } else {
                    $('.no-data-row').show().find('td').text('No matching jobs found.');
                }
            } else {
                $('.no-data-row').hide();
            }
        }

        $('#jobSearchFilter').on('keyup', filterJobsTable);
        $('#locationFilter').on('keyup', filterJobsTable);
        $('#fromDateFilter').on('change', filterJobsTable);
        $('#toDateFilter').on('change', filterJobsTable);

        // Export helper access
        window.clearAllFilters = function() {
            $('#jobSearchFilter').val('');
            $('#locationFilter').val('');
            $('#fromDateFilter').val('');
            $('#toDateFilter').val('');
            filterJobsTable();
        };
    });
</script>
}
