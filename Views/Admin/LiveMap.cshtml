@using RaahSathi.Models
@{
    ViewData["Title"] = "National Live Map Telemetry";
    var mechanics = ViewBag.Mechanics as List<MechanicProfile> ?? new List<MechanicProfile>();
    var activeJobs = ViewBag.ActiveJobs as List<Job> ?? new List<Job>();

    var serializedMechanics = mechanics.Select(m => new {
        id = m.UserId,
        name = m.User?.Name ?? "Verified Mechanic",
        phone = m.User?.PhoneNumber ?? "N/A",
        lat = m.Latitude,
        lng = m.Longitude,
        rating = m.Rating,
        experience = m.ExperienceYears,
        specialization = m.Specialization ?? "General"
    }).ToList();

    var serializedJobs = activeJobs.Select(j => new {
        id = j.Id,
        customerName = j.Customer?.Name ?? "Customer",
        customerPhone = j.Customer?.PhoneNumber ?? "N/A",
        lat = j.CustomerLat,
        lng = j.CustomerLng,
        vehicle = j.Vehicle?.Model ?? "Vehicle",
        problem = j.ProblemType,
        status = j.Status,
        address = j.Address
    }).ToList();
}

<!-- Leaflet Imports locally to ensure self-contained operation -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
    #admin-map {
        background: #0f172a;
        height: 580px;
        min-height: 580px;
    }
    @@media (max-width: 768px) {
        #admin-map {
            height: 360px !important;
            min-height: 320px !important;
        }
        .card.overflow-hidden {
            min-height: 360px !important;
        }
    }
    .filter-btn {
        transition: all 0.2s ease-in-out;
        opacity: 0.7;
    }
    .filter-btn.active {
        opacity: 1;
        box-shadow: 0 0 12px rgba(255, 255, 255, 0.2);
        border: 2.5px solid #ffffff !important;
    }
    .leaflet-popup-content-wrapper {
        background: #1e293b !important;
        color: #f8fafc !important;
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 8px;
    }
    .leaflet-popup-tip {
        background: #1e293b !important;
    }
</style>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h4 class="text-white font-weight-bold mb-1"><i class="fa-solid fa-map-location-dot text-warning me-2"></i> All-India Live Map Telemetry</h4>
        <p class="text-muted small mb-0">Real-time GPS dispatch tracking: Click buttons to list active entries, then locate them on map.</p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        <button id="btnFilterMechanics" class="btn btn-success btn-sm px-3 py-2 font-weight-bold filter-btn" onclick="toggleFilter('mechanics')">
            <i class="fa-solid fa-circle text-white me-1" style="font-size:0.6rem;"></i> Mechanics (@mechanics.Count)
        </button>
        <button id="btnFilterJobs" class="btn btn-warning btn-sm px-3 py-2 font-weight-bold filter-btn text-dark" onclick="toggleFilter('jobs')">
            <i class="fa-solid fa-circle text-dark me-1" style="font-size:0.6rem;"></i> Live Jobs (@activeJobs.Count)
        </button>
        <button id="btnFilterCustomers" class="btn btn-primary btn-sm px-3 py-2 font-weight-bold filter-btn" onclick="toggleFilter('customers')">
            <i class="fa-solid fa-circle text-white me-1" style="font-size:0.6rem;"></i> Active Customers (@activeJobs.Count)
        </button>
        <button id="btnFilterTows" class="btn btn-danger btn-sm px-3 py-2 font-weight-bold filter-btn" onclick="toggleFilter('tows')">
            <i class="fa-solid fa-truck me-1"></i> Tow Trucks (0)
        </button>
    </div>
</div>

<div class="row">
    <!-- Map Column -->
    <div class="col-lg-8 mb-4 mb-lg-0">
        <div class="card bg-dark border-secondary shadow-lg overflow-hidden" style="min-height: 580px; height: 100%;">
            <div id="admin-map" style="width: 100%; height: 580px; z-index: 10;"></div>
        </div>
    </div>
    
    <!-- Details Sidebar Column -->
    <div class="col-lg-4">
        <div class="card bg-dark border-secondary shadow-lg h-100" style="min-height: 580px; display: flex; flex-direction: column;">
            <div class="card-header border-secondary bg-black bg-opacity-40 py-3">
                <h5 class="text-warning font-weight-bold mb-0" id="sidebarTitle">
                    <i class="fa-solid fa-circle-info me-2"></i> Telemetry Details Console
                </h5>
            </div>
            <div class="card-body p-3 overflow-auto flex-grow-1" style="max-height: 500px;" id="sidebarContent">
                <div class="text-center py-5 text-muted">
                    <i class="fa-solid fa-tower-broadcast fa-3x mb-3 text-secondary d-block"></i>
                    <p class="mb-0 small">Select a telemetry category from the buttons above to inspect details and track individual locations.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var mechanicsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(serializedMechanics));
    var jobsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(serializedJobs));
    var map;
    var activeMarker = null;

    // Marker Icons
    var greenIcon = L.icon({
        iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-green.png',
        shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
        iconSize: [25, 41],
        iconAnchor: [12, 41],
        popupAnchor: [1, -34],
        shadowSize: [41, 41]
    });

    var orangeIcon = L.icon({
        iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-orange.png',
        shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
        iconSize: [25, 41],
        iconAnchor: [12, 41],
        popupAnchor: [1, -34],
        shadowSize: [41, 41]
    });

    var blueIcon = L.icon({
        iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-blue.png',
        shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
        iconSize: [25, 41],
        iconAnchor: [12, 41],
        popupAnchor: [1, -34],
        shadowSize: [41, 41]
    });

    document.addEventListener("DOMContentLoaded", function() {
        var defaultLat = 28.6250;
        var defaultLng = 77.3100;

        // Initialize Map
        map = L.map('admin-map').setView([defaultLat, defaultLng], 12);
        
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19
        }).addTo(map);

        window.clearMap = function() {
            if (activeMarker) {
                map.removeLayer(activeMarker);
                activeMarker = null;
            }
        };

        // Category Selection
        window.toggleFilter = function(category) {
            $('.filter-btn').removeClass('active');
            
            var btnId = '';
            var title = '';
            var html = '';
            
            if (category === 'mechanics') {
                btnId = '#btnFilterMechanics';
                $(btnId).addClass('active');
                title = '<i class="fa-solid fa-wrench text-success me-2"></i> Online Mechanics List';
                
                if (mechanicsData.length === 0) {
                    html = '<div class="text-muted text-center py-4 small">No mechanics online right now.</div>';
                } else {
                    html = '<div class="d-flex flex-column gap-2">';
                    mechanicsData.forEach(function(m) {
                        html += `
                            <div class="p-3 bg-black bg-opacity-40 border border-secondary rounded d-flex flex-column gap-2">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <span class="text-white font-weight-bold d-block">${m.name}</span>
                                        <span class="text-muted small">${m.phone}</span>
                                    </div>
                                    <span class="badge bg-success font-weight-bold">🟢 Online</span>
                                </div>
                                <div class="text-muted small">
                                    <div><b>Rating:</b> ⭐ ${m.rating.toFixed(1)} | <b>Exp:</b> ${m.experience} Yrs</div>
                                    <div><b>Expertise:</b> ${m.specialization}</div>
                                </div>
                                <button class="btn btn-warning btn-sm font-weight-bold text-dark w-100 mt-1" onclick="locateMechanic(${m.id})">
                                    <i class="fa-solid fa-location-dot me-1"></i> Locate on Map
                                </button>
                            </div>
                        `;
                    });
                    html += '</div>';
                }
            } else if (category === 'jobs') {
                btnId = '#btnFilterJobs';
                $(btnId).addClass('active');
                title = '<i class="fa-solid fa-screwdriver-wrench text-warning me-2"></i> Live Repair Jobs';
                
                if (jobsData.length === 0) {
                    html = '<div class="text-muted text-center py-4 small">No active repair jobs in progress.</div>';
                } else {
                    html = '<div class="d-flex flex-column gap-2">';
                    jobsData.forEach(function(j) {
                        html += `
                            <div class="p-3 bg-black bg-opacity-40 border border-secondary rounded d-flex flex-column gap-2">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <span class="text-white font-weight-bold d-block">Job #${j.id}</span>
                                        <span class="text-muted small">${j.vehicle}</span>
                                    </div>
                                    <span class="badge bg-warning text-dark font-weight-bold">${j.status}</span>
                                </div>
                                <div class="text-muted small">
                                    <div><b>Issue:</b> ${j.problem}</div>
                                    <div><b>Customer:</b> ${j.customerName}</div>
                                </div>
                                <button class="btn btn-warning btn-sm font-weight-bold text-dark w-100 mt-1" onclick="locateJob(${j.id})">
                                    <i class="fa-solid fa-location-dot me-1"></i> Track Repair Map
                                </button>
                            </div>
                        `;
                    });
                    html += '</div>';
                }
            } else if (category === 'customers') {
                btnId = '#btnFilterCustomers';
                $(btnId).addClass('active');
                title = '<i class="fa-solid fa-user text-primary me-2"></i> Active Customers';
                
                if (jobsData.length === 0) {
                    html = '<div class="text-muted text-center py-4 small">No active customers requesting help.</div>';
                } else {
                    html = '<div class="d-flex flex-column gap-2">';
                    jobsData.forEach(function(j) {
                        html += `
                            <div class="p-3 bg-black bg-opacity-40 border border-secondary rounded d-flex flex-column gap-2">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <span class="text-white font-weight-bold d-block">${j.customerName}</span>
                                        <span class="text-muted small">${j.customerPhone}</span>
                                    </div>
                                    <span class="badge bg-primary font-weight-bold">Active</span>
                                </div>
                                <div class="text-muted small">
                                    <div><b>Vehicle:</b> ${j.vehicle}</div>
                                    <div><b>Requested:</b> ${j.problem}</div>
                                </div>
                                <button class="btn btn-warning btn-sm font-weight-bold text-dark w-100 mt-1" onclick="locateCustomer(${j.id})">
                                    <i class="fa-solid fa-location-dot me-1"></i> Locate Customer
                                </button>
                            </div>
                        `;
                    });
                    html += '</div>';
                }
            } else if (category === 'tows') {
                btnId = '#btnFilterTows';
                $(btnId).addClass('active');
                title = '<i class="fa-solid fa-truck text-danger me-2"></i> Tow Trucks';
                html = '<div class="text-muted text-center py-4 small">No tow patrol agents active right now.</div>';
            }
            
            $('#sidebarTitle').html(title);
            $('#sidebarContent').html(html);
        };

        window.locateMechanic = function(id) {
            clearMap();
            var found = mechanicsData.find(m => m.id === id);
            if (found && found.lat && found.lng) {
                activeMarker = L.marker([found.lat, found.lng], { icon: greenIcon })
                    .bindPopup(`
                        <div style="font-family: 'Outfit'; min-width: 180px;">
                            <h6 class="text-success font-weight-bold mb-1"><i class="fa-solid fa-circle-check"></i> ${found.name}</h6>
                            <div class="small text-light mb-1"><b>Rating:</b> ⭐ ${found.rating.toFixed(1)} | <b>Exp:</b> ${found.experience} Yrs</div>
                            <div class="small text-light mb-1"><b>Phone:</b> ${found.phone}</div>
                            <div class="small text-light"><b>Specialization:</b> ${found.specialization}</div>
                        </div>
                    `)
                    .addTo(map);
                
                map.setView([found.lat, found.lng], 16);
                activeMarker.openPopup();
            } else {
                alert("This mechanic does not have active GPS coordinates.");
            }
        };

        window.locateJob = function(id) {
            clearMap();
            var found = jobsData.find(j => j.id === id);
            if (found && found.lat && found.lng) {
                activeMarker = L.marker([found.lat, found.lng], { icon: orangeIcon })
                    .bindPopup(`
                        <div style="font-family: 'Outfit'; min-width: 200px;">
                            <h6 class="text-warning font-weight-bold mb-1"><i class="fa-solid fa-wrench"></i> Job #${found.id}</h6>
                            <div class="small text-light mb-1"><b>Vehicle:</b> ${found.vehicle}</div>
                            <div class="small text-light mb-1"><b>Issue:</b> ${found.problem}</div>
                            <div class="small text-light mb-1"><b>Status:</b> <span class="badge bg-warning text-dark font-weight-bold">${found.status}</span></div>
                            <div class="small text-light"><b>Address:</b> ${found.address}</div>
                        </div>
                    `)
                    .addTo(map);
                
                map.setView([found.lat, found.lng], 16);
                activeMarker.openPopup();
            } else {
                alert("This job location details are incomplete.");
            }
        };

        window.locateCustomer = function(id) {
            clearMap();
            var found = jobsData.find(j => j.id === id);
            if (found && found.lat && found.lng) {
                activeMarker = L.marker([found.lat, found.lng], { icon: blueIcon })
                    .bindPopup(`
                        <div style="font-family: 'Outfit'; min-width: 180px;">
                            <h6 class="text-primary font-weight-bold mb-1"><i class="fa-solid fa-user"></i> ${found.customerName}</h6>
                            <div class="small text-light mb-1"><b>Phone:</b> ${found.customerPhone}</div>
                            <div class="small text-light"><b>Vehicle:</b> ${found.vehicle}</div>
                        </div>
                    `)
                    .addTo(map);
                
                map.setView([found.lat, found.lng], 16);
                activeMarker.openPopup();
            } else {
                alert("Customer coordinates are not available.");
            }
        };
    });
</script>
