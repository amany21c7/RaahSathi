@using RaahSathi.Models
@{
    ViewData["Title"] = "Operations Admin Console";
    var pendingMechanics = ViewBag.PendingMechanics as List<MechanicProfile> ?? new List<MechanicProfile>();
    var pricingRules = ViewBag.PricingRules as List<PricingRule> ?? new List<PricingRule>();
    var disputes = ViewBag.Disputes as List<Job> ?? new List<Job>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="text-white mb-0">Operations Dashboard</h3>
    <div class="d-flex gap-2">
        <a href="/Admin/Messages" class="btn btn-warning font-weight-bold text-dark"><i class="fa-solid fa-headset me-2"></i> Contact Enquiries</a>
        <a href="/Admin/ManageUsers" class="btn btn-premium-primary"><i class="fa-solid fa-users me-2"></i> Manage Users</a>
        <a href="/Admin/ManagePricing" class="btn btn-premium-secondary"><i class="fa-solid fa-tags me-2"></i> Manage Pricing</a>
    </div>
</div>

<!-- Admin Stats Row -->
<div class="row g-3 mb-5">
    <div class="col-md-3 col-sm-6">
        <div class="glass-card p-3 border-success border-opacity-20 h-100">
            <div class="text-muted small">Online Mechanics</div>
            <h3 class="text-success font-weight-extrabold mt-1 mb-0" style="font-family: 'Outfit';">@ViewBag.OnlineMechanics</h3>
            <span class="text-muted" style="font-size:0.7rem;">Active URA Network nodes</span>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="glass-card p-3 border-warning border-opacity-20 h-100">
            <div class="text-muted small">Active Emergencies</div>
            <h3 class="text-warning font-weight-extrabold mt-1 mb-0" style="font-family: 'Outfit';">@ViewBag.ActiveRequests</h3>
            <span class="text-muted" style="font-size:0.7rem;">Dispatch pipeline jobs</span>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="glass-card p-3 border-info border-opacity-20 h-100">
            <div class="text-muted small">Completed Resolutions</div>
            <h3 class="text-info font-weight-extrabold mt-1 mb-0" style="font-family: 'Outfit';">@ViewBag.TotalJobs</h3>
            <span class="text-muted" style="font-size:0.7rem;">Total resolved breakdowns</span>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="glass-card p-3 border-primary border-opacity-20 h-100">
            <div class="text-muted small">Platform Volume</div>
            <h3 class="text-primary font-weight-extrabold mt-1 mb-0" style="font-family: 'Outfit';">₹@ViewBag.TotalRevenue.ToString("F2")</h3>
            <span class="text-muted" style="font-size:0.7rem;">Escrow payments processed</span>
        </div>
    </div>
</div>

<div class="row">
    <!-- Left Column: Operations (KYC & Disputes) -->
    <div class="col-lg-7">
        <!-- KYC Approval Section -->
        <div class="glass-card mb-4 border-info border-opacity-30">
            <h4 class="text-white mb-4"><i class="fa-solid fa-address-card text-info me-2"></i> Partner Onboarding Queue</h4>
            
            @if (pendingMechanics.Count == 0)
            {
                <p class="text-muted py-3 mb-0 text-center">No pending KYC approvals in onboarding queue.</p>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var m in pendingMechanics)
                    {
                        <div class="p-3 bg-dark bg-opacity-40 rounded border border-secondary">
                            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                                <div>
                                    <h5 class="text-white mb-0"><i class="fa-solid fa-user-gear text-info me-1"></i> @m.User?.Name <span class="badge bg-warning bg-opacity-20 text-warning border border-warning ms-2" style="font-size:0.7rem;">@m.DisplayId</span></h5>
                                    <span class="text-muted small">Phone: <b class="text-light">@m.User?.PhoneNumber</b></span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-warning text-dark">KYC Audit</span>
                                    <a href="/Admin/ReviewKyc/@m.UserId" class="btn btn-outline-info btn-xs py-1 px-2" style="font-size: 0.75rem;"><i class="fa-solid fa-eye me-1"></i> View Docs</a>
                                </div>
                            </div>
                            
                            <!-- Detailed Info Grid -->
                            <div class="row g-2 text-muted small mb-3">
                                <div class="col-sm-6 border-end border-secondary border-opacity-30">
                                    <span class="d-block">Email: <strong class="text-light">@(string.IsNullOrEmpty(m.Email) ? "N/A" : m.Email)</strong></span>
                                    <span class="d-block">Aadhaar: <strong class="text-light">@m.AadhaarNumber</strong></span>
                                    <span class="d-block">Gender & DOB: <strong class="text-light">@m.Gender | @(m.DateOfBirth?.ToString("dd MMM yyyy") ?? "N/A")</strong></span>
                                </div>
                                <div class="col-sm-6">
                                    <span class="d-block">Shop Name: <strong class="text-warning">@(string.IsNullOrEmpty(m.ShopName) ? "N/A" : m.ShopName)</strong></span>
                                    <span class="d-block">Timings: <strong class="text-light">@(string.IsNullOrEmpty(m.ShopTiming) ? "N/A" : m.ShopTiming)</strong></span>
                                    <span class="d-block">Experience: <strong class="text-light">@m.ExperienceYears Years @(m.IsCertified ? "(Certified)" : "")</strong></span>
                                </div>
                                <div class="col-12 mt-2 pt-2 border-top border-secondary border-opacity-30">
                                    <span class="d-block mb-1"><strong>Vehicles:</strong> 
                                        @if(!string.IsNullOrEmpty(m.VehicleExpertise)) {
                                            @foreach(var v in m.VehicleExpertise.Split(',', StringSplitOptions.RemoveEmptyEntries)) {
                                                <span class="badge bg-secondary text-light text-xs me-1">@v.Trim()</span>
                                            }
                                        } else {
                                            <span class="text-muted">None</span>
                                        }
                                    </span>
                                    <span class="d-block mt-1"><strong>Specializations:</strong> 
                                        @if(!string.IsNullOrEmpty(m.Specialization)) {
                                            @foreach(var s in m.Specialization.Split(',', StringSplitOptions.RemoveEmptyEntries)) {
                                                <span class="badge bg-info text-dark text-xs me-1 font-weight-medium">@s.Trim()</span>
                                            }
                                        } else {
                                            <span class="text-muted">None</span>
                                        }
                                    </span>
                                </div>
                            </div>
                            
                            <div class="d-flex gap-2 justify-content-end border-top border-secondary pt-2">
                                <form action="/Admin/ApproveKyc" method="POST" class="d-inline">
                                    <input type="hidden" name="userId" value="@m.UserId">
                                    <input type="hidden" name="status" value="Approved">
                                    <button type="submit" class="btn btn-premium-primary btn-sm"><i class="fa-solid fa-check me-1"></i> Approve KYC</button>
                                </form>
                                <form action="/Admin/ApproveKyc" method="POST" class="d-inline">
                                    <input type="hidden" name="userId" value="@m.UserId">
                                    <input type="hidden" name="status" value="Rejected">
                                    <button type="submit" class="btn btn-premium-secondary btn-sm text-danger border-danger border-opacity-40"><i class="fa-solid fa-xmark me-1"></i> Reject</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Dispute Center Section -->
        <div class="glass-card border-danger border-opacity-30">
            <h4 class="text-white mb-4"><i class="fa-solid fa-triangle-exclamation text-danger me-2"></i> Escrow Dispute Resolution Center</h4>
            
            @if (disputes.Count == 0)
            {
                <p class="text-muted py-3 mb-0 text-center">No active disputes filed. Escrow ledger clear.</p>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var d in disputes)
                    {
                        <div class="p-3 bg-dark bg-opacity-40 rounded border border-danger border-opacity-20">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="badge bg-danger mb-2">Dispute Filed</span>
                                    <h5 class="text-white mb-1">Job #@d.Id - @d.Vehicle?.Model</h5>
                                    <p class="text-muted small mb-0">Customer: <b>@d.Customer?.Name</b> | Mechanic: <b>@d.Mechanic?.Name</b></p>
                                </div>
                                <h5 class="text-warning">₹@d.FinalBillAmount</h5>
                            </div>
                            <div class="p-2 rounded bg-black text-muted small my-2 border border-secondary">
                                <b>Reason filed:</b> @d.DisputeReason
                            </div>
                            <form action="/Admin/ResolveDispute" method="POST" class="mt-3">
                                <input type="hidden" name="jobId" value="@d.Id">
                                <div class="mb-3">
                                    <label class="form-label text-muted small">Resolution Action Details (Logged in SLA ledger)</label>
                                    <input type="text" class="form-control glass-input" name="resolution" placeholder="e.g. Issue resolved, parts cost compensated" required>
                                </div>
                                <div class="d-flex gap-2 justify-content-end">
                                    <button type="submit" name="actionType" value="Release" class="btn btn-premium-primary btn-sm"><i class="fa-solid fa-unlock me-1"></i> Release to Mechanic</button>
                                    <button type="submit" name="actionType" value="Refund" class="btn btn-premium-danger btn-sm"><i class="fa-solid fa-arrow-rotate-left me-1"></i> Refund Customer</button>
                                </div>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Right Column: Persistent Pricing Rule Editor -->
    <div class="col-lg-5">
        <div class="glass-card border-warning border-opacity-30">
            <h4 class="text-white mb-4"><i class="fa-solid fa-sliders text-warning me-2"></i> Pricing Engine Tuning</h4>
            <p class="text-muted small mb-4">Modify the persistent database coefficients for Distance Visited (Layer 1) and Towing (Layer 4) pricing rules below. Updates apply instantly system-wide.</p>
            
            <div class="d-flex flex-column gap-4">
                @foreach (var r in pricingRules)
                {
                    <div class="p-3 bg-dark bg-opacity-40 rounded border border-secondary">
                        <h6 class="text-white font-weight-bold mb-3">@r.VehicleCategory Rate Settings</h6>
                        <form action="/Admin/UpdatePricingRule" method="POST">
                            <input type="hidden" name="ruleId" value="@r.Id">
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <label class="form-label text-muted small" style="font-size:0.75rem;">Base Visiting Fee</label>
                                    <input type="number" class="form-control glass-input" name="baseFee" value="@r.BaseFee" step="1">
                                </div>
                                <div class="col-6">
                                    <label class="form-label text-muted small" style="font-size:0.75rem;">Visiting Per-KM Rate</label>
                                    <input type="number" class="form-control glass-input" name="perKmRate" value="@r.PerKmRate" step="1">
                                </div>
                                <div class="col-6">
                                    <label class="form-label text-muted small" style="font-size:0.75rem;">Base Towing Fee</label>
                                    <input type="number" class="form-control glass-input" name="baseTowingFee" value="@r.BaseTowingFee" step="1">
                                </div>
                                <div class="col-6">
                                    <label class="form-label text-muted small" style="font-size:0.75rem;">Towing Per-KM Rate</label>
                                    <input type="number" class="form-control glass-input" name="perKmTowingRate" value="@r.PerKmTowingRate" step="1">
                                </div>
                            </div>
                            <button type="submit" class="btn btn-premium-primary btn-sm w-100">Apply Rates Update</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
