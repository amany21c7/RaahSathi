@using RaahSathi.Models
@{
    ViewData["Title"] = "Operations Admin Console";
    var pendingMechanics = ViewBag.PendingMechanics as List<MechanicProfile> ?? new List<MechanicProfile>();
    var pricingRules = ViewBag.PricingRules as List<PricingRule> ?? new List<PricingRule>();
    var disputes = ViewBag.Disputes as List<Job> ?? new List<Job>();
    var cityAreas = ViewBag.CityAreas as List<CityServiceArea> ?? new List<CityServiceArea>();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 border-bottom border-secondary border-opacity-30 pb-3">
    <div>
        <h3 class="text-white font-weight-bold mb-1" style="font-family: 'Outfit', sans-serif;">
            <i class="fa-solid fa-tower-cell text-warning me-2"></i> All-India Command &amp; Control Center
        </h3>
        <p class="text-muted small mb-0">Real-time National Operations Telemetry, Emergency Surge Monitoring &amp; Dispatch Management</p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2 w-100 w-md-auto">
        <a href="/Admin/Messages" class="btn btn-dark border-secondary text-warning btn-sm font-weight-bold flex-grow-1 flex-md-grow-0"><i class="fa-solid fa-headset me-1"></i> Support Inquiries</a>
        <a href="/Admin/Mechanics" class="btn btn-warning text-dark btn-sm font-weight-bold flex-grow-1 flex-md-grow-0"><i class="fa-solid fa-user-check me-1"></i> KYC Approvals</a>
    </div>
</div>

<!-- 🟢 Live Telemetry Status Row (Clickable Categories with Live Filter Grid) -->
<div class="row g-2 g-sm-3 mb-4">
    <div class="col-lg-2 col-md-4 col-6">
        <div class="p-2.5 p-sm-3 rounded-3 bg-dark bg-opacity-70 border border-success border-opacity-40 text-center shadow-sm h-100" style="cursor: pointer; transition: transform 0.2s, border-color 0.2s;" onmouseover="this.style.transform='scale(1.03)';" onmouseout="this.style.transform='scale(1)';" onclick="openTelemetryModal('onlineMechanics', 'Online Mechanics Network')">
            <span class="text-muted small d-block mb-1 text-truncate" style="font-size: 0.72rem;"><i class="fa-solid fa-circle text-success me-1" style="font-size:0.55rem;"></i> Online Fleet</span>
            <h3 class="text-success font-weight-extrabold mb-0" id="lblOnlineMechanics" style="font-size: 1.5rem;">@(ViewBag.OnlineMechanics ?? 0)</h3>
            <span class="text-muted d-block text-truncate" style="font-size: 0.65rem;">Tap for grid <i class="fa-solid fa-arrow-right ms-0.5"></i></span>
        </div>
    </div>
    <div class="col-lg-2 col-md-4 col-6">
        <div class="p-2.5 p-sm-3 rounded-3 bg-dark bg-opacity-70 border border-info border-opacity-40 text-center shadow-sm h-100" style="cursor: pointer; transition: transform 0.2s, border-color 0.2s;" onmouseover="this.style.transform='scale(1.03)';" onmouseout="this.style.transform='scale(1)';" onclick="openTelemetryModal('liveRequests', 'Live Assistance Requests')">
            <span class="text-muted small d-block mb-1 text-truncate" style="font-size: 0.72rem;"><i class="fa-solid fa-tower-broadcast text-info me-1"></i> Live Requests</span>
            <h3 class="text-info font-weight-extrabold mb-0" id="lblLiveRequests" style="font-size: 1.5rem;">@(ViewBag.LiveRequests ?? 0)</h3>
            <span class="text-muted d-block text-truncate" style="font-size: 0.65rem;">Tap for grid <i class="fa-solid fa-arrow-right ms-0.5"></i></span>
        </div>
    </div>
    <div class="col-lg-2 col-md-4 col-6">
        <div class="p-2.5 p-sm-3 rounded-3 bg-dark bg-opacity-70 border border-warning border-opacity-40 text-center shadow-sm h-100" style="cursor: pointer; transition: transform 0.2s, border-color 0.2s;" onmouseover="this.style.transform='scale(1.03)';" onmouseout="this.style.transform='scale(1)';" onclick="openTelemetryModal('activeJobs', 'Active Jobs in Progress')">
            <span class="text-muted small d-block mb-1 text-truncate" style="font-size: 0.72rem;"><i class="fa-solid fa-bolt text-warning me-1"></i> Active Jobs</span>
            <h3 class="text-warning font-weight-extrabold mb-0" id="lblActiveJobs" style="font-size: 1.5rem;">@(ViewBag.ActiveRequests ?? 0)</h3>
            <span class="text-muted d-block text-truncate" style="font-size: 0.65rem;">Tap for grid <i class="fa-solid fa-arrow-right ms-0.5"></i></span>
        </div>
    </div>
    <div class="col-lg-2 col-md-4 col-6">
        <div class="p-2.5 p-sm-3 rounded-3 bg-dark bg-opacity-70 border border-secondary border-opacity-40 text-center shadow-sm h-100" style="cursor: pointer; transition: transform 0.2s, border-color 0.2s;" onmouseover="this.style.transform='scale(1.03)';" onmouseout="this.style.transform='scale(1)';" onclick="openTelemetryModal('pendingRequests', 'Unassigned Pending Requests')">
            <span class="text-muted small d-block mb-1 text-truncate" style="font-size: 0.72rem;"><i class="fa-solid fa-hourglass-half text-light me-1"></i> Pending Req</span>
            <h3 class="text-light font-weight-extrabold mb-0" id="lblPendingRequests" style="font-size: 1.5rem;">@(ViewBag.PendingRequests ?? 0)</h3>
            <span class="text-muted d-block text-truncate" style="font-size: 0.65rem;">Tap for grid <i class="fa-solid fa-arrow-right ms-0.5"></i></span>
        </div>
    </div>
    <div class="col-lg-2 col-md-4 col-6">
        <div class="p-2.5 p-sm-3 rounded-3 bg-dark bg-opacity-70 border border-success border-opacity-40 text-center shadow-sm h-100" style="cursor: pointer; transition: transform 0.2s, border-color 0.2s;" onmouseover="this.style.transform='scale(1.03)';" onmouseout="this.style.transform='scale(1)';" onclick="openTelemetryModal('completedToday', 'Jobs Completed Today')">
            <span class="text-muted small d-block mb-1 text-truncate" style="font-size: 0.72rem;"><i class="fa-solid fa-circle-check text-success me-1"></i> Completed</span>
            <h3 class="text-success font-weight-extrabold mb-0" id="lblCompletedToday" style="font-size: 1.5rem;">@(ViewBag.CompletedToday ?? 0)</h3>
            <span class="text-muted d-block text-truncate" style="font-size: 0.65rem;">Tap for grid <i class="fa-solid fa-arrow-right ms-0.5"></i></span>
        </div>
    </div>
    <div class="col-lg-2 col-md-4 col-6">
        <div class="p-2.5 p-sm-3 rounded-3 bg-dark bg-opacity-70 border border-danger border-opacity-40 text-center shadow-sm h-100" style="cursor: pointer; transition: transform 0.2s, border-color 0.2s;" onmouseover="this.style.transform='scale(1.03)';" onmouseout="this.style.transform='scale(1)';" onclick="openTelemetryModal('cancelledToday', 'Jobs Cancelled Today')">
            <span class="text-muted small d-block mb-1 text-truncate" style="font-size: 0.72rem;"><i class="fa-solid fa-circle-xmark text-danger me-1"></i> Cancelled</span>
            <h3 class="text-danger font-weight-extrabold mb-0" id="lblCancelledToday" style="font-size: 1.5rem;">@(ViewBag.CancelledToday ?? 0)</h3>
            <span class="text-muted d-block text-truncate" style="font-size: 0.65rem;">Tap for grid <i class="fa-solid fa-arrow-right ms-0.5"></i></span>
        </div>
    </div>
</div>

<!-- Today's Financial Telemetry & Commission Vault (2x2 on Mobile, 4-col on Desktop) -->
<div class="row g-2 g-sm-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="p-2.5 p-sm-3.5 rounded-3 bg-dark bg-opacity-70 border border-primary border-opacity-40 shadow-sm h-100">
            <span class="text-muted small d-block mb-1 text-truncate" style="font-size: 0.72rem;">Today's Revenue</span>
            <h2 class="text-primary font-weight-extrabold mb-1" style="font-family: 'Outfit'; font-size: 1.45rem;" id="lblTodayRevenue">₹@(((double)(ViewBag.TodayRevenue ?? 0.0)).ToString("N0"))</h2>
            <span class="badge bg-primary text-white text-truncate d-inline-block" style="font-size: 0.62rem; max-width: 100%;">Escrow Ledger</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="p-2.5 p-sm-3.5 rounded-3 bg-dark bg-opacity-70 border border-warning border-opacity-40 shadow-sm h-100">
            <span class="text-muted small d-block mb-1 text-truncate" style="font-size: 0.72rem;">Commission</span>
            <h2 class="text-warning font-weight-extrabold mb-1" style="font-family: 'Outfit'; font-size: 1.45rem;" id="lblTodayCommission">₹@(((double)(ViewBag.TodayCommission ?? 0.0)).ToString("N0"))</h2>
            <span class="badge bg-warning text-dark text-truncate d-inline-block" style="font-size: 0.62rem; max-width: 100%;">Commission Vault</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="p-2.5 p-sm-3.5 rounded-3 bg-dark bg-opacity-70 border border-info border-opacity-40 shadow-sm h-100">
            <span class="text-muted small d-block mb-1 text-truncate" style="font-size: 0.72rem;">Avg Response</span>
            <h2 class="text-info font-weight-extrabold mb-1" style="font-family: 'Outfit'; font-size: 1.45rem;" id="lblAvgResponseTime">8 min</h2>
            <span class="badge bg-info text-dark text-truncate d-inline-block" style="font-size: 0.62rem; max-width: 100%;"><i class="fa-solid fa-clock me-1"></i> SLA Guaranteed</span>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="p-2.5 p-sm-3.5 rounded-3 bg-dark bg-opacity-70 border border-success border-opacity-40 shadow-sm h-100">
            <span class="text-muted small d-block mb-1 text-truncate" style="font-size: 0.72rem;">Customer Rating</span>
            <h2 class="text-success font-weight-extrabold mb-1" style="font-family: 'Outfit'; font-size: 1.45rem;" id="lblAvgCustomerRating">4.8 ★</h2>
            <span class="badge bg-success text-white text-truncate d-inline-block" style="font-size: 0.62rem; max-width: 100%;">98.4% Satisfaction</span>
        </div>
    </div>
</div>

<!-- Live India Regional Map & Live Pipeline Stepper Row -->
<div class="row g-4 mb-4">
    <!-- Live Regional India Network Status -->
    <div class="col-lg-6">
        <div class="p-3.5 rounded-3 bg-dark bg-opacity-70 border border-secondary border-opacity-40 shadow-sm h-100">
            <h5 class="text-white mb-3 d-flex align-items-center justify-content-between">
                <span><i class="fa-solid fa-map-location-dot text-warning me-2"></i> Live India Regional Network</span>
                <span class="badge bg-dark border border-warning text-warning font-weight-bold small" id="lblHubsCount">@(cityAreas.Count > 0 ? $"{cityAreas.Count} Active Hubs" : "4 Major Hubs")</span>
            </h5>
            <div class="row g-2 mb-3" id="regionalCitiesContainer">
                @if (cityAreas.Count == 0)
                {
                    <div class="col-12 col-sm-6">
                        <div class="p-2.5 rounded bg-black bg-opacity-50 border border-info border-opacity-30 d-flex align-items-center justify-content-between">
                            <span class="text-light font-weight-bold"><i class="fa-solid fa-circle text-info me-1" style="font-size:0.6rem;"></i> Delhi NCR</span>
                            <span class="badge bg-info text-dark font-weight-bold">142 Mechanics</span>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="p-2.5 rounded bg-black bg-opacity-50 border border-success border-opacity-30 d-flex align-items-center justify-content-between">
                            <span class="text-light font-weight-bold"><i class="fa-solid fa-circle text-success me-1" style="font-size:0.6rem;"></i> Lucknow</span>
                            <span class="badge bg-success text-white font-weight-bold">🟢 Online (88)</span>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="p-2.5 rounded bg-black bg-opacity-50 border border-warning border-opacity-30 d-flex align-items-center justify-content-between">
                            <span class="text-light font-weight-bold"><i class="fa-solid fa-circle text-warning me-1" style="font-size:0.6rem;"></i> Jaipur</span>
                            <span class="badge bg-warning text-dark font-weight-bold">🟡 Busy (74)</span>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6">
                        <div class="p-2.5 rounded bg-black bg-opacity-50 border border-danger border-opacity-30 d-flex align-items-center justify-content-between">
                            <span class="text-light font-weight-bold"><span class="pulse-red-dot me-1"></span> Mumbai</span>
                            <span class="badge bg-danger text-white font-weight-bold">🔴 Surge (+12%)</span>
                        </div>
                    </div>
                }
                else
                {
                    bool isGlobalSurge = ViewBag.IsGlobalEmergency ?? false;
                    @foreach (var c in cityAreas)
                    {
                        bool isSurgeActive = c.IsEmergencyMode || isGlobalSurge;
                        <div class="col-12 col-sm-6">
                            <div class="p-2.5 rounded bg-black bg-opacity-50 border @(isSurgeActive ? "border-danger bg-danger bg-opacity-10 shadow-sm" : "border-warning border-opacity-40") d-flex align-items-center justify-content-between">
                                <div>
                                    <span class="text-light font-weight-bold d-flex align-items-center gap-1">
                                        @if (isSurgeActive)
                                        {
                                            <span class="pulse-red-dot" title="Emergency Weather Surge Active (+12%)"></span>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-circle text-warning me-1" style="font-size:0.6rem;"></i>
                                        }
                                        @c.CityName
                                    </span>
                                    <div class="text-muted" style="font-size:0.7rem;">
                                        @c.AreaName (@c.State)
                                        @if (isSurgeActive)
                                        {
                                            <span class="text-danger font-weight-bold ms-1" style="font-size:0.68rem;">🚨 @(string.IsNullOrEmpty(c.EmergencyReason) ? "Rain Surge" : c.EmergencyReason)</span>
                                        }
                                    </div>
                                </div>
                                @if (isSurgeActive)
                                {
                                    <span class="badge bg-danger text-white font-weight-bold shadow-sm" style="font-size:0.7rem;">🚨 +12% Surge</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark font-weight-bold">@c.ServiceRadiusKm KM</span>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="p-2.5 rounded bg-black bg-opacity-30 border border-secondary text-muted small">
                <i class="fa-solid fa-circle-info text-warning me-1"></i> Regional capacity automatically balances roadside dispatch queues across states.
            </div>
        </div>
    </div>

    <!-- Live Requests Pipeline Stepper -->
    <div class="col-lg-6">
        <div class="p-3.5 rounded-3 bg-dark bg-opacity-70 border border-secondary border-opacity-40 shadow-sm h-100 position-relative">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="text-white mb-0 d-flex align-items-center gap-2">
                    <i class="fa-solid fa-diagram-project text-info"></i> Live Assistance Pipeline Stepper
                    <span class="badge bg-info text-dark" id="lblLiveJobsCount">0 Active</span>
                </h5>
                <span class="badge bg-success text-white" style="font-size:0.65rem;">
                    <i class="fa-solid fa-rotate me-1 fa-spin"></i> Live 3s Polling
                </span>
            </div>

            <!-- Job Selector if multiple active jobs -->
            <div id="pipelineJobSelectorContainer" class="mb-3 d-none">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-black text-warning border-secondary"><i class="fa-solid fa-list-check me-1"></i> Active Job:</span>
                    <select id="selPipelineJob" class="form-select bg-dark text-white border-secondary small">
                    </select>
                </div>
            </div>

            <!-- Active Stepper Content Container -->
            <div id="pipelineStepperCard">
                <div class="text-center py-4 text-muted">
                    <i class="fa-solid fa-circle-notch fa-spin text-info fs-3 mb-2 d-block"></i>
                    <span class="small">Initializing Live Breakdown Pipeline...</span>
                </div>
            </div>

            <!-- Admin Quick Actions Bar -->
            <div id="pipelineAdminActions" class="mt-3 pt-2 border-top border-secondary border-opacity-30 d-flex flex-wrap align-items-center justify-content-between gap-2 d-none">
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-info btn-xs py-1 px-2 font-weight-bold" id="btnAdminAssignMechanicModal" data-bs-toggle="modal" data-bs-target="#assignMechanicModal">
                        <i class="fa-solid fa-user-plus me-1"></i> Assign/Reassign Partner
                    </button>
                    <div class="dropdown">
                        <button class="btn btn-outline-warning btn-xs py-1 px-2 dropdown-toggle font-weight-bold" type="button" data-bs-toggle="dropdown">
                            <i class="fa-solid fa-sliders me-1"></i> Update Status
                        </button>
                        <ul class="dropdown-menu dropdown-menu-dark">
                            <li><a class="dropdown-item small" href="#" onclick="adminUpdateJobStatus('Requested')">1. Mark Requested (Searching)</a></li>
                            <li><a class="dropdown-item small" href="#" onclick="adminUpdateJobStatus('Assigned')">2. Mark Assigned</a></li>
                            <li><a class="dropdown-item small" href="#" onclick="adminUpdateJobStatus('In Progress')">3. Mark Repairing/In-Progress</a></li>
                            <li><a class="dropdown-item small" href="#" onclick="adminUpdateJobStatus('Completed')">4. Mark Completed</a></li>
                        </ul>
                    </div>
                </div>
                <a href="/Admin/LiveMap" class="text-info small font-weight-bold text-decoration-none">
                    <i class="fa-solid fa-map-location-dot me-1"></i> Open Live Map Telemetry
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Assign Mechanic Modal -->
<div class="modal fade" id="assignMechanicModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-info">
            <div class="modal-header border-secondary py-2">
                <h5 class="modal-title fs-6"><i class="fa-solid fa-user-gear text-info me-2"></i> Assign Partner / Mechanic</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">Select an available online mechanic to dispatch for <strong id="lblAssignJobDisplayId" class="text-warning">#JOB</strong></p>
                <div class="mb-3">
                    <label class="form-label text-muted small font-weight-bold">Select Online Mechanic</label>
                    <select id="selAssignMechanic" class="form-select bg-black text-white border-secondary">
                        <option value="">-- Choose Online Mechanic --</option>
                        @if (ViewBag.AvailableMechanics != null)
                        {
                            foreach (var m in (List<MechanicProfile>)ViewBag.AvailableMechanics)
                            {
                                <option value="@m.UserId">@m.User?.Name (@(string.IsNullOrEmpty(m.ShopName) ? "Garage" : m.ShopName) - @(string.IsNullOrEmpty(m.City) ? "Noida" : m.City)) ⭐ @m.Rating</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer border-secondary py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-info btn-sm font-weight-bold text-dark" id="btnSubmitAssignMechanic">
                    <i class="fa-solid fa-paper-plane me-1"></i> Confirm Dispatch
                </button>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Partner Onboarding Queue -->
    <div class="col-lg-6 col-12">
        <div class="glass-card h-100 border-info border-opacity-30">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="text-white mb-0"><i class="fa-solid fa-address-card text-info me-2"></i> Partner Onboarding Queue</h4>
                @if (pendingMechanics.Count > 0)
                {
                    <span class="badge bg-warning text-dark font-weight-bold">@pendingMechanics.Count Pending</span>
                }
            </div>
            
            @if (pendingMechanics.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="fa-solid fa-clipboard-check text-success fs-1 mb-2 d-block opacity-75"></i>
                    <p class="text-muted mb-0">No pending KYC approvals in onboarding queue.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var m in pendingMechanics)
                    {
                        <div class="p-3 bg-dark bg-opacity-40 rounded border border-secondary">
                            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom border-secondary pb-2">
                                <div>
                                    <h5 class="text-white mb-0"><i class="fa-solid fa-user-gear text-info me-1"></i> @m.User?.Name <span class="badge bg-warning bg-opacity-20 text-warning border border-warning ms-2" style="font-size:0.7rem;">@m.DisplayId</span></h5>
                                    <span class="text-muted small">Phone: <b class="text-light">@m.User?.PhoneNumber</b></span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-warning text-dark">KYC Audit</span>
                                    <button type="button" class="btn btn-outline-info btn-xs py-1 px-2 open-kyc-modal" data-id="@m.UserId" style="font-size: 0.75rem;"><i class="fa-solid fa-eye me-1"></i> View Docs</button>
                                </div>
                            </div>
                            
                            <!-- Detailed Info Grid -->
                            <div class="row g-2 text-muted small mb-3">
                                <div class="col-sm-6 border-end border-secondary border-opacity-30">
                                    <span class="d-block">Email: <strong class="text-light">@(string.IsNullOrEmpty(m.Email) ? "N/A" : m.Email)</strong></span>
                                    <span class="d-block">Aadhaar: <strong class="text-light">@m.AadhaarNumber</strong></span>
                                    <span class="d-block">Gender & DOB: <strong class="text-light">@m.Gender | @(m.DateOfBirth?.ToString("dd MMM yyyy") ?? "N/A")</strong></span>
                                </div>
                                <div class="col-sm-6">
                                    <span class="d-block">Shop Name: <strong class="text-warning">@(string.IsNullOrEmpty(m.ShopName) ? "N/A" : m.ShopName)</strong></span>
                                    <span class="d-block">Timings: <strong class="text-light">@(string.IsNullOrEmpty(m.ShopTiming) ? "N/A" : m.ShopTiming)</strong></span>
                                    <span class="d-block">Experience: <strong class="text-light">@m.ExperienceYears Years @(m.IsCertified ? "(Certified)" : "")</strong></span>
                                </div>
                                <div class="col-12 mt-2 pt-2 border-top border-secondary border-opacity-30">
                                    <span class="d-block mb-1"><strong>Vehicles:</strong> 
                                        @if(!string.IsNullOrEmpty(m.VehicleExpertise)) {
                                            @foreach(var v in m.VehicleExpertise.Split(',', StringSplitOptions.RemoveEmptyEntries)) {
                                                <span class="badge bg-secondary text-light text-xs me-1">@v.Trim()</span>
                                            }
                                        } else {
                                            <span class="text-muted">None</span>
                                        }
                                    </span>
                                    <span class="d-block mt-1"><strong>Specializations:</strong> 
                                        @if(!string.IsNullOrEmpty(m.Specialization)) {
                                            @foreach(var s in m.Specialization.Split(',', StringSplitOptions.RemoveEmptyEntries)) {
                                                <span class="badge bg-info text-dark text-xs me-1 font-weight-medium">@s.Trim()</span>
                                            }
                                        } else {
                                            <span class="text-muted">None</span>
                                        }
                                    </span>
                                </div>
                            </div>
                            
                            <div class="d-flex gap-2 justify-content-end border-top border-secondary pt-2">
                                <form action="/Admin/ApproveKyc" method="POST" class="d-inline">
                                    <input type="hidden" name="userId" value="@m.UserId">
                                    <input type="hidden" name="status" value="Approved">
                                    <input type="hidden" name="returnUrl" value="/Admin/Dashboard">
                                    <button type="submit" class="btn btn-premium-primary btn-sm font-weight-bold" onclick="return confirm('Verify & Approve KYC for partner @(m.User?.Name)?');"><i class="fa-solid fa-circle-check me-1"></i> Approve KYC</button>
                                </form>
                                <form action="/Admin/ApproveKyc" method="POST" class="d-inline">
                                    <input type="hidden" name="userId" value="@m.UserId">
                                    <input type="hidden" name="status" value="Rejected">
                                    <input type="hidden" name="returnUrl" value="/Admin/Dashboard">
                                    <button type="submit" class="btn btn-premium-secondary btn-sm text-danger border-danger border-opacity-40 font-weight-bold" onclick="return confirm('Reject KYC application for partner @(m.User?.Name)?');"><i class="fa-solid fa-circle-xmark me-1"></i> Reject</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Escrow Dispute Center Section -->
    <div class="col-lg-6 col-12">
        <div class="glass-card h-100 border-danger border-opacity-30">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="text-white mb-0"><i class="fa-solid fa-triangle-exclamation text-danger me-2"></i> Escrow Dispute Resolution Center</h4>
                @if (disputes.Count > 0)
                {
                    <span class="badge bg-danger text-white font-weight-bold">@disputes.Count Active</span>
                }
            </div>
            
            @if (disputes.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="fa-solid fa-shield-check text-success fs-1 mb-2 d-block opacity-75"></i>
                    <p class="text-muted mb-0">No active disputes filed. Escrow ledger clear.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var d in disputes)
                    {
                        <div class="p-3 bg-dark bg-opacity-40 rounded border border-danger border-opacity-20">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="badge bg-danger mb-2">Dispute Filed</span>
                                    <h5 class="text-white mb-1">Job #@d.Id - @d.Vehicle?.Model</h5>
                                    <p class="text-muted small mb-0">Customer: <b>@d.Customer?.Name</b> | Mechanic: <b>@d.Mechanic?.Name</b></p>
                                </div>
                                <h5 class="text-warning">₹@d.FinalBillAmount</h5>
                            </div>
                            <div class="p-2 rounded bg-black text-muted small my-2 border border-secondary">
                                <b>Reason filed:</b> @d.DisputeReason
                            </div>
                            <form action="/Admin/ResolveDispute" method="POST" class="mt-3">
                                <input type="hidden" name="jobId" value="@d.Id">
                                <div class="mb-3">
                                    <label class="form-label text-muted small">Resolution Action Details (Logged in SLA ledger)</label>
                                    <input type="text" class="form-control glass-input" name="resolution" placeholder="e.g. Issue resolved, parts cost compensated" required>
                                </div>
                                <div class="d-flex gap-2 justify-content-end">
                                    <button type="submit" name="actionType" value="Hold" class="btn btn-warning btn-sm text-dark font-weight-bold shadow-sm"><i class="fa-solid fa-lock me-1"></i> Hold Payment</button>
                                    <button type="submit" name="actionType" value="Release" class="btn btn-premium-primary btn-sm"><i class="fa-solid fa-unlock me-1"></i> Release to Mechanic</button>
                                    <button type="submit" name="actionType" value="Refund" class="btn btn-premium-danger btn-sm"><i class="fa-solid fa-arrow-rotate-left me-1"></i> Refund Customer</button>
                                </div>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- KYC Review Modal -->
<div class="modal fade" id="kycReviewModal" tabindex="-1" aria-labelledby="kycReviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary text-light">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-warning" id="kycReviewModalLabel"><i class="fa-solid fa-id-card me-2"></i> KYC Audit & Review Panel</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" onclick="var m = bootstrap.Modal.getOrCreateInstance(document.getElementById('kycReviewModal')); if(m) m.hide();"></button>
            </div>
            <div class="modal-body p-4" id="kycReviewModalBody">
                <div class="text-center py-5">
                    <div class="spinner-border text-warning" role="status">
                        <span class="visually-hidden">Loading KYC details...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<!-- 📊 Live Telemetry Category Details Grid Modal -->
<div class="modal fade" id="mdlTelemetryDetails" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-fullscreen-sm-down modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content bg-dark text-light border border-secondary shadow-lg">
            <div class="modal-header border-secondary py-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark font-weight-bold" id="lblTelemetryCategoryBadge">LIVE TELEMETRY</span>
                    <h5 class="modal-title font-weight-bold text-white mb-0" id="lblTelemetryModalTitle">Telemetry Details</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Search & Filter Bar -->
                <div class="row g-2 mb-3 align-items-center">
                    <div class="col-md-7 col-12">
                        <div class="input-group">
                            <span class="input-group-text bg-black bg-opacity-50 border-secondary text-warning"><i class="fa-solid fa-magnifying-glass"></i></span>
                            <input type="text" class="form-control bg-black bg-opacity-50 border-secondary text-white" id="txtTelemetrySearch" placeholder="Filter by Job ID (#RS-...), Name, Phone, Vehicle, Issue..." onkeyup="filterTelemetryGrid()">
                        </div>
                    </div>
                    <div class="col-md-5 col-12 text-md-end text-muted small">
                        Showing <strong class="text-warning fs-6" id="lblTelemetryItemCount">0</strong> records
                    </div>
                </div>

                <!-- Grid Table -->
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle border-secondary mb-0" id="tblTelemetryGrid">
                        <thead class="table-black text-warning small text-uppercase">
                            <tr>
                                <th>ID</th>
                                <th>Customer / Mechanic</th>
                                <th>Vehicle & Issue</th>
                                <th>Status</th>
                                <th>Amount / Rating</th>
                                <th>Time / Details</th>
                            </tr>
                        </thead>
                        <tbody id="tblTelemetryBody">
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">Loading real-time records...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer border-secondary py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var currentTelemetryData = [];

    function openTelemetryModal(category, title) {
        $('#lblTelemetryModalTitle').text(title);
        $('#lblTelemetryCategoryBadge').text(category.toUpperCase());
        $('#txtTelemetrySearch').val('');
        $('#tblTelemetryBody').html('<tr><td colspan="6" class="text-center text-muted py-4"><i class="fa-solid fa-spinner fa-spin text-warning me-2 fs-5"></i> Fetching live telemetry records...</td></tr>');
        
        var modal = new bootstrap.Modal(document.getElementById('mdlTelemetryDetails'));
        modal.show();

        $.get('/Admin/GetTelemetryCategoryDetails?category=' + category, function (res) {
            if (res && res.success) {
                currentTelemetryData = res.items || [];
                renderTelemetryGrid(currentTelemetryData);
            } else {
                $('#tblTelemetryBody').html('<tr><td colspan="6" class="text-center text-danger py-4">Failed to load telemetry records.</td></tr>');
            }
        });
    }

    function renderTelemetryGrid(items) {
        $('#lblTelemetryItemCount').text(items.length);
        if (items.length === 0) {
            $('#tblTelemetryBody').html('<tr><td colspan="6" class="text-center text-muted py-4">No matching telemetry records found.</td></tr>');
            return;
        }

        var html = '';
        items.forEach(function (item) {
            var itemType = item.type || item.Type || '';
            var displayId = item.displayId || item.DisplayId || '';

            if (itemType === "Mechanic") {
                var name = item.name || item.Name || 'Mechanic';
                var phone = item.phone || item.Phone || 'N/A';
                var subDetail = item.subDetail || item.SubDetail || 'Individual Mechanic';
                var skill = item.skill || item.Skill || 'General';
                var status = item.status || item.Status || '🟢 Online';
                var rating = item.rating || item.Rating || '5.0 ★';
                var extra = item.extra || item.Extra || '';

                html += '<tr>' +
                    '<td><span class="badge bg-dark border border-warning text-warning font-weight-bold">' + displayId + '</span></td>' +
                    '<td><div class="font-weight-bold text-white">' + name + '</div><div class="text-muted small"><i class="fa-solid fa-phone me-1"></i> ' + phone + '</div></td>' +
                    '<td><div class="text-light font-weight-bold">' + subDetail + '</div><div class="text-muted small"><i class="fa-solid fa-screwdriver-wrench me-1"></i> ' + skill + '</div></td>' +
                    '<td><span class="badge bg-success text-white font-weight-bold">' + status + '</span></td>' +
                    '<td><span class="text-warning font-weight-extrabold">' + rating + '</span></td>' +
                    '<td class="small text-muted">' + extra + '</td>' +
                '</tr>';
            } else {
                var customerName = item.customerName || item.CustomerName || 'Customer';
                var customerPhone = item.customerPhone || item.CustomerPhone || '';
                var mechanicName = item.mechanicName || item.MechanicName || 'Unassigned / Auto-Matching';
                var mechanicPhone = item.mechanicPhone || item.MechanicPhone || '';
                var vehicleModel = item.vehicleModel || item.VehicleModel || 'Vehicle';
                var regNo = item.regNo || item.RegNo || '';
                var problemType = item.problemType || item.ProblemType || 'Roadside Assistance';
                var status = item.status || item.Status || 'Requested';
                var amount = item.amount || item.Amount || '₹350';
                var createdAt = item.createdAt || item.CreatedAt || '';
                var address = item.address || item.Address || '';

                var statusBadge = 'bg-info text-dark';
                if (status === 'Completed') statusBadge = 'bg-success text-white';
                if (status === 'Cancelled') statusBadge = 'bg-danger text-white';
                if (status === 'Requested') statusBadge = 'bg-warning text-dark';

                html += '<tr>' +
                    '<td><span class="badge bg-dark border border-secondary text-warning font-weight-bold">' + displayId + '</span></td>' +
                    '<td><div class="font-weight-bold text-white">' + customerName + (customerPhone ? ' <span class="text-muted small">(' + customerPhone + ')</span>' : '') + '</div><div class="text-info small"><i class="fa-solid fa-wrench me-1"></i> ' + mechanicName + (mechanicPhone ? ' (' + mechanicPhone + ')' : '') + '</div></td>' +
                    '<td><div class="text-light font-weight-bold">' + vehicleModel + ' <span class="badge bg-secondary">' + regNo + '</span></div><div class="text-warning small"><i class="fa-solid fa-circle-exclamation me-1"></i> ' + problemType + '</div></td>' +
                    '<td><span class="badge ' + statusBadge + ' font-weight-bold">' + status + '</span></td>' +
                    '<td><span class="text-success font-weight-extrabold">' + amount + '</span></td>' +
                    '<td class="small text-muted">' + createdAt + '<div class="text-secondary small">' + address + '</div></td>' +
                '</tr>';
            }
        });
        $('#tblTelemetryBody').html(html);
    }

    function filterTelemetryGrid() {
        var query = $('#txtTelemetrySearch').val().toLowerCase().trim();
        if (!query) {
            renderTelemetryGrid(currentTelemetryData);
            return;
        }

        var filtered = currentTelemetryData.filter(function (item) {
            var itemType = item.type || item.Type || '';
            var displayId = item.displayId || item.DisplayId || '';
            var id = (item.id || item.Id || '').toString();

            if (itemType === "Mechanic") {
                var name = item.name || item.Name || '';
                var phone = item.phone || item.Phone || '';
                var subDetail = item.subDetail || item.SubDetail || '';
                var skill = item.skill || item.Skill || '';

                return displayId.toLowerCase().includes(query) ||
                       id.includes(query) ||
                       name.toLowerCase().includes(query) ||
                       phone.toLowerCase().includes(query) ||
                       subDetail.toLowerCase().includes(query) ||
                       skill.toLowerCase().includes(query);
            } else {
                var customerName = item.customerName || item.CustomerName || '';
                var customerPhone = item.customerPhone || item.CustomerPhone || '';
                var mechanicName = item.mechanicName || item.MechanicName || '';
                var mechanicPhone = item.mechanicPhone || item.MechanicPhone || '';
                var vehicleModel = item.vehicleModel || item.VehicleModel || '';
                var regNo = item.regNo || item.RegNo || '';
                var problemType = item.problemType || item.ProblemType || '';

                return displayId.toLowerCase().includes(query) ||
                       id.includes(query) ||
                       customerName.toLowerCase().includes(query) ||
                       customerPhone.toLowerCase().includes(query) ||
                       mechanicName.toLowerCase().includes(query) ||
                       mechanicPhone.toLowerCase().includes(query) ||
                       vehicleModel.toLowerCase().includes(query) ||
                       regNo.toLowerCase().includes(query) ||
                       problemType.toLowerCase().includes(query);
            }
        });

        renderTelemetryGrid(filtered);
    }

    $('#formAdminWithdraw').on('submit', function (e) {
        e.preventDefault();
        var amount = parseFloat($('#admWithdrawAmount').val());
        var method = $('#admWithdrawMethod').val();
        var ref = $('#admWithdrawRef').val();

        if (!amount || amount <= 0) {
            alert('Please enter a valid withdrawal amount.');
            return;
        }

        $.post('/Admin/WithdrawAdminCommission', { amount: amount, payoutMethod: method, referenceNumber: ref }, function (res) {
            if (res.success) {
                alert(res.message);
                window.location.reload();
            } else {
                alert(res.message || 'Error executing withdrawal.');
            }
        });
    });

    function pollAdminTelemetry() {
        $.get('/Admin/GetLiveTelemetry', function (res) {
            if (res && res.success) {
                $('#lblOnlineMechanics').text(res.onlineMechanics ?? 0);
                $('#lblLiveRequests').text(res.liveRequests ?? 0);
                $('#lblActiveJobs').text(res.activeJobs ?? 0);
                $('#lblPendingRequests').text(res.pendingRequests ?? 0);
                $('#lblCompletedToday').text(res.completedToday ?? 0);
                $('#lblCancelledToday').text(res.cancelledToday ?? 0);

                $('#lblTodayRevenue').text('₹' + Number(res.todayRevenue || 0).toLocaleString('en-IN'));
                $('#lblTodayCommission').text('₹' + Number(res.todayCommission || 0).toLocaleString('en-IN'));
                $('#lblAvgResponseTime').text((res.avgResponseTimeMinutes || 8) + ' min');
                $('#lblAvgCustomerRating').text((res.avgRating || 4.8) + ' ★');

                // Dynamic Topbar Emergency Mode Toggle sync
                var btn = $('#btnNocEmergencyToggle');
                if (res.isEmergencyMode) {
                    btn.removeClass('btn-outline-danger').addClass('btn-danger text-white').html('<i class="fa-solid fa-triangle-exclamation me-1"></i> Emergency Mode: ACTIVE 🚨');
                } else {
                    btn.removeClass('btn-danger text-white').addClass('btn-outline-danger').html('<i class="fa-solid fa-triangle-exclamation me-1"></i> Emergency Mode: OFF');
                }

                // Dynamic Regional Cities rendering
                if (res.cities && res.cities.length > 0) {
                    $('#lblHubsCount').text(res.cities.length + ' Active Hubs');
                    var html = '';
                    res.cities.forEach(function (c) {
                        html += '<div class="col-6">' +
                            '<div class="p-2.5 rounded bg-black bg-opacity-50 border border-warning border-opacity-40 d-flex align-items-center justify-content-between">' +
                                '<div>' +
                                    '<span class="text-light font-weight-bold"><i class="fa-solid fa-circle text-warning me-1" style="font-size:0.6rem;"></i> ' + c.cityName + '</span>' +
                                    '<div class="text-muted" style="font-size:0.7rem;">' + (c.areaName ? c.areaName : '') + ' (' + c.state + ')</div>' +
                                '</div>' +
                                '<span class="badge bg-warning text-dark font-weight-bold">' + c.serviceRadiusKm + ' KM</span>' +
                            '</div>' +
                        '</div>';
                    });
                    $('#regionalCitiesContainer').html(html);
                }
            }
        });
    }

    var selectedJobId = 0;

    function renderPipelineStepper(job) {
        if (!job) {
            $('#pipelineStepperCard').html(`
                <div class="text-center py-4 text-muted">
                    <i class="fa-solid fa-circle-check fs-1 text-success mb-2 d-block opacity-75"></i>
                    <h6 class="text-white font-weight-bold mb-1">No Active Breakdown Requests</h6>
                    <p class="small mb-0">System is standing by. New requests from customers will appear here live in real-time.</p>
                </div>
            `);
            $('#pipelineAdminActions').addClass('d-none');
            return;
        }

        $('#pipelineAdminActions').removeClass('d-none');
        selectedJobId = job.id;
        $('#lblAssignJobDisplayId').text(job.displayId);

        var step = 1;
        var statusText = job.status || "Requested";
        if (statusText === "Assigned" || statusText === "Accepted") step = 2;
        else if (statusText === "En Route" || statusText === "In Progress" || statusText === "Repairing") step = 3;
        else if (statusText === "Completed") step = 4;

        var step1Class = step >= 1 ? "bg-primary text-white shadow-sm" : "bg-dark text-muted border border-secondary";
        var step2Class = step >= 2 ? "bg-info text-dark shadow-sm" : "bg-dark text-muted border border-secondary";
        var step3Class = step >= 3 ? "bg-warning text-dark shadow-sm" : "bg-dark text-muted border border-secondary";
        var step4Class = step >= 4 ? "bg-success text-white shadow-sm" : "bg-dark text-muted border border-secondary";

        var html = `
            <!-- Dynamic 4-Step Pipeline Visual Stepper -->
            <div class="d-flex align-items-center justify-content-between mb-3 px-1">
                <div class="text-center flex-fill">
                    <span class="badge ${step1Class} rounded-circle p-2 mb-1" style="width:30px; height:30px; line-height:16px;">1</span>
                    <div class="small ${step >= 1 ? 'text-primary font-weight-bold' : 'text-muted'}" style="font-size:0.7rem;">Requested</div>
                </div>
                <div class="border-top flex-fill ${step >= 2 ? 'border-info' : 'border-secondary'}" style="margin-top:-15px;"></div>
                <div class="text-center flex-fill">
                    <span class="badge ${step2Class} rounded-circle p-2 mb-1" style="width:30px; height:30px; line-height:16px;">2</span>
                    <div class="small ${step >= 2 ? 'text-info font-weight-bold' : 'text-muted'}" style="font-size:0.7rem;">Assigned</div>
                </div>
                <div class="border-top flex-fill ${step >= 3 ? 'border-warning' : 'border-secondary'}" style="margin-top:-15px;"></div>
                <div class="text-center flex-fill">
                    <span class="badge ${step3Class} rounded-circle p-2 mb-1" style="width:30px; height:30px; line-height:16px;">3</span>
                    <div class="small ${step >= 3 ? 'text-warning font-weight-bold' : 'text-muted'}" style="font-size:0.7rem;">In Progress</div>
                </div>
                <div class="border-top flex-fill ${step >= 4 ? 'border-success' : 'border-secondary'}" style="margin-top:-15px;"></div>
                <div class="text-center flex-fill">
                    <span class="badge ${step4Class} rounded-circle p-2 mb-1" style="width:30px; height:30px; line-height:16px;">4</span>
                    <div class="small ${step >= 4 ? 'text-success font-weight-bold' : 'text-muted'}" style="font-size:0.7rem;">Completed</div>
                </div>
            </div>

            <!-- Customer & Vehicle Info -->
            <div class="p-2.5 rounded bg-black bg-opacity-50 border border-secondary mb-2">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary">Customer</span>
                        <span class="text-white small font-weight-bold">${job.customerName}</span>
                        <span class="text-muted small">(${job.customerPhone})</span>
                    </div>
                    <span class="badge bg-warning text-dark font-weight-bold">${job.problem}</span>
                </div>
                <div class="text-muted small d-flex align-items-center justify-content-between">
                    <span><i class="fa-solid fa-car me-1 text-secondary"></i> ${job.vehicle}</span>
                    <span><i class="fa-solid fa-clock me-1 text-secondary"></i> ${job.elapsedMinutes} mins ago</span>
                </div>
            </div>

            <!-- Partner / Mechanic & ETA Info -->
            <div class="p-2.5 rounded bg-black bg-opacity-50 border ${job.mechanicId ? 'border-info border-opacity-40' : 'border-warning border-opacity-40'} mb-2">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge ${job.mechanicId ? 'bg-info text-dark' : 'bg-secondary'}">${job.mechanicId ? 'Assigned Partner' : 'Unassigned'}</span>
                        <span class="text-white small font-weight-bold">${job.mechanicName}</span>
                    </div>
                    <span class="text-info small font-weight-bold">${job.etaMins}</span>
                </div>
                <div class="text-muted small">
                    <i class="fa-solid fa-location-dot me-1 text-danger"></i> ${job.address} ${(job.landmark ? ' • ' + job.landmark : '')}
                </div>
            </div>
        `;

        $('#pipelineStepperCard').html(html);
    }

    function pollLivePipelineStepper() {
        $.get('/Admin/GetLivePipelineJobs', function(res) {
            if (res && res.success) {
                $('#lblLiveJobsCount').text(res.count + ' Active');
                if (res.count === 0) {
                    renderPipelineStepper(null);
                    $('#pipelineJobSelectorContainer').addClass('d-none');
                } else {
                    var select = $('#selPipelineJob');
                    var currentVal = select.val();
                    
                    var optionsHtml = '';
                    res.jobs.forEach(function(j) {
                        optionsHtml += `<option value="${j.id}">${j.displayId} - ${j.customerName} (${j.problem}) - [${j.status}]</option>`;
                    });
                    select.html(optionsHtml);

                    if (res.count > 1) $('#pipelineJobSelectorContainer').removeClass('d-none');
                    else $('#pipelineJobSelectorContainer').addClass('d-none');

                    var activeJob = res.jobs[0];
                    if (currentVal && res.jobs.some(j => j.id == currentVal)) {
                        select.val(currentVal);
                        activeJob = res.jobs.find(j => j.id == currentVal);
                    }
                    renderPipelineStepper(activeJob);
                }
            }
        });
    }

    $('#selPipelineJob').change(function() {
        pollLivePipelineStepper();
    });

    window.adminUpdateJobStatus = function(status) {
        if (!selectedJobId) return;
        $.post('/Admin/UpdateJobStatusDirect', { jobId: selectedJobId, status: status }, function(res) {
            if (res.success) {
                pollLivePipelineStepper();
            } else {
                alert('⚠️ ' + res.message);
            }
        });
    };

    $('#btnSubmitAssignMechanic').click(function() {
        var mechanicId = $('#selAssignMechanic').val();
        if (!mechanicId || !selectedJobId) {
            alert('⚠️ Please select an online mechanic.');
            return;
        }
        $.post('/Admin/AssignMechanicToJob', { jobId: selectedJobId, mechanicUserId: mechanicId }, function(res) {
            if (res.success) {
                $('#assignMechanicModal').modal('hide');
                pollLivePipelineStepper();
            } else {
                alert('⚠️ ' + res.message);
            }
        });
    });

    // Open KYC Review Modal from Dashboard
    $(document).on('click', '.open-kyc-modal', function() {
        var id = $(this).data('id');
        $('#kycReviewModalBody').html('<div class="text-center py-5"><div class="spinner-border text-warning" role="status"><span class="visually-hidden">Loading KYC details...</span></div></div>');
        
        var modalEl = document.getElementById('kycReviewModal');
        var myModal = bootstrap.Modal.getOrCreateInstance(modalEl);
        myModal.show();
        
        $('#kycReviewModalBody').load('/Admin/ReviewKyc/' + id + '?partial=true');
    });

    // Auto-poll telemetry & pipeline stepper in real-time (optimized 10s to keep server & UI ultra-fast)
    setInterval(pollAdminTelemetry, 10000);
    setInterval(pollLivePipelineStepper, 10000);
    pollAdminTelemetry();
    pollLivePipelineStepper();
</script>
}
