@using RaahSathi.Models
@using RaahSathi.Services
@{
    ViewData["Title"] = "API & Contact Settings";
    var settings = ViewBag.Settings as List<AdminSystemSetting> ?? new List<AdminSystemSetting>();
    var apiSettings = ViewBag.ApiSettings as SystemApiSetting;
    var contactSettings = ViewBag.ContactSettings as SystemContactSetting;
    
    // API Gateway Keys
    var smsApiKeySetting = apiSettings?.SmsApiKey ?? settings.FirstOrDefault(s => s.SettingKey == "SmsApiKey")?.SettingValue ?? "F2SMS_LIVE_SEC_882190012";
    var whatsappNoSetting = apiSettings?.WhatsAppBusinessNumber ?? settings.FirstOrDefault(s => s.SettingKey == "WhatsAppNo")?.SettingValue ?? ContactInfoHelper.WhatsAppNumber;
    var googleMapsKeySetting = apiSettings?.GoogleMapsApiKey ?? settings.FirstOrDefault(s => s.SettingKey == "GoogleMapsKey")?.SettingValue ?? "AIzaSyA88921_RS_MAPS_KEY";
    var emailSenderSetting = apiSettings?.SmtpSenderEmail ?? settings.FirstOrDefault(s => s.SettingKey == "EmailSender")?.SettingValue ?? ContactInfoHelper.SupportEmail;

    // Payment Gateway Credentials
    var razorpayKeyId = settings.FirstOrDefault(s => s.SettingKey == "RazorpayKeyId")?.SettingValue ?? "";
    var razorpayKeySecret = settings.FirstOrDefault(s => s.SettingKey == "RazorpayKeySecret")?.SettingValue ?? "";
    var razorpayMode = settings.FirstOrDefault(s => s.SettingKey == "RazorpayMode")?.SettingValue ?? "Test";
    var isGatewayEnabled = settings.FirstOrDefault(s => s.SettingKey == "PaymentGatewayEnabled")?.SettingValue?.Equals("true", StringComparison.OrdinalIgnoreCase) ?? (!string.IsNullOrEmpty(razorpayKeyId));

    // Connected Active Bank & UPI Account (from Admin Accounts)
    var activeUpiId = settings.FirstOrDefault(s => s.SettingKey == "AdminUpiId")?.SettingValue ?? "";
    var activeHolder = settings.FirstOrDefault(s => s.SettingKey == "AdminAccountHolderName")?.SettingValue ?? "";
    var activeBank = settings.FirstOrDefault(s => s.SettingKey == "AdminBankName")?.SettingValue ?? "";
    var activeAccNo = settings.FirstOrDefault(s => s.SettingKey == "AdminAccountNumber")?.SettingValue ?? "";
    var activeIfsc = settings.FirstOrDefault(s => s.SettingKey == "AdminIfscCode")?.SettingValue ?? "";

    // Fallback: If not mirrored in AdminSystemSettings, check AdminAccountsJson
    if (string.IsNullOrEmpty(activeUpiId) && string.IsNullOrEmpty(activeAccNo))
    {
        var accountsSetting = settings.FirstOrDefault(s => s.SettingKey == "AdminAccountsJson");
        if (accountsSetting != null && !string.IsNullOrEmpty(accountsSetting.SettingValue))
        {
            try
            {
                var accList = System.Text.Json.JsonSerializer.Deserialize<List<RaahSathi.Controllers.AdminAccountModel>>(accountsSetting.SettingValue);
                var activeAcc = accList?.FirstOrDefault(a => a.IsActive) ?? accList?.FirstOrDefault();
                if (activeAcc != null)
                {
                    activeUpiId = activeAcc.UpiId ?? "";
                    activeHolder = activeAcc.HolderName ?? "";
                    activeBank = activeAcc.BankName ?? "";
                    activeAccNo = activeAcc.AccountNumber ?? "";
                    activeIfsc = activeAcc.IfscCode ?? "";
                }
            }
            catch {}
        }
    }

    // RaahSathi Core Public Contact Details
    var helplineNumberSetting = contactSettings?.HelplineNumber ?? settings.FirstOrDefault(s => s.SettingKey == "HelplineNumber")?.SettingValue ?? ContactInfoHelper.HelplineNumber;
    var whatsAppNumberSetting = contactSettings?.WhatsAppNumber ?? settings.FirstOrDefault(s => s.SettingKey == "WhatsAppNumber")?.SettingValue ?? ContactInfoHelper.WhatsAppNumber;
    var supportEmailSetting = contactSettings?.SupportEmail ?? settings.FirstOrDefault(s => s.SettingKey == "SupportEmail")?.SettingValue ?? ContactInfoHelper.SupportEmail;
    var officeAddressSetting = contactSettings?.OfficeAddress ?? settings.FirstOrDefault(s => s.SettingKey == "OfficeAddress")?.SettingValue ?? ContactInfoHelper.OfficeAddress;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="text-white font-weight-bold mb-1"><i class="fa-solid fa-sliders text-warning me-2"></i> System API &amp; Contact Integration</h4>
        <p class="text-muted small mb-0">Configure live SMS/WhatsApp gateways, system SMTP, Razorpay payment gateway, and manage official RaahSathi public contact details.</p>
    </div>
</div>

<div class="row g-4">
    <!-- 1. API Gateway Credentials Panel -->
    <div class="col-lg-12">
        <form action="/Admin/SaveApiSettings" method="POST">

            <div class="card bg-dark border-secondary shadow-sm">
                <div class="card-header border-secondary bg-transparent py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="text-info mb-0"><i class="fa-solid fa-key me-2"></i> SMS, WhatsApp &amp; Map API Keys</h5>
                    <span class="badge bg-info bg-opacity-20 text-info border border-info border-opacity-40"><i class="fa-solid fa-server me-1"></i> API Gateway SP</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6 mb-2">
                            <label class="form-label text-muted small font-weight-bold">Fast2SMS / Twilio SMS API Key</label>
                            <input type="password" name="smsApiKey" class="form-control glass-input text-white" value="@smsApiKeySetting" placeholder="Enter SMS gateway secret key...">
                        </div>
                        <div class="col-md-6 mb-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label text-muted small font-weight-bold mb-0">
                                    <i class="fa-brands fa-whatsapp text-success me-1"></i> WhatsApp Business API Phone
                                </label>
                                <span id="waFieldStatusBadge" class="badge bg-secondary text-white" style="font-size: 0.72rem;">
                                    <i class="fa-solid fa-circle-notch fa-spin"></i> Checking...
                                </span>
                            </div>
                            <div class="input-group">
                                <input type="text" id="waInputPhoneField" name="whatsappNo" class="form-control glass-input text-white font-weight-bold" value="@whatsappNoSetting" placeholder="+91 9891819236">
                                <button type="button" class="btn btn-outline-success font-weight-bold px-3 d-flex align-items-center gap-1.5" id="btnOpenWaModal" data-bs-toggle="modal" data-bs-target="#modalWhatsAppQr">
                                    <i class="fa-solid fa-qrcode"></i> <span id="btnWaModalText">Link WhatsApp</span>
                                </button>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <small class="text-muted" id="waFieldHelpText">Click 'Link WhatsApp' to scan QR or view live status.</small>
                                <a href="javascript:void(0)" id="lnkDisconnectWa" class="text-danger small d-none" onclick="logoutWhatsAppGateway()">
                                    <i class="fa-solid fa-right-from-bracket me-1"></i> Disconnect
                                </a>
                            </div>
                        </div>

                        <div class="col-md-6 mb-2">
                            <label class="form-label text-muted small font-weight-bold">Google Maps JavaScript API Key</label>
                            <input type="password" name="googleMapsKey" class="form-control glass-input text-white" value="@googleMapsKeySetting" placeholder="Enter Maps Javascript API key...">
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label text-muted small font-weight-bold">System SMTP Sender Email Address</label>
                            <input type="email" name="emailSender" class="form-control glass-input text-white" value="@emailSenderSetting" placeholder="support.raahsathi@gmail.com">
                        </div>

                        <!-- 💳 Payment Gateway API Credentials (Razorpay) -->
                        <div class="col-12 mt-3 pt-3 border-top border-secondary border-opacity-40">
                            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                                <h6 class="text-warning font-weight-bold mb-0">
                                    <i class="fa-solid fa-credit-card me-2"></i> Payment Gateway API Credentials (Razorpay)
                                </h6>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="form-check form-switch m-0">
                                        <input class="form-check-input" type="checkbox" role="switch" id="chkPaymentGatewayEnabled" name="paymentGatewayEnabled" value="true" @(isGatewayEnabled ? "checked" : "") style="cursor: pointer;">
                                        <label class="form-check-label text-white small font-weight-bold" for="chkPaymentGatewayEnabled">
                                            Gateway Active
                                        </label>
                                    </div>
                                    <span class="badge @(razorpayMode == "Live" ? "bg-success" : "bg-warning text-dark") px-2.5 py-1 font-weight-bold" style="font-size: 0.72rem;">
                                        Mode: @razorpayMode
                                    </span>
                                </div>
                            </div>
                            <p class="text-muted extra-small mb-3">
                                Directly receives Fast Membership subscriptions &amp; customer payments via UPI, GooglePay, PhonePe, Cards &amp; NetBanking.
                            </p>
                        </div>

                        <div class="col-md-5 mb-2">
                            <label class="form-label text-muted small font-weight-bold">Razorpay Key ID</label>
                            <input type="text" name="razorpayKeyId" class="form-control glass-input text-white" value="@razorpayKeyId" placeholder="rzp_live_xxxxxxxx or rzp_test_xxxxxxxx">
                        </div>
                        <div class="col-md-5 mb-2">
                            <label class="form-label text-muted small font-weight-bold">Razorpay Key Secret</label>
                            <div class="input-group">
                                <input type="password" id="txtRazorpaySecret" name="razorpayKeySecret" class="form-control glass-input text-white border-end-0" value="@razorpayKeySecret" placeholder="Enter Razorpay Key Secret...">
                                <button class="btn btn-outline-secondary text-muted border-start-0" type="button" onclick="toggleSecretVisibility('txtRazorpaySecret', this)" style="border-color: rgba(255,255,255,0.15);">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-2 mb-2">
                            <label class="form-label text-muted small font-weight-bold">Environment</label>
                            <select name="razorpayMode" class="form-select glass-input text-white">
                                <!option value="Test" @(razorpayMode != "Live" ? "selected" : "")>Test / Sandbox</!option>
                                <!option value="Live" @(razorpayMode == "Live" ? "selected" : "")>Live / Production</!option>
                            </select>
                        </div>

                        <!-- 🏦 Connected Active Admin Settlement Account (Auto-Synced from Treasury) -->
                        <div class="col-12 mt-3 pt-3 border-top border-secondary border-opacity-40">
                            <div class="p-3 rounded-3 bg-black bg-opacity-40 border border-secondary border-opacity-40 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="p-2.5 rounded-circle bg-warning bg-opacity-20 text-warning d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px;">
                                        <i class="fa-solid fa-building-columns fs-5"></i>
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <strong class="text-white" style="font-size: 0.92rem;">Connected Settlement Bank &amp; UPI Account</strong>
                                            <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-40 font-weight-bold" style="font-size: 0.72rem;">
                                                <i class="fa-solid fa-circle-check me-1"></i> Live Synced from Admin Accounts
                                            </span>
                                        </div>
                                        <div class="text-light small mt-1">
                                            <b>Holder:</b> <span class="text-warning font-weight-bold">@(string.IsNullOrEmpty(activeHolder) ? "Aman yadav" : activeHolder)</span>
                                            &bull; <b>UPI ID:</b> <span class="badge bg-secondary bg-opacity-50 text-white font-monospace">@(string.IsNullOrEmpty(activeUpiId) ? "raahsathi@upi" : activeUpiId)</span>
                                            @if (!string.IsNullOrEmpty(activeBank))
                                            {
                                                <span> &bull; <b>Bank:</b> @activeBank (A/C: @(activeAccNo?.Length > 4 ? "••••••" + activeAccNo.Substring(activeAccNo.Length - 4) : activeAccNo))</span>
                                            }
                                        </div>
                                        <small class="text-muted d-block mt-0.5" style="font-size: 0.74rem;">
                                            Mechanics and customers scanning the direct UPI QR or transferring via IMPS will send payments directly to this active account.
                                        </small>
                                    </div>
                                </div>
                                <a href="/Admin/Account" class="btn btn-outline-warning btn-sm rounded-pill px-3 py-1.5 font-weight-bold flex-shrink-0">
                                    <i class="fa-solid fa-gear me-1"></i> Manage Bank Accounts
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer border-secondary bg-transparent py-3 text-end">
                    <button type="submit" class="btn btn-info text-dark font-weight-bold px-4 py-2 shadow-sm">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Save API Keys
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- 2. RaahSathi Core Public Contact Details Panel -->
    <div class="col-lg-12">
        <form action="/Admin/SaveContactSettings" method="POST">
            <div class="card bg-dark border-secondary shadow-sm">
                <div class="card-header border-secondary bg-transparent py-3 d-flex justify-content-between align-items-center">
                    <h5 class="text-warning mb-0"><i class="fa-solid fa-headset me-2"></i> RaahSathi Contact &amp; Helpline Details</h5>
                    <span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-40"><i class="fa-solid fa-arrows-rotate me-1"></i> Global Live Sync</span>
                </div>
                <div class="card-body p-4">
                    <div class="p-3 bg-warning bg-opacity-10 border border-warning border-opacity-30 rounded-3 mb-4 d-flex align-items-center gap-3">
                        <i class="fa-solid fa-shield-halved text-warning fs-4"></i>
                        <div>
                            <strong class="text-white d-block" style="font-size: 0.95rem;">Universal Platform Live Synchronization</strong>
                        </div>
                    </div>

                    <div class="row g-3">
                        <!-- 1. 24x7 Helpline / Calling Number -->
                        <div class="col-md-4 mb-2">
                            <label class="form-label text-muted small font-weight-bold">
                                <i class="fa-solid fa-phone-volume text-warning me-1"></i> 24×7 Calling Helpline
                            </label>
                            <input type="text" name="helplineNumber" class="form-control glass-input text-white font-weight-bold" value="@helplineNumberSetting" placeholder="+91 9891819236">
                            <span class="text-muted text-xs d-block mt-1">Main phone on Call Now buttons &amp; Header</span>
                        </div>

                        <!-- 2. WhatsApp Support Number -->
                        <div class="col-md-4 mb-2">
                            <label class="form-label text-muted small font-weight-bold">
                                <i class="fa-brands fa-whatsapp text-success me-1"></i> WhatsApp Support Number
                            </label>
                            <input type="text" name="whatsAppNumber" class="form-control glass-input text-white" value="@whatsAppNumberSetting" placeholder="+91 9891819236">
                            <span class="text-muted text-xs d-block mt-1">Direct WhatsApp chat &amp; live location link</span>
                        </div>

                        <!-- 3. Customer Support Email -->
                        <div class="col-md-4 mb-2">
                            <label class="form-label text-muted small font-weight-bold">
                                <i class="fa-solid fa-envelope text-info me-1"></i> Customer Support Email
                            </label>
                            <input type="email" name="supportEmail" class="form-control glass-input text-white" value="@supportEmailSetting" placeholder="support.raahsathi@gmail.com">
                            <span class="text-muted text-xs d-block mt-1">Official public support inbox</span>
                        </div>

                        <!-- 4. Corporate Head Office Address -->
                        <div class="col-12 mb-2">
                            <label class="form-label text-muted small font-weight-bold">
                                <i class="fa-solid fa-location-dot text-danger me-1"></i> Corporate Head Office Address
                            </label>
                            <input type="text" name="officeAddress" class="form-control glass-input text-white" value="@officeAddressSetting" placeholder="Tower B, DLF Cyber City, Sector 24, Gurugram, Haryana - 122002">
                            <span class="text-muted text-xs d-block mt-1">Head office address displayed on Contact Us page &amp; Footer</span>
                        </div>
                    </div>
                </div>
                <div class="card-footer border-secondary bg-transparent py-3 text-end">
                    <button type="submit" class="btn btn-warning text-dark font-weight-bold px-5 py-2.5 shadow">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Save Contact Details
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- WhatsApp QR Scanner Modal -->
<div class="modal fade" id="modalWhatsAppQr" tabindex="-1" aria-labelledby="modalWhatsAppQrLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-success shadow-lg" style="border-width: 2px;">
            <div class="modal-header border-secondary bg-transparent py-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-brands fa-whatsapp text-success fs-4"></i>
                    <h5 class="modal-title text-white font-weight-bold" id="modalWhatsAppQrLabel">WhatsApp Web QR Gateway</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-4">
                <div id="modalWaStatusBadge" class="badge bg-warning text-dark px-3 py-2 fs-6 mb-3 font-weight-bold">
                    <i class="fa-solid fa-circle-notch fa-spin me-1"></i> Checking Gateway...
                </div>

                <!-- Live QR Container -->
                <div id="modalWaQrContainer" class="p-3 bg-white rounded shadow-lg d-inline-block my-2" style="min-width: 240px; min-height: 240px;">
                    <img id="modalWaQrImage" src="" alt="WhatsApp QR Code" style="width: 220px; height: 220px; display: none;" />
                    <div id="modalWaQrPlaceholder" class="d-flex flex-column align-items-center justify-content-center text-dark" style="height: 220px; width: 220px;">
                        <i class="fa-solid fa-circle-notch fa-spin text-muted fs-2 mb-2"></i>
                        <span class="text-muted small">Loading QR...</span>
                    </div>
                </div>

                <!-- Instructions -->
                <div id="modalWaInstructions" class="text-start bg-black p-3 rounded border border-secondary border-opacity-40 my-3">
                    <h6 class="text-warning font-weight-bold small mb-2"><i class="fa-solid fa-mobile-screen-button me-1"></i> How to Link:</h6>
                    <ol class="text-light small ps-3 mb-0" style="line-height: 1.7;">
                        <li>Open <strong>WhatsApp</strong> on your phone.</li>
                        <li>Tap <strong>Settings</strong> (iOS) or <strong>Three Dots (⋮)</strong> (Android) &gt; <strong>Linked Devices</strong>.</li>
                        <li>Tap <strong>Link a Device</strong> and point your camera at the QR code above.</li>
                    </ol>
                </div>

                <!-- Connected Info -->
                <div id="modalWaConnectedInfo" class="d-none my-3">
                    <div class="alert alert-success bg-dark border-success text-white mb-2">
                        <i class="fa-solid fa-circle-check text-success fs-3 d-block mb-1"></i>
                        <strong>WhatsApp Gateway Connected!</strong>
                        <div class="small mt-1 text-light">All OTPs will be delivered directly from this connected phone number.</div>
                        <div class="fs-5 font-monospace text-warning font-weight-bold mt-2" id="modalWaConnectedPhone">+91 XXXXX XXXXX</div>
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm mt-2" onclick="logoutWhatsAppGateway()">
                        <i class="fa-solid fa-right-from-bracket me-1"></i> Disconnect / Switch Number
                    </button>
                </div>
            </div>
            <div class="modal-footer border-secondary bg-transparent py-2 justify-content-end">
                <button type="button" class="btn btn-secondary btn-sm px-4" data-bs-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>

<script>
    function toggleSecretVisibility(inputId, btn) {
        var input = document.getElementById(inputId);
        if (!input) return;
        var icon = btn.querySelector('i');
        if (input.type === "password") {
            input.type = "text";
            if (icon) {
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            }
        } else {
            input.type = "password";
            if (icon) {
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }
    }

    // --- WhatsApp Web QR Gateway Live Polling ---
    async function checkWhatsAppGatewayStatus() {
        try {
            const res = await fetch('/Admin/GetWhatsAppGatewayStatus');
            const data = await res.json();

            const fieldBadge = document.getElementById('waFieldStatusBadge');
            const btnText = document.getElementById('btnWaModalText');
            const fieldHelp = document.getElementById('waFieldHelpText');
            const lnkDisc = document.getElementById('lnkDisconnectWa');
            const phoneInput = document.getElementById('waInputPhoneField');

            const modalBadge = document.getElementById('modalWaStatusBadge');
            const modalQrImage = document.getElementById('modalWaQrImage');
            const modalQrPlaceholder = document.getElementById('modalWaQrPlaceholder');
            const modalInstructions = document.getElementById('modalWaInstructions');
            const modalConnectedInfo = document.getElementById('modalWaConnectedInfo');
            const modalConnectedPhone = document.getElementById('modalWaConnectedPhone');

            if (!data.success || (!data.isOnline && !data.isConnected)) {
                if (fieldBadge) {
                    fieldBadge.className = 'badge bg-danger text-white font-weight-bold';
                    fieldBadge.innerHTML = '<i class="fa-solid fa-circle-xmark me-1"></i> Gateway Offline';
                }
                if (btnText) {
                    btnText.innerHTML = 'Link WhatsApp';
                }
                if (fieldHelp) {
                    fieldHelp.innerHTML = '<span class="text-danger"><i class="fa-solid fa-triangle-exclamation me-1"></i> WhatsApp Gateway service is offline or starting up on server.</span>';
                }
                if (lnkDisc) {
                    lnkDisc.classList.add('d-none');
                }
                if (modalBadge) {
                    modalBadge.className = 'badge bg-danger text-white px-3 py-2 fs-6';
                    modalBadge.innerHTML = '<i class="fa-solid fa-triangle-exclamation me-1"></i> Gateway Offline';
                }
                if (modalQrPlaceholder) {
                    modalQrPlaceholder.style.display = 'flex';
                    modalQrPlaceholder.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-danger fs-2 mb-2"></i><span class="text-danger font-weight-bold small">WhatsApp Gateway is currently offline.</span><small class="text-muted mt-1" style="font-size:0.75rem;">' + (data.message || 'Starting background service...') + '</small>';
                }
                if (modalQrImage) modalQrImage.style.display = 'none';
                return;
            }


            if (data.isConnected) {
                var cleanPhone = data.connectedPhone || '';
                var formatted = cleanPhone.startsWith('+') ? cleanPhone : ('+' + cleanPhone);

                if (fieldBadge) {
                    fieldBadge.className = 'badge bg-success text-dark font-weight-bold';
                    fieldBadge.innerHTML = '<i class="fa-solid fa-circle-check text-dark me-1"></i> Connected';
                }
                if (btnText) {
                    btnText.innerHTML = '🟢 Linked';
                }
                if (fieldHelp) {
                    fieldHelp.innerHTML = '<span class="text-success"><i class="fa-solid fa-circle-check me-1"></i> Active: OTPs are being sent via ' + formatted + '</span>';
                }
                if (lnkDisc) {
                    lnkDisc.classList.remove('d-none');
                }
                if (phoneInput && (!phoneInput.value || phoneInput.value.trim() === '')) {
                    phoneInput.value = formatted;
                }

                // Modal Updates
                if (modalBadge) {
                    modalBadge.className = 'badge bg-success text-dark px-3 py-2 fs-6 font-weight-bold';
                    modalBadge.innerHTML = '<i class="fa-solid fa-circle-check me-1"></i> Active &amp; Connected';
                }
                if (modalQrImage) modalQrImage.style.display = 'none';
                if (modalQrPlaceholder) {
                    modalQrPlaceholder.innerHTML = '<i class="fa-solid fa-circle-check text-success fs-1 mb-2"></i><span class="text-success font-weight-bold">WhatsApp Connected</span>';
                    modalQrPlaceholder.style.display = 'flex';
                }
                if (modalInstructions) modalInstructions.classList.add('d-none');
                if (modalConnectedInfo) modalConnectedInfo.classList.remove('d-none');
                if (modalConnectedPhone) modalConnectedPhone.innerText = formatted;

            } else if (data.qrDataUrl) {
                if (fieldBadge) {
                    fieldBadge.className = 'badge bg-warning text-dark font-weight-bold';
                    fieldBadge.innerHTML = '<i class="fa-solid fa-qrcode me-1"></i> Ready to Scan';
                }
                if (btnText) {
                    btnText.innerHTML = 'Scan QR';
                }
                if (fieldHelp) {
                    fieldHelp.innerHTML = 'Click "Scan QR" to connect your WhatsApp number.';
                }
                if (lnkDisc) {
                    lnkDisc.classList.add('d-none');
                }

                // Modal Updates
                if (modalBadge) {
                    modalBadge.className = 'badge bg-warning text-dark px-3 py-2 fs-6 font-weight-bold';
                    modalBadge.innerHTML = '<i class="fa-solid fa-qrcode me-1"></i> Ready to Scan';
                }
                if (modalQrImage) {
                    modalQrImage.src = data.qrDataUrl;
                    modalQrImage.style.display = 'block';
                }
                if (modalQrPlaceholder) modalQrPlaceholder.style.display = 'none';
                if (modalInstructions) modalInstructions.classList.remove('d-none');
                if (modalConnectedInfo) modalConnectedInfo.classList.add('d-none');

            } else {
                if (fieldBadge) {
                    fieldBadge.className = 'badge bg-secondary text-white';
                    fieldBadge.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin me-1"></i> Initializing...';
                }
                if (btnText) {
                    btnText.innerHTML = 'Link WhatsApp';
                }
                if (modalBadge) {
                    modalBadge.className = 'badge bg-secondary text-white px-3 py-2 fs-6';
                    modalBadge.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin me-1"></i> Initializing Gateway...';
                }
                if (modalQrPlaceholder) {
                    modalQrPlaceholder.style.display = 'flex';
                    modalQrPlaceholder.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin text-muted fs-2 mb-2"></i><span class="text-muted small">Loading QR...</span>';
                }
                if (modalQrImage) modalQrImage.style.display = 'none';
                if (modalInstructions) modalInstructions.classList.remove('d-none');
                if (modalConnectedInfo) modalConnectedInfo.classList.add('d-none');
            }
        } catch (err) {
            const fieldBadge = document.getElementById('waFieldStatusBadge');
            if (fieldBadge) {
                fieldBadge.className = 'badge bg-danger text-white';
                fieldBadge.innerHTML = '<i class="fa-solid fa-circle-xmark me-1"></i> Offline';
            }
            const modalBadge = document.getElementById('modalWaStatusBadge');
            if (modalBadge) {
                modalBadge.className = 'badge bg-danger text-white px-3 py-2 fs-6';
                modalBadge.innerHTML = '<i class="fa-solid fa-circle-xmark me-1"></i> Gateway Offline';
            }
        }
    }

    async function logoutWhatsAppGateway() {
        if (!confirm('Are you sure you want to disconnect this WhatsApp number? You will need to scan a new QR code.')) return;
        try {
            const res = await fetch('/Admin/LogoutWhatsAppGateway', { method: 'POST' });
            const data = await res.json();
            alert(data.message || 'Gateway session reset.');
            checkWhatsAppGatewayStatus();
        } catch (e) {
            alert('Failed to disconnect: ' + e.message);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        checkWhatsAppGatewayStatus();
        setInterval(checkWhatsAppGatewayStatus, 5000);
    });
</script>


