@{
    ViewData["Title"] = "Request Roadside Assistance";
    var vehicles = ViewBag.Vehicles as List<RaahSathi.Models.Vehicle> ?? new List<RaahSathi.Models.Vehicle>();
    var pricingRules = ViewBag.PricingRules as List<RaahSathi.Models.PricingRule> ?? new List<RaahSathi.Models.PricingRule>();
    var problemTypes = ViewBag.ProblemTypes as List<RaahSathi.Models.ProblemTypePricing> ?? new List<RaahSathi.Models.ProblemTypePricing>();
    var carRule = pricingRules.FirstOrDefault(r => r.VehicleCategory == "Car") ?? new RaahSathi.Models.PricingRule { BaseFee = 99, PerKmRate = 8 };
    var bikeRule = pricingRules.FirstOrDefault(r => r.VehicleCategory == "2-Wheeler") ?? new RaahSathi.Models.PricingRule { BaseFee = 49, PerKmRate = 5 };
    var erickRule = pricingRules.FirstOrDefault(r => r.VehicleCategory == "E-Rickshaw") ?? new RaahSathi.Models.PricingRule { BaseFee = 69, PerKmRate = 6 };
    var autoRule = pricingRules.FirstOrDefault(r => r.VehicleCategory == "Auto-Rickshaw") ?? new RaahSathi.Models.PricingRule { BaseFee = 79, PerKmRate = 7 };
    var commRule = pricingRules.FirstOrDefault(r => r.VehicleCategory == "Commercial") ?? new RaahSathi.Models.PricingRule { BaseFee = 199, PerKmRate = 12 };
    var heavyRule = pricingRules.FirstOrDefault(r => r.VehicleCategory == "Heavy") ?? new RaahSathi.Models.PricingRule { BaseFee = 299, PerKmRate = 15 };

    bool isCustLoggedIn = Context.User.Identity?.IsAuthenticated == true && Context.User.IsInRole("Customer");
    string custName = (Context.User.Identity?.IsAuthenticated == true ? Context.User.Identity.Name : "Customer") ?? "Customer";
    var preSelectedVehicle = ViewBag.PreSelectedVehicle as RaahSathi.Models.Vehicle;
}

<style>
    .prob-card {
        background: #0f172a !important;
        border: 1px solid rgba(255, 255, 255, 0.14) !important;
        transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
        user-select: none;
        box-shadow: 0 2px 6px rgba(0,0,0,0.3);
    }
    .prob-card:hover {
        background: #1e293b !important;
        border-color: rgba(245, 158, 11, 0.6) !important;
        transform: translateY(-2px);
    }
    .prob-card.active-prob-card {
        background: linear-gradient(135deg, #020617 0%, #0a1128 100%) !important;
        border: 2px solid #f59e0b !important;
        box-shadow: 0 0 18px rgba(245, 158, 11, 0.4), inset 0 0 14px rgba(245, 158, 11, 0.12) !important;
        transform: scale(1.01);
    }
    .prob-card.active-prob-card .prob-title {
        color: #fbbf24 !important;
        font-weight: 800 !important;
        letter-spacing: 0.2px;
    }
    .prob-card.active-prob-card .prob-icon {
        color: #fbbf24 !important;
        filter: drop-shadow(0 0 6px rgba(245, 158, 11, 0.8));
    }
    .prob-card.active-prob-card .prob-price {
        color: #34d399 !important;
        font-weight: 800 !important;
    }
</style>

<!-- Top Live Status Banner -->
<div class="row mb-3">
    <div class="col-12">
        <div class="p-3 px-3.5 rounded-3 border border-warning border-opacity-50 d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 shadow-lg" style="background: linear-gradient(135deg, rgba(15, 23, 42, 0.98), rgba(30, 41, 59, 0.98));">
            <div class="d-flex align-items-center overflow-hidden">
                <div class="rounded-circle bg-success bg-opacity-20 p-2 me-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width:44px; height:44px;">
                    <i class="fa-solid fa-location-crosshairs text-success fa-xl animate-pulse"></i>
                </div>
                <div class="overflow-hidden">
                    <h5 class="text-white font-weight-bold mb-0" style="font-size:1.02rem; letter-spacing: -0.2px;">Auto GPS Location Detection Active</h5>
                    <span class="text-muted small d-block" id="detectedLocationText" style="font-size:0.82rem; margin-top: 2px;">Detecting your breakdown location via browser GPS...</span>
                </div>
            </div>
            <div id="nearbyBadgeContainer" class="flex-shrink-0">
                <span class="badge bg-warning text-dark font-weight-bold px-3.5 py-2 shadow-sm" style="font-size:0.85rem;" id="nearbyMechanicsBadge">
                    <i class="fa-solid fa-bolt me-1 text-dark"></i> Checking Nearby Mechanics...
                </span>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Left Column: Interactive Map & Location Lock (Balanced Proportions) -->
    <div class="col-lg-5 mb-4 mb-lg-0">
        <div class="glass-card p-0 overflow-hidden d-flex flex-column shadow-sm" style="min-height: 410px; position: sticky; top: 80px; z-index: 10;">
            <div class="p-2.5 bg-dark border-bottom border-secondary d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2">
                <h6 class="mb-0 text-white font-weight-bold">
                    <i class="fa-solid fa-map-location-dot text-warning me-2"></i> Breakdown Location Map
                </h6>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-warning btn-sm font-weight-bold text-dark text-nowrap shadow-sm" onclick="reDetectGPS()" style="font-size:0.75rem; padding: 2px 8px;">
                        <i class="fa-solid fa-crosshairs me-1"></i> Live GPS
                    </button>
                </div>
            </div>
            
            <div class="p-2 bg-dark bg-opacity-90 border-bottom border-secondary d-flex align-items-center gap-2">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-dark border-secondary text-warning py-1"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" id="mapSearchInput" class="form-control bg-dark text-white border-secondary py-1" placeholder="Search area/landmark/city on map..." onkeypress="if(event.key==='Enter'){event.preventDefault();searchMapLocation();}" />
                    <button class="btn btn-warning text-dark font-weight-bold py-1" type="button" onclick="searchMapLocation()">Search</button>
                </div>
            </div>
            
            <div id="map-container" style="height: 310px; min-height: 310px; width: 100%;"></div>
            
            <div class="p-2 bg-dark border-top border-secondary text-muted small d-flex justify-content-between align-items-center" style="font-size:0.72rem;">
                <span><i class="fa-solid fa-hand-pointer text-warning me-1"></i> Click map to adjust pin.</span>
                <span class="text-success font-weight-bold" id="gpsAccuracyText"><i class="fa-solid fa-bullseye me-1"></i> GPS Active</span>
            </div>
        </div>
    </div>

    <!-- Right Column: 30-Second Ultra-Fast Booking Form (Expanded 7-Col for High Visibility) -->
    <div class="col-lg-7">
        <div class="glass-card">
            <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2 pb-2 border-bottom border-secondary border-opacity-30">
                <h4 class="text-white font-weight-bold mb-0 d-flex align-items-center">
                    <i class="fa-solid fa-bolt text-warning me-2 animate-pulse"></i> Instant Request
                </h4>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    @if (vehicles.Count > 0)
                    {
                        <div class="d-flex align-items-center gap-2 p-1.5 px-2.5 rounded-3 border border-warning border-opacity-40 shadow-sm" style="background: linear-gradient(135deg, rgba(30, 41, 59, 0.9), rgba(15, 23, 42, 0.95));">
                            <i class="fa-solid fa-car text-warning fs-6"></i>
                            <span class="text-white font-weight-bold small text-nowrap" style="font-size:0.8rem;">Vehicle:</span>
                            <select class="form-select form-select-sm glass-input text-white font-weight-bold py-1 px-2 border-secondary" id="topRegisteredVehicleSelect" onchange="onTopVehicleChange(this)" style="min-width: 170px; max-width: 250px; font-size:0.82rem; height: 34px; line-height: 1.4; background-color: rgba(15, 23, 42, 0.8);">
                                @foreach (var v in vehicles)
                                {
                                    <option value="@v.Id" class="bg-dark text-white" data-model="@v.Model" data-reg="@v.RegistrationNumber" data-type="@v.VehicleType" selected="@(preSelectedVehicle?.Id == v.Id ? "selected" : null)">@v.Model (@v.RegistrationNumber)</option>
                                }
                            </select>
                        </div>
                    }
                    <span class="badge bg-danger text-white px-2.5 py-2 font-weight-bold small shadow-sm">EXPRESS DISPATCH</span>
                </div>
            </div>

            <!-- Step 1: Vehicle Category Selection -->
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark rounded-circle d-inline-flex align-items-center justify-content-center font-weight-bold" style="width:20px; height:20px; font-size:0.7rem;">1</span>
                    <label class="form-label text-white small font-weight-bold mb-0">Select Vehicle Type</label>
                </div>
                <span class="badge bg-dark text-warning border border-warning border-opacity-40 px-2.5 py-1 font-weight-bold" id="vehicleCategoryTooltipBadge" style="font-size:0.75rem;">
                    <i class="fa-solid fa-circle-info me-1"></i> All Cars and SUVs
                </span>
            </div>
            <div class="row g-2 mb-3">
                <div class="col-4 col-md-2">
                    <div id="vPill-Car" class="v-pill p-2 rounded-3 text-center cursor-pointer border active-v-pill" onclick="setVehicleType('Car')" data-bs-toggle="tooltip" title="All Cars and SUVs">
                        <i class="fa-solid fa-car text-warning me-1"></i>
                        <div class="text-white font-weight-bold small">Car/SUV</div>
                    </div>
                </div>
                <div class="col-4 col-md-2">
                    <div id="vPill-2-Wheeler" class="v-pill p-2 rounded-3 text-center cursor-pointer border border-secondary" onclick="setVehicleType('2-Wheeler')" data-bs-toggle="tooltip" title="All Bikes and Scooters">
                        <i class="fa-solid fa-motorcycle text-warning me-1"></i>
                        <div class="text-white font-weight-bold small">2-Wheeler</div>
                    </div>
                </div>
                <div class="col-4 col-md-2">
                    <div id="vPill-E-Rickshaw" class="v-pill p-2 rounded-3 text-center cursor-pointer border border-secondary position-relative" onclick="setVehicleType('E-Rickshaw')" data-bs-toggle="tooltip" title="EV E-Rickshaw Specialist Dispatch">
                        <span class="badge bg-success text-white position-absolute top-0 end-0 m-1" style="font-size:0.55rem;">EV</span>
                        <i class="fa-solid fa-bolt-lightning text-success me-1"></i>
                        <div class="text-white font-weight-bold small">E-Rickshaw</div>
                    </div>
                </div>
                <div class="col-4 col-md-2">
                    <div id="vPill-Auto-Rickshaw" class="v-pill p-2 rounded-3 text-center cursor-pointer border border-secondary" onclick="setVehicleType('Auto-Rickshaw')" data-bs-toggle="tooltip" title="Auto-Rickshaw (CNG / Petrol / LPG)">
                        <span class="me-1" style="font-size: 1.15rem; line-height: 1; vertical-align: middle;">🛺</span>
                        <div class="text-white font-weight-bold small">Auto-Rickshaw</div>
                    </div>
                </div>
                <div class="col-4 col-md-2">
                    <div id="vPill-Commercial" class="v-pill p-2 rounded-3 text-center cursor-pointer border border-secondary" onclick="setVehicleType('Commercial')" data-bs-toggle="tooltip" title="All Commercial Vehicles">
                        <i class="fa-solid fa-truck text-warning me-1"></i>
                        <div class="text-white font-weight-bold small">Commercial</div>
                    </div>
                </div>
                <div class="col-4 col-md-2">
                    <div id="vPill-Heavy" class="v-pill p-2 rounded-3 text-center cursor-pointer border border-secondary" onclick="setVehicleType('Heavy')" data-bs-toggle="tooltip" title="All Heavy Vehicles">
                        <i class="fa-solid fa-tractor text-warning me-1"></i>
                        <div class="text-white font-weight-bold small">Heavy/JCB</div>
                    </div>
                </div>
            </div>

            <!-- Vehicle Brand & Model and Optional Registration Number -->
            <div class="row g-2 mb-3">
                <div class="col-md-7">
                    <label class="form-label text-white small font-weight-bold mb-1">Vehicle Name &amp; Model <span class="text-warning font-weight-bold">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-warning"><i class="fa-solid fa-car" id="vehicleModelIcon"></i></span>
                        <input type="text" class="form-control glass-input text-white font-weight-bold" id="vehicleNameModelInput" value="@(preSelectedVehicle?.Model ?? "")" placeholder="e.g. Mahindra Treo / Bajaj RE / Swift" required />
                    </div>
                </div>
                <div class="col-md-5">
                    <label class="form-label text-white small font-weight-bold mb-1">Registration No. <span class="text-warning font-weight-bold">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-warning"><i class="fa-solid fa-id-card"></i></span>
                        <input type="text" class="form-control glass-input text-white font-weight-bold text-uppercase" id="vehicleRegNumberInput" value="@(preSelectedVehicle?.RegistrationNumber ?? "")" placeholder="e.g. UP16 AB 1234" required />
                    </div>
                </div>
            </div>

            <!-- E-Rickshaw Specific Battery Type Selector & Safety Warning -->
            <div id="erickshawSection" class="p-3 rounded-3 mb-3 border border-success border-opacity-40 bg-dark bg-opacity-70 d-none">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-white small font-weight-bold"><i class="fa-solid fa-car-battery text-success me-1"></i> Battery Technology Type:</span>
                    <span class="badge bg-success text-white" style="font-size:0.7rem;">EV Verified Flow</span>
                </div>
                <div class="d-flex gap-2 mb-2">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="batteryTypeRadio" id="bTypeLead" value="Lead Acid" checked>
                        <label class="form-check-label text-white small" for="bTypeLead">Lead-Acid</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="batteryTypeRadio" id="bTypeLithium" value="Lithium Ion">
                        <label class="form-check-label text-white small" for="bTypeLithium">Lithium-Ion</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="batteryTypeRadio" id="bTypeUnknown" value="Don't Know">
                        <label class="form-check-label text-warning small font-weight-bold" for="bTypeUnknown">Don't Know</label>
                    </div>
                </div>
                <!-- EV Battery Safety Protocol Alert -->
                <div class="alert alert-warning bg-warning bg-opacity-10 border-warning text-white small p-2 mb-0 rounded" style="font-size:0.75rem; line-height:1.4;">
                    <i class="fa-solid fa-shield-halved text-warning me-1"></i> <strong>Safety Protocol:</strong> For your safety, do not allow unverified persons to modify, bypass, or remotely access your vehicle's Battery Management System (BMS). RaahSathi dispatches certified EV technicians with authentic diagnostic tools.
                </div>
            </div>

            <!-- Auto-Rickshaw Specific Fuel Type Selector -->
            <div id="autoSection" class="p-3 rounded-3 mb-3 border border-warning border-opacity-40 bg-dark bg-opacity-70 d-none">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-white small font-weight-bold"><i class="fa-solid fa-gas-pump text-warning me-1"></i> Auto-Rickshaw Fuel Type:</span>
                    <span class="badge bg-warning text-dark font-weight-bold" style="font-size:0.7rem;">CNG Specialist Match</span>
                </div>
                <div class="d-flex flex-wrap gap-3">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="fuelTypeRadio" id="fTypeCng" value="CNG" checked>
                        <label class="form-check-label text-white small font-weight-bold" for="fTypeCng">CNG</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="fuelTypeRadio" id="fTypePetrol" value="Petrol">
                        <label class="form-check-label text-white small" for="fTypePetrol">Petrol</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="fuelTypeRadio" id="fTypeLpg" value="LPG">
                        <label class="form-check-label text-white small" for="fTypeLpg">LPG</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="fuelTypeRadio" id="fTypeElectric" value="Electric">
                        <label class="form-check-label text-white small" for="fTypeElectric">Electric</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="fuelTypeRadio" id="fTypeOther" value="Other">
                        <label class="form-check-label text-muted small" for="fTypeOther">Other</label>
                    </div>
                </div>
            </div>

            <!-- Step 2: Issue / Problem Category Selection (Multi-Select Allowed) -->
            <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark rounded-circle d-inline-flex align-items-center justify-content-center font-weight-bold" style="width:20px; height:20px; font-size:0.7rem;">2</span>
                    <label class="form-label text-white small font-weight-bold mb-0" id="problemSectionLabel">Select Vehicle Problems <span class="badge bg-warning bg-opacity-20 text-warning border border-warning ms-1" style="font-size:0.65rem;">Multi-Select Allowed</span></label>
                </div>
                <span class="badge bg-secondary text-warning" id="probCountBadge" style="font-size:0.72rem;">0 Selected</span>
            </div>

            <!-- Dynamic Problem Selector Dropdown with Approximate Basic Rate -->
            <div class="mb-2">
                <select id="problemTypeSelect" class="form-select glass-input text-warning font-weight-bold border-secondary py-2" onchange="onProblemDropdownAdd(this.value)">
                    <!-- Dynamically populated per vehicle selection -->
                </select>
            </div>

            <!-- Quick Filter & Problem Cards Grid -->
            <div class="mb-3">
                <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 mt-2 mb-2">
                    <span class="text-white-50 small font-weight-medium">
                        <i class="fa-solid fa-hand-pointer text-warning me-1"></i> Select Problem with Approximate charges:
                    </span>
                    <div class="input-group input-group-sm" style="max-width: 220px;">
                        <span class="input-group-text bg-dark border-secondary text-warning py-1"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" id="problemSearchFilter" class="form-control bg-dark text-white border-secondary py-1" style="font-size:0.75rem;" placeholder="Search problems..." oninput="filterProblemCards(this.value)">
                    </div>
                </div>

                <div id="dynamicProblemCardsGrid" class="row g-2 custom-scroll" style="max-height: 285px; overflow-y: auto; padding-right: 2px;">
                    <!-- Dynamically generated problem cards with checkboxes -->
                </div>
            </div>

            <!-- Problem Details Description & Vehicle Breakdown Photo Upload -->
            <div class="row g-2 mb-3">
                <div class="col-12">
                    <label class="form-label text-white small font-weight-bold mb-1">Other Problem Details <span class="text-warning font-weight-normal" style="font-size:0.75rem;">(Optional)</span></label>
                    <textarea class="form-control glass-input text-white font-weight-bold" id="problemDescInput" rows="2" placeholder="Describe problem in detail (e.g. Gaadi chal nahi rahi, meter on ho raha hai but accelerator par response nahi hai)..."></textarea>
                </div>
                <div class="col-12">
                    <label class="form-label text-white small font-weight-bold mb-1">Upload Vehicle / Breakdown Photo <span class="text-warning font-weight-normal" style="font-size:0.75rem;">(Optional)</span></label>
                    <div class="p-3 border border-secondary rounded-3 bg-dark bg-opacity-60 text-center position-relative cursor-pointer" id="photoUploadBox" style="border-style: dashed !important;">
                        <input type="file" class="position-absolute top-0 start-0 w-100 h-100 cursor-pointer" id="problemPhotoInput" accept="image/*" onchange="previewProblemPhoto(this)" style="z-index:10; opacity:0;" />
                        <div id="photoPreviewContainer">
                            <i class="fa-solid fa-camera text-warning fa-2x mb-1"></i>
                            <div class="text-white font-weight-bold small">Snap Photo or Choose from Gallery</div>
                            <span class="text-muted" style="font-size:0.75rem;">Helps mechanic understand issue instantly</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 3: Breakdown Address & Gali / House No. -->
            <div class="row g-2 mb-3">
                <div class="col-12">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-warning text-dark rounded-circle d-inline-flex align-items-center justify-content-center font-weight-bold" style="width:20px; height:20px; font-size:0.7rem;">3</span>
                        <label class="form-label text-white small font-weight-bold mb-0">Exact Breakdown Address <span class="text-warning">*</span></label>
                    </div>
                    <div class="input-group">
                        <input type="text" class="form-control glass-input text-white font-weight-bold" id="addressInput" placeholder="Auto-detecting Gali, House No, Sector & City via GPS..." onkeypress="if(event.key==='Enter'){event.preventDefault();searchAddressFromInput();}" required />
                        <button type="button" class="btn btn-warning font-weight-bold text-dark text-nowrap" onclick="searchAddressFromInput()" title="Search address on map">
                            <i class="fa-solid fa-magnifying-glass-location me-1"></i> Search Address
                        </button>
                    </div>
                </div>
                <div class="col-12">
                    <input type="text" class="form-control glass-input text-white" id="landmarkInput" placeholder="House No / Gali No / Nearby Landmark (e.g. Gali No 4, Near Shiv Temple)" />
                    <span class="text-muted" style="font-size:0.75rem;"><i class="fa-solid fa-circle-info text-warning me-1"></i> Tip: Adding Gali No. or Landmark helps mechanics find your exact spot 2x faster.</span>
                </div>
            </div>

            <!-- Transparent Upfront Cost Estimator Box -->
            <div class="bg-dark bg-opacity-80 p-3 rounded-3 border border-secondary border-opacity-40 mb-3">
                <div id="emergencySurgeNotice" class="alert alert-danger bg-danger bg-opacity-20 border-danger text-white small p-2 mb-2 rounded d-none">
                    <i class="fa-solid fa-cloud-showers-heavy text-danger me-1"></i> <strong>⚡ Weather Emergency Surge Active (+12%)</strong>
                    <div class="small" style="font-size:0.75rem; opacity:0.9;">Severe weather / heavy rain in this area. Basic rates adjusted by +12%.</div>
                </div>
                <div class="d-flex justify-content-between text-muted small mb-1">
                    <span>Base Visiting Charge:</span>
                    <span id="baseFeeText" class="text-white font-weight-bold">₹99.00</span>
                </div>
                <div class="d-flex justify-content-between text-muted small mb-1">
                    <span>Service Fix Estimate:</span>
                    <span id="serviceRangeText" class="text-white font-weight-bold">₹150 - ₹3,500</span>
                </div>
                <div class="d-flex justify-content-between text-muted small mb-1">
                    <span>Distance to Nearest Patrol:</span>
                    <span id="distanceText" class="text-warning font-weight-bold">3.2 km</span>
                </div>
                <hr class="border-secondary border-opacity-30 my-2">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-white font-weight-bold">Upfront Total Estimate:</span>
                    <h4 class="text-warning font-weight-extrabold mb-0" style="font-family:'Outfit';" id="totalEstimateText">₹249 - ₹3,599</h4>
                </div>
            </div>

            <!-- 30-Second Fast Request Trigger Button -->
            <button type="button" class="btn btn-warning btn-lg w-100 py-3 font-weight-extrabold text-dark shadow" id="btnRequestDispatch" style="background:#f59e0b; border:none; font-size:1.1rem;">
                <i class="fa-solid fa-paper-plane me-2"></i> Request Assistance Now 🚀
            </button>
        </div>
    </div>
</div>

<!-- Guest OTP Quick Authentication Modal (If user is not logged in) -->
<div class="modal fade" id="guestAuthModal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
