@{
    ViewData["Title"] = "About Us - On Every Road, A Trusted Companion";
}

<div class="container py-4 py-md-5">
    <!-- Header Section -->
    <div class="text-center mb-5">
        <span class="badge bg-warning text-dark px-3 py-2 font-weight-bold mb-3 rounded-pill" style="font-size: 0.85rem; letter-spacing: 1px;">
            <i class="fa-solid fa-shield-halved me-1"></i> ABOUT <span class="notranslate" translate="no"><span style="color: #ff6b00;">RAAH</span><span class="text-dark">SATHI</span></span>
        </span>
        <h1 class="display-4 font-weight-bold text-white mb-3" style="font-family: 'Outfit', sans-serif;">
            "Har raaste pe, ek trusted saathi."
        </h1>
        <p class="lead text-muted max-w-700 mx-auto" style="font-size: 1.2rem; line-height: 1.6;">
            On every road, a trusted companion — fast, fair and transparent roadside assistance.
        </p>
    </div>

    <!-- Main Content Sections Grid -->
    <div class="row g-4 mb-5">
        <!-- 1. Who We Are -->
        <div class="col-md-6">
            <div class="glass-card h-100 p-4 border-warning border-opacity-25 hover-lift">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle bg-dark border border-warning p-2 d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                        <i class="fa-solid fa-users text-warning fa-lg"></i>
                    </div>
                    <div>
                        <span class="badge bg-dark text-warning border border-warning mb-1" style="font-size: 0.75rem;">OUR STORY</span>
                        <h4 class="text-white font-weight-bold mb-0" style="font-family: 'Outfit', sans-serif;">1. Who We Are</h4>
                    </div>
                </div>
                <p class="text-light mb-3" style="line-height: 1.7;">
                    <span class="notranslate" translate="no"><span style="color: #ff6b00;">Raah</span><span class="text-white">Sathi</span></span> is India’s roadside assistance platform that connects vehicle owners during breakdown emergencies directly with instant, transparent, and trusted mechanics — whether you drive a 2-wheeler, car, or heavy commercial truck, on a city street or a remote highway.
                </p>
                <div class="p-3 rounded bg-dark border border-info border-opacity-50">
                    <span class="text-info small font-weight-semibold">
                        <i class="fa-solid fa-circle-info me-1"></i> <strong>Honest Launch Note:</strong> We are currently in our launch phase in Noida and progressively expanding across major corridors with authentic, 100% verified service.
                    </span>
                </div>
            </div>
        </div>

        <!-- 2. Why We Started (The Problem) -->
        <div class="col-md-6">
            <div class="glass-card h-100 p-4 border-warning border-opacity-25 hover-lift">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle bg-dark border border-warning p-2 d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                        <i class="fa-solid fa-triangle-exclamation text-warning fa-lg"></i>
                    </div>
                    <div>
                        <span class="badge bg-dark text-warning border border-warning mb-1" style="font-size: 0.75rem;">THE PROBLEM</span>
                        <h4 class="text-white font-weight-bold mb-0" style="font-family: 'Outfit', sans-serif;">2. Why We Started</h4>
                    </div>
                </div>
                <p class="text-light mb-3" style="line-height: 1.7;">
                    In India, experiencing a vehicle breakdown on a road or highway is often stressful — which mechanic to call, how much they will charge without price certainty, and whether the mechanic is trustworthy.
                </p>
                <p class="text-muted small mb-0" style="line-height: 1.6;">
                    We created RaahSathi to eliminate breakdown panic — building a platform where help arrives fast, pricing is crystal clear upfront, and quality is guaranteed.
                </p>
            </div>
        </div>

        <!-- 3. Our Mission -->
        <div class="col-md-6">
            <div class="glass-card h-100 p-4 border-warning border-opacity-25 hover-lift">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle bg-dark border border-warning p-2 d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                        <i class="fa-solid fa-bullseye text-warning fa-lg"></i>
                    </div>
                    <div>
                        <span class="badge bg-dark text-warning border border-warning mb-1" style="font-size: 0.75rem;">OUR GOAL</span>
                        <h4 class="text-white font-weight-bold mb-0" style="font-family: 'Outfit', sans-serif;">3. Our Mission</h4>
                    </div>
                </div>
                <p class="text-light mb-0" style="line-height: 1.7;">
                    To empower every vehicle owner — whether riding a 2-wheeler or driving a heavy truck — with single-tap access to verified mechanics, fair upfront pricing, and complete peace of mind on any road, at any time.
                </p>
            </div>
        </div>

        <!-- 6. Our Vision -->
        <div class="col-md-6">
            <div class="glass-card h-100 p-4 border-warning border-opacity-25 hover-lift">
                <div class="d-flex align-items-center mb-3">
                    <div class="rounded-circle bg-dark border border-warning p-2 d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                        <i class="fa-solid fa-compass text-warning fa-lg"></i>
                    </div>
                    <div>
                        <span class="badge bg-dark text-warning border border-warning mb-1" style="font-size: 0.75rem;">FUTURE ROADMAP</span>
                        <h4 class="text-white font-weight-bold mb-0" style="font-family: 'Outfit', sans-serif;">6. Our Vision</h4>
                    </div>
                </div>
                <p class="text-light mb-0" style="line-height: 1.7;">
                    Starting our journey from Noida, we aim to expand across every city and national highway in India — ensuring that wherever a vehicle travels, RaahSathi is always right by their side.
                </p>
            </div>
        </div>
    </div>

    <!-- 4. What Makes Us Different -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="glass-card p-4 p-md-5 border-warning border-opacity-30">
                <div class="d-flex align-items-center mb-4">
                    <div class="rounded-circle bg-dark border border-warning p-2 d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                        <i class="fa-solid fa-shield-halved text-warning fa-lg"></i>
                    </div>
                    <h3 class="text-white font-weight-bold mb-0" style="font-family: 'Outfit', sans-serif;">
                        4. What Makes Us Different
                    </h3>
                </div>

                <div class="row g-3">
                    <div class="col-md-6 col-lg-3">
                        <div class="p-3 bg-dark bg-opacity-70 rounded border border-secondary h-100">
                            <i class="fa-solid fa-indian-rupee-sign text-warning fa-lg mb-2"></i>
                            <h6 class="text-white font-weight-bold mb-1">Upfront Pricing</h6>
                            <p class="text-muted small mb-0">Know the estimated service cost before any mechanic is dispatched.</p>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <div class="p-3 bg-dark bg-opacity-70 rounded border border-secondary h-100">
                            <i class="fa-solid fa-user-check text-warning fa-lg mb-2"></i>
                            <h6 class="text-white font-weight-bold mb-1">Verified Mechanics</h6>
                            <p class="text-muted small mb-0">KYC-checked, rated partners with live map tracking as they head your way.</p>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <div class="p-3 bg-dark bg-opacity-70 rounded border border-secondary h-100">
                            <i class="fa-solid fa-car text-warning fa-lg mb-2"></i>
                            <h6 class="text-white font-weight-bold mb-1">For All Vehicles</h6>
                            <p class="text-muted small mb-0">Bicycles to buses, tractors to JCBs — every vehicle type covered on one platform.</p>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <div class="p-3 bg-dark bg-opacity-70 rounded border border-secondary h-100">
                            <i class="fa-solid fa-truck-pickup text-warning fa-lg mb-2"></i>
                            <h6 class="text-white font-weight-bold mb-1">On-Spot + Towing</h6>
                            <p class="text-muted small mb-0">On-site repairs whenever possible, or towing to the nearest garage when needed.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. Our Promise -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="glass-card p-4 p-md-5 border-success border-opacity-40" style="background: linear-gradient(135deg, rgba(30, 41, 59, 0.95) 0%, rgba(15, 23, 42, 0.95) 100%);">
                <div class="d-flex align-items-center mb-4">
                    <div class="rounded-circle bg-dark border border-success p-2 d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;">
                        <i class="fa-solid fa-handshake text-success fa-lg"></i>
                    </div>
                    <h3 class="text-white font-weight-bold mb-0" style="font-family: 'Outfit', sans-serif;">
                        5. Our Promise
                    </h3>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="p-3 bg-dark rounded border border-success border-opacity-30 h-100">
                            <div class="d-flex align-items-center mb-2">
                                <i class="fa-solid fa-circle-check text-success me-2"></i>
                                <h6 class="text-white font-weight-bold mb-0">No Hidden Charges</h6>
                            </div>
                            <p class="text-muted small mb-0">Complete transparency with clear Visiting &amp; Fix estimates.</p>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="p-3 bg-dark rounded border border-success border-opacity-30 h-100">
                            <div class="d-flex align-items-center mb-2">
                                <i class="fa-solid fa-circle-check text-success me-2"></i>
                                <h6 class="text-white font-weight-bold mb-0">No Overcharging</h6>
                            </div>
                            <p class="text-muted small mb-0">Work begins only after you review and approve the price in-app.</p>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="p-3 bg-dark rounded border border-success border-opacity-30 h-100">
                            <div class="d-flex align-items-center mb-2">
                                <i class="fa-solid fa-circle-check text-success me-2"></i>
                                <h6 class="text-white font-weight-bold mb-0">Your Safety First</h6>
                            </div>
                            <p class="text-muted small mb-0">KYC-verified mechanics, live tracking, and 24x7 emergency SOS support.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 7. A Note from the Founders -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="p-4 p-md-5 rounded-3 border border-warning border-opacity-40" style="background: linear-gradient(135deg, rgba(245, 158, 11, 0.15) 0%, rgba(30, 41, 59, 0.95) 100%);">
                <div class="d-flex align-items-center mb-3">
                    <i class="fa-solid fa-quote-left text-warning fa-2x me-3"></i>
                    <h4 class="text-white font-weight-bold mb-0" style="font-family: 'Outfit', sans-serif;">7. A Note from the Founders</h4>
                </div>
                <blockquote class="blockquote text-light mb-0" style="font-size: 1.15rem; line-height: 1.7; font-style: italic;">
                    "We built RaahSathi because everyone has faced a stressful breakdown at some point — and in that critical moment, you only want one thing: someone who arrives quickly, states an honest price, and fixes the issue reliably. That is exactly who we strive to be every single day."
                </blockquote>
            </div>
        </div>
    </div>

    <!-- Bottom CTA Button -->
    <div class="row">
        <div class="col-12 text-center">
            <div class="p-4 rounded-3 border border-warning border-opacity-30" style="background: rgba(30, 41, 59, 0.8);">
                <h4 class="text-white font-weight-bold mb-3" style="font-family: 'Outfit', sans-serif;">Stranded on the road?</h4>
                <a href="/Customer/Book" class="btn btn-premium-primary btn-lg px-5 py-3 font-weight-bold shadow-lg">
                    <i class="fa-solid fa-car me-2"></i> Request Assistance Now
                </a>
            </div>
        </div>
    </div>
</div>
