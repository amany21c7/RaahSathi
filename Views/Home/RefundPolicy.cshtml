@{
    ViewData["Title"] = "Refund & Escrow Protection Policy";
}

<div class="container py-4 py-md-5">
    <!-- Header Section -->
    <div class="text-center mb-5">
        <span class="badge bg-success text-dark px-3 py-2 font-weight-bold mb-3 rounded-pill" style="font-size: 0.85rem; letter-spacing: 1px;">
            <i class="fa-solid fa-shield-halved me-1"></i> 100% ESCROW GUARANTEE
        </span>
        <h1 class="display-4 font-weight-bold text-white mb-3" style="font-family: 'Outfit', sans-serif;">
            Refund &amp; Money-Back Guarantee Policy
        </h1>
        <p class="lead text-muted max-w-700 mx-auto" style="font-size: 1.15rem; line-height: 1.6;">
            Learn how <span class="notranslate" translate="no"><span style="color: #ff6b00;">Raah</span><span class="text-white">Sathi</span></span> Escrow protects your money and guarantees instant refunds for unfulfilled or cancelled services.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="glass-card p-4 p-md-5 border border-secondary border-opacity-30">
                <div class="mb-4 pb-3 border-bottom border-secondary border-opacity-30 d-flex justify-content-between align-items-center">
                    <span class="text-muted small">Effective Date: July 2026 | Escrow Rules v2.0</span>
                    <span class="badge bg-warning text-dark font-weight-bold">Zero-Risk Protection</span>
                </div>

                <!-- Section 1 -->
                <div class="mb-5">
                    <h4 class="text-warning font-weight-bold mb-3">1. <span class="notranslate" translate="no"><span style="color: #ff6b00;">Raah</span><span class="text-white">Sathi</span></span> Escrow Safety Net</h4>
                    <p class="text-muted" style="line-height: 1.8;">
                        Every payment made on <span class="notranslate" translate="no"><span style="color: #ff6b00;">Raah</span><span class="text-white">Sathi</span></span> is deposited into an automated Escrow account. Unlike traditional services where cash is handed over upfront, your payment is <strong>never released to the mechanic until the repair is fully completed</strong> to your satisfaction.
                    </p>
                </div>

                <!-- Section 2 -->
                <div class="mb-5">
                    <h4 class="text-warning font-weight-bold mb-3">2. Eligible Full Refund Scenarios (100% Refund)</h4>
                    <p class="text-muted" style="line-height: 1.8;">
                        You are entitled to an immediate 100% full refund under the following conditions:
                    </p>
                    <ul class="text-muted" style="line-height: 1.8;">
                        <li><strong>Mechanic Non-Arrival / Delay:</strong> If the assigned mechanic fails to reach your location within 45 minutes of accepted ETA without valid emergency notice.</li>
                        <li><strong>Mechanic Cancellation:</strong> If the mechanic cancels the assignment due to vehicle mismatch, equipment unavailability, or distance issues.</li>
                        <li><strong>Unresolved Breakdown:</strong> If the mechanic is unable to diagnose or repair the issue and no alternative solution/towing is provided.</li>
                        <li><strong>Double Billing / Gateway Error:</strong> Any duplicate transaction or payment gateway processing error.</li>
                    </ul>
                </div>

                <!-- Section 3 -->
                <div class="mb-5">
                    <h4 class="text-warning font-weight-bold mb-3">3. Partial Refund &amp; Cancellation Fee Rules</h4>
                    <ul class="text-muted" style="line-height: 1.8;">
                        <li>If a customer cancels the booking after the mechanic has travelled more than 3 km toward the breakdown spot, a minimal visiting allowance (up to ₹99 or actual travel cost) is paid to the mechanic for gas/time, and the remainder is refunded to the customer.</li>
                        <li>No cancellation fee is charged if cancelled within 5 minutes of booking creation.</li>
                    </ul>
                </div>

                <!-- Section 4 -->
                <div class="mb-5">
                    <h4 class="text-warning font-weight-bold mb-3">4. Refund Processing Timeline</h4>
                    <p class="text-muted" style="line-height: 1.8;">
                        Refunds are initiated instantly upon job cancellation or dispute resolution:
                    </p>
                    <ul class="text-muted" style="line-height: 1.8;">
                        <li><strong>UPI / Paytm / PhonePe / GPay:</strong> 15 minutes to 2 hours.</li>
                        <li><strong>Debit / Credit Cards &amp; NetBanking:</strong> 1 to 3 working business days depending on bank clearance.</li>
                        <li><strong>RaahSathi Wallet:</strong> Instant credit.</li>
                    </ul>
                </div>

                <!-- Section 5 -->
                <div class="mb-4">
                    <h4 class="text-warning font-weight-bold mb-3">5. Raising a Payment Dispute</h4>
                    <p class="text-muted" style="line-height: 1.8;">
                        If you have any dispute regarding billing or service quality, click <strong>"Dispute Bill"</strong> on your Customer Dashboard or call our 24×7 Billing Helpline at <strong>+91 9891819236</strong> / email <a href="mailto:billing@raahsathi.in" class="text-warning text-decoration-none">billing@raahsathi.in</a>.
                    </p>
                </div>

                <div class="pt-4 border-top border-secondary border-opacity-30 text-center">
                    <a href="/Customer/Dashboard" class="btn btn-warning text-dark font-weight-bold px-4 py-2 me-2"><i class="fa-solid fa-wallet me-2"></i> Track Payments</a>
                    <a href="/Home/ContactUs" class="btn btn-outline-light px-4 py-2"><i class="fa-solid fa-headset me-2"></i> Contact Billing Support</a>
                </div>
            </div>
        </div>
    </div>
</div>
