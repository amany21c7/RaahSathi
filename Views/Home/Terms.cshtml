                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center me-3 font-weight-extrabold fs-5" style="width: 42px; height: 42px;">
