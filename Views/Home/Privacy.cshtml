@{
    ViewData["Title"] = "Privacy Policy & Data Safety Rules";
}

<div class="container py-4 py-md-5">
    <!-- Header Section -->
    <div class="text-center mb-5">
        <span class="badge bg-warning text-dark px-3 py-2 font-weight-bold mb-3 rounded-pill" style="font-size: 0.85rem; letter-spacing: 1px;">
            <i class="fa-solid fa-user-shield me-1"></i> PRIVACY &amp; DATA PROTECTION
        </span>
        <h1 class="display-4 font-weight-bold text-white mb-3" style="font-family: 'Outfit', sans-serif;">
            Privacy Policy &amp; Data Safety
        </h1>
        <p class="lead text-muted max-w-700 mx-auto" style="font-size: 1.15rem; line-height: 1.6;">
            Your trust is our foundation. Learn how RaahSathi protects your personal information, live location data, and payment security.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="glass-card p-4 p-md-5 border border-secondary border-opacity-30">
                <div class="mb-4 pb-3 border-bottom border-secondary border-opacity-30">
                    <span class="text-muted small">Effective Date: July 2026 | Version 2.4</span>
                </div>

                <!-- Section 1 -->
                <div class="mb-5">
                    <h4 class="text-warning font-weight-bold mb-3">1. Information We Collect</h4>
                    <p class="text-muted" style="line-height: 1.8;">
                        To provide instant, reliable roadside assistance across India, RaahSathi collects minimal essential information necessary for breakdown emergency dispatch:
                    </p>
                    <ul class="text-muted" style="line-height: 1.8;">
                        <li><strong>Personal Identification:</strong> Full name, phone number, and optional email address.</li>
                        <li><strong>Vehicle Information:</strong> Make, model, vehicle category (2-Wheeler, Car, Commercial, Heavy), and registration number.</li>
                        <li><strong>GPS Location Data:</strong> Precise breakdown coordinates collected only during active assistance requests to dispatch the nearest mechanic.</li>
                        <li><strong>KYC Data (Mechanics):</strong> Aadhaar, Driving License, workshop location, and background verification records.</li>
                    </ul>
                </div>

                <!-- Section 2 -->
                <div class="mb-5">
                    <h4 class="text-warning font-weight-bold mb-3">2. How We Use Your Data</h4>
                    <p class="text-muted" style="line-height: 1.8;">
                        Your data is strictly used to fulfill breakdown requests, improve response ETAs, and ensure financial protection:
                    </p>
                    <ul class="text-muted" style="line-height: 1.8;">
                        <li>Calculating accurate upfront pricing via our weighted 4-layer pricing engine.</li>
                        <li>Matching and dispatching the nearest KYC-verified partner mechanic to your breakdown spot.</li>
                        <li>Facilitating secure Escrow payment authorization and digital invoices.</li>
                        <li>Sending real-time SMS/WhatsApp job updates and emergency SOS tracking links to chosen contacts.</li>
                    </ul>
                </div>

                <!-- Section 3 -->
                <div class="mb-5">
                    <h4 class="text-warning font-weight-bold mb-3">3. Location Privacy &amp; Live Tracking</h4>
                    <p class="text-muted" style="line-height: 1.8;">
                        Location access is requested <strong>only when initiating an emergency booking</strong>. Your live location is shared exclusively with your assigned mechanic during active dispatch and automatically terminated once the job is marked completed. We never sell or share location history with third-party advertisers.
                    </p>
                </div>

                <!-- Section 4 -->
                <div class="mb-5">
                    <h4 class="text-warning font-weight-bold mb-3">4. Escrow &amp; Payment Security</h4>
                    <p class="text-muted" style="line-height: 1.8;">
                        All digital transactions on RaahSathi are processed through RBI-compliant, PCI-DSS Level 1 encrypted payment gateways. Payment details (UPI IDs, card numbers) are never stored on our servers. Funds remain protected in Escrow until job verification.
                    </p>
                </div>

                <!-- Section 5 -->
                <div class="mb-4">
                    <h4 class="text-warning font-weight-bold mb-3">5. Contact Data Protection Officer</h4>
                    <p class="text-muted" style="line-height: 1.8;">
                        If you have questions regarding data privacy or wish to request data deletion, contact our Data Protection Desk at <a href="mailto:privacy@raahsathi.in" class="text-warning text-decoration-none">privacy@raahsathi.in</a> or call our 24×7 hotline at <strong>1800-102-7224</strong>.
                    </p>
                </div>

                <div class="pt-4 border-top border-secondary border-opacity-30 text-center">
                    <a href="/Home/ContactUs" class="btn btn-premium-primary px-4 py-2 me-2"><i class="fa-solid fa-headset me-2"></i> Contact Privacy Desk</a>
                    <a href="/Home/Faq" class="btn btn-outline-secondary px-4 py-2"><i class="fa-solid fa-circle-question me-2"></i> Read FAQs</a>
                </div>
            </div>
        </div>
    </div>
</div>
