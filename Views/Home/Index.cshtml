<style>
    .v-box {
        background: #1e293b;
        transition: all 0.2s ease;
    }
    .v-box:hover {
        background: #334155;
    }
    .active-v-box {
        border-color: #ff6b00 !important;
        background: rgba(255, 107, 0, 0.12) !important;
        box-shadow: 0 0 10px rgba(255, 107, 0, 0.3);
    }
</style>

<script>
    let selectedCategory = 'Car';
    const pricingData = {
        "Car": { base: @carRule.BaseFee, rate: @carRule.PerKmRate },
        "2-Wheeler": { base: @bikeRule.BaseFee, rate: @bikeRule.PerKmRate },
        "Commercial": { base: @commRule.BaseFee, rate: @commRule.PerKmRate },
        "Heavy": { base: @heavyRule.BaseFee, rate: @heavyRule.PerKmRate }
    };

    function selectVehicleCategory(cat) {
        selectedCategory = cat;
        document.querySelectorAll('.v-box').forEach(el => el.classList.remove('active-v-box'));
        const activeBox = document.getElementById('vBox-' + cat);
        if (activeBox) {
            activeBox.classList.add('active-v-box');
        }
        updateEstPrice();
    }

    function updateEstPrice() {
        const dist = parseFloat(document.getElementById('calcDistance').value) || 0;
        const problemVal = document.getElementById('calcProblem').value || "150-3500";
        const parts = problemVal.split('-');
        const minFix = parseFloat(parts[0]) || 0;
        const maxFix = parseFloat(parts[1]) || 0;

        const data = pricingData[selectedCategory] || pricingData["Car"];

        const baseVal = data.base;
        const distVal = dist * data.rate;
        const visitingCharge = baseVal + distVal;

        const minTotal = Math.round(visitingCharge + minFix);
        const maxTotal = Math.round(visitingCharge + maxFix);

        document.getElementById('calcDistKmDisplay').innerText = dist + ' km';
        document.getElementById('calcVisitingCharge').innerText = '₹' + visitingCharge.toFixed(2);
        document.getElementById('calcServiceFixRange').innerText = '₹' + minFix + ' - ₹' + maxFix;
        document.getElementById('calcTotalUpfrontRange').innerText = '₹' + minTotal + ' - ₹' + maxTotal;
    }

    document.addEventListener('DOMContentLoaded', function() {
        updateEstPrice();
    });
</script>



