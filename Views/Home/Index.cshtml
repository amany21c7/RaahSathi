            <div class="d-flex flex-row gap-3 mb-5">
                <a href="/Customer/Book" class="btn btn-premium-primary btn-lg">
                    <i class="fa-solid fa-car-burst me-2"></i> Get Help Now
                </a>
                <a href="/Auth/Login?role=Mechanic" class="btn btn-premium-secondary btn-lg">
                    <i class="fa-solid fa-wrench me-2"></i> Join as Partner Mechanic
                </a>
            </div>

            <div class="row text-white text-opacity-80">
                <div class="col-4">
                    <h3 class="font-weight-extrabold text-warning mb-0" style="font-family: 'Inter', sans-serif;">25 Mins</h3>
                    <span class="text-muted" style="font-size: 0.85rem;">Avg. Dispatch ETA</span>
                </div>
                <div class="col-4">
                    <h3 class="font-weight-extrabold text-warning mb-0" style="font-family: 'Inter', sans-serif;">100%</h3>
                    <span class="text-muted" style="font-size: 0.85rem;">KYC Verified Partners</span>
                </div>
                <div class="col-4">
                    <h3 class="font-weight-extrabold text-warning mb-0" style="font-family: 'Inter', sans-serif;">Upfront</h3>
                    <span class="text-muted" style="font-size: 0.85rem;">Zero Verbal Negotiation</span>
                </div>
            </div>
        </div>

        <!-- Hero Right: Upfront Cost Estimator Grid -->
        <div class="col-lg-6">
            <div class="p-4 rounded-4 text-start border border-secondary border-opacity-30 shadow-lg" style="background: #0f172a;">
                <!-- Header -->
                <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
                    <h4 class="text-white font-weight-bold mb-0" style="font-family: 'Inter', sans-serif;">
                        <i class="fa-solid fa-calculator text-warning me-2"></i> Upfront Cost Estimator
                    </h4>
                    <div class="text-end">
                        <span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-30 px-3 py-1 font-weight-bold" style="font-size: 0.82rem; letter-spacing: 0.3px;">
                            <i class="fa-solid fa-circle-info me-1"></i> Approximate Charges
                        </span>
                        <div class="text-muted small mt-1" style="font-size: 0.73rem; opacity: 0.85;">Based on average market rates.</div>
                    </div>
                </div>

                <!-- 1. Select Vehicle Category 6-Box Grid -->
                <label class="form-label text-muted small font-weight-bold mb-2">1. Select Vehicle Category</label>
                <div class="row g-2 mb-4">
                    <!-- Car Box (Default Selected) -->
                    <div class="col-4">
                        <div id="vBox-Car" class="v-box p-2.5 rounded-3 text-center cursor-pointer border active-v-box" onclick="selectVehicleCategory('Car')">
                            <i class="fa-solid fa-car text-warning fa-lg mb-1.5"></i>
                            <div class="text-white font-weight-bold small">Car / SUV</div>
                            <div class="text-muted" style="font-size: 0.72rem;">₹@carRule.BaseFee + ₹@carRule.PerKmRate/km</div>
                        </div>
                    </div>

                    <!-- 2-Wheeler Box -->
                    <div class="col-4">
                        <div id="vBox-2-Wheeler" class="v-box p-2.5 rounded-3 text-center cursor-pointer border border-secondary border-opacity-30" onclick="selectVehicleCategory('2-Wheeler')">
                            <i class="fa-solid fa-motorcycle text-warning fa-lg mb-1.5"></i>
                            <div class="text-white font-weight-bold small">2-Wheeler</div>
                            <div class="text-muted" style="font-size: 0.72rem;">₹@bikeRule.BaseFee + ₹@bikeRule.PerKmRate/km</div>
                        </div>
                    </div>

                    <!-- E-Rickshaw Box (NEW EV) -->
                    <div class="col-4">
                        <div id="vBox-E-Rickshaw" class="v-box p-2.5 rounded-3 text-center cursor-pointer border border-secondary border-opacity-30 position-relative" onclick="selectVehicleCategory('E-Rickshaw')">
                            <span class="badge bg-success text-white position-absolute top-0 end-0 m-1" style="font-size: 0.6rem;">EV</span>
                            <i class="fa-solid fa-bolt-lightning text-success fa-lg mb-1.5"></i>
                            <div class="text-white font-weight-bold small">E-Rickshaw</div>
                            <div class="text-muted" style="font-size: 0.72rem;">₹@erickRule.BaseFee + ₹@erickRule.PerKmRate/km</div>
                        </div>
                    </div>

                    <!-- Auto-Rickshaw Box (NEW) -->
                    <div class="col-4">
                        <div id="vBox-Auto-Rickshaw" class="v-box p-2.5 rounded-3 text-center cursor-pointer border border-secondary border-opacity-30" onclick="selectVehicleCategory('Auto-Rickshaw')">
                            <div class="mb-1.5" style="font-size: 1.4rem; line-height: 1.2;">🛺</div>
                            <div class="text-white font-weight-bold small">Auto-Rickshaw</div>
                            <div class="text-muted" style="font-size: 0.72rem;">₹@autoRule.BaseFee + ₹@autoRule.PerKmRate/km</div>
                        </div>
                    </div>

                    <!-- Commercial Box -->
                    <div class="col-4">
                        <div id="vBox-Commercial" class="v-box p-2.5 rounded-3 text-center cursor-pointer border border-secondary border-opacity-30" onclick="selectVehicleCategory('Commercial')">
                            <i class="fa-solid fa-truck text-warning fa-lg mb-1.5"></i>
                            <div class="text-white font-weight-bold small">Commercial</div>
                            <div class="text-muted" style="font-size: 0.72rem;">₹@commRule.BaseFee + ₹@commRule.PerKmRate/km</div>
                        </div>
                    </div>

                    <!-- Heavy Box -->
                    <div class="col-4">
                        <div id="vBox-Heavy" class="v-box p-2.5 rounded-3 text-center cursor-pointer border border-secondary border-opacity-30" onclick="selectVehicleCategory('Heavy')">
                            <i class="fa-solid fa-tractor text-warning fa-lg mb-1.5"></i>
                            <div class="text-white font-weight-bold small">Heavy / JCB</div>
                            <div class="text-muted" style="font-size: 0.72rem;">₹@heavyRule.BaseFee + ₹@heavyRule.PerKmRate/km</div>
                        </div>
                    </div>
                </div>

                <!-- 2. Estimated Distance Slider (Max 30 KM) -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between text-muted small mb-2">
                        <span class="font-weight-bold">2. Estimated Distance (to Mechanic)</span>
                        <span class="text-warning font-weight-bold" id="calcDistKmDisplay">5 km</span>
                    </div>
                    <input type="range" class="form-range" id="calcDistance" min="1" max="30" value="5" oninput="updateEstPrice()">
                </div>

                <!-- 3. Select Problem Type Dropdown -->
                <div class="mb-4">
                    <label class="form-label text-muted small font-weight-bold mb-2">3. Select Problem Type</label>
                    <select id="calcProblem" class="form-select bg-dark text-white border-secondary" onchange="updateEstPrice()">
                        @if (problemTypes != null && problemTypes.Any())
                        {
                            foreach (var pt in problemTypes)
                            {
                                <option value="@pt.MinServiceCharge-@pt.MaxServiceCharge" data-category="@pt.VehicleCategory">@pt.ProblemName (₹@pt.MinServiceCharge - ₹@pt.MaxServiceCharge)</option>
                            }
                        }
                        else
                        {
                            <option value="150-3500" data-category="Car">Battery jump-start/replacement (₹150 - ₹3,500)</option>
                            <option value="200-800" data-category="Car">Flat Tyre / Puncture Repair (₹200 - ₹800)</option>
                            <option value="250-1200" data-category="Car">Emergency Fuel Delivery (₹250 - ₹1,200)</option>
