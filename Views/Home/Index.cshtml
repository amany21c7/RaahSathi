<script>
    let selectedCategory = 'Car';
    let modalSelectedCategory = 'Car';
    const pricingData = {
        "Car": { base: @carRule.BaseFee, rate: @carRule.PerKmRate },
        "2-Wheeler": { base: @bikeRule.BaseFee, rate: @bikeRule.PerKmRate },
        "E-Rickshaw": { base: @erickRule.BaseFee, rate: @erickRule.PerKmRate },
        "Auto-Rickshaw": { base: @autoRule.BaseFee, rate: @autoRule.PerKmRate },
        "Commercial": { base: @commRule.BaseFee, rate: @commRule.PerKmRate },
        "Heavy": { base: @heavyRule.BaseFee, rate: @heavyRule.PerKmRate }
    };

    function filterProblemDropdown(cat) {
        const select = document.getElementById('calcProblem');
        if (!select) return;
        let hasSelected = false;
        Array.from(select.options).forEach(opt => {
            const optCat = opt.getAttribute('data-category');
            if (!optCat || optCat === cat || optCat === 'All' || (cat === '2-Wheeler' && (optCat === 'Bike' || optCat === '2-Wheeler'))) {
                opt.style.display = '';
                if (!hasSelected) {
                    opt.selected = true;
                    hasSelected = true;
                }
            } else {
                opt.style.display = 'none';
            }
        });
    }

    function filterModalProblemDropdown(cat) {
        const select = document.getElementById('modalCalcProblem');
        if (!select) return;
        let hasSelected = false;
        Array.from(select.options).forEach(opt => {
            const optCat = opt.getAttribute('data-category');
            if (!optCat || optCat === cat || optCat === 'All' || (cat === '2-Wheeler' && (optCat === 'Bike' || optCat === '2-Wheeler'))) {
                opt.style.display = '';
                if (!hasSelected) {
                    opt.selected = true;
                    hasSelected = true;
                }
            } else {
                opt.style.display = 'none';
            }
        });
    }

    function selectVehicleCategory(cat) {
        selectedCategory = cat;
        document.querySelectorAll('.v-box').forEach(el => el.classList.remove('active-v-box'));
        const activeBox = document.getElementById('vBox-' + cat);
        if (activeBox) {
            activeBox.classList.add('active-v-box');
        }
        filterProblemDropdown(cat);
        updateEstPrice();
    }

    function selectModalVehicle(cat) {
        modalSelectedCategory = cat;
        document.querySelectorAll('.mob-v-btn').forEach(el => {
            el.classList.remove('btn-outline-warning', 'active');
            el.classList.add('btn-outline-secondary');
        });
        const btn = document.querySelector(`.mob-v-btn[data-v="${cat}"]`);
        if (btn) {
            btn.classList.remove('btn-outline-secondary');
            btn.classList.add('btn-outline-warning', 'active');
        }
        filterModalProblemDropdown(cat);
        updateModalEstPrice();
    }

    function updateEstPrice() {
        const distEl = document.getElementById('calcDistance');
        const probEl = document.getElementById('calcProblem');
        if (!distEl || !probEl) return;

        const dist = parseFloat(distEl.value) || 0;
        const problemVal = probEl.value || "150-3500";
        const parts = problemVal.split('-');
        const minFix = parseFloat(parts[0]) || 0;
        const maxFix = parseFloat(parts[1]) || 0;

        const data = pricingData[selectedCategory] || pricingData["Car"];

        const baseVal = data.base;
        const distVal = (dist * 2) * data.rate;
        const visitingCharge = baseVal + distVal;

        const minTotal = Math.round(visitingCharge + minFix);
        const maxTotal = Math.round(visitingCharge + maxFix);

        const distDisplay = document.getElementById('calcDistKmDisplay');
        const visitDisplay = document.getElementById('calcVisitingCharge');
        const servDisplay = document.getElementById('calcServiceFixRange');
        const totalDisplay = document.getElementById('calcTotalUpfrontRange');

        if (distDisplay) distDisplay.innerText = dist + ' km';
        if (visitDisplay) visitDisplay.innerText = '₹' + visitingCharge.toFixed(2);
        if (servDisplay) servDisplay.innerText = '₹' + minFix + ' - ₹' + maxFix;
        if (totalDisplay) totalDisplay.innerText = '₹' + minTotal + ' - ₹' + maxTotal;
    }

    function updateModalEstPrice() {
        const distEl = document.getElementById('modalCalcDistance');
        const probEl = document.getElementById('modalCalcProblem');
        if (!distEl || !probEl) return;

        const dist = parseFloat(distEl.value) || 0;
        const problemVal = probEl.value || "150-3500";
        const parts = problemVal.split('-');
        const minFix = parseFloat(parts[0]) || 0;
        const maxFix = parseFloat(parts[1]) || 0;

        const data = pricingData[modalSelectedCategory] || pricingData["Car"];

        const baseVal = data.base;
        const distVal = (dist * 2) * data.rate;
        const visitingCharge = baseVal + distVal;

        const minTotal = Math.round(visitingCharge + minFix);
        const maxTotal = Math.round(visitingCharge + maxFix);

        const distDisplay = document.getElementById('modalCalcDistDisplay');
        const visitDisplay = document.getElementById('modalCalcVisiting');
        const servDisplay = document.getElementById('modalCalcService');
        const totalDisplay = document.getElementById('modalCalcTotal');

        if (distDisplay) distDisplay.innerText = dist + ' km';
        if (visitDisplay) visitDisplay.innerText = '₹' + visitingCharge.toFixed(2);
        if (servDisplay) servDisplay.innerText = '₹' + minFix + ' - ₹' + maxFix;
        if (totalDisplay) totalDisplay.innerText = '₹' + minTotal + ' - ₹' + maxTotal;
    }

    document.addEventListener('DOMContentLoaded', function() {
        filterProblemDropdown('Car');
        updateEstPrice();
        filterModalProblemDropdown('Car');
        updateModalEstPrice();
    });
</script>

