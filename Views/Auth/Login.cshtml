@{
    ViewData["Title"] = "Login / Register";
    string targetRole = ViewBag.TargetRole as string ?? Context.Request.Query["role"].ToString();
}

<div class="row justify-content-center align-items-center min-vh-75 py-3 py-md-5">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="glass-card p-4 p-md-5 mx-2 mx-md-0">
            <div class="text-center mb-4">
                <img src="~/images/header-logo.png?v=8" asp-append-version="true" alt="RaahSathi Logo" style="height: 64px; border-radius: 12px; object-fit: contain; border: 1.5px solid #ff6b00;" class="mb-3 shadow" />
                <h3 class="text-white font-weight-bold" style="font-family: 'Outfit';" id="titleText">Welcome to <span style="color: #ff6b00;">Raah</span><span class="text-white">Sathi</span></h3>
                <p class="text-muted small" id="subtitleText">Login with your credentials or register a new account</p>
            </div>

            <!-- ------------------------------------------------------------- -->
            <!-- PANEL 1: PASSWORD LOGIN -->
            <!-- ------------------------------------------------------------- -->
            <div id="panelLogin">
                <!-- Role Selection -->
                <div class="mb-4 d-flex justify-content-center gap-2">
                    <input type="radio" class="btn-check" name="loginRole" id="loginRoleCustomer" value="Customer" @(targetRole == "Customer" ? "checked" : "") autocomplete="off">
                    <label class="btn btn-outline-warning rounded-pill px-4" for="loginRoleCustomer">
                        <i class="fa-solid fa-car me-1"></i> Customer
                    </label>

                    <input type="radio" class="btn-check" name="loginRole" id="loginRoleMechanic" value="Mechanic" @(targetRole == "Mechanic" ? "checked" : "") autocomplete="off">
                    <label class="btn btn-outline-warning rounded-pill px-4" for="loginRoleMechanic">
                        <i class="fa-solid fa-wrench me-1"></i> Mechanic
                    </label>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">10-Digit Mobile Number</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-muted">+91</span>
                        <input type="tel" class="form-control glass-input text-white" id="loginPhone" placeholder="Enter Mobile Number" maxlength="10" autocomplete="off" value="">
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small">Password</label>
                    <input type="password" class="form-control glass-input text-white" id="loginPassword" placeholder="••••••••" autocomplete="new-password" value="">
                </div>

                <button class="btn btn-premium-primary w-100 py-2.5 font-weight-bold mb-3 shadow" id="btnLoginSubmit">
                    Secure Login <i class="fa-solid fa-unlock ms-1"></i>
                </button>

                <div class="d-flex justify-content-between flex-wrap gap-2">
                    <a href="#" id="lnkShowRegister" class="text-warning small font-weight-bold" style="text-decoration:none;"><i class="fa-solid fa-user-plus me-1"></i> Create Account</a>
                    <a href="#" id="lnkShowForgot" class="text-muted small" style="text-decoration:none;"><i class="fa-solid fa-circle-question me-1"></i> Forgot Password?</a>
                </div>
            </div>


            <!-- ------------------------------------------------------------- -->
            <!-- PANEL 1B: INSTANT LOGIN VIA WHATSAPP OTP -->
            <!-- ------------------------------------------------------------- -->
            <div id="panelOtpLogin" style="display:none;">
                <div class="mb-4 d-flex justify-content-center gap-2">
                    <input type="radio" class="btn-check" name="otpLoginRole" id="otpLoginRoleCustomer" value="Customer" @(targetRole == "Customer" ? "checked" : "") autocomplete="off">
                    <label class="btn btn-outline-warning rounded-pill px-4" for="otpLoginRoleCustomer">
                        <i class="fa-solid fa-car me-1"></i> Customer
                    </label>

                    <input type="radio" class="btn-check" name="otpLoginRole" id="otpLoginRoleMechanic" value="Mechanic" @(targetRole == "Mechanic" ? "checked" : "") autocomplete="off">
                    <label class="btn btn-outline-warning rounded-pill px-4" for="otpLoginRoleMechanic">
                        <i class="fa-solid fa-wrench me-1"></i> Mechanic
                    </label>
                </div>

                <div id="otpLoginStep1">
                    <div class="mb-3">
                        <label class="form-label text-muted small">10-Digit Mobile Number</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-muted">+91</span>
                            <input type="tel" class="form-control glass-input text-white" id="otpLoginPhone" placeholder="Enter Mobile Number" maxlength="10">
                        </div>
                    </div>
                    <button class="btn btn-success w-100 py-2.5 font-weight-bold mb-3 shadow d-flex align-items-center justify-content-center gap-2" id="btnSendLoginOtp">
                        <i class="fa-brands fa-whatsapp fs-5"></i> Send WhatsApp Login OTP
                    </button>
                </div>

                <div id="otpLoginStep2" style="display:none;">
                    <div class="text-center mb-3">
                        <!-- WhatsApp OTP message indicator -->
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Enter 6-Digit WhatsApp OTP</label>
                        <input type="text" class="form-control glass-input text-white text-center font-monospace font-weight-bold" id="otpLoginCode" placeholder="••••••" maxlength="6" style="letter-spacing: 12px; font-size: 1.5rem;" autocomplete="one-time-code">
                    </div>
                    <button class="btn btn-success w-100 py-2.5 font-weight-bold mb-3 shadow" id="btnVerifyLoginOtp">
                        Verify OTP &amp; Login <i class="fa-solid fa-arrow-right ms-1"></i>
                    </button>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <a href="#" id="btnBackToOtpStep1" class="text-warning small font-weight-bold" style="text-decoration:none;"><i class="fa-solid fa-arrow-left me-1"></i> Change Number</a>
                        <button type="button" id="btnResendLoginOtp" class="btn btn-link text-decoration-none text-muted small p-0" disabled>
                            Resend in <span id="timerLoginOtp">60</span>s
                        </button>
                    </div>
                </div>

                <div class="text-center">
                    <a href="#" class="btnBackToLogin text-warning small font-weight-bold" style="text-decoration:none;"><i class="fa-solid fa-arrow-left me-1"></i> Back to Password Login</a>
                </div>
            </div>

            <!-- ------------------------------------------------------------- -->
            <!-- PANEL 2: REGISTRATION DETAILS -->
            <!-- ------------------------------------------------------------- -->
            <div id="panelRegisterDetails" style="display:none;">
                <!-- Role Selection -->
                <div class="mb-3 d-flex justify-content-center gap-2">
                    <input type="radio" class="btn-check" name="registerRole" id="registerRoleCustomer" value="Customer" @(targetRole == "Customer" ? "checked" : "") autocomplete="off">
                    <label class="btn btn-outline-warning rounded-pill px-4" for="registerRoleCustomer">
                        <i class="fa-solid fa-car me-1"></i> Customer
                    </label>

                    <input type="radio" class="btn-check" name="registerRole" id="registerRoleMechanic" value="Mechanic" @(targetRole == "Mechanic" ? "checked" : "") autocomplete="off">
                    <label class="btn btn-outline-warning rounded-pill px-4" for="registerRoleMechanic">
                        <i class="fa-solid fa-wrench me-1"></i> Mechanic
                    </label>
                </div>

                <!-- Green WhatsApp OTP Alert Banner (Initially Hidden) -->
                <div id="regOtpSentBanner" class="text-center mb-3" style="display:none;">
                    <span class="badge bg-success bg-opacity-25 text-success border border-success rounded-pill px-3 py-2 w-100 shadow-sm">
                        <i class="fa-brands fa-whatsapp fs-5 me-1 text-success align-middle"></i> OTP sent to WhatsApp: <span id="lblSentRegisterPhone" class="fw-bold"></span>
                    </span>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">Full Name</label>
                    <input type="text" class="form-control glass-input text-white" id="registerName" placeholder="">
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">10-Digit Mobile Number</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-muted">+91</span>
                        <input type="tel" class="form-control glass-input text-white" id="registerPhone" placeholder="" maxlength="10">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small">Referral Code <span class="text-warning">(Optional - Get Joining Bonus)</span></label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-dark border-secondary text-warning"><i class="fa-solid fa-gift"></i></span>
                        <input type="text" class="form-control glass-input text-white font-monospace text-uppercase" id="registerReferralCode" value="@(ViewBag.ReferralCode ?? "")" placeholder="" style="height: 38px; font-size: 0.9rem;">
                    </div>
                </div>

                <!-- Inline OTP Field (Shown after clicking Get OTP Verification) -->
                <div id="regOtpGroup" class="mb-3" style="display:none;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label text-muted small mb-0">Enter 6-Digit WhatsApp OTP</label>
                        <button type="button" id="btnResendRegisterOtp" class="btn btn-link text-decoration-none text-muted small p-0" disabled>
                            Resend in <span id="timerRegisterOtp">60</span>s
                        </button>
                    </div>
                    <input type="text" class="form-control glass-input text-white text-center font-monospace font-weight-bold" id="registerOtpCode" placeholder="••••••" maxlength="6" style="letter-spacing: 12px; font-size: 1.3rem;" autocomplete="one-time-code">
                </div>

                <button class="btn btn-premium-primary w-100 py-2 font-weight-bold mb-3 d-flex align-items-center justify-content-center gap-2" id="btnRegisterAction">
                    <i class="fa-solid fa-shield-halved me-1"></i> <span>Get OTP Verification</span>
                </button>

                <div class="text-center">
                    <a href="#" class="btnBackToLogin text-warning small font-weight-bold" style="text-decoration:none;"><i class="fa-solid fa-arrow-left me-1"></i> Back to Login</a>
                </div>
            </div>

            <!-- ------------------------------------------------------------- -->
            <!-- PANEL 4: REGISTRATION GENERATE PASSWORD -->
            <!-- ------------------------------------------------------------- -->
            <div id="panelRegisterPassword" style="display:none;">
                <div class="alert alert-success border-success bg-dark text-success small py-2 mb-3">
                    <i class="fa-solid fa-circle-check me-1"></i> Mobile number verified! Now set your login password.
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted small">Create Password</label>
                    <input type="password" class="form-control glass-input text-white" id="registerNewPassword" placeholder="••••••••">
                </div>
                <div class="mb-4">
                    <label class="form-label text-muted small">Confirm Password</label>
                    <input type="password" class="form-control glass-input text-white" id="registerConfirmPassword" placeholder="••••••••">
                </div>
                <button class="btn btn-success w-100 py-2 font-weight-bold mb-3" id="btnRegisterComplete">
                    Create Account & Login <i class="fa-solid fa-circle-check ms-1"></i>
                </button>
            </div>

            <!-- ------------------------------------------------------------- -->
            <!-- PANEL 5: FORGOT PASSWORD PHONE -->
            <!-- ------------------------------------------------------------- -->
            <div id="panelForgotPhone" style="display:none;">
                <!-- Role Selection -->
                <div class="mb-4 d-flex justify-content-center gap-2">
                    <input type="radio" class="btn-check" name="forgotRole" id="forgotRoleCustomer" value="Customer" @(targetRole == "Customer" ? "checked" : "") autocomplete="off">
                    <label class="btn btn-outline-warning rounded-pill px-4" for="forgotRoleCustomer">
                        <i class="fa-solid fa-car me-1"></i> Customer
                    </label>

                    <input type="radio" class="btn-check" name="forgotRole" id="forgotRoleMechanic" value="Mechanic" @(targetRole == "Mechanic" ? "checked" : "") autocomplete="off">
                    <label class="btn btn-outline-warning rounded-pill px-4" for="forgotRoleMechanic">
                        <i class="fa-solid fa-wrench me-1"></i> Mechanic
                    </label>
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted small">10-Digit Mobile Number</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-muted">+91</span>
                        <input type="tel" class="form-control glass-input text-white" id="forgotPhone" placeholder="" maxlength="10">
                    </div>
                </div>

                <button class="btn btn-premium-primary w-100 py-2 font-weight-bold mb-3 d-flex align-items-center justify-content-center gap-2" id="btnForgotSendOtp">
                    <i class="fa-brands fa-whatsapp fs-5 text-success"></i> Send WhatsApp Reset OTP
                </button>

                <div class="position-relative my-3 text-center">
                    <hr class="border-secondary opacity-25">
                    <span class="position-absolute top-50 start-50 translate-middle bg-dark px-2 text-muted text-xs">OR</span>
                </div>

                <button type="button" class="btn btn-outline-success w-100 py-2 font-weight-bold mb-3 d-flex align-items-center justify-content-center gap-2" id="btnShowOtpLogin">
                    <i class="fa-brands fa-whatsapp fs-5 text-success"></i> Instant Login with WhatsApp OTP
                </button>

                <div class="text-center">
                    <a href="#" class="btnBackToLogin text-warning small font-weight-bold" style="text-decoration:none;"><i class="fa-solid fa-arrow-left me-1"></i> Back to Login</a>
                </div>
            </div>


            <!-- ------------------------------------------------------------- -->
            <!-- PANEL 6: FORGOT PASSWORD OTP -->
            <!-- ------------------------------------------------------------- -->
            <div id="panelForgotOtp" style="display:none;">
                <div class="text-center mb-3">
                    <span class="badge bg-success bg-opacity-25 text-success border border-success rounded-pill px-3 py-2">
                        <i class="fa-brands fa-whatsapp fs-5 me-1 text-success align-middle"></i> OTP sent to WhatsApp: <span id="lblSentForgotPhone"></span>
                    </span>
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted small">Enter 6-Digit WhatsApp OTP</label>
                    <input type="text" class="form-control glass-input text-white text-center font-monospace font-weight-bold" id="forgotOtpCode" placeholder="••••••" maxlength="6" style="letter-spacing: 12px; font-size: 1.5rem;" autocomplete="one-time-code">
                </div>
                <button class="btn btn-premium-primary w-100 py-2 font-weight-bold mb-3" id="btnForgotVerifyOtp">
                    Verify WhatsApp OTP <i class="fa-solid fa-arrow-right ms-1"></i>
                </button>
                <div class="d-flex justify-content-between align-items-center">
                    <a href="#" id="btnBackToForgotPhone" class="text-warning small font-weight-bold" style="text-decoration:none;"><i class="fa-solid fa-arrow-left me-1"></i> Back</a>
                    <button type="button" id="btnResendForgotOtp" class="btn btn-link text-decoration-none text-muted small p-0" disabled>
                        Resend in <span id="timerForgotOtp">60</span>s
                    </button>
                </div>
            </div>

            <!-- ------------------------------------------------------------- -->
            <!-- PANEL 7: FORGOT PASSWORD RESET -->
            <!-- ------------------------------------------------------------- -->
            <div id="panelForgotReset" style="display:none;">
                <div class="alert alert-success border-success bg-dark text-success small py-2 mb-3">
                    <i class="fa-solid fa-circle-check me-1"></i> Identity verified! Set your new login password.
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted small">New Password</label>
                    <input type="password" class="form-control glass-input text-white" id="forgotNewPassword" placeholder="••••••••">
                </div>
                <div class="mb-4">
                    <label class="form-label text-muted small">Confirm New Password</label>
                    <input type="password" class="form-control glass-input text-white" id="forgotConfirmPassword" placeholder="••••••••">
                </div>
                <button class="btn btn-success w-100 py-2 font-weight-bold mb-3" id="btnForgotComplete">
                    Reset Password & Login <i class="fa-solid fa-circle-check ms-1"></i>
                </button>
            </div>

        </div>
    </div>
</div>

<!-- Only for Admin Modal Popup -->
<div class="modal fade" id="adminLoginModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-warning border-opacity-40" style="border-radius: 16px;">
            <div class="modal-header border-secondary py-3">
                <h5 class="modal-title font-weight-bold text-warning d-flex align-items-center" id="adminModalHeaderTitle">
                    <i class="fa-solid fa-shield-halved me-2 fs-4"></i> Only for Admin
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-danger d-none py-2 px-3 small mb-3" id="adminModalError"></div>

                <!-- 1. ADMIN LOGIN PANEL -->
                <div id="adminPanelLogin">
                    <div class="text-center mb-4">
                        <span class="badge bg-warning text-dark px-3 py-1 font-weight-bold rounded-pill mb-2">RESTRICTED ACCESS</span>
                        <p class="text-muted small mb-0">Enter your Administrator mobile number & password to access the system console.</p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small font-weight-bold">Admin Mobile Number / ID</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-muted">+91</span>
                            <input type="tel" class="form-control glass-input text-white font-weight-bold" id="adminPhoneInput" placeholder="Enter Mobile Number" maxlength="10">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small font-weight-bold">Admin Password</label>
                        <input type="password" class="form-control glass-input text-white" id="adminPasswordInput" placeholder="••••••••">
                    </div>

                    <button type="button" class="btn btn-warning w-100 py-2.5 font-weight-bold text-dark mb-3" id="btnAdminModalLogin" style="border-radius: 25px;">
                        <i class="fa-solid fa-unlock me-1"></i> Admin Login
                    </button>

                    <div class="text-center">
                        <a href="#" id="btnShowAdminForgot" class="text-warning small font-weight-bold" style="text-decoration:none;">
                            <i class="fa-solid fa-key me-1"></i> Forgot Admin Password?
                        </a>
                    </div>
                </div>

                <!-- 2. ADMIN FORGOT PASSWORD - PHONE & OTP -->
                <div id="adminPanelForgotPhone" style="display:none;">
                    <div class="text-center mb-4">
                        <span class="badge bg-info text-dark px-3 py-1 font-weight-bold rounded-pill mb-2">SECURITY RESET</span>
                        <p class="text-muted small mb-0">Enter your registered Admin mobile number to receive verification OTP.</p>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small font-weight-bold">Registered Admin Mobile Number</label>
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary text-muted">+91</span>
                            <input type="tel" class="form-control glass-input text-white font-weight-bold" id="adminForgotPhoneInput" placeholder="9876543210" maxlength="10">
                        </div>
                    </div>

                    <button type="button" class="btn btn-warning w-100 py-2.5 font-weight-bold text-dark mb-3" id="btnAdminSendForgotOtp" style="border-radius: 25px;">
                        Send Reset OTP <i class="fa-solid fa-arrow-right ms-1"></i>
                    </button>

                    <div class="text-center">
                        <a href="#" class="btnBackToAdminLogin text-warning small font-weight-bold" style="text-decoration:none;">
                            <i class="fa-solid fa-arrow-left me-1"></i> Back to Admin Login
                        </a>
                    </div>
                </div>

                <!-- 3. ADMIN FORGOT PASSWORD - VERIFY & RESET -->
                <div id="adminPanelForgotReset" style="display:none;">
                    <div class="text-center mb-3">
                        <span class="badge bg-success bg-opacity-25 text-success border border-success rounded-pill px-3 py-1 small">
                            <i class="fa-solid fa-check-circle me-1"></i> OTP Sent to <span id="lblSentAdminPhone"></span>
                        </span>
                        <div id="devOtpBannerAdminForgot" class="alert alert-warning py-2 px-3 mt-2 small d-none font-monospace border-warning"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small font-weight-bold">Enter 6-Digit OTP</label>
                        <input type="text" class="form-control glass-input text-white text-center font-monospace font-weight-bold" id="adminForgotOtpCode" placeholder="••••••" maxlength="6" style="letter-spacing: 12px; font-size: 1.4rem;" autocomplete="one-time-code">
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small font-weight-bold">Create New Password</label>
                        <input type="password" class="form-control glass-input text-white" id="adminForgotNewPassword" placeholder="••••••••">
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small font-weight-bold">Confirm New Password</label>
                        <input type="password" class="form-control glass-input text-white" id="adminForgotConfirmPassword" placeholder="••••••••">
                    </div>

                    <button type="button" class="btn btn-success w-100 py-2.5 font-weight-bold text-white mb-3" id="btnAdminCompleteReset" style="border-radius: 25px;">
                        Reset Password & Login <i class="fa-solid fa-circle-check ms-1"></i>
                    </button>

                    <div class="text-center">
                        <a href="#" class="btnBackToAdminLogin text-warning small font-weight-bold" style="text-decoration:none;">
                            <i class="fa-solid fa-arrow-left me-1"></i> Back to Admin Login
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
$(document).ready(function() {
    // Clear all credentials inputs on load to ensure clean fresh state after logout
    function clearLoginInputs() {
        $('#loginPhone').val('');
        $('#loginPassword').val('');
        $('#adminPhoneInput').val('');
        $('#adminPasswordInput').val('');
        $('#registerPhone').val('');
        $('#registerName').val('');
        $('#registerNewPassword').val('');
        $('#registerConfirmPassword').val('');
        $('#forgotPhoneNum').val('');
    }

    clearLoginInputs();
    setTimeout(clearLoginInputs, 150);
    setTimeout(clearLoginInputs, 500);

    // Sync initial targetRole on load
    var initialRole = "@targetRole" || "Customer";
    if (initialRole !== "Admin") {
        $('input[name="loginRole"][value="' + initialRole + '"]').prop('checked', true);
        $('input[name="registerRole"][value="' + initialRole + '"]').prop('checked', true);
        $('input[name="forgotRole"][value="' + initialRole + '"]').prop('checked', true);
    }

    var passedRefCode = "@(ViewBag.ReferralCode ?? "")";
    if (passedRefCode && passedRefCode.length > 0) {
        showPanel('panelRegisterDetails', 'Register Account', 'fa-gift', 'Joining with Referral Code: ' + passedRefCode);
    }

    // Dynamic role sync on user selection change
    $('input[name="loginRole"], input[name="registerRole"], input[name="forgotRole"]').change(function() {
        var val = $(this).val();
        if (val !== "Admin") {
            $('input[name="loginRole"][value="' + val + '"]').prop('checked', true);
            $('input[name="registerRole"][value="' + val + '"]').prop('checked', true);
            $('input[name="forgotRole"][value="' + val + '"]').prop('checked', true);
        }
        clearLoginInputs();
    });

    // Open Only for Admin Modal Popup
    function openAdminModal() {
        var modalEl = document.getElementById('adminLoginModal');
        if (modalEl) {
            showAdminModalPanel('adminPanelLogin', 'Only for Admin');
            var adminModal = new bootstrap.Modal(modalEl);
            adminModal.show();
        }
    }

    // Admin Modal Panel Switcher
    function showAdminModalPanel(panelId, title) {
        $('#adminPanelLogin, #adminPanelForgotPhone, #adminPanelForgotReset').hide();
        $('#' + panelId).show();
        $('#adminModalError').addClass('d-none');
        if (title) {
            $('#adminModalHeaderTitle').html('<i class="fa-solid fa-shield-halved me-2 fs-4"></i> ' + title);
        }
    }

    $('#btnShowAdminForgot').click(function(e) {
        e.preventDefault();
        showAdminModalPanel('adminPanelForgotPhone', 'Reset Admin Password');
    });

    $('.btnBackToAdminLogin').click(function(e) {
        e.preventDefault();
        showAdminModalPanel('adminPanelLogin', 'Only for Admin');
    });

    $('#loginRoleAdmin, #adminBackdoor').click(function(e) {
        e.preventDefault();
        openAdminModal();
    });

    // Auto open modal if user requested Admin portal (/Auth/Login?role=admin, /AdminRaahiSathiLogin, etc.)
    var reqRole = ("@(targetRole ?? "")").toLowerCase();
    var urlParams = new URLSearchParams(window.location.search);
    var qRole = (urlParams.get('role') || '').toLowerCase();
    var path = window.location.pathname.toLowerCase();

    if (reqRole === "admin" || qRole === "admin" || path.indexOf("admin") !== -1) {
        setTimeout(function() {
            openAdminModal();
        }, 150);
    }

    $('#btnAdminModalLogin').click(function() {
        var phone = $('#adminPhoneInput').val().trim();
        var password = $('#adminPasswordInput').val().trim();
        
        if (phone.length < 10) {
            alert('⚠️ Please enter a valid 10-digit Admin mobile number / ID.');
            $('#adminModalError').removeClass('d-none').text('Please enter a valid 10-digit Admin mobile number / ID.');
            return;
        }
        if (!password) {
            alert('⚠️ Please enter your Admin password.');
            $('#adminModalError').removeClass('d-none').text('Please enter your Admin password.');
            return;
        }

        $('#adminModalError').addClass('d-none');
        $(this).html('<i class="fa-solid fa-circle-notch fa-spin"></i> Authenticating...').prop('disabled', true);

        $.post('/Auth/PasswordLogin', { phoneNumber: phone, password: password, role: 'Admin' }, function(res) {
            if (res.success) {
                window.location.href = res.redirect;
            } else {
                alert('⚠️ Admin login failed: ' + res.message);
                $('#adminModalError').removeClass('d-none').text(res.message);
                $('#btnAdminModalLogin').html('<i class="fa-solid fa-unlock me-1"></i> Admin Login').prop('disabled', false);
            }
        });
    });

    // Admin Forgot Password - Send OTP
    var adminForgotPhone = "";

    $('#btnAdminSendForgotOtp').click(function() {
        adminForgotPhone = $('#adminForgotPhoneInput').val().trim();
        if (adminForgotPhone.length < 10) {
            alert('⚠️ Please enter a valid 10-digit Admin mobile number.');
            $('#adminModalError').removeClass('d-none').text('Please enter a valid 10-digit Admin mobile number.');
            return;
        }

        $('#adminModalError').addClass('d-none');
        $(this).html('<i class="fa-solid fa-circle-notch fa-spin"></i> Sending OTP...').prop('disabled', true);

        $.post('/Auth/SendOtpForForgotPassword', { phoneNumber: adminForgotPhone, role: 'Admin' }, function(res) {
            $('#btnAdminSendForgotOtp').html('Send Reset OTP <i class="fa-solid fa-arrow-right ms-1"></i>').prop('disabled', false);
            if (res.success) {
                $('#lblSentAdminPhone').text('+91 ' + adminForgotPhone);
                if (res.devOtp) {
                    $('#devOtpBannerAdminForgot').removeClass('d-none').html('⚠️ <b>Admin Emergency Recovery OTP:</b> ' + res.devOtp + ' <small class="d-block text-muted">WhatsApp gateway is offline. Use this recovery OTP to reset your password.</small>');
                } else {
                    $('#devOtpBannerAdminForgot').addClass('d-none');
                }
                showAdminModalPanel('adminPanelForgotReset', 'Admin OTP Verification');
                $('#adminForgotOtpCode').val('').focus();
            } else {
                alert('⚠️ ' + res.message);
                $('#adminModalError').removeClass('d-none').text(res.message);
            }
        });
    });

    // Admin Forgot Password - Complete Reset
    $('#btnAdminCompleteReset').click(function() {
        var otp = $('#adminForgotOtpCode').val().trim();
        var password = $('#adminForgotNewPassword').val().trim();
        var confirm = $('#adminForgotConfirmPassword').val().trim();

        if (otp.length !== 6) {
            alert('⚠️ Please enter the 6-digit OTP code.');
            $('#adminModalError').removeClass('d-none').text('Please enter the 6-digit OTP code.');
            return;
        }
        if (password.length < 4) {
            alert('⚠️ Password must be at least 4 characters long.');
            $('#adminModalError').removeClass('d-none').text('Password must be at least 4 characters long.');
            return;
        }
        if (password !== confirm) {
            alert('⚠️ Passwords do not match.');
            $('#adminModalError').removeClass('d-none').text('Passwords do not match.');
            return;
        }

        $('#adminModalError').addClass('d-none');
        var btn = $(this);
        btn.html('<i class="fa-solid fa-circle-notch fa-spin"></i> Verifying OTP &amp; Resetting...').prop('disabled', true);

        // Step 1: Verify OTP with backend
        $.post('/Auth/VerifyOtpForForgotPassword', { phoneNumber: adminForgotPhone, otp: otp }, function(vRes) {
            if (!vRes.success) {
                alert('⚠️ ' + vRes.message);
                $('#adminModalError').removeClass('d-none').text(vRes.message);
                btn.html('Reset Password &amp; Login <i class="fa-solid fa-circle-check ms-1"></i>').prop('disabled', false);
                return;
            }

            // Step 2: Reset Password
            $.post('/Auth/ResetPassword', {
                phoneNumber: adminForgotPhone,
                role: 'Admin',
                password: password
            }, function(res) {
                if (res.success) {
                    window.location.href = res.redirect;
                } else {
                    alert('⚠️ ' + res.message);
                    $('#adminModalError').removeClass('d-none').text(res.message);
                    btn.html('Reset Password &amp; Login <i class="fa-solid fa-circle-check ms-1"></i>').prop('disabled', false);
                }
            });
        });
    });

    // Switch Panels
    function showPanel(panelId, title, iconClass, subtitle) {
        var activeRole = $('input[name="loginRole"]:checked').val() || 
                         $('input[name="registerRole"]:checked').val() || 
                         $('input[name="forgotRole"]:checked').val() || 
                         "@targetRole" || 
                         "Customer";
                         
        if (activeRole !== "Admin") {
            $('input[name="loginRole"][value="' + activeRole + '"]').prop('checked', true);
            $('input[name="registerRole"][value="' + activeRole + '"]').prop('checked', true);
            $('input[name="forgotRole"][value="' + activeRole + '"]').prop('checked', true);
        }

        $('#panelLogin, #panelOtpLogin, #panelRegisterDetails, #panelRegisterOtp, #panelRegisterPassword, #panelForgotPhone, #panelForgotOtp, #panelForgotReset').hide();
        $('#' + panelId).show();
        
        if (title) $('#titleText').html(title);
        if (iconClass) $('#titleIcon').attr('class', 'fa-solid ' + iconClass + ' text-warning mb-2');
        if (subtitle) $('#subtitleText').text(subtitle);
    }

    // Cooldown Timer Helpers
    var loginTimerInterval = null;
    function startLoginTimer(seconds) {
        clearInterval(loginTimerInterval);
        var remaining = seconds || 60;
        var btn = $('#btnResendLoginOtp');
        btn.prop('disabled', true).text('Resend in ' + remaining + 's');
        loginTimerInterval = setInterval(function() {
            remaining--;
            if (remaining <= 0) {
                clearInterval(loginTimerInterval);
                btn.prop('disabled', false).html('<i class="fa-brands fa-whatsapp text-success me-1"></i> Resend OTP');
            } else {
                btn.text('Resend in ' + remaining + 's');
            }
        }, 1000);
    }

    var regTimerInterval = null;
    function startRegTimer(seconds) {
        clearInterval(regTimerInterval);
        var remaining = seconds || 60;
        var btn = $('#btnResendRegisterOtp');
        btn.prop('disabled', true).text('Resend in ' + remaining + 's');
        regTimerInterval = setInterval(function() {
            remaining--;
            if (remaining <= 0) {
                clearInterval(regTimerInterval);
                btn.prop('disabled', false).html('<i class="fa-brands fa-whatsapp text-success me-1"></i> Resend OTP');
            } else {
                btn.text('Resend in ' + remaining + 's');
            }
        }, 1000);
    }

    var forgotTimerInterval = null;
    function startForgotTimer(seconds) {
        clearInterval(forgotTimerInterval);
        var remaining = seconds || 60;
        var btn = $('#btnResendForgotOtp');
        btn.prop('disabled', true).text('Resend in ' + remaining + 's');
        forgotTimerInterval = setInterval(function() {
            remaining--;
            if (remaining <= 0) {
                clearInterval(forgotTimerInterval);
                btn.prop('disabled', false).html('<i class="fa-brands fa-whatsapp text-success me-1"></i> Resend OTP');
            } else {
                btn.text('Resend in ' + remaining + 's');
            }
        }, 1000);
    }

    // Nav Links
    $('#lnkShowRegister').click(function(e) {
        e.preventDefault();
        resetRegisterFlow();
        showPanel('panelRegisterDetails', 'Register Account', 'fa-user-plus', 'Join RaahSathi roadside assistance network');
    });

    $('#lnkShowForgot').click(function(e) {
        e.preventDefault();
        showPanel('panelForgotPhone', 'Reset Password', 'fa-key', 'Recover your login credentials securely');
    });

    $('.btnBackToLogin').click(function(e) {
        e.preventDefault();
        resetRegisterFlow();
        showPanel('panelLogin', 'Welcome to <span style="color: #ff6b00;">Raah</span><span class="text-white">Sathi</span>', 'fa-shield-halved', 'Login with your credentials or register a new account');
    });

    $('#btnShowOtpLogin').click(function(e) {
        e.preventDefault();
        var currentRole = $('input[name="forgotRole"]:checked').val() || $('input[name="loginRole"]:checked').val() || "Customer";
        var phone = $('#forgotPhone').val().trim();
        $('input[name="otpLoginRole"][value="' + currentRole + '"]').prop('checked', true);
        if (phone) {
            $('#otpLoginPhone').val(phone);
        }
        $('#otpLoginStep1').show();
        $('#otpLoginStep2').hide();
        showPanel('panelOtpLogin', 'WhatsApp OTP Login', 'fa-brands fa-whatsapp', 'Instant password-free login via WhatsApp');
    });


    // 1. Password Login
    $('#btnLoginSubmit').click(function() {
        var role = $('input[name="loginRole"]:checked').val();
        if (!role) {
            alert('⚠️ Please select your account type: Customer, Mechanic, or Admin!');
            return;
        }

        var phone = $('#loginPhone').val().trim();
        var password = $('#loginPassword').val().trim();

        if (phone.length < 10) {
            alert('Please enter a valid 10-digit mobile number.');
            return;
        }
        if (!password) {
            alert('Please enter your password.');
            return;
        }

        $(this).html('<i class="fa-solid fa-circle-notch fa-spin"></i>').prop('disabled', true);

        $.post('/Auth/PasswordLogin', { phoneNumber: phone, password: password, role: role }, function(res) {
            if (res.success) {
                window.location.href = res.redirect;
            } else {
                alert(res.message);
                $('#btnLoginSubmit').html('Secure Login <i class="fa-solid fa-unlock ms-1"></i>').prop('disabled', false);
            }
        });
    });

    // 1B. WhatsApp OTP Login Flow
    var otpLoginPhoneVal = "";
    var otpLoginRoleVal = "";

    $('#btnSendLoginOtp, #btnResendLoginOtp').click(function() {
        otpLoginRoleVal = $('input[name="otpLoginRole"]:checked').val();
        if (!otpLoginRoleVal) {
            alert('⚠️ Please select your account type: Customer or Mechanic!');
            return;
        }

        otpLoginPhoneVal = $('#otpLoginPhone').val().trim();
        if (otpLoginPhoneVal.length < 10) {
            alert('Please enter a valid 10-digit mobile number.');
            return;
        }

        var btn = $('#btnSendLoginOtp');
        btn.html('<i class="fa-solid fa-circle-notch fa-spin"></i> Sending WhatsApp OTP...').prop('disabled', true);

        $.post('/Auth/SendOtp', { phoneNumber: otpLoginPhoneVal, role: otpLoginRoleVal }, function(res) {
            btn.html('<i class="fa-brands fa-whatsapp fs-5"></i> Send WhatsApp Login OTP').prop('disabled', false);
            if (res.success) {
                $('#lblSentLoginPhone').text('+91 ' + otpLoginPhoneVal);
                $('#otpLoginStep1').hide();
                $('#otpLoginStep2').show();
                $('#otpLoginCode').val('').focus();
                startLoginTimer(60);
            } else {
                alert(res.message);
            }
        });
    });

    $('#btnBackToOtpStep1').click(function(e) {
        e.preventDefault();
        $('#otpLoginStep2').hide();
        $('#otpLoginStep1').show();
    });

    $('#btnVerifyLoginOtp').click(function() {
        var otp = $('#otpLoginCode').val().trim();
        if (otp.length !== 6) {
            alert('Please enter the 6-digit WhatsApp OTP.');
            return;
        }

        $(this).html('<i class="fa-solid fa-circle-notch fa-spin"></i> Verifying...').prop('disabled', true);

        $.post('/Auth/VerifyOtp', { phoneNumber: otpLoginPhoneVal, role: otpLoginRoleVal, otp: otp }, function(res) {
            if (res.success) {
                window.location.href = res.redirect;
            } else {
                alert(res.message);
                $('#btnVerifyLoginOtp').html('Verify OTP &amp; Login <i class="fa-solid fa-arrow-right ms-1"></i>').prop('disabled', false);
            }
        });
    });

    // 2. Register - Single Panel (Send OTP & Verify OTP)
    var regPhone = "";
    var regRole = "";
    var regName = "";
    var regReferralCode = "";
    var regOtpSent = false;

    function resetRegisterFlow() {
        regOtpSent = false;
        $('#regOtpSentBanner').hide();
        $('#regOtpGroup').hide();
        $('#registerOtpCode').val('');
        $('#registerPhone, #registerName, #registerReferralCode, input[name="registerRole"]').prop('readonly', false).prop('disabled', false);
        $('#btnRegisterAction').removeClass('btn-success').addClass('btn-premium-primary')
            .html('<i class="fa-solid fa-shield-halved me-1"></i> <span>Get OTP Verification</span>').prop('disabled', false);
    }

    function sendRegistrationOtp(isResend) {
        regRole = $('input[name="registerRole"]:checked').val();
        if (!regRole) {
            alert('⚠️ Please select your account type: Customer or Mechanic!');
            return;
        }

        regPhone = $('#registerPhone').val().trim();
        regName = $('#registerName').val().trim();
        regReferralCode = $('#registerReferralCode').val().trim();

        if (!regName) {
            alert('Please enter your full name.');
            $('#registerName').focus();
            return;
        }
        if (regPhone.length < 10) {
            alert('Please enter a valid 10-digit mobile number.');
            $('#registerPhone').focus();
            return;
        }

        var btn = $('#btnRegisterAction');
        btn.html('<i class="fa-solid fa-circle-notch fa-spin"></i> ' + (isResend ? 'Resending OTP...' : 'Sending OTP...')).prop('disabled', true);

        $.post('/Auth/SendOtpForRegistration', { phoneNumber: regPhone, role: regRole, name: regName }, function(res) {
            if (res.success) {
                regOtpSent = true;
                $('#lblSentRegisterPhone').text('+91 ' + regPhone);
                $('#regOtpSentBanner').slideDown(250);
                $('#regOtpGroup').slideDown(250);
                $('#registerOtpCode').focus();
                
                // Change button state to Verify OTP & Continue
                btn.removeClass('btn-premium-primary').addClass('btn-success')
                    .html('Verify OTP &amp; Continue <i class="fa-solid fa-arrow-right ms-1"></i>').prop('disabled', false);

                startRegTimer(60);
            } else {
                alert(res.message);
                if (!regOtpSent) {
                    btn.html('<i class="fa-solid fa-shield-halved me-1"></i> <span>Get OTP Verification</span>').prop('disabled', false);
                } else {
                    btn.html('Verify OTP &amp; Continue <i class="fa-solid fa-arrow-right ms-1"></i>').prop('disabled', false);
                }
            }
        });
    }

    $('#btnRegisterAction').click(function() {
        if (!regOtpSent) {
            sendRegistrationOtp(false);
        } else {
            // Verify OTP
            var otp = $('#registerOtpCode').val().trim();
            if (otp.length !== 6) {
                alert('Please enter the 6-digit OTP received on WhatsApp.');
                $('#registerOtpCode').focus();
                return;
            }

            var btn = $(this);
            btn.html('<i class="fa-solid fa-circle-notch fa-spin"></i> Verifying...').prop('disabled', true);

            $.post('/Auth/VerifyOtpForRegistration', { phoneNumber: regPhone, otp: otp }, function(res) {
                btn.html('Verify OTP &amp; Continue <i class="fa-solid fa-arrow-right ms-1"></i>').prop('disabled', false);
                if (res.success) {
                    showPanel('panelRegisterPassword', 'Set Password', 'fa-lock', 'Choose a strong password for login');
                } else {
                    alert('⚠️ ' + res.message);
                }
            });
        }
    });

    $('#btnResendRegisterOtp').click(function() {
        sendRegistrationOtp(true);
    });

    // 4. Register - Complete (Submit Password)
    $('#btnRegisterComplete').click(function() {
        var password = $('#registerNewPassword').val().trim();
        var confirm = $('#registerConfirmPassword').val().trim();

        if (password.length < 4) {
            alert('Password must be at least 4 characters long.');
            return;
        }
        if (password !== confirm) {
            alert('Passwords do not match.');
            return;
        }

        $(this).html('<i class="fa-solid fa-circle-notch fa-spin"></i>').prop('disabled', true);

        $.post('/Auth/CompleteRegistration', {
            name: regName,
            phoneNumber: regPhone,
            role: regRole,
            password: password,
            referralCode: regReferralCode
        }, function(res) {
            if (res.success) {
                window.location.href = res.redirect;
            } else {
                alert(res.message);
                $('#btnRegisterComplete').html('Create Account & Login <i class="fa-solid fa-circle-check ms-1"></i>').prop('disabled', false);
            }
        });
    });

    // 5. Forgot Password - Send WhatsApp OTP
    var forgotPhoneNum = "";
    var forgotRoleVal = "";

    $('#btnForgotSendOtp, #btnResendForgotOtp').click(function() {
        forgotRoleVal = $('input[name="forgotRole"]:checked').val();
        if (!forgotRoleVal) {
            alert('⚠️ Please select your account type: Customer or Mechanic!');
            return;
        }

        forgotPhoneNum = $('#forgotPhone').val().trim();

        if (forgotPhoneNum.length < 10) {
            alert('Please enter a valid 10-digit mobile number.');
            return;
        }

        var btn = $(this);
        btn.html('<i class="fa-solid fa-circle-notch fa-spin"></i> Sending WhatsApp OTP...').prop('disabled', true);

        $.post('/Auth/SendOtpForForgotPassword', { phoneNumber: forgotPhoneNum, role: forgotRoleVal }, function(res) {
            btn.html('<i class="fa-brands fa-whatsapp fs-5 text-success"></i> Send WhatsApp Reset OTP').prop('disabled', false);
            if (res.success) {
                $('#lblSentForgotPhone').text('+91 ' + forgotPhoneNum);
                showPanel('panelForgotOtp', 'WhatsApp Reset Verification', 'fa-brands fa-whatsapp', 'Verify your WhatsApp identity to reset password');
                $('#forgotOtpCode').val('').focus();
                startForgotTimer(60);
            } else {
                alert(res.message);
            }
        });
    });

    $('#btnBackToForgotPhone').click(function(e) {
        e.preventDefault();
        showPanel('panelForgotPhone', 'Reset Password', 'fa-key', 'Recover your login credentials securely');
    });

    // 6. Forgot Password - Verify WhatsApp OTP
    $('#btnForgotVerifyOtp').click(function() {
        var otp = $('#forgotOtpCode').val().trim();
        if (otp.length !== 6) {
            alert('Please enter the 6-digit WhatsApp OTP.');
            return;
        }

        var btn = $(this);
        btn.html('<i class="fa-solid fa-circle-notch fa-spin"></i> Verifying...').prop('disabled', true);

        $.post('/Auth/VerifyOtpForForgotPassword', { phoneNumber: forgotPhoneNum, otp: otp }, function(res) {
            btn.html('Verify WhatsApp OTP <i class="fa-solid fa-arrow-right ms-1"></i>').prop('disabled', false);
            if (res.success) {
                showPanel('panelForgotReset', 'Choose New Password', 'fa-lock', 'Reset your account security keys');
            } else {
                alert('⚠️ ' + res.message);
            }
        });
    });

    // 7. Forgot Password - Complete Reset
    $('#btnForgotComplete').click(function() {
        var password = $('#forgotNewPassword').val().trim();
        var confirm = $('#forgotConfirmPassword').val().trim();

        if (password.length < 4) {
            alert('Password must be at least 4 characters long.');
            return;
        }
        if (password !== confirm) {
            alert('Passwords do not match.');
            return;
        }

        $(this).html('<i class="fa-solid fa-circle-notch fa-spin"></i>').prop('disabled', true);

        $.post('/Auth/ResetPassword', {
            phoneNumber: forgotPhoneNum,
            role: forgotRoleVal,
            password: password
        }, function(res) {
            if (res.success) {
                window.location.href = res.redirect;
            } else {
                alert(res.message);
                $('#btnForgotComplete').html('Reset Password & Login <i class="fa-solid fa-circle-check ms-1"></i>').prop('disabled', false);
            }
        });
    });
});

</script>
}
