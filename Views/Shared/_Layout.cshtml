        <!-- City-Wise Emergency Weather Surge Control Modal -->
        <div class="modal fade" id="emergencyCitySurgeModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content bg-dark text-white border border-danger shadow-lg">
                    <div class="modal-header border-secondary bg-black bg-opacity-60">
                        <h5 class="modal-title text-danger font-weight-bold d-flex align-items-center gap-2">
                            <i class="fa-solid fa-triangle-exclamation text-danger fs-5"></i>
                            City-Wise Emergency Weather Surge Controller (+12% Surcharge)
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="alert alert-danger bg-danger bg-opacity-20 border-danger text-white small mb-4">
                            <i class="fa-solid fa-circle-info me-2"></i>
                            Activating Emergency Mode for a city applies a <strong>+12% Weather Surge Increase</strong> to base visiting fees, towing rates, and service fixes in that area due to heavy rain, storms, or severe weather.
                        </div>

                        <!-- All Cities Master Surge Switch -->
                        <div class="p-3 bg-black bg-opacity-40 rounded-3 border border-secondary mb-4">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                                <div>
                                    <h6 class="text-warning font-weight-bold mb-1"><i class="fa-solid fa-earth-americas me-1"></i> ALL CITIES GLOBAL EMERGENCY SURGE</h6>
                                    <p class="text-muted small mb-0">Turn ON/OFF Emergency Weather Surge for all cities nationwide at once.</p>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <select id="globalWeatherReason" class="form-select glass-input text-warning small font-weight-bold" style="width: auto;">
                                        <option value="Heavy Rain & Storm 🌧️">🌧️ Heavy Rain & Storm</option>
                                        <option value="Thunderstorm & Cyclone 🌩️">🌩️ Thunderstorm & Cyclone</option>
                                        <option value="Waterlogging & Flood 🌊">🌊 Waterlogging & Flood</option>
                                        <option value="Severe Weather Alert 🌪️">🌪️ Severe Weather Alert</option>
                                    </select>
                                    <button type="button" class="btn btn-danger font-weight-bold px-3 py-1.5" onclick="toggleCityEmergency('All Cities', true)">
                                        ALL ON (+12%)
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary text-light font-weight-bold px-3 py-1.5" onclick="toggleCityEmergency('All Cities', false)">
                                        ALL OFF
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- City-Wise Status Grid -->
                        <h6 class="text-white font-weight-bold mb-3"><i class="fa-solid fa-city text-warning me-2"></i> Individual City Emergency Statuses</h6>
                        <div id="citySurgeContainer" class="row g-3">
                            <div class="text-center py-4 text-muted"><i class="fa-solid fa-spinner fa-spin me-2"></i> Loading City Emergency Statuses...</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script>
            function toggleAdminSidebar() {
                $('.noc-sidebar').toggleClass('show');
                $('.noc-sidebar-overlay').toggleClass('show');
            }

            function toggleSettingsMenu(e) {
                if (e) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                $('.noc-settings-menu-drawer').toggleClass('show');
                $('.noc-settings-overlay').toggleClass('show');
            }

            function closeSettingsMenu() {
                $('.noc-settings-menu-drawer').removeClass('show');
                $('.noc-settings-overlay').removeClass('show');
            }

            function openEmergencySurgeModal() {
                var modal = new bootstrap.Modal(document.getElementById('emergencyCitySurgeModal'));
                modal.show();
                loadCityEmergencyStatuses();
            }

            function loadCityEmergencyStatuses() {
                $.get('/Admin/GetCityEmergencyStatuses', function(res) {
                    if (res && res.success) {
                        updateEmergencyButtonBadge(res.isGlobalEmergency, res.cities);

                        var html = '';
                        if (!res.cities || res.cities.length === 0) {
                            html = '<div class="col-12 text-center text-muted py-3">No cities configured.</div>';
                        } else {
                            $.each(res.cities, function(idx, c) {
                                var isON = c.isEmergencyMode || res.isGlobalEmergency;
                                var statusBadge = isON 
                                    ? '<span class="badge bg-danger text-white border border-danger"><i class="fa-solid fa-bolt me-1"></i> ACTIVE (+12%)</span>' 
                                    : '<span class="badge bg-secondary text-light"><i class="fa-solid fa-circle me-1"></i> Normal Rate</span>';
                                
                                html += '<div class="col-md-6">' +
                                    '<div class="p-3 bg-dark bg-opacity-60 rounded-3 border ' + (isON ? 'border-danger' : 'border-secondary') + ' d-flex justify-content-between align-items-center">' +
                                        '<div>' +
                                            '<div class="font-weight-bold text-white fs-6">' + c.cityName + ' <span class="text-muted small">(' + c.state + ')</span></div>' +
                                            '<div class="mt-1">' + statusBadge + ' <span class="text-muted small ms-1">' + (c.emergencyReason || 'Normal') + '</span></div>' +
                                        '</div>' +
                                        '<div>' +
                                            (isON 
                                                ? '<button type="button" class="btn btn-outline-danger btn-sm font-weight-bold" onclick="toggleCityEmergency(\'' + c.cityName.replace("'", "\\'") + '\', false)">Turn OFF</button>'
                                                : '<button type="button" class="btn btn-warning btn-sm font-weight-bold text-dark" onclick="toggleCityEmergency(\'' + c.cityName.replace("'", "\\'") + '\', true)">Activate +12% Surge</button>'
                                            ) +
                                        '</div>' +
                                    '</div>' +
                                '</div>';
                            });
                        }
                        $('#citySurgeContainer').html(html);

                        // Real-time dynamic sync of Live India Regional Network grid on Dashboard
                        if ($('#regionalCitiesContainer').length && res.cities && res.cities.length > 0) {
                            var dashHtml = '';
                            $.each(res.cities, function(idx, c) {
                                var isSurge = c.isEmergencyMode || res.isGlobalEmergency;
                                dashHtml += '<div class="col-6">' +
                                    '<div class="p-2.5 rounded bg-black bg-opacity-50 border ' + (isSurge ? 'border-danger bg-danger bg-opacity-10 shadow-sm' : 'border-warning border-opacity-40') + ' d-flex align-items-center justify-content-between">' +
                                        '<div>' +
                                            '<span class="text-light font-weight-bold d-flex align-items-center gap-1">' +
                                                (isSurge 
                                                    ? '<span class="pulse-red-dot" title="Emergency Weather Surge Active (+12%)"></span>' 
                                                    : '<i class="fa-solid fa-circle text-warning me-1" style="font-size:0.6rem;"></i>'
                                                ) +
                                                c.cityName +
                                            '</span>' +
                                            '<div class="text-muted" style="font-size:0.7rem;">' +
                                                (c.areaName ? c.areaName + ' ' : '') + '(' + c.state + ')' +
                                                (isSurge ? ' <span class="text-danger font-weight-bold ms-1" style="font-size:0.68rem;">🚨 ' + (c.emergencyReason || 'Rain Surge') + '</span>' : '') +
                                            '</div>' +
                                        '</div>' +
                                        (isSurge 
                                            ? '<span class="badge bg-danger text-white font-weight-bold shadow-sm" style="font-size:0.7rem;">🚨 +12% Surge</span>' 
                                            : '<span class="badge bg-warning text-dark font-weight-bold">' + (c.serviceRadiusKm || 30) + ' KM</span>'
                                        ) +
                                    '</div>' +
                                '</div>';
                            });
                            $('#regionalCitiesContainer').html(dashHtml);
                        }
                    }
                });
            }

            function toggleCityEmergency(cityName, enable) {
                var reason = $('#globalWeatherReason').val() || 'Heavy Rain & Storm 🌧️';
                $.post('/Admin/ToggleCityEmergencyMode', { cityName: cityName, enable: enable, weatherReason: reason }, function(res) {
                    if (res && res.success) {
                        loadCityEmergencyStatuses();
                    } else {
                        alert(res.message || 'Failed to update emergency mode.');
                    }
                });
            }

            function updateEmergencyButtonBadge(isGlobal, cities) {
                var btn = $('#btnNocEmergencyToggle');
                var activeCities = (cities || []).filter(function(c) { return c.isEmergencyMode; });
                
                if (isGlobal) {
                    btn.removeClass('btn-outline-danger').addClass('btn-danger text-white');
                    $('#txtEmergencyModeState').html('ALL CITIES 🚨 (+12%)');
                } else if (activeCities.length === 1) {
                    btn.removeClass('btn-outline-danger').addClass('btn-danger text-white');
                    $('#txtEmergencyModeState').html(activeCities[0].cityName.toUpperCase() + ' 🚨 (+12%)');
                } else if (activeCities.length > 1) {
                    btn.removeClass('btn-outline-danger').addClass('btn-danger text-white');
                    $('#txtEmergencyModeState').html(activeCities[0].cityName.toUpperCase() + ' +' + (activeCities.length - 1) + ' MORE 🚨 (+12%)');
                } else {
                    btn.removeClass('btn-danger text-white').addClass('btn-outline-danger');
                    $('#txtEmergencyModeState').html('OFF');
                }
            }

            $(document).ready(function() {
                if ($('#btnNocEmergencyToggle').length) {
                    $.get('/Admin/GetCityEmergencyStatuses', function(res) {
                        if (res && res.success) {
                            updateEmergencyButtonBadge(res.isGlobalEmergency, res.cities);
                        }
                    });
                }
            });
        </script>
