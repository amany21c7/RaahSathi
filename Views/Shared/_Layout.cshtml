    <script>
        function toggleAiChat() {
            const win = document.getElementById('aiChatWindow');
            win.classList.toggle('d-none');
        }

        function askAiFloating(query) {
            document.getElementById('aiFloatingInput').value = query;
            submitAiFloatingQuery();
        }

        function submitAiFloatingQuery() {
            const input = document.getElementById('aiFloatingInput');
            const box = document.getElementById('aiFloatingConsoleBox');
            const text = input.value.trim();
            if(!text) return;

            box.innerHTML += `<div class="text-warning text-end my-1"><i class="fa-solid fa-user me-1"></i> <strong>You:</strong> ${text}</div>`;
            input.value = '';
            box.scrollTop = box.scrollHeight;

            const loadingId = 'loading-' + Date.now();
            box.innerHTML += `<div id="${loadingId}" class="text-muted my-1"><i class="fa-solid fa-spinner fa-spin text-warning me-1"></i> <em>AI is thinking...</em></div>`;
            box.scrollTop = box.scrollHeight;

            $.post('/Home/AskAiChat', { prompt: text }, function(res) {
                const loader = document.getElementById(loadingId);
                if (loader) loader.remove();

                const answer = res && res.answer ? res.answer : "For instant emergency breakdown assistance, call our 24×7 hotline at 1800-102-7224.";
                box.innerHTML += `<div class="text-light my-1"><i class="fa-solid fa-robot text-warning me-1"></i> <strong>AI:</strong> ${answer.replace(/\n/g, '<br>')}</div>`;
                box.scrollTop = box.scrollHeight;
            }).fail(function() {
                const loader = document.getElementById(loadingId);
                if (loader) loader.remove();

                box.innerHTML += `<div class="text-light my-1"><i class="fa-solid fa-robot text-warning me-1"></i> <strong>AI:</strong> RaahSathi 24×7 Emergency Toll-Free Hotline: 1800-102-7224. Or click 'Request Assistance Now' for instant mechanic dispatch.</div>`;
                box.scrollTop = box.scrollHeight;
            });
        }
    </script>
