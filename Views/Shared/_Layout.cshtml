    </footer>

    <!-- Emergency Support Modal -->
    <div class="modal fade" id="emergencySupportModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-card border-danger border-opacity-40" style="background: linear-gradient(135deg, rgba(18, 31, 53, 0.98) 0%, rgba(10, 19, 36, 0.99) 100%);">
                <div class="modal-header border-secondary border-opacity-30">
                    <h5 class="modal-title text-white font-weight-bold">
                        <i class="fa-solid fa-triangle-exclamation text-danger me-2"></i> 24×7 Emergency Highway Support
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="p-3 bg-danger bg-opacity-10 border border-danger border-opacity-30 rounded-3 text-center mb-4">
                        <span class="badge bg-danger text-white mb-2 font-weight-bold">INSTANT DISPATCH HOTLINE</span>
                        <h2 class="text-white font-weight-extrabold mb-1" style="font-family: 'Outfit';">1800-102-7224</h2>
                        <span class="text-muted small">Toll-Free • Available 24 Hours • 7 Days a Week</span>
                    </div>

                    <div class="d-flex flex-column gap-3">
                        <a href="tel:18001027224" class="btn btn-danger btn-lg py-3 font-weight-bold w-100">
                            <i class="fa-solid fa-phone-volume me-2"></i> Call Toll-Free Helpline Now
                        </a>
                        <a href="/Customer/Book" class="btn btn-warning btn-lg py-3 font-weight-bold text-dark w-100">
                            <i class="fa-solid fa-location-arrow me-2"></i> Request Instant Mechanic Dispatch
                        </a>
                        <a href="https://wa.me/919876543210" target="_blank" class="btn btn-outline-success py-2 w-100">
                            <i class="fa-brands fa-whatsapp me-2"></i> Chat with Emergency Desk on WhatsApp
                        </a>
                    </div>
                </div>
                <div class="modal-footer border-secondary border-opacity-30 justify-content-between text-muted small">
                    <span><i class="fa-solid fa-shield-halved text-success me-1"></i> 100% KYC Verified Patrol Network</span>
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Small Floating AI Chatbot Widget (Bottom Right) -->
    <div id="aiFloatingWidgetContainer" style="position: fixed; bottom: 20px; right: 20px; z-index: 1050;">
        <!-- Compact AI Chat Popup Window -->
        <div id="aiChatWindow" class="card shadow-lg border-warning border-opacity-40 text-start d-none" style="width: 310px; max-width: 90vw; background: #0f172a; border-radius: 16px; overflow: hidden; margin-bottom: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.5) !important;">
            <!-- Header -->
            <div class="card-header bg-dark border-bottom border-secondary border-opacity-30 d-flex align-items-center justify-content-between p-3" style="background: linear-gradient(135deg, #1e293b, #0f172a);">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-2 font-weight-bold shadow" style="width: 30px; height: 30px; background: #f59e0b; color: #0f172a;">
                        <i class="fa-solid fa-robot"></i>
                    </div>
                    <div>
                        <h6 class="text-white font-weight-bold mb-0" style="font-size: 0.88rem;"><span style="color: #ff6b00;">Raah</span><span class="text-white">Sathi</span> AI Bot</h6>
                        <span class="text-success small" style="font-size: 0.7rem;"><i class="fa-solid fa-circle me-1" style="font-size: 0.45rem;"></i> Active Online</span>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white small" onclick="toggleAiChat()"></button>
            </div>

            <!-- Chat Message Area -->
            <div id="aiFloatingConsoleBox" class="card-body p-3 text-light small" style="height: 200px; overflow-y: auto; background: #0b1120; line-height: 1.4;">
                <div class="text-light my-1"><i class="fa-solid fa-sparkles text-warning me-1"></i> <strong>AI Bot:</strong> Hi! How can I help you with roadside breakdown assistance today?</div>
            </div>

            <!-- Quick Suggestions -->
            <div class="px-2 py-1 bg-dark border-top border-secondary border-opacity-20 d-flex gap-1 overflow-x-auto" style="white-space: nowrap;">
                <button class="btn btn-outline-warning btn-sm py-0 px-2" style="font-size: 0.7rem;" onclick="askAiFloating('How to book mechanic?')">Book Mechanic</button>
                <button class="btn btn-outline-warning btn-sm py-0 px-2" style="font-size: 0.7rem;" onclick="askAiFloating('What are charges?')">Visiting Charges</button>
                <button class="btn btn-outline-warning btn-sm py-0 px-2" style="font-size: 0.7rem;" onclick="askAiFloating('Emergency helpline')">Helpline</button>
            </div>

            <!-- Footer Input -->
            <div class="card-footer p-2 bg-dark border-top border-secondary border-opacity-30">
                <div class="input-group input-group-sm">
                    <input type="text" id="aiFloatingInput" class="form-control bg-dark text-white border-secondary" placeholder="Type a message..." onkeypress="if(event.key === 'Enter') submitAiFloatingQuery()">
                    <button class="btn btn-warning text-dark font-weight-bold" onclick="submitAiFloatingQuery()" style="background: #f59e0b; border: none;">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Trigger Button -->
        <button class="btn btn-warning rounded-pill shadow-lg font-weight-bold d-flex align-items-center gap-2 px-3 py-2 text-dark" onclick="toggleAiChat()" style="background: #f59e0b; border: 2px solid #ffffff; box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4) !important;">
            <div class="rounded-circle bg-dark text-warning d-flex align-items-center justify-content-center" style="width: 26px; height: 26px;">
                <i class="fa-solid fa-comments"></i>
            </div>
            <span>Chat</span>
        </button>
    </div>

    <script>
        function toggleAiChat() {
            const win = document.getElementById('aiChatWindow');
            win.classList.toggle('d-none');
        }

        function askAiFloating(query) {
            document.getElementById('aiFloatingInput').value = query;
            submitAiFloatingQuery();
        }

        function submitAiFloatingQuery() {
            const input = document.getElementById('aiFloatingInput');
            const box = document.getElementById('aiFloatingConsoleBox');
            const text = input.value.trim();
            if(!text) return;

            box.innerHTML += `<div class="text-warning text-end my-1"><i class="fa-solid fa-user me-1"></i> <strong>You:</strong> ${text}</div>`;
            input.value = '';
            box.scrollTop = box.scrollHeight;

            const loadingId = 'loading-' + Date.now();
            box.innerHTML += `<div id="${loadingId}" class="text-muted my-1"><i class="fa-solid fa-spinner fa-spin text-warning me-1"></i> <em>AI is thinking...</em></div>`;
            box.scrollTop = box.scrollHeight;

            $.post('/Home/AskAiChat', { prompt: text }, function(res) {
                const loader = document.getElementById(loadingId);
                if (loader) loader.remove();

                const answer = res && res.answer ? res.answer : "For instant emergency breakdown assistance, call our 24×7 hotline at 1800-102-7224.";
                box.innerHTML += `<div class="text-light my-1"><i class="fa-solid fa-robot text-warning me-1"></i> <strong>AI:</strong> ${answer.replace(/\n/g, '<br>')}</div>`;
                box.scrollTop = box.scrollHeight;
            }).fail(function() {
                const loader = document.getElementById(loadingId);
                if (loader) loader.remove();

                box.innerHTML += `<div class="text-light my-1"><i class="fa-solid fa-robot text-warning me-1"></i> <strong>AI:</strong> RaahSathi 24×7 Emergency Toll-Free Hotline: 1800-102-7224. Or click 'Request Assistance Now' for instant mechanic dispatch.</div>`;
                box.scrollTop = box.scrollHeight;
            });
        }
    </script>

    <!-- Bootstrap & jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Leaflet JS Map -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Global Translatable HTML Alert Modal -->
    <div class="modal fade" id="globalAlertModal" tabindex="-1" aria-hidden="true" style="z-index: 10600;">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content bg-dark border-warning text-white shadow-lg" style="border-radius:14px; border:1.5px solid #f59e0b;">
                <div class="modal-body p-4 text-center">
                    <div class="mb-3">
                        <i class="fa-solid fa-circle-info text-warning fa-3x animate-pulse"></i>
                    </div>
                    <div class="font-weight-bold text-white mb-3" id="globalAlertModalMessage" style="font-size:0.95rem; line-height:1.5; white-space:pre-line;"></div>
                    <button type="button" class="btn btn-warning w-100 font-weight-bold text-dark py-2" data-bs-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Google Translate Engine (Hidden from UI, controlled via our custom dropdown) -->
    <div id="google_translate_element" style="display:none;"></div>
    <script type="text/javascript">
        function googleTranslateElementInit() {
            new google.translate.TranslateElement({
                pageLanguage: 'en',
                includedLanguages: 'en,hi,mr,gu,pa,bn,ta,te,kn,ml',
                autoDisplay: false
            }, 'google_translate_element');
        }

        // Overriding native window.alert to render HTML DOM modal so Google Translate & language engine translate all alerts!
        (function() {
            var originalAlert = window.alert;
            window.alert = function(msg) {
                if (!msg) return;
                var modalEl = document.getElementById('globalAlertModal');
                var msgEl = document.getElementById('globalAlertModalMessage');
                if (modalEl && msgEl) {
                    msgEl.innerText = msg;
                    var bsModal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                    bsModal.show();
                } else {
                    originalAlert(msg);
                }
            };
        })();
    </script>
    <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
</body>
</html>
