@{
    bool isAdminPage = Context.Request.Path.Value?.StartsWith("/Admin", StringComparison.OrdinalIgnoreCase) == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Instant Zero-Flash Translation Guard -->
    <style id="fouc-guard-style">
        html.lang-loading body {
            visibility: hidden !important;
            opacity: 0 !important;
        }
        html.translated-ltr body, html.translated-rtl body, html.lang-ready body {
            visibility: visible !important;
            opacity: 1 !important;
            transition: opacity 0.1s ease-in;
        }
    </style>
    <script>
        // RaahSathi Ultra-Fast Real-Time Multi-Language Engine
        (function() {
            function getCookie(name) {
                let match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
                return match ? match[2] : null;
            }
            const isAdmin = @(isAdminPage.ToString().ToLower());
            const key = isAdmin ? 'admin_lang' : 'public_lang';
            const currentLang = getCookie(key) || localStorage.getItem(key) || 'en';

            window.currentSelectedLang = currentLang;

            if (currentLang !== 'en') {
                document.documentElement.className += ' lang-loading';
                document.cookie = 'googtrans=/en/' + currentLang + '; path=/';
                document.cookie = 'googtrans=/en/' + currentLang + '; domain=' + location.hostname + '; path=/';
            }
        })();

        function setCookie(name, value, days) {
            let d = new Date();
            d.setTime(d.getTime() + (days * 24 * 60 * 60 * 1000));
            document.cookie = name + "=" + value + ";expires=" + d.toUTCString() + ";path=/";
        }

        function applyTranslationToCombo(targetLang) {
            const combo = document.querySelector('.goog-te-combo');
            if (combo) {
                combo.value = targetLang;
                combo.dispatchEvent(new Event('change'));
                return true;
            }
            return false;
        }

        function changeLanguage(lang) {
            const isAdmin = @(isAdminPage.ToString().ToLower());
            const key = isAdmin ? 'admin_lang' : 'public_lang';
            setCookie(key, lang, 30);
            localStorage.setItem(key, lang);
            
            document.cookie = `googtrans=/en/${lang}; path=/`;
            document.cookie = `googtrans=/en/${lang}; domain=${location.hostname}; path=/`;

            window.currentSelectedLang = lang;

            // Instant Real-Time translation without full reload
            if (!applyTranslationToCombo(lang)) {
                window.location.reload();
            } else {
                revealPage();
                updateLanguageLabel(lang);
            }
        }

        function revealPage() {
            document.documentElement.classList.remove('lang-loading');
            document.documentElement.classList.add('lang-ready');
            if (document.body) {
                document.body.style.visibility = 'visible';
                document.body.style.opacity = '1';
            }
        }

        function updateLanguageLabel(lang) {
            const langNames = {
                'en': 'English',
                'hi': 'Hindi (हिंदी)',
                'mr': 'Marathi (मराठी)',
                'gu': 'Gujarati (ગુજરાતી)',
                'pa': 'Punjabi (ਪੰਜਾਬੀ)',
                'bn': 'Bengali (বাংলা)',
                'ta': 'Tamil (தமிழ்)',
                'te': 'Telugu (తెలుగు)',
                'kn': 'Kannada (ಕನ್ನಡ)',
                'ml': 'Malayalam (മലയാളം)'
            };
            const el = document.getElementById('selectedLangName');
            if (el && langNames[lang]) {
                el.textContent = langNames[lang];
            }
        }

        // Google Translate Engine Initialization & Real-Time Sync
        function googleTranslateElementInit() {
            new google.translate.TranslateElement({
                pageLanguage: 'en',
                includedLanguages: 'en,hi,mr,gu,pa,bn,ta,te,kn,ml',
                autoDisplay: false
            }, 'google_translate_element');

            var attempts = 0;
            var syncTimer = setInterval(function() {
                attempts++;
                var lang = window.currentSelectedLang;
                if (lang && lang !== 'en') {
                    if (applyTranslationToCombo(lang)) {
                        revealPage();
                        updateLanguageLabel(lang);
                        clearInterval(syncTimer);
                    }
                } else {
                    revealPage();
                    clearInterval(syncTimer);
                }
                if (attempts > 30) {
                    revealPage();
                    clearInterval(syncTimer);
                }
            }, 30);
        }

        // Real-Time MutationObserver for immediate reveal
        (function() {
            if (document.documentElement.classList.contains('lang-loading')) {
                const observer = new MutationObserver(function() {
                    if (document.documentElement.classList.contains('translated-ltr') || 
                        document.documentElement.classList.contains('translated-rtl')) {
                        revealPage();
                        observer.disconnect();
                    }
                });
                observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
                setTimeout(revealPage, 120);
            }
        })();
    </script>

    <!-- Google Translate Engine Pre-Loader -->
    <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

    <title>@(ViewData["Title"] ?? "RaahSathi | Roadside Assistance")</title>
