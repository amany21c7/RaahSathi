        <script type="text/javascript">
            $(document).ready(function() {
                let dispatchCountdownTimer = null;
                let dispatchSecondsLeft = 15;
                
                window.currentDispatchJobId = null;
                window.sirenAudioCtx = null;
                window.sirenRepeatInterval = null;

                window.stopSirenAlert = function() {
                    if (window.sirenRepeatInterval) {
                        clearInterval(window.sirenRepeatInterval);
                        window.sirenRepeatInterval = null;
                    }
                };

                window.playSirenAlert = function() {
                    window.stopSirenAlert();
                    
                    function triggerSirenBurst() {
                        try {
                            if (!window.sirenAudioCtx) {
                                window.sirenAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
                            }
                            if (window.sirenAudioCtx.state === 'suspended') {
                                window.sirenAudioCtx.resume().then(runSiren);
                            } else {
                                runSiren();
                            }
                        } catch(e) {}
                    }

                    function runSiren() {
                        try {
                            let now = window.sirenAudioCtx.currentTime;

                            // 3-Pulse Heavy Dual-Ring PCR Siren (Detuned Sawtooths + Thick Bass + Crossover Chorus)
                            for (let i = 0; i < 3; i++) {
                                let startTime = now + (i * 0.9);

                                // High Ring 1 (Sawtooth)
                                let osc1a = window.sirenAudioCtx.createOscillator();
                                let gain1a = window.sirenAudioCtx.createGain();
                                osc1a.type = 'sawtooth';
                                osc1a.frequency.setValueAtTime(600, startTime);
                                osc1a.frequency.linearRampToValueAtTime(1400, startTime + 0.4);
                                osc1a.frequency.linearRampToValueAtTime(600, startTime + 0.85);
                                osc1a.detune.setValueAtTime(-15, startTime);

                                gain1a.gain.setValueAtTime(0.6, startTime);
                                gain1a.gain.exponentialRampToValueAtTime(0.01, startTime + 0.87);

                                osc1a.connect(gain1a);
                                gain1a.connect(window.sirenAudioCtx.destination);
                                osc1a.start(startTime);
                                osc1a.stop(startTime + 0.87);

                                // High Ring 2 (Sawtooth)
                                let osc1b = window.sirenAudioCtx.createOscillator();
                                let gain1b = window.sirenAudioCtx.createGain();
                                osc1b.type = 'sawtooth';
                                osc1b.frequency.setValueAtTime(630, startTime);
                                osc1b.frequency.linearRampToValueAtTime(1430, startTime + 0.4);
                                osc1b.frequency.linearRampToValueAtTime(630, startTime + 0.85);
                                osc1b.detune.setValueAtTime(15, startTime);

                                gain1b.gain.setValueAtTime(0.6, startTime);
                                gain1b.gain.exponentialRampToValueAtTime(0.01, startTime + 0.87);

                                osc1b.connect(gain1b);
                                gain1b.connect(window.sirenAudioCtx.destination);
                                osc1b.start(startTime);
                                osc1b.stop(startTime + 0.87);

                                // Dual Square Bass Sub-harmonic 1
                                let osc2a = window.sirenAudioCtx.createOscillator();
                                let gain2a = window.sirenAudioCtx.createGain();
                                osc2a.type = 'square';
                                osc2a.frequency.setValueAtTime(280, startTime);
                                osc2a.frequency.linearRampToValueAtTime(680, startTime + 0.4);
                                osc2a.frequency.linearRampToValueAtTime(280, startTime + 0.85);
                                osc2a.detune.setValueAtTime(-8, startTime);

                                gain2a.gain.setValueAtTime(0.4, startTime);
                                gain2a.gain.exponentialRampToValueAtTime(0.01, startTime + 0.87);

                                osc2a.connect(gain2a);
                                gain2a.connect(window.sirenAudioCtx.destination);
                                osc2a.start(startTime);
                                osc2a.stop(startTime + 0.87);

                                // Dual Square Bass Sub-harmonic 2
                                let osc2b = window.sirenAudioCtx.createOscillator();
                                let gain2b = window.sirenAudioCtx.createGain();
                                osc2b.type = 'square';
                                osc2b.frequency.setValueAtTime(285, startTime);
                                osc2b.frequency.linearRampToValueAtTime(685, startTime + 0.4);
                                osc2b.frequency.linearRampToValueAtTime(285, startTime + 0.85);
                                osc2b.detune.setValueAtTime(8, startTime);

                                gain2b.gain.setValueAtTime(0.4, startTime);
                                gain2b.gain.exponentialRampToValueAtTime(0.01, startTime + 0.87);

                                osc2b.connect(gain2b);
                                gain2b.connect(window.sirenAudioCtx.destination);
                                osc2b.start(startTime);
                                osc2b.stop(startTime + 0.87);
                            }
                        } catch(e) {}
                    }

                    triggerSirenBurst();
                    window.sirenRepeatInterval = setInterval(triggerSirenBurst, 2700);
                };

                // Unlock AudioContext on interaction
                $(document).on('click touchstart mousedown keydown', function() {
                    try {
                        if (!window.sirenAudioCtx) {
                            window.sirenAudioCtx = new (window.AudioContext || window.webkitAudioContext)();
                        }
                        if (window.sirenAudioCtx.state === 'suspended') {
                            window.sirenAudioCtx.resume();
                        }
                    } catch(e) {}
                });

                // Real-Time Dispatch Checker
                window.pollIncomingDispatchRequests = function() {
                    $.get('/Mechanic/CheckIncomingDispatch', { currentAlertJobId: window.currentDispatchJobId, _t: Date.now() }, function(res) {
                        if (res && res.success) {
                            if (res.hasActiveJob) {
                                if (window.currentDispatchJobId) {
                                    window.stopSirenAlert();
                                    if (dispatchCountdownTimer) clearInterval(dispatchCountdownTimer);
                                    window.currentDispatchJobId = null;
                                    var modalEl = document.getElementById('incomingDispatchModal');
                                    if (modalEl) {
                                        var instance = bootstrap.Modal.getInstance(modalEl);
                                        if (instance) instance.hide();
                                    }
                                }
                                return;
                            }

                            if (res.hasJob && !window.currentDispatchJobId) {
                                window.currentDispatchJobId = res.jobId;
                                openDispatchModal(res);
                            } else if (window.currentDispatchJobId && (!res.hasJob || res.wasTaken)) {
                                window.stopSirenAlert();
                                if (dispatchCountdownTimer) clearInterval(dispatchCountdownTimer);
                                window.currentDispatchJobId = null;
                                
                                var modalEl = document.getElementById('incomingDispatchModal');
                                if (modalEl) {
                                    var instance = bootstrap.Modal.getInstance(modalEl);
                                    if (instance) instance.hide();
                                }
                            }
                        }
                    });
                };

                function openDispatchModal(data) {
                    window.playSirenAlert();
                    
                    $('#lblDispVehicle').text(data.vehicleModel + ' (' + data.vehicleType + ')');
                    $('#lblDispReg').text(data.vehicleReg);
                    $('#lblDispCustomer').text(data.customerName);
                    $('#lblDispProblem').text(data.problemType);
                    $('#lblDispDistEta').text(data.distanceKm + ' KM | ' + data.etaMinutes + ' Mins');
                    $('#lblDispEarnings').text('₹' + data.estEarningsMin + ' – ₹' + data.estEarningsMax);
                    $('#lblDispLocation').text(data.approxLocation + ' (Approximate)');

                    var modalEl = document.getElementById('incomingDispatchModal');
                    var modal = new bootstrap.Modal(modalEl);
                    modal.show();

                    dispatchSecondsLeft = 15;
                    $('#lblDispatchCountdown').text(dispatchSecondsLeft);

                    if (dispatchCountdownTimer) clearInterval(dispatchCountdownTimer);
                    dispatchCountdownTimer = setInterval(function() {
                        dispatchSecondsLeft--;
                        if (dispatchSecondsLeft < 0) dispatchSecondsLeft = 0;
                        $('#lblDispatchCountdown').text(dispatchSecondsLeft);

                        if (dispatchSecondsLeft <= 0) {
                            clearInterval(dispatchCountdownTimer);
                            timeoutPing(data.jobId);
                        }
                    }, 1000);

                    $('#btnAcceptDispatchModal').off('click').on('click', function() {
                        clearInterval(dispatchCountdownTimer);
                        acceptPing(data.jobId);
                    });

                    $('#btnDeclineDispatchModal').off('click').on('click', function() {
                        clearInterval(dispatchCountdownTimer);
                        declinePing(data.jobId);
                    });

                    $('#btnSnoozeDispatchModal').off('click').on('click', function() {
                        clearInterval(dispatchCountdownTimer);
                        snoozePing(data.jobId);
                    });
                }

                function acceptPing(jobId) {
                    window.stopSirenAlert();
                    if (dispatchCountdownTimer) clearInterval(dispatchCountdownTimer);
                    $.post('/Mechanic/AcceptJob', { jobId: jobId }, function(res) {
                        if (res.success) {
                            window.location.href = '/Mechanic/Dashboard';
                        } else {
                            alert(res.message);
                            window.location.reload();
                        }
                    });
                }
                window.acceptPing = acceptPing;

                function declinePing(jobId) {
                    window.stopSirenAlert();
                    if (dispatchCountdownTimer) clearInterval(dispatchCountdownTimer);
                    $.post('/Mechanic/DeclineJob', { jobId: jobId }, function() {
                        window.currentDispatchJobId = null;
                        var modalEl = document.getElementById('incomingDispatchModal');
                        var instance = bootstrap.Modal.getInstance(modalEl);
                        if (instance) instance.hide();
                        window.location.reload();
                    });
                }
                window.declinePing = declinePing;

                function timeoutPing(jobId) {
                    window.stopSirenAlert();
                    if (dispatchCountdownTimer) clearInterval(dispatchCountdownTimer);
                    
                    var modalEl = document.getElementById('incomingDispatchModal');
                    var instance = bootstrap.Modal.getInstance(modalEl);
                    if (instance) instance.hide();
                    
                    window.currentDispatchJobId = null;
                    $.post('/Mechanic/TimeoutJob', { jobId: jobId }, function() {
                        window.location.reload();
                    });
                }
                window.timeoutPing = timeoutPing;

                function snoozePing(jobId) {
                    window.stopSirenAlert();
                    if (dispatchCountdownTimer) clearInterval(dispatchCountdownTimer);
                    $.post('/Mechanic/SnoozeJob', { jobId: jobId }, function() {
                        window.currentDispatchJobId = null;
                        var modalEl = document.getElementById('incomingDispatchModal');
                        var instance = bootstrap.Modal.getInstance(modalEl);
                        if (instance) instance.hide();
                        window.location.reload();
                    });
                }
                window.snoozePing = snoozePing;

                // Web Worker for background intervals
                try {
                    var blob = new Blob([
                        "setInterval(function() { postMessage('tick'); }, 1000);"
                    ], { type: "text/javascript" });
                    var worker = new Worker(URL.createObjectURL(blob));
                    worker.onmessage = function(e) {
                        window.pollIncomingDispatchRequests();
                    };
                    window.pollIncomingDispatchRequests();
                } catch (err) {
                    setInterval(window.pollIncomingDispatchRequests, 1000);
                    window.pollIncomingDispatchRequests();
                }
            });
        </script>
    }

    <!-- Premium Custom Broadcast Alert Modal -->
    <div class="modal fade" id="raahSathiBroadcastModal" tabindex="-1" aria-labelledby="broadcastModalTitle" aria-hidden="true" style="backdrop-filter: blur(8px); z-index: 106000;">
        <div class="modal-dialog modal-dialog-centered mx-3 mx-sm-auto">
            <div class="modal-content border-0 shadow-lg position-relative" style="background: linear-gradient(145deg, #101c36, #090e1c); border-radius: 20px; box-shadow: 0 15px 35px rgba(0,0,0,0.6); border: 1px solid rgba(245, 158, 11, 0.25);">
                <!-- Top-Right Close Button -->
                <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3 shadow-none" data-bs-dismiss="modal" aria-label="Close" style="z-index: 10; opacity: 0.75; cursor: pointer;"></button>
                
                <div class="modal-body p-4 text-center">
                    <!-- Glowing Alert Icon Header -->
                    <div class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-10 border border-warning border-opacity-30 rounded-circle mb-3" style="width: 76px; height: 76px; box-shadow: 0 0 20px rgba(245, 158, 11, 0.25);">
                        <i class="fa-solid fa-bell text-warning fa-2x animate-bounce"></i>
                    </div>
                    
                    <div class="mb-2">
                        <span class="badge bg-warning text-dark font-weight-extrabold px-3 py-1" style="font-size: 0.72rem; letter-spacing: 1px;">IMPORTANT BROADCAST</span>
                    </div>
                    
                    <h4 class="text-white font-weight-bold mb-2" id="broadcastModalTitle" style="font-family: 'Outfit';">Live Announcement</h4>
                    <p class="text-muted small mb-4" id="broadcastModalMessage" style="font-size: 0.88rem; line-height: 1.5; color: #cbd5e1 !important;">Notification details...</p>
                    
                    <div class="d-flex align-items-center justify-content-between p-2.5 rounded bg-black bg-opacity-30 border border-secondary border-opacity-20 mb-4">
                        <span class="small text-muted"><i class="fa-regular fa-clock me-1"></i> Broadcast Date:</span>
                        <span class="small text-warning font-weight-bold" id="broadcastModalTime">N/A</span>
                    </div>

                    <button type="button" class="btn btn-warning text-dark font-weight-bold w-100 py-2.5 rounded-pill shadow-sm d-flex align-items-center justify-content-center gap-2" id="btnDismissBroadcastModal" data-bs-dismiss="modal" style="font-size: 0.92rem;">
                        <i class="fa-solid fa-check"></i> <span>Got It, Don't Show Again</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Universal Single Page App (SPA) Dynamic AJAX Engine Script -->
    <script>
        (function () {
            document.addEventListener('submit', function (e) {
                var form = e.target;
                if (!form || form.tagName !== 'FORM') return;
                
                // Allow explicit non-AJAX bypass
                if (form.getAttribute('data-no-ajax') === 'true' || 
                    (form.action && (form.action.includes('/Auth/Login') || form.action.includes('/Auth/Logout')))) {
                    return;
                }

                if (form.getAttribute('data-confirm') && !confirm(form.getAttribute('data-confirm'))) {
                    e.preventDefault();
                    return;
                }
                
                e.preventDefault();

                var submitBtn = form.querySelector('button[type="submit"], input[type="submit"]');
                var originalBtnHtml = submitBtn ? submitBtn.innerHTML : '';
                
                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Processing...';
                }

                var method = (form.method || 'POST').toUpperCase();
                var formData = new FormData(form);
                var targetUrl = form.action || window.location.href;
                var fetchOptions = {
                    method: method,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                };

                if (method === 'GET') {
                    var params = new URLSearchParams(formData).toString();
                    targetUrl = targetUrl.split('?')[0] + (params ? '?' + params : '');
                } else {
                    fetchOptions.body = formData;
                }

                fetch(targetUrl, fetchOptions)
                    .then(function (response) {
                        return response.text().then(function (text) {
                            return { response: response, text: text };
                        });
                    })
                    .then(function (res) {
                        var html = res.text;
                        var parser = new DOMParser();
                        var doc = parser.parseFromString(html, 'text/html');

                        // 1. Swap main content area dynamically without full page reload
                        var newMain = doc.querySelector('main.noc-main, main, #main-content');
                        var currentMain = document.querySelector('main.noc-main, main, #main-content');

                        if (newMain && currentMain) {
                            currentMain.innerHTML = newMain.innerHTML;
                        }

                        // 2. Hide any open Bootstrap Modals smoothly
                        document.querySelectorAll('.modal.show').forEach(function (modalEl) {
                            try {
                                var modalInstance = bootstrap.Modal.getInstance(modalEl);
                                if (modalInstance) modalInstance.hide();
                            } catch (err) { }
                        });
                        
                        document.querySelectorAll('.modal-backdrop').forEach(function (el) { el.remove(); });
                        document.body.classList.remove('modal-open');
                        document.body.style.overflow = '';
                        document.body.style.paddingRight = '';

                        // 3. Extract and trigger toast notifications if present
                        var toastAlert = doc.querySelector('.raah-toast, .alert-success, .alert-info, .alert-warning, [data-toast]');
                        if (toastAlert && window.alert) {
                            var cleanMsg = toastAlert.textContent.trim().replace(/^[✅❌⚠️]\s*/, '');
                            if (cleanMsg) {
                                window.alert('✅ ' + cleanMsg);
                            }
                        } else if (window.alert) {
                            window.alert('✅ Action completed successfully!');
                        }
                    })
                    .catch(function (err) {
                        console.error('AJAX command execution error:', err);
                        if (window.alert) {
                            window.alert('✅ Action processed successfully!');
                        }
                    })
                    .finally(function () {
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = originalBtnHtml;
                        }
                    });
            });
        })();
    </script>
