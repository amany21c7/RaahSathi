    <script type="text/javascript">
        $(document).ready(function () {
            var searchInputs = $('#globalSearchInput, #mobileSearchInput');
            var debounceTimer;

            // Close search results dropdown on clicking outside
            $(document).on('click', function (e) {
                if (!$(e.target).closest('.noc-topbar-search, .position-relative').length) {
                    $('#globalSearchResults, #mobileSearchResults').hide();
                }
            });

            // Prevent closing when clicking inside results
            $('#globalSearchResults, #mobileSearchResults').on('click', function(e) {
                e.stopPropagation();
            });

            searchInputs.on('input focus', function () {
                clearTimeout(debounceTimer);
                var self = $(this);
                var query = self.val();
                var resultsDiv = self.siblings('.dropdown-menu');

                if (!query || query.trim().length < 2) {
                    resultsDiv.hide().empty();
                    return;
                }

                debounceTimer = setTimeout(function () {
                    $.getJSON('/Admin/GlobalSearch', { query: query }, function (data) {
                        resultsDiv.empty();

                        if (!data.success) {
                            resultsDiv.append('<div class="dropdown-header text-danger"><i class="fa-solid fa-triangle-exclamation me-1"></i> Error loading results</div>');
                            resultsDiv.show();
                            return;
                        }

                        var hasResults = false;

                        // Mechanics Header
                        if (data.mechanics && data.mechanics.length > 0) {
                            hasResults = true;
                            resultsDiv.append('<h6 class="dropdown-header text-info font-weight-bold pb-1 pt-2 px-3 m-0" style="font-size:0.75rem;"><i class="fa-solid fa-user-gear me-1"></i> MECHANICS (' + data.mechanics.length + ')</h6>');
                            data.mechanics.forEach(function (m) {
                                var badgeKyc = m.kycStatus === 'Approved' ? 'bg-success' : 'bg-warning text-dark';
                                var onlineStatus = m.isOnline ? '<span class="text-success ms-1">🟢</span>' : '<span class="text-muted ms-1">⚫</span>';
                                var html = '<a class="dropdown-item d-flex align-items-center justify-content-between py-2 px-3 border-bottom border-secondary border-opacity-10 text-white small" href="javascript:void(0);" onclick="showGlobalMechanicDetails(' + m.id + ')">' +
                                    '<div>' +
                                    '  <strong class="text-light font-weight-bold">' + m.name + '</strong>' + onlineStatus +
                                    '  <div class="text-muted small" style="font-size:0.75rem;">' + (m.shopName || 'Independent Partner') + ' | ' + m.phone + '</div>' +
                                    '</div>' +
                                    '<span class="badge ' + badgeKyc + ' font-weight-bold small" style="font-size:0.65rem;">' + m.kycStatus + '</span>' +
                                    '</a>';
                                resultsDiv.append(html);
                            });
                        }

                        // Jobs Header
                        if (data.jobs && data.jobs.length > 0) {
                            hasResults = true;
                            resultsDiv.append('<h6 class="dropdown-header text-warning font-weight-bold pb-1 pt-2 px-3 m-0" style="font-size:0.75rem;"><i class="fa-solid fa-wrench me-1"></i> ACTIVE JOBS (' + data.jobs.length + ')</h6>');
                            data.jobs.forEach(function (j) {
                                var badgeClass = 'bg-secondary';
                                if (j.status === 'Completed') badgeClass = 'bg-success';
                                else if (j.status === 'Cancelled') badgeClass = 'bg-danger';
                                else if (j.status === 'Assigned') badgeClass = 'bg-info text-dark';
                                else if (j.status === 'Requested') badgeClass = 'bg-warning text-dark';

                                var html = '<a class="dropdown-item d-flex align-items-center justify-content-between py-2 px-3 border-bottom border-secondary border-opacity-10 text-white small" href="javascript:void(0);" onclick="showGlobalJobDetails(' + j.id + ')">' +
                                    '<div>' +
                                    '  <strong class="text-light font-weight-bold">#RS-' + String(j.id).padStart(4, '0') + ' (' + j.problem + ')</strong>' +
                                    '  <div class="text-muted small" style="font-size:0.75rem;">Cust: ' + j.customerName + ' | Tech: ' + j.mechanicName + '</div>' +
                                    '</div>' +
                                    '<span class="badge ' + badgeClass + ' font-weight-bold small" style="font-size:0.65rem;">' + j.status + '</span>' +
                                    '</a>';
                                resultsDiv.append(html);
                            });
                        }

                        if (!hasResults) {
                            resultsDiv.append('<div class="p-3 text-center text-muted small"><i class="fa-solid fa-magnifying-glass-minus me-1"></i> No matching entries found</div>');
                        }

                        resultsDiv.show();
                    });
                }, 250);
            });
        });

        function showGlobalJobDetails(jobId) {
            $('#globalSearchResults, #mobileSearchResults').hide();
            if ($('.noc-sidebar').hasClass('show')) {
                toggleAdminSidebar();
            }
            $.getJSON('/Admin/GetGlobalJobDetails', { id: jobId }, function (data) {
                if (!data.success) {
                    alert(data.message || "Failed to load job details.");
                    return;
                }

                $('#gJobTitle').text('Job Details: ' + data.displayId);
                $('#gJobStatus').text(data.status).attr('class', 'badge font-weight-bold').addClass(
                    data.status === 'Completed' ? 'bg-success text-white' :
                    data.status === 'Cancelled' ? 'bg-danger text-white' :
                    data.status === 'Assigned' ? 'bg-info text-dark' : 'bg-warning text-dark'
                );
                $('#gJobDate').text(data.date);
                $('#gJobCustomer').text(data.customerName);
                $('#gJobCustomerPhone').text(data.customerPhone);
                $('#gJobMechanic').text(data.mechanicName);
                $('#gJobMechanicPhone').text(data.mechanicPhone);
                $('#gJobVehicle').text(data.vehicle);
                $('#gJobProblem').text(data.problem);
                $('#gJobDesc').text(data.description || 'No description provided.');
                $('#gJobAddress').text(data.address);

                // Financials
                $('#gJobBillVisit').text('₹' + data.visiting.toFixed(2));
                $('#gJobBillService').text('₹' + data.service.toFixed(2));

                if (data.customEst > 0) {
                    $('#rowGJobCustomEst').show();
                    $('#gJobBillCustomEst').text('₹' + data.customEst.toFixed(2));
                } else {
                    $('#rowGJobCustomEst').hide();
                }

                if (data.parts > 0) {
                    $('#rowGJobParts').show();
                    $('#gJobBillParts').text('₹' + data.parts.toFixed(2));
                } else {
                    $('#rowGJobParts').hide();
                }

                if (data.labour > 0) {
                    $('#rowGJobLabour').show();
                    $('#gJobBillLabour').text('₹' + data.labour.toFixed(2));
                } else {
                    $('#rowGJobLabour').hide();
                }

                if (data.towing > 0) {
                    $('#rowGJobTowing').show();
                    $('#gJobBillTowing').text('₹' + data.towing.toFixed(2));
                } else {
                    $('#rowGJobTowing').hide();
                }

                $('#gJobBillTotal').text('₹' + data.total.toFixed(2));

                // Dispute
                if (data.disputeStatus !== 'None') {
                    $('#gJobDisputeContainer').show();
                    $('#gJobDisputeStatus').text(data.disputeStatus);
                    $('#gJobDisputeReason').text(data.disputeReason || 'No details provided.');
                } else {
                    $('#gJobDisputeContainer').hide();
                }

                var jobModal = new bootstrap.Modal(document.getElementById('globalJobDetailsModal'));
                jobModal.show();
            });
