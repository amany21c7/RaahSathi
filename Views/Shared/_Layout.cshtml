<body class="d-flex flex-column min-vh-100">
    @{
        bool isCustPage = Context.Request.Path.Value?.StartsWith("/Customer", StringComparison.OrdinalIgnoreCase) == true;
        bool isMechPage = Context.Request.Path.Value?.StartsWith("/Mechanic", StringComparison.OrdinalIgnoreCase) == true;
        bool isAdminPage = Context.Request.Path.Value?.StartsWith("/Admin", StringComparison.OrdinalIgnoreCase) == true;
        
        bool isCustLoggedIn = Context.Request.Cookies.ContainsKey("RaahSathiCustomerUserId") || Context.Request.Cookies["RaahSathiUserRole"] == "Customer";
        bool isMechLoggedIn = Context.Request.Cookies.ContainsKey("RaahSathiMechanicUserId") || Context.Request.Cookies["RaahSathiUserRole"] == "Mechanic";
        bool isAdminLoggedIn = Context.Request.Cookies.ContainsKey("RaahSathiAdminUserId") || Context.Request.Cookies["RaahSathiUserRole"] == "Admin";

        var activeRole = isAdminPage || isAdminLoggedIn ? "Admin" 
                       : isMechPage || isMechLoggedIn ? "Mechanic" 
                       : isCustPage || isCustLoggedIn ? "Customer" 
                       : (Context.Request.Cookies.ContainsKey("RaahSathiUserId") ? (Context.Request.Cookies["RaahSathiUserRole"] ?? "Guest") : "Guest");

        var rawUserName = activeRole == "Admin" ? "Admin" : (Context.Request.Cookies["RaahSathiUserName"] ?? activeRole);

        string GetUserInitials(string name)
        {
            if (string.IsNullOrWhiteSpace(name) || name == "Guest")
                return "U";
            var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 1)
            {
                return parts[0].Length >= 2 
                    ? parts[0].Substring(0, 2).ToUpper() 
                    : parts[0].ToUpper();
            }
            char first = char.ToUpper(parts[0][0]);
            char last = char.ToUpper(parts[parts.Length - 1][0]);
            return $"{first}{last}";
        }

        var activeUserInitials = GetUserInitials(rawUserName);
    }

