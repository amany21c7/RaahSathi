<body class="d-flex flex-column min-vh-100">
    <!-- Custom Alert Toast Container -->
    <div id="custom-toast-container" style="position: fixed; top: 80px; right: 20px; z-index: 105500; pointer-events: none; display: flex; flex-direction: column; gap: 10px;"></div>

    <script>
        (function() {
            var originalAlert = window.alert;
            
            window.alert = function(message) {
                if (!message) return;
                
                var container = document.getElementById('custom-toast-container');
                if (!container) {
                    originalAlert(message);
                    return;
                }
                
                var toast = document.createElement('div');
                toast.className = 'raah-toast';
                
                // Determine type of message
                var msgLower = message.toLowerCase();
                var isSuccess = message.includes('✅') || msgLower.includes('success') || msgLower.includes('approve') || msgLower.includes('released') || msgLower.includes('accepted') || msgLower.includes('complete') || msgLower.includes('received') || msgLower.includes('filed') || msgLower.includes('sent');
                var isError = message.includes('❌') || msgLower.includes('error') || msgLower.includes('fail') || msgLower.includes('unauthorized') || msgLower.includes('wrong') || msgLower.includes('blocked');
                var isWarning = message.includes('⚠️') || msgLower.includes('warning') || msgLower.includes('timedout') || msgLower.includes('stale');
                
                var icon = '<i class="fa-solid fa-circle-info text-info fs-5"></i>';
                if (isError) {
                    toast.classList.add('danger');
                    icon = '<i class="fa-solid fa-circle-xmark text-danger fs-5"></i>';
                } else if (isWarning) {
                    toast.classList.add('warning');
                    icon = '<i class="fa-solid fa-triangle-exclamation text-warning fs-5"></i>';
                } else {
                    toast.classList.add('success'); // Default to success green
                    icon = '<i class="fa-solid fa-circle-check text-success fs-5"></i>';
                }
                
                // Strip out emoji prefixes for clean text representation
                var cleanMessage = message.replace(/^[✅❌⚠️]\s*/, '');
                
                toast.innerHTML = `
                    <div class="raah-toast-content">
                        ${icon}
                        <div>${cleanMessage}</div>
                    </div>
                    <button class="raah-toast-close" onclick="this.parentElement.classList.remove('show'); setTimeout(() => this.parentElement.remove(), 300);">&times;</button>
                `;
                
                container.appendChild(toast);
                
                // Trigger reflow/animation
                setTimeout(function() {
                    toast.classList.add('show');
                }, 50);
                
                // Auto remove after 5 seconds
                setTimeout(function() {
                    if (toast && toast.parentElement) {
                        toast.classList.remove('show');
                        setTimeout(function() {
                            if (toast && toast.parentElement) {
                                toast.remove();
                            }
                        }, 300);
                    }
                }, 5000);
            };
        })();
    </script>
    @{
        bool isCustPage = Context.Request.Path.Value?.StartsWith("/Customer", StringComparison.OrdinalIgnoreCase) == true;
        bool isMechPage = Context.Request.Path.Value?.StartsWith("/Mechanic", StringComparison.OrdinalIgnoreCase) == true;
        bool isAdminPage = Context.Request.Path.Value?.StartsWith("/Admin", StringComparison.OrdinalIgnoreCase) == true;
        bool isSettingsSubPage = Context.Request.Path.Value?.StartsWith("/Admin/Settings", StringComparison.OrdinalIgnoreCase) == true
                              || Context.Request.Path.Value?.StartsWith("/Admin/Pricing", StringComparison.OrdinalIgnoreCase) == true
                              || Context.Request.Path.Value?.StartsWith("/Admin/ManagePricing", StringComparison.OrdinalIgnoreCase) == true
                              || Context.Request.Path.Value?.StartsWith("/Admin/Services", StringComparison.OrdinalIgnoreCase) == true
                              || Context.Request.Path.Value?.StartsWith("/Admin/Cities", StringComparison.OrdinalIgnoreCase) == true
                              || Context.Request.Path.Value?.StartsWith("/Admin/Payments", StringComparison.OrdinalIgnoreCase) == true
                              || Context.Request.Path.Value?.StartsWith("/Admin/Notifications", StringComparison.OrdinalIgnoreCase) == true
                              || Context.Request.Path.Value?.StartsWith("/Admin/Cms", StringComparison.OrdinalIgnoreCase) == true
                              || Context.Request.Path.Value?.StartsWith("/Admin/Account", StringComparison.OrdinalIgnoreCase) == true
                              || Context.Request.Path.Value?.StartsWith("/Admin/Admins", StringComparison.OrdinalIgnoreCase) == true
                              || Context.Request.Path.Value?.StartsWith("/Admin/Referrals", StringComparison.OrdinalIgnoreCase) == true;
        
        bool isSettingsHubPage = Context.Request.Path.Value?.Equals("/Admin/Settings", StringComparison.OrdinalIgnoreCase) == true;
        
        bool isCustLoggedIn = Context.User.Identity?.IsAuthenticated == true && Context.User.IsInRole("Customer");
        bool isMechLoggedIn = Context.User.Identity?.IsAuthenticated == true && Context.User.IsInRole("Mechanic");
        bool isAdminLoggedIn = Context.User.Identity?.IsAuthenticated == true && Context.User.IsInRole("Admin");
        
        string adminSubRole = Context.User.FindFirst("AdminRole")?.Value ?? "Super Admin";
        bool isSuperAdmin = isAdminLoggedIn && adminSubRole.Equals("Super Admin", StringComparison.OrdinalIgnoreCase);

        var activeRole = isAdminLoggedIn ? "Admin" 
                       : isMechLoggedIn ? "Mechanic" 
                       : isCustLoggedIn ? "Customer" 
                       : "Guest";

        var rawUserName = Context.User.Identity?.IsAuthenticated == true ? Context.User.Identity.Name : "Guest";

        string GetUserInitials(string? name)
        {
            if (string.IsNullOrWhiteSpace(name) || name == "Guest")
                return "U";
            var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 1)
            {
                return parts[0].Length >= 2 
                    ? parts[0].Substring(0, 2).ToUpper() 
                    : parts[0].ToUpper();
            }
            char first = char.ToUpper(parts[0][0]);
            char last = char.ToUpper(parts[parts.Length - 1][0]);
            return $"{first}{last}";
        }

        var activeUserInitials = GetUserInitials(rawUserName);
    }

