                            <ul class="dropdown-menu dropdown-menu-end bg-dark border-secondary shadow-lg" style="max-height: 380px; overflow-y: auto; z-index: 1060;">
                                <li><a class="dropdown-item text-light py-2" href="#" onclick="changeLanguage('en')"><i class="fa-solid fa-globe me-2 text-warning"></i>English</a></li>
                                <li><a class="dropdown-item text-light py-2" href="#" onclick="changeLanguage('hi')"><i class="fa-solid fa-language me-2 text-warning"></i>Hindi (हिंदी)</a></li>
                                <li><a class="dropdown-item text-light py-2" href="#" onclick="changeLanguage('mr')"><i class="fa-solid fa-language me-2 text-warning"></i>Marathi (मराठी)</a></li>
                                <li><a class="dropdown-item text-light py-2" href="#" onclick="changeLanguage('gu')"><i class="fa-solid fa-language me-2 text-warning"></i>Gujarati (ગુજરાતી)</a></li>
                                <li><a class="dropdown-item text-light py-2" href="#" onclick="changeLanguage('pa')"><i class="fa-solid fa-language me-2 text-warning"></i>Punjabi (ਪੰਜਾਬੀ)</a></li>
                                <li><a class="dropdown-item text-light py-2" href="#" onclick="changeLanguage('bn')"><i class="fa-solid fa-language me-2 text-warning"></i>Bengali (বাংলা)</a></li>
                                <li><a class="dropdown-item text-light py-2" href="#" onclick="changeLanguage('ta')"><i class="fa-solid fa-language me-2 text-warning"></i>Tamil (தமிழ்)</a></li>
                                <li><a class="dropdown-item text-light py-2" href="#" onclick="changeLanguage('te')"><i class="fa-solid fa-language me-2 text-warning"></i>Telugu (తెలుగు)</a></li>
                                <li><a class="dropdown-item text-light py-2" href="#" onclick="changeLanguage('kn')"><i class="fa-solid fa-language me-2 text-warning"></i>Kannada (ಕನ್ನಡ)</a></li>
                                <li><a class="dropdown-item text-light py-2" href="#" onclick="changeLanguage('ml')"><i class="fa-solid fa-language me-2 text-warning"></i>Malayalam (മലയാളം)</a></li>
                            </ul>
                        </div>
                        
                        <!-- Auth Actions -->
                        @if (activeRole != "Guest")
                        {
                            <div class="dropdown">
                                <button class="btn btn-nav-user dropdown-toggle d-flex align-items-center gap-1.5" type="button" data-bs-toggle="dropdown" title="@rawUserName (@activeRole)">
                                    @if (activeRole == "Admin")
                                    {
                                        <span class="d-inline-flex align-items-center justify-content-center bg-black rounded-circle shadow-sm border border-warning overflow-hidden" style="width: 30px; height: 30px;">
                                            <img src="~/images/header-logo.png?v=8" asp-append-version="true" alt="RaahSathi Logo" style="width: 100%; height: 100%; object-fit: contain; padding: 2px;" />
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="d-inline-flex align-items-center justify-content-center bg-warning text-dark rounded-circle font-weight-extrabold shadow-sm" style="width: 28px; height: 28px; font-size: 0.8rem; letter-spacing: 0.5px;">
                                            @activeUserInitials
                                        </span>
                                    }
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end bg-dark border-secondary shadow-lg py-2" style="min-width: 160px;">
                                    <li><h6 class="dropdown-header text-warning font-weight-bold fs-6 mb-1"><i class="fa-solid @(activeRole == "Admin" ? "fa-user-shield" : "fa-circle-user") me-1"></i> @rawUserName</h6></li>
                                    <li><hr class="dropdown-divider border-secondary my-1" /></li>
                                    <li><a class="dropdown-item text-danger py-2 font-weight-bold" href="/Auth/Logout"><i class="fa-solid fa-sign-out-alt me-2"></i> Logout</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a href="/Auth/Login" class="btn btn-nav-login">
                                <span>Login / Sign Up</span> <i class="fa-solid fa-arrow-right"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

