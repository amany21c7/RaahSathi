            new google.translate.TranslateElement({
                pageLanguage: 'en',
                includedLanguages: 'en,hi,mr,gu,pa,bn,ta,te,kn,ml',
                autoDisplay: false
            }, 'google_translate_element');
        }

        // Overriding native window.alert to render HTML DOM modal so Google Translate & language engine translate all alerts!
        (function() {
            var originalAlert = window.alert;
            window.alert = function(msg) {
                if (!msg) return;
                var modalEl = document.getElementById('globalAlertModal');
                var msgEl = document.getElementById('globalAlertModalMessage');
                if (modalEl && msgEl) {
                    msgEl.innerText = msg;
                    var bsModal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                    bsModal.show();
                } else {
                    originalAlert(msg);
                }
            };
        })();
    </script>
