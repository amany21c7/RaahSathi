        // Global Enter Key Behavior: Submit card inputs or trigger primary actions in modals
        $(document).ready(function() {
            // 1. Pressing Enter inside any text/password input clicks the primary button in the same card/container
            $(document).on('keypress', 'input[type="text"], input[type="password"], input[type="tel"], input[type="email"]', function(e) {
                if (e.which === 13) { // Enter key
                    e.preventDefault();
                    var container = $(this).closest('.card, .modal-content, .glass-card, div.mb-3, div.p-4, form, .form-container, .glass-form');
                    if (container.length) {
                        var btn = container.find('button.btn-primary, button.btn-warning, button.btn-success, button[id*="Submit"], button[id*="Login"], button[id^="btn"]').first();
                        if (btn.length) {
                            btn.click();
                        }
                    }
                }
            });

            // 2. Pressing Enter when a modal is showing triggers the primary action button of the modal
            $(document).on('keydown', function(e) {
                if (e.which === 13) { // Enter key
                    var openModal = $('.modal.show');
                    if (openModal.length) {
                        // Check if the focus is NOT already on a button or inputs
                        if (!$(document.activeElement).is('button, input, textarea')) {
                            var primaryBtn = openModal.find('.modal-footer button.btn-primary, .modal-footer button.btn-warning, .modal-footer button.btn-success, .modal-footer button[id*="Accept"], .modal-footer button[id^="btn"]').first();
                            if (primaryBtn.length) {
                                e.preventDefault();
                                primaryBtn.click();
                            }
                        }
                    }
                }
            });

            // Real-Time Push Notifications fetcher
            var isUserAuthenticated = @((User.Identity?.IsAuthenticated == true).ToString().ToLower());
            var currentBroadcastModalId = null;
            var sessionDismissedBroadcastIds = [];

            function isHomePageCheck() {
                var p = (window.location.pathname || '').toLowerCase();
                return p === '/' || p === '' || p === '/home' || p === '/home/' || p === '/home/index' || p === '/home/index/';
            }

            function markBroadcastNotificationDismissed(id) {
                if (!id) return;
                var numId = parseInt(id);
                if (isNaN(numId)) return;
                
                // Track in-session dismissal so 30s background poll doesn't reopen it in same view
                if (!sessionDismissedBroadcastIds.includes(numId)) {
                    sessionDismissedBroadcastIds.push(numId);
                }

                // If user is logged in, save permanently in localStorage so it never shows again
                if (isUserAuthenticated) {
                    try {
                        var dismissedNotifs = JSON.parse(localStorage.getItem('raahsathi_dismissed_notifs') || '[]');
                        if (!Array.isArray(dismissedNotifs)) dismissedNotifs = [];
                        dismissedNotifs = dismissedNotifs.map(Number);
                        if (!dismissedNotifs.includes(numId)) {
                            dismissedNotifs.push(numId);
                            localStorage.setItem('raahsathi_dismissed_notifs', JSON.stringify(dismissedNotifs));
                        }
                    } catch(e) {
                        console.error('Error saving dismissed notif:', e);
                    }
                }
            }

            window.pollPushNotifications = function() {
                $.get('/Home/GetActiveNotifications', { _t: Date.now() }, function(res) {
                    if (res && res.success && res.notifications) {
                        var notifications = res.notifications;
                        var newCount = 0;
                        var lastSeenId = parseInt(localStorage.getItem('raahsathi_last_seen_notif_id') || '0');
                        var maxId = lastSeenId;
                        
                        var dismissedNotifs = [];
                        try {
                            dismissedNotifs = JSON.parse(localStorage.getItem('raahsathi_dismissed_notifs') || '[]');
                            if (Array.isArray(dismissedNotifs)) {
                                dismissedNotifs = dismissedNotifs.map(Number);
                            } else {
                                dismissedNotifs = [];
                            }
                        } catch(e) {
                            dismissedNotifs = [];
                        }

                        var showPopupNotif = null;
                        var onHome = isHomePageCheck();
                        
                        var listHtml = '';
                        if (notifications.length === 0) {
                            listHtml = '<div class="text-center py-4 text-muted small">' +
                                '<i class="fa-solid fa-bell-slash fa-2x mb-2 text-secondary opacity-50"></i>' +
                                '<p class="mb-0">No active notifications.</p>' +
                                '</div>';
                        } else {
                            $.each(notifications, function(idx, n) {
                                var nid = parseInt(n.id);
                                if (nid > lastSeenId) {
                                    newCount++;
                                    if (nid > maxId) {
                                        maxId = nid;
                                    }
                                }
                                
                                // Auto popup logic strictly based on Admin's Target Audience setting:
                                var shouldPopup = false;
                                var audience = (n.targetAudience || '').toLowerCase();
                                var isHomepageOnly = (audience.indexOf('homepage') !== -1);

                                if (!isUserAuthenticated) {
                                    if (isHomepageOnly) {
                                        // Admin chose Homepage Visitors -> Show popup ONLY on Homepage
                                        if (onHome && !sessionDismissedBroadcastIds.includes(nid)) {
                                            shouldPopup = true;
                                        }
                                    } else {
                                        // Admin chose All Users -> Show popup on any public page (unless dismissed in session)
                                        if (!sessionDismissedBroadcastIds.includes(nid)) {
                                            shouldPopup = true;
                                        }
                                    }
                                } else if (isUserAuthenticated) {
                                    if (!dismissedNotifs.includes(nid) && !sessionDismissedBroadcastIds.includes(nid)) {
                                        shouldPopup = true;
                                    }
                                }
                                
                                if (shouldPopup) {
                                    if (!showPopupNotif || nid > showPopupNotif.id) {
                                        showPopupNotif = n;
                                    }
                                }
                                
                                listHtml += '<div class="p-3 border-bottom border-secondary border-opacity-30 hover-lift" style="cursor: pointer;" onclick="openBroadcastModalDirect(' + n.id + ', \'' + encodeURIComponent(n.title) + '\', \'' + encodeURIComponent(n.message) + '\', \'' + n.sentAt + '\')">' +
                                    '<div class="d-flex justify-content-between align-items-start mb-1">' +
                                        '<strong class="text-white small" style="font-family:\'Outfit\';">' + n.title + '</strong>' +
                                        '<span class="text-muted extra-small" style="font-size: 0.68rem;">' + n.sentAt + '</span>' +
                                    '</div>' +
                                    '<p class="text-muted small mb-0" style="font-size: 0.78rem; line-height: 1.35;">' + n.message + '</p>' +
                                    '</div>';
                            });
                        }
                        
                        // Update DOM elements if they exist
                        $('#notificationItemsList').html(listHtml);
                        $('#notificationCountBadge').text(newCount + ' New');
                        
                        if (newCount > 0) {
                            $('#notificationBadge').text(newCount).removeClass('d-none');
                        } else {
                            $('#notificationBadge').addClass('d-none');
                        }
                        
                        // Auto popup when loaded if there is an active notification to display
                        if (showPopupNotif) {
                            showBroadcastModal(showPopupNotif.id, showPopupNotif.title, showPopupNotif.message, showPopupNotif.sentAt);
                        }
                        
                        // Save last seen ID on dropdown open
                        $('#notificationBellBtn').off('click').on('click', function() {
                            localStorage.setItem('raahsathi_last_seen_notif_id', maxId);
                            $('#notificationBadge').addClass('d-none');
                            $('#notificationCountBadge').text('0 New');
                        });
                    }
                });
            };

            function showBroadcastModal(id, title, message, sentAt) {
                currentBroadcastModalId = id;
                $('#broadcastModalTitle').text(title);
                $('#broadcastModalMessage').text(message);
                $('#broadcastModalTime').html('<i class="fa-regular fa-clock me-1"></i> ' + sentAt);
                
                var modalEl = document.getElementById('raahSathiBroadcastModal');
                if (!modalEl) return;

                // Whenever modal is hidden by any action (backdrop click, close button, Got It button, Esc key)
                $(modalEl).off('hidden.bs.modal').on('hidden.bs.modal', function() {
                    if (currentBroadcastModalId) {
                        markBroadcastNotificationDismissed(currentBroadcastModalId);
                    }
                });

                $('#btnDismissBroadcastModal').off('click').on('click', function() {
                    if (currentBroadcastModalId) {
                        markBroadcastNotificationDismissed(currentBroadcastModalId);
                    }
                    var instance = bootstrap.Modal.getInstance(modalEl);
                    if (instance) {
                        instance.hide();
                    }
                });

                var instance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                instance.show();
            }

            window.openBroadcastModalDirect = function(id, titleEnc, messageEnc, sentAt) {
                showBroadcastModal(id, decodeURIComponent(titleEnc), decodeURIComponent(messageEnc), sentAt);
            };

            // Start polling if user is NOT an admin
            $(document).ready(function() {
                var isAdminLoggedIn = @(isAdminLoggedIn.ToString().ToLower());
                if (!isAdminLoggedIn) {
                    window.pollPushNotifications();
                    // Check for new broadcasts every 30 seconds
                    setInterval(window.pollPushNotifications, 30000);
                }
            });

            // Real-Time Admin Operations Notification fetcher
            window.pollAdminNotifications = function() {
                $.get('/Admin/GetAdminNotifications', { _t: Date.now() }, function(res) {
                    if (res && res.success && res.notifications) {
                        var notifications = res.notifications;
                        var count = notifications.length;
                        
                        var listHtml = '';
                        if (count === 0) {
                            listHtml = '<div class="text-center py-4 text-muted small">' +
                                '<i class="fa-solid fa-circle-check fa-2x mb-2 text-success opacity-80"></i>' +
                                '<p class="mb-0">All clear! No pending tasks.</p>' +
                                '</div>';
                        } else {
                            $.each(notifications, function(idx, n) {
                                listHtml += '<a href="' + n.url + '" class="text-decoration-none d-block p-3 border-bottom border-secondary border-opacity-35 hover-lift" style="transition: background 0.15s ease;">' +
                                    '<div class="d-flex align-items-start gap-2.5">' +
                                        '<div class="fs-5 mt-0.5"><i class="' + n.icon + '"></i></div>' +
                                        '<div class="flex-grow-1" style="min-width: 0;">' +
                                            '<div class="d-flex justify-content-between align-items-center mb-0.5">' +
                                                '<strong class="text-white small" style="font-family:\'Outfit\'; text-overflow: ellipsis; overflow: hidden; white-space: nowrap; max-width: 140px;">' + n.title + '</strong>' +
                                                '<span class="text-muted extra-small" style="font-size: 0.68rem; flex-shrink: 0;">' + n.createdAt + '</span>' +
                                            '</div>' +
                                            '<p class="text-muted small mb-0" style="font-size: 0.78rem; line-height: 1.35; text-overflow: ellipsis; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">' + n.message + '</p>' +
                                        '</div>' +
                                    '</div>' +
                                    '</a>';
                            });
                        }
                        
                        $('#adminNotifItemsList').html(listHtml);
                        $('#adminNotifCountBadge').text(count + ' Pending');
                        
                        if (count > 0) {
                            $('#adminNotifBadge').text(count).removeClass('d-none');
                        } else {
                            $('#adminNotifBadge').addClass('d-none');
                        }
                    }
                });
            };

            // Start polling if Admin bell icon exists and user is Admin
            if ($('#adminNotifBellBtn').length && isAdminLoggedIn) {
                window.pollAdminNotifications();
                // Check for new pending items every 20 seconds
                setInterval(window.pollAdminNotifications, 20000);
            }
        });
    </script>

